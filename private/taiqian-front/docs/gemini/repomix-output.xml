    placeholder: '请输入',
    prop: 'contractName'
  },
  {
    type: 'select',
    label: '合同状态',
    placeholder: '请选择',
    opts: [
      {
        label: '待签署',
        value: '0'
      },
      {
        label: '签署中',
        value: '1'
      },
      {
        label: '已签署',
        value: '2'
      }
    ],

    prop: 'signStatus'
  },
  {
    type: 'daterange',
    label: '签署日期',
    placeholder: '请选择',
    prop: 'timeList',
    searchProps: ['signTimeStart', 'signTimeEnd'],
    format: 'YYYY-MM-DD'
  }
])

const gridOptions = reactive({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },

  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true
  },
  columns: [
    { type: 'seq', width: 70 },
    { title: '融资企业名称', field: 'orgName', minWidth: 240 },
    { title: '金融产品名称', field: 'productName', minWidth: 180, showOverflow: true },
    { title: '合同名称', field: 'contractName', minWidth: 240 },
    { title: '合同编号', field: 'contractNo', minWidth: 240 },
    { title: '合同状态', field: 'signStatus', minWidth: 120, slots: { default: 'signStatusRender' } },
    { title: '签署时间', field: 'signTime', minWidth: 160, formatter: ['formatTime'] },
    { title: '操作', field: 'active', minWidth: 140, fixed: 'right', align: 'center', slots: { default: 'active' } }
