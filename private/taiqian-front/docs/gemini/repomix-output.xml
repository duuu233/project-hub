function setFileType(list, fileType) {
  if (!list || !list.length) return

  list.map((v, i) => {
    v.fileType = fileType
  })
}
const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      setFileType(form.value.creditVoucher, 200)
      setFileType(form.value.creditCooperationAgreement, 201)
      setFileType(form.value.creditMarginAgreement, 202)
      if (!form.value.creditVoucher) {
        form.value.creditVoucher = []
      }
      const submitData = cloneDeep(form.value)
      submitData.orgName = orgIdInfo.value.orgName
      submitData.creditDateStart = submitData.creditTime[0]
      submitData.creditDateEnd = submitData.creditTime[1]
      delete submitData.creditTime
      submitData.socialCreditCode = orgIdInfo.value.socialCreditCode
      if (JSON.stringify(submitData.orgCreditAccounts) !== '[{}]') {
        submitData.orgCreditAccounts.map(v => {
          v.type = 3

          v.currencySymbol = enumData.currencyList.find(o => o.currencyName === v.currency).currencySymbol
        })
        submitData.orgCreditAccounts = submitData.orgCreditAccounts.concat([
          {
            bankAccount: submitData.bankAccount,
            openingBank: submitData.openingBank,
            collectionName: submitData.collectionName,

            bankNo: submitData.bankNo,
            type: 1,
            currency: submitData.currency,
            currencySymbol: enumData.currencyList.find(o => o.currencyName === submitData.currency).currencySymbol
          },
