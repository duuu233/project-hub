          fileName: '法人身份证反面',
          fileType: 3002,
          fileUrl: form.value.legalCardBackFile
        }
      ]

      delete submitData.cascader
      if (_props.pageType === 2) {
        submitData.id = currentRoute.value.query.id
      }
      await coreEnterpriseAdd(submitData)
      ElMessage.success('操作成功')
      setTimeout(() => {
        proxy.toList({
