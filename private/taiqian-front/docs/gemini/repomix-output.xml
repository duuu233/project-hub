                :style="{ width: '100%' }"
                @change="handleFeeTypeChange($event, index)"
                :disabled="isDetailView || true"
              >
                <el-option v-for="dict in fee_type" :key="dict.value" :label="dict.label" :value="dict.value" />
              </el-select>
            </el-form-item>
          </el-col>
          <el-col :span="6">
            <el-form-item :prop="'feeInfo.' + index + '.feeRatio'" :rules="{ required: false, message: '请输入收费比例', trigger: 'blur' }">
              <el-input-number
                v-model="feeItem.feeRatio"
                :min="0.01"
                :max="100"
                :precision="2"
                placeholder=""
                :style="{ width: '100%' }"
                :disabled="isDetailView"
              />
            </el-form-item>
          </el-col>
          <el-col :span="6">
            <el-form-item>
              <el-input :value="feeItem.feeExpress" placeholder="" disabled />
            </el-form-item>
          </el-col>
          <el-col :span="6">
            <el-form-item :prop="'feeInfo.' + index + '.status'">
              <el-select v-model="feeItem.status" placeholder="请选择" :style="{ width: '100%' }" :disabled="isDetailView">
                <el-option label="启用" value="0" />
                <el-option label="禁用" value="1" />
              </el-select>
            </el-form-item>
          </el-col>
        </el-row>
      </div>
    </Collapse>

    <Collapse title="预存款预警配置">
      <el-row :gutter="20">
        <el-col :span="8">
          <el-form-item label="预存款低于预警值(元)" prop="prePayLimit">
            <el-input-number
              v-model="form.prePayLimit"
              :min="0"
              :precision="2"
              placeholder="请输入预警值"
              :style="{ width: '100%' }"
              :disabled="isDetailView"
            />
          </el-form-item>
        </el-col>
      </el-row>
    </Collapse>

    <el-form-item v-if="pageType !== 3">
      <div style="padding: 20px 0 0 20px">
        <el-button type="info" v-throttle @click="cancel">取消</el-button>
        <el-button type="primary" v-throttle @click="submit" :loading="submitLoading">确定</el-button>
      </div>
    </el-form-item>
  </el-form>
</template>

<script setup>
import { ref, reactive, onMounted, getCurrentInstance } from 'vue'
import { industryList as industryListApi } from '@/api/industry'
import { addFinanceProduct, getFinanceProductDetail, updateFinanceProduct, getSuperviserSimpleList } from '@/api/deppon/product'
import Collapse from '@/components/Collapse'
import { ElMessage } from 'element-plus'
import { useRouter } from 'vue-router'
import dayjs from 'dayjs'

const { currentRoute, back } = useRouter()
const { proxy } = getCurrentInstance()
const { product_type, repayment_entry_type, fee_type, rpa_data } = proxy.useDict('product_type', 'repayment_entry_type', 'fee_type', 'rpa_data')
const getStatusText = status => {
  return status == 0 ? '已生效' : '已失效'
}

const props = defineProps({
  pageType: Number
})
const isView = computed(() => props.pageType === 2)
const isDetailView = computed(() => props.pageType === 3)
const bankListOptions = ref([])
const traderListOptions = ref([])
const superviserListOptions = ref([])
const initSuperviserList = ref([])
const warehouseListOptions = ref([])

const projectInfoEditData = ref([])

const enumData = reactive({
  industryList: []
})
const submitLoading = ref(false)

const form = ref({
  projectInfo: [],
  dataCode: '',
  superviseInfo: [],
  feeInfo: [],
  loanMode: '1',
  payControlType: '0',
  repayEntryType: '1',
  prePayLimit: null,
  cooperationPeriod: []
})
const formRef = ref()

const pickDay = ref()
const handleFocus = () => {
  pickDay.value = null
}
const disabledDateFn = time => {
  if (!pickDay.value) {
    return
  }
  const startDate = dayjs(pickDay.value)
  const minEndDate = startDate.add(6, 'month')
  return time.valueOf() < minEndDate.valueOf()
}
const handleChange = val => {
  const [pointDay] = val
  pickDay.value = pointDay
}

onMounted(async () => {
  await getEnumData()
  getBankList()
  getSuperviserList()
  getTraderList()
  initFeeInfo()
  if (props.pageType !== 1) {
    getDetails()
  } else {
    addSupervisor()
  }
})

const initFeeInfo = () => {
  if (fee_type.value && fee_type.value.length > 0) {
    form.value.feeInfo = fee_type.value.map(item => ({
      feeExpress: item.remark || '',
      feeRatio: null,
      feeTypeName: item.label,
      feeTypeValue: item.value,
      financeProductId: null,
      status: '0'
    }))
  }
}

const handleFeeTypeChange = (value, index) => {
  const selectedFeeType = fee_type.value.find(item => item.value === value)
  if (selectedFeeType) {
    form.value.feeInfo[index].feeTypeName = selectedFeeType.label
    form.value.feeInfo[index].feeExpress = selectedFeeType.remark || ''
  }
}

const handleSuperviserChange = (value, index) => {
  const selectedSuperviser = initSuperviserList.value.find(item => item.value === value)
  if (selectedSuperviser) {
    form.value.superviseInfo[index].superviseName = selectedSuperviser.label
    form.value.superviseInfo[index].superviseId = selectedSuperviser.value

    form.value.superviseInfo[index].superviseWarehouseName = ''
    form.value.superviseInfo[index].superviseWarehouseId = ''
  }
}
const getSuperviserList = async () => {
  const res = await getSuperviserSimpleList({ orgType: 5 })
  const arr = res.data.map(item => ({
    label: item.orgName,
    value: item.id,
    superviseWarehouseName: '',
    superviseWarehouseId: '',
    warehouses: []
  }))

  const allWarehouses = []

  for (const item of arr) {
    const warehouseRes = await getSuperviserSimpleList({
      orgType: 6,
      regulatoryAuthoritiesId: item.value
    })

    const warehouses = warehouseRes.data.map(warehouse => ({
      label: warehouse.orgName,
      value: warehouse.id,
      superviserId: item.value
    }))

    item.warehouses = warehouses
    allWarehouses.push(...warehouses)

    if (warehouseRes.data.length) {
      item.superviseWarehouseName = warehouseRes.data[0]?.orgName
      item.superviseWarehouseId = warehouseRes.data[0]?.id
    }
  }

  superviserListOptions.value = arr
  initSuperviserList.value = arr
  warehouseListOptions.value = allWarehouses
}

const getAvailableWarehouses = currentIndex => {
  const currentSuperviseId = form.value.superviseInfo[currentIndex]?.superviseId
  if (!currentSuperviseId) {
    return []
  }

  return warehouseListOptions.value.filter(warehouse => warehouse.superviserId === currentSuperviseId)
}

const handleWarehouseChange = (warehouseId, index) => {
  const selectedWarehouse = warehouseListOptions.value.find(warehouse => warehouse.value === warehouseId)
  if (selectedWarehouse) {
    form.value.superviseInfo[index].superviseWarehouseName = selectedWarehouse.label
    form.value.superviseInfo[index].superviseWarehouseId = selectedWarehouse.value
  }
}

const getAvailableTraders = currentIndex => {
  return traderListOptions.value
}
const getAvailableSupervisers = currentIndex => {
  const currentTraderId = form.value.superviseInfo[currentIndex]?.traderId
  const selectedSuperviserIds = form.value.superviseInfo
    .filter((s, index) => index !== currentIndex && s.traderId === currentTraderId && s.superviseId)
    .map(s => s.superviseId)
  return superviserListOptions.value.filter(superviser => !selectedSuperviserIds.includes(superviser.value))
}

const getTraderList = async () => {
  const res = await getSuperviserSimpleList({ orgType: 0 })
  traderListOptions.value = res.data.map(item => ({
    label: item.orgName,
    value: item.id
  }))
}

const getBankList = async () => {
  const res = await getSuperviserSimpleList({ orgType: 3 })
  bankListOptions.value = res.data.map(item => ({
    label: item.orgName,
    value: item.id
  }))
}
async function getEnumData() {
  try {
    const res = await industryListApi({ pageSize: 500, pageNum: 1 })
    enumData.industryList = res.rows || []
  } catch (error) {
    console.log(error)
  }
}
const convertFormDataForSubmit = data => {
  let projectInfo = []
  if (data.projectInfo && data.projectInfo.length) {
    data.projectInfo.map(item => {
      let projectItem = enumData.industryList.find(o => o.id === item)
      projectInfo.push({
        id: item,
        projectName: projectItem.projectName
      })
    })
  }

  let dataName = ''
  if (data.dataCode) {
    let rpaDataItem = rpa_data.value.find(o => o.value === data.dataCode)
    if (rpaDataItem) {
      dataName = rpaDataItem.label
    }
  }

  const convertedData = {
    superviseInfo: [],
    feeInfo: [],
    ...data,
    projectInfo,
    dataName,
    bankName: bankListOptions.value.find(item => item.value === data.bankId)?.label
  }

  convertedData.superviseInfo = data.superviseInfo.map(item => ({
    coreOrgId: item.traderId,
    coreOrgName: traderListOptions.value.find(trader => trader.value === item.traderId)?.label || '',
    superviseId: item.superviseId,
    superviseName: item.superviseName,
    superviseProtocolNo: item.superviseProtocol,
    superviseWarehouseId: item.superviseWarehouseId,
    superviseWarehouseName: item.superviseWarehouseName
  }))

  convertedData.feeInfo = data.feeInfo.map(item => ({
    ...item,
    feeRatio: item.feeRatio / 100
  }))

  if (convertedData.productCreditLimit) {
    convertedData.productCreditLimit = convertedData.productCreditLimit * 1e4
  }
  if (convertedData.perMaxLimit) {
    convertedData.perMaxLimit = convertedData.perMaxLimit * 1e4
  }
  if (convertedData.financeInterestRate) {
    convertedData.financeInterestRate = convertedData.financeInterestRate / 100
  }
  return convertedData
}

const convertFormDataForDisplay = data => {
  const convertedData = {
    superviseInfo: [],
    feeInfo: [],
    ...data,
    loanMode: String(data.loanMode),
    type: String(data.type),
    repayMethod: String(data.repayMethod)
  }

  convertedData.superviseInfo =
    data.superviseInfo?.map(item => ({
      traderId: item.coreOrgId,
      superviseId: item.superviseId,
      superviseName: item.superviseName,
      superviseProtocol: item.superviseProtocolNo,
      superviseWarehouseId: item.superviseWarehouseId,
      superviseWarehouseName: item.superviseWarehouseName
    })) || []

  convertedData.feeInfo =
    data.feeInfo?.map(item => ({
      ...item,
      feeRatio: item.feeRatio * 100,
      status: String(item.status)
    })) || []

  if (convertedData.productCreditLimit) {
    convertedData.productCreditLimit = convertedData.productCreditLimit / 1e4
  }
  if (convertedData.perMaxLimit) {
    convertedData.perMaxLimit = convertedData.perMaxLimit / 1e4
  }
  if (convertedData.financeInterestRate) {
    convertedData.financeInterestRate = convertedData.financeInterestRate * 100
  }
  return convertedData
}

async function getDetails() {
  try {
    const res = await getFinanceProductDetail({
      id: currentRoute.value.query.id
    })
    res.data.payControlType = String(res.data.payControlType)
    form.value = convertFormDataForDisplay(res.data)
    form.value.repayEntryType = String(form.value.repayEntryType)
    projectInfoEditData.value = form.value.projectInfo
    let projectInfo = []
    if (form.value.projectInfo?.length) {
      form.value.projectInfo.map(item => {
        projectInfo.push(item.id)
      })
    }
    form.value.cooperationPeriod = [
      dayjs(res.data.productCooperateStartTime).format('YYYY-MM-DD'),
      dayjs(res.data.productCooperateEndTime).format('YYYY-MM-DD')
    ]
    form.value.projectInfo = projectInfo

    if (!form.value.feeInfo || form.value.feeInfo.length === 0) {
      initFeeInfo()
    }

    Array.isArray(res.data.superviseInfo) &&
      res.data.superviseInfo.forEach((item, index) => {
        const selectedSuperviser = initSuperviserList.value.find(superviser => superviser.value === item.superviseId)
        if (selectedSuperviser) {
          form.value.superviseInfo[index].superviseName = selectedSuperviser.label
        }
      })
  } catch (error) {}
}
function removeTag(v) {
  if (projectInfoEditData.value.length) {
    projectInfoEditData.value.map(item => {
      if (v === item.id) {
        ElMessage.warning('已保存过的关联产业不允许删除')
        form.value.projectInfo.push(v)
      }
    })
  }
}
const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      submitLoading.value = true
      try {
        const submitData = convertFormDataForSubmit(form.value)

        if (props.pageType === 1) {
          await addFinanceProduct(submitData)
        } else if (props.pageType === 2) {
          await updateFinanceProduct({
            ...submitData,
            id: currentRoute.value.query.id
          })
        }
        ElMessage.success('操作成功')
        back()
      } catch (error) {
        console.log('error', error)
      } finally {
        submitLoading.value = false
      }
    }
  })
}

const handleDateChange = val => {
  if (val && val.length === 2) {
    form.value.productCooperateStartTime = val[0]
    form.value.productCooperateEndTime = val[1]
  } else {
    form.value.productCooperateStartTime = ''
    form.value.productCooperateEndTime = ''
  }
}

const addSupervisor = () => {
  form.value.superviseInfo.push({
    traderId: '',
    superviseId: '',
    superviseName: '',
    superviseProtocol: '',
    superviseWarehouseId: '',
    superviseWarehouseName: ''
  })
}

const removeSupervisor = index => {
  form.value.superviseInfo.splice(index, 1)
}

const cancel = () => {
  back()
}

const rules = reactive({
  projectInfo: [{ type: 'array', required: true, message: '请选择产业项目', trigger: 'change' }],
  dataCode: [{ required: false, message: '请选择RPA数据包', trigger: 'change' }],
  type: [{ required: true, message: '请选择产品类型', trigger: 'change' }],
  loanMode: [{ required: true, message: '请选择放款模式', trigger: 'change' }],
  bankId: [{ required: true, message: '请选择银行', trigger: 'change' }],
  productName: [{ required: true, message: '请输入产品名称', trigger: 'blur' }],
  cooperationPeriod: [{ required: true, message: '请选择合作期限', trigger: 'change' }],
  productCreditLimit: [
    { required: true, message: '请输入授信额度', trigger: 'blur' },
    { type: 'number', min: 0, max: 1000000, message: '范围在0到1000000之间', trigger: 'blur' }
  ],
  financeInterestRate: [
    { required: false, message: '请输入融资利率', trigger: 'blur' },
    { type: 'number', min: 0, max: 20, message: '范围在0到20之间', trigger: 'blur' }
  ],
  perMaxLimit: [
    { required: true, message: '请输入单户最高额', trigger: 'blur' },
    { type: 'number', min: 0, max: 10000, message: '范围在0到10000之间', trigger: 'blur' }
  ],
  perLoanTimeLimit: [{ required: true, message: '请输入借款期限', trigger: 'blur' }],
  repayMethod: [{ required: true, message: '请选择还款方式', trigger: 'change' }],
  payControlType: [{ required: true, message: '请选择支付控制类型', trigger: 'change' }],
  repayEntryType: [{ required: true, message: '请选择还款入口类型', trigger: 'change' }],
  prePayLimit: [{ required: false, message: '请输入预存款预警值', trigger: 'blur' }],
  prepayType: [{ required: true, message: '请选择是否预付款模式', trigger: 'change' }]
})
</script>

