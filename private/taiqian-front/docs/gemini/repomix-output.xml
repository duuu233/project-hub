<script setup>
import Collapse from '@/components/Collapse'
import { InfoFilled } from '@element-plus/icons-vue'
import AreaCascader from '@/components/AreaCascader'
import { regulatoryWarehouseDetail, regulatoryWarehouseAdd, regulatoryAuthoritiesList } from '@/api/business'
import { onMounted, watchEffect } from 'vue'
import { ElMessage } from 'element-plus'
import { cloneDeep } from 'lodash-es'
import { industryList as industryListApi } from '@/api/industry'
import { useRouter } from 'vue-router'
const { push, currentRoute, back, replace } = useRouter()
const { proxy } = getCurrentInstance()
const { regulatory_type } = proxy.useDict('regulatory_type')
const _props = defineProps({
  pageType: Number
})
const form = ref({
  operatorList: [],
  regulatoryWarehouseOrg: {}
})
const enumData = reactive({
  supervisoryPartyList: [],
  industryList: []
})
const formRef = ref()
const cascaderRef = ref()

async function getDetails() {
  try {
    const res = await regulatoryWarehouseDetail(currentRoute.value.query.id)
    form.value = res.data
    let regulatoryWarehouseOrg = res.data.regulatoryWarehouseOrg || {}
    form.value.cascader = [regulatoryWarehouseOrg.provinceCode, regulatoryWarehouseOrg.cityCode, regulatoryWarehouseOrg.areaCode]

    if (!regulatoryWarehouseOrg.areaCode) {
      form.value.cascader.pop()
    }

    form.value.regulatoryType = form.value.regulatoryType + ''
  } catch (error) {
    console.log(error)
  }
}
const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      const submitData = cloneDeep(form.value)
      if (submitData.cascader && form.value.cascader.length) {
        submitData.regulatoryWarehouseOrg.areaFullName = cascaderRef.value.getNames().join('-')
        submitData.regulatoryWarehouseOrg.provinceCode = submitData.cascader[0]
        submitData.regulatoryWarehouseOrg.cityCode = submitData.cascader[1]
        submitData.regulatoryWarehouseOrg.areaCode = submitData.cascader[2] || ''
      }
      submitData.regulatoryAuthoritiesOrg = enumData.supervisoryPartyList.find(v => v.orgId === submitData.regulatoryAuthoritiesOrgId)
      submitData.regulatoryAuthoritiesOrg.id = submitData.regulatoryAuthoritiesOrg.orgId
      delete submitData.cascader
      if (_props.pageType === 2) {
        submitData.id = currentRoute.value.query.id
      }
      await regulatoryWarehouseAdd(submitData)
      ElMessage.success('操作成功')
      setTimeout(() => {
        proxy.toList({
          path: `business-supervision-warehouse`,
          listName: 'Business-supervision-warehouse'
        })
      }, 300)
    } else {
      console.log('error submit!', fields)
    }
  })
}
async function getEnumData() {
  try {
    const res = await regulatoryAuthoritiesList({})

    enumData.supervisoryPartyList = res.data || []
    const res2 = await industryListApi({ pageSize: 500, pageNum: 1 })
    enumData.industryList = res2.rows || []
  } catch (error) {
    console.log(error)
  }
}
onMounted(async () => {
  getEnumData()

  if (_props.pageType !== 1) {
    getDetails()
  }
})

const rules = reactive({
  'regulatoryWarehouseOrg.orgName': [
    {
      required: true,
      message: '请输入监管仓名称',
      trigger: 'blur'
    }
  ],
  'regulatoryWarehouseOrg.orgSimpleName': [
    {
      required: false,
      message: '请输入监管仓简称',
      trigger: 'blur'
    }
  ],
  'regulatoryWarehouseOrg.projectId': [
    {
      required: true,
      message: '请选择产业项目',
      trigger: 'change'
    }
  ],

  depponWarehouseCode: [
    {
      required: true,
      message: '请输入仓库编码(德邦)',
      trigger: 'blur'
    }
  ],

  depponWarehouseName: [
    {
      required: true,
      message: '请输入仓库编码(德邦)',
      trigger: 'blur'
    }
  ],

  regulatoryType: [
    {
      required: true,
      message: '请选择监管仓类型',
      trigger: 'change'
    }
  ],

  statisticalName: [
    {
      required: true,
      message: '请输入监管仓统计名称',
      trigger: 'blur'
    }
  ],

  cascader: [
    {
      required: true,
      type: 'array',
      message: '请选择仓库地址',
      trigger: 'change'
    }
  ],

  'regulatoryWarehouseOrg.address': [
    {
      required: true,

      message: '请输入具体地址',
      trigger: 'blur'
    }
  ],

  regulatoryAuthoritiesOrgId: [
    {
      required: true,
      message: '请选择监管方',
      trigger: 'change'
    }
  ],

  businessManager: [
    {
      required: false,
      message: '请输入业务经理名称',
      trigger: 'blur'
    }
  ],
  businessManagerPhone: [
    {
      required: false,
      message: '请输入业务经理手机号',
      trigger: 'blur'
    }
  ],
  contactEmail: [
    {
      required: false,
      message: '请输入联系邮箱',
      trigger: 'blur'
    }
  ]
})
</script>
