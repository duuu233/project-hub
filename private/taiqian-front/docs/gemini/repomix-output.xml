            bankAccount: submitData.bankAccount2,
            openingBank: submitData.openingBank2,
            collectionName: submitData.collectionName2,

            bankNo: submitData.bankNo2,
            type: 2,
            currency: submitData.currency2,
            currencySymbol: enumData.currencyList.find(o => o.currencyName === submitData.currency2).currencySymbol
          }
        ])
      }

      await coreEnterpriseCreditAdd(submitData)
      ElMessage.success('操作成功')
      setTimeout(() => {
        proxy.toList({
          path: `credit-core-enterprise`,
          listName: 'Credit-core-enterprise'
        })
      }, 300)
    } else {
      console.log('error submit!', fields)
    }
  })
}
