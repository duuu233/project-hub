        <el-popconfirm
          confirm-button-text="确定"
          cancel-button-text="取消"
          :icon="InfoFilled"
          icon-color="#626AEF"
          cancel-button-type="info"
          title="确定要删除该项?"
          @confirm="confirmDel(row)"
        >
          <template #reference>
            <el-button v-if="row.status == 0" v-hasPermi="['tenant:fee:delete']" link type="primary">删除</el-button>
          </template>
        </el-popconfirm>
