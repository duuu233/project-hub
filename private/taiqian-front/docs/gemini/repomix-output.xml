      <div class="subsystem-wrapper">
        <span class="subsystem-label">{{ currentSystemLabel }}</span>
        <el-icon><caret-bottom /></el-icon>
      </div>
      <template #dropdown>
        <el-dropdown-menu>
          <el-dropdown-item
            v-for="item in systemList"
            :key="item.code"
            :command="item.code"
            :disabled="item.code === currentSystemKey"
          >
            <span>{{ item.label }}</span>
          </el-dropdown-item>
        </el-dropdown-menu>
      </template>
    </el-dropdown>
  </div>
</template>

<script setup>
import { computed, onMounted, ref } from 'vue'
import {
  getAccessibleSsoSystems,
  getCurrentSsoSystemCode,
  getCurrentSsoSystemLabel,
  openSsoSystemWindow,
  syncSsoSystemContext
} from '@/utils/ssoSystem'

const accessibleSystems = ref([])

function refreshSystemList() {
  accessibleSystems.value = getAccessibleSsoSystems()
}

const currentSystemKey = computed(() => getCurrentSsoSystemCode())

const currentSystemLabel = computed(() => {
  return getCurrentSsoSystemLabel() || '系统切换'
})

const systemList = computed(() => {
  if ((accessibleSystems.value || []).length <= 1) {
    return []
  }

  return accessibleSystems.value.filter(item => item.code !== currentSystemKey.value)
})

function handleCommand(command) {
  if (!command || command === currentSystemKey.value) {
    return
  }

  openSsoSystemWindow(command)
}

onMounted(() => {
  syncSsoSystemContext()
  refreshSystemList()
})
</script>

