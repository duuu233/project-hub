          <el-tab-pane label="待处理" name="todo"></el-tab-pane>
          <el-tab-pane label="已完成" name="done"></el-tab-pane>
        </el-tabs>

        <div class="search-container">
          <el-select v-model="query.processAuditStatus" placeholder="全部状态" clearable class="status-select">
            <el-option v-for="item in processAuditStatus" :key="item.value" :label="item.label" :value="item.value" />
          </el-select>

          <el-select v-model="query.category" placeholder="业务类型审批" clearable class="status-select">
            <el-option v-for="item in auditCategory" :key="item.value" :label="item.label" :value="item.value" />
          </el-select>

          <el-button type="primary" @click="handleSearch" class="search-button">查询</el-button>
        </div>

        <div class="task-list">
          <div
            v-for="(item, index) in tableData"
            :key="item.uniqueId"
            class="task-item"
            :class="{ active: selectedTask && selectedTask.uniqueId === item.uniqueId }"
            @click="handleSelectTask(item)"
          >
            <div class="task-item-header">
              <span class="task-type">{{ item.modelName }}</span>
              <span
                class="task-status"
                :class="getStatusClass(activeTab === 'todo' ? item.isFinish : activeTab === 'init' ? item.processAuditStatus : item.auditStatus)"
              >
                {{
                  activeTab === 'todo'
                    ? getStatusLabel(item.isFinish)
                    : activeTab === 'init'
                    ? getApprovalStatusName(item.processAuditStatus)
                    : getApprovalStatusName(item.auditStatus)
                }}
              </span>
            </div>

            <div class="task-item-content">
              <div class="task-info-row">
                <span class="task-label">流水号：</span>
                <span class="task-value">{{ item.businessKey || '-' }}</span>
              </div>
              <div class="task-info-row">
                <span class="task-label">企业名称：</span>
                <span class="task-value">{{ item.customerName || '-' }}</span>
              </div>
              <div class="task-info-row">
                <span class="task-label">{{ activeTab === 'todo' ? '发起人：' : '节点名称：' }}</span>
                <span class="task-value">{{ activeTab === 'todo' ? item.initiatorName || '-' : item.taskName || '-' }}</span>
              </div>
              <div class="task-info-row">
                <span class="task-label">创建时间：</span>
                <span class="task-value">{{ item.processCreateTime || '-' }}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="pagination-container">
          <el-pagination
            v-show="total > 0"
            layout="prev, pager, next"
            :total="total"
            :page-size="queryParams.pageSize"
            :current-page="queryParams.pageNum"
            @current-change="handleCurrentChange"
            class="custom-pagination"
          />
        </div>
      </div>

      <div class="approval-right">
        <template v-if="selectedTask">
          <div class="approval-header">
            <h2 class="approval-title">任务审批</h2>
            <div class="approval-id">流水号：{{ selectedTask.businessKey || '-' }}</div>
          </div>

          <el-tabs v-model="detailActiveTab" class="custom-tabs">
            <el-tab-pane label="审批详情" name="detail"></el-tab-pane>
            <el-tab-pane label="审批记录" name="record"></el-tab-pane>
          </el-tabs>

          <div class="approval-content-container" v-if="detailActiveTab === 'detail'">
            <div class="component-container">
              <transition name="fade" mode="out-in">
                <div v-if="componentLoading" class="component-loading">
                  <el-skeleton animated :rows="10" />
                </div>
                <component
                  v-else-if="currentModelKey"
                  :is="getApprovalComponent"
                  :key="componentKey"
                  :task-data="selectedTask"
                  @update="handleComponentUpdate"
                />
                <div v-else class="placeholder-content">
                  <p>审批内容将在这里显示</p>
                  <p class="hint-text">可以根据实际需求引入具体审批内容组件</p>
                </div>
              </transition>
            </div>
          </div>

          <div class="approval-flow" v-if="detailActiveTab === 'record' && approvalFlowList.length">
            <el-table :data="approvalFlowList" border style="width: 100%" class="custom-table">
              <el-table-column label="节点名称" prop="taskName" />
              <el-table-column label="审批人" prop="auditorName" />
              <el-table-column label="审批结果" prop="auditStatusName">
                <template #default="scope">
                  <el-tag :type="getApprovalTagType(scope.row.auditStatus)" class="custom-tag">
                    {{ scope.row.auditStatusName }}
                  </el-tag>
                </template>
              </el-table-column>
              <el-table-column label="审批意见" prop="auditComment" />
              <el-table-column label="审批时间" prop="auditedTime" />
            </el-table>
          </div>

          <div class="approval-actions" v-if="isApproval && detailActiveTab === 'detail'">
            <div class="approval-form">
              <div class="form-item">
                <span class="label">审批意见：</span>
                <el-input type="textarea" v-model="auditForm.comment" :rows="4" placeholder="请输入审批意见" class="comment-textarea"></el-input>
              </div>
            </div>

            <div v-if="hasValidationErrors" class="validation-error-message">
              <el-alert type="error" :title="validationErrorMessage" :closable="false" show-icon />
            </div>

            <div class="action-buttons">
              <el-button v-if="includedOperations.includes('agree')" type="primary" @click="submitAudit('agree')" class="action-button approve-button"
                >审核通过</el-button
              >
              <el-button v-if="includedOperations.includes('reject')" type="danger" @click="submitAudit('reject')" class="action-button"
                >拒绝</el-button
              >
              <el-button v-if="includedOperations.includes('reject_up')" @click="submitAudit('reject_up')" class="action-button"
                >打回上一级</el-button
              >
              <el-button v-if="includedOperations.includes('reject_first')" @click="submitAudit('reject_first')" class="action-button"
                >打回第一级</el-button
              >
            </div>
          </div>
        </template>

        <div class="no-task-selected" v-else>
          <el-empty description="请选择一个审批任务"></el-empty>

        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, reactive, onMounted, watch, computed, nextTick } from 'vue'
import { Search } from '@element-plus/icons-vue'
import { ElMessage } from 'element-plus'
import { getInitList, getTodoList, getDoneList, postTodo, getCheckByApplyId, taskDetail } from '@/api/deppon/todo'
import CoreEnterpriseAccess from './components/CoreEnterpriseAccess.vue'
import CoreEnterpriseCredit from './components/CoreEnterpriseCredit.vue'
import LoanEnterpriseAccess from './components/LoanEnterpriseAccess.vue'
import LoanEnterpriseCredit from './components/LoanEnterpriseCredit.vue'
import RegulatoryWarehouseAccess from './components/RegulatoryWarehouseAccess.vue'
import FinanceRepay from './components/FinanceRepay.vue'
import FinanceLoan from './components/FinanceLoan.vue'
import FinanceCancel from './components/FinanceCancel.vue'
import FinanceApply from './components/FinanceApply.vue'
import StockInAudit from './components/StockInAudit.vue'
import StockOutAudit from './components/StockOutAudit.vue'
import CouponIssueAudit from './components/CouponIssueAudit.vue'

const activeTab = ref('init')
const detailActiveTab = ref('detail')
const includedOperations = ref([])

const loading = ref(false)
const componentLoading = ref(false)
const total = ref(0)
const tableData = ref([])
const selectedTask = ref(null)
const isApproval = ref(false)
const approvalFlowList = ref([])
const currentModelKey = ref('')
const componentKey = ref('')

const statusOptions = [
  { value: 0, label: '未审批' },
  { value: 1, label: '已通过' }
]

const processAuditStatus = [
  { value: 'processing', label: '审核中' },
  { value: 'agree', label: '审核通过' },
  { value: 'reject', label: '审核不通过' }
]

const approvalStatus = [

  { value: 'agree', label: '审核通过' },
  { value: 'reject', label: '拒绝' },
  { value: 'reject_up', label: '打回上一级' },
  { value: 'reject_first', label: '打回第一级' },
  { value: 'processing', label: '审核中' }
]

const auditCategory = [
  { value: 'finance_apply', label: '融资申请审核' },
  { value: 'finance_cancel', label: '融资取消审核' },
  { value: 'finance_loan', label: '融资放款审核' },
  { value: 'finance_repay', label: '融资还款审核' },
  { value: 'LoanEnterprise_Access', label: '借款企业准入审核' },
  { value: 'LoanEnterprise_Credit', label: '借款企业授信审核' },
  { value: 'RegulatoryWarehouse_Access', label: '监管仓库准入审核' },
  { value: 'CoreEnterprise_Access', label: '核心企业准入审核' },
  { value: 'CoreEnterprise_Credit', label: '核心企业授信审核' },
  { value: 'stock_in_audit', label: '实际入库审核' },
  { value: 'stock_out_audit', label: '实际出库审核' },
  { value: 'coupon_issue_audit', label: '优惠券发放审核' },
]

const queryParams = reactive({
  pageNum: 1,
  pageSize: 10
})

const query = reactive({
  processAuditStatus: '',
  category: null
})

const auditForm = reactive({
  auditResult: '',
  comment: '',
  instanceId: '',
  taskId: '',
  checkItemContent: ''
})

const updateRecord = ref(null)

const hasValidationErrors = computed(() => {
  return updateRecord.value && !updateRecord.value.isValid
})

const validationErrorMessage = computed(() => {
  if (hasValidationErrors.value) {
    return `请完善${selectedTask.value.modelName}必填信息，再提交审批`
  }
  return ''
})

const getList = async () => {
  loading.value = true
  try {
    const params = {
      ...queryParams,
      ...query
    }

    const apiMap = {
      init: getInitList,
      todo: getTodoList,
      done: getDoneList
    }

    const response = await apiMap[activeTab.value](params)
    tableData.value = (response.rows || []).map(item => {
      if (activeTab.value === 'todo') {
        item.isFinish = 0
      }
      return {
        ...item,
        uniqueId: `${item.modelKey || ''}_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`
      }
    })
    total.value = +response.total || 0
  } catch (error) {
    console.error('获取列表失败', error)
  } finally {
    loading.value = false
  }
}

const handleSearch = () => {
  queryParams.pageNum = 1
  getList()
}

const handleCurrentChange = page => {
  queryParams.pageNum = page
  getList()
}

const getStatusLabel = value => {
  return statusOptions.find(item => item.value === Number(value))?.label || '处理中'
}

const getStatusClass = value => {
  if (activeTab.value === 'todo') {
    switch (value) {
      case '0':
      case 0:
        return 'status-warning'
      case '1':
      case 1:
        return 'status-success'
      default:
        return 'status-info'
    }
  } else {
    switch (value) {
      case 'agree':
        return 'status-success'
      case 'reject':
      case 'reject_up':
      case 'reject_first':
        return 'status-danger'
      default:
        return 'status-info'
    }
  }
}

const getApprovalTagType = status => {
  switch (status) {
    case 'agree':
      return 'success'
    case 'reject':
    case 'reject_up':
    case 'reject_first':
      return 'danger'
    default:
      return 'info'
  }
}

const getApprovalStatusName = status => {
  return approvalStatus.find(item => item.value === status)?.label || '-'
}

const handleSelectTask = async task => {

  updateRecord.value = null

  componentLoading.value = true

  task.activeTab = activeTab.value

  selectedTask.value = task
  isApproval.value = activeTab.value === 'todo' && +task.isFinish === 0

  auditForm.instanceId = task.processInstanceId || ''
  auditForm.taskId = task.taskId || ''
  auditForm.comment = ''

  if (isApproval.value) {
    try {
      const response = await taskDetail({
        instanceId: task.processInstanceId,
        taskId: task.taskId
      })
      includedOperations.value = response.data.includedOperation || []
    } catch (error) {
      console.error('获取任务详情失败', error)
      includedOperations.value = []
    }
  } else {
    includedOperations.value = []
  }

  const modelKey = task.modelKey || ''
  currentModelKey.value = modelKey.split('.')[0] || ''

  componentKey.value = `${currentModelKey.value}_${task.businessKey || ''}_${Date.now()}`

  fetchApprovalFlow(task.businessKey || '')

  await new Promise(resolve => setTimeout(resolve, 600))

  componentLoading.value = false
}

const fetchApprovalFlow = async businessKey => {
  if (!businessKey) return

  try {
    const response = await getCheckByApplyId({ businessKey })
    approvalFlowList.value = response.data.list || []
  } catch (error) {
    console.error('获取审批流程失败', error)
  }
}

const handleComponentUpdate = data => {
  updateRecord.value = data
}

const submitAudit = async result => {
  if (!selectedTask.value) {
    ElMessage.warning('请选择审批任务')
    return
  }

  if (result === 'agree' && updateRecord.value) {

    if (!updateRecord.value.isValid) {
      ElMessage.error('请完善必填的授信信息后再提交审批')
      return
    }
  }

  auditForm.auditResult = result

  if (updateRecord.value) {
    auditForm.data = updateRecord.value
  }

  try {
    await postTodo(auditForm)
    ElMessage.success('审批提交成功')
    getList()
    selectedTask.value = null
    updateRecord.value = null
  } catch (error) {
    console.error('提交审批失败', error)
    ElMessage.error('提交审批失败')
  }
}

watch(activeTab, newVal => {
  queryParams.pageNum = 1
  selectedTask.value = null
  updateRecord.value = null
  getList()
})

watch(detailActiveTab, () => {
  if (detailActiveTab.value === 'detail') {
    componentLoading.value = true
    nextTick(() => {
      setTimeout(() => {
        componentLoading.value = false
      }, 300)
    })
  }
})

onMounted(() => {
  getList()
})

const getApprovalComponent = computed(() => {
  const componentMap = {
    CoreEnterprise_Access: CoreEnterpriseAccess,
    CoreEnterprise_Credit: CoreEnterpriseCredit,
    LoanEnterprise_Access: LoanEnterpriseAccess,
    LoanEnterprise_Credit: LoanEnterpriseCredit,
    RegulatoryWarehouse_Access: RegulatoryWarehouseAccess,
    finance_repay: FinanceRepay,
    finance_loan: FinanceLoan,
    finance_cancel: FinanceCancel,
    finance_apply: FinanceApply,
    stock_in_audit: StockInAudit,
    stock_out_audit: StockOutAudit,
    coupon_issue_audit: CouponIssueAudit,
  }
  return componentMap[currentModelKey.value] || null
})
</script>

