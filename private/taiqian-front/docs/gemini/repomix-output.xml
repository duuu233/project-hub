const router = useRouter()
const { proxy } = getCurrentInstance()
const { finance_status } = proxy.useDict('finance_status')
const gridRef = ref()

const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const query = reactive({
  customerName: '',
  productName: ''
})
const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  getList('handleSearch')
}

const searchOpt = ref([
  {
    type: 'input',
    label: '融资企业名称',
    placeholder: '请输入',
    prop: 'customerName'
  },
  {
    type: 'input',
    label: '金融产品名称',
    placeholder: '请输入',
    prop: 'productName'
  }
])

const gridOptions = reactive({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true
  },
  columns: [
    { type: 'seq', width: 70 },
    { title: '融资企业名称', field: 'customerName', minWidth: 160 },
    { title: '金融产品名称', field: 'productName', minWidth: 160 },
    { title: '预付款存款', minWidth: 160, field: `feeAmount1`, formatter: ['formatThousand'] },
    { title: '技术服务费', minWidth: 160, field: `feeAmount2`, formatter: ['formatThousand'] },
    { title: '数据监管费用', minWidth: 160, field: `feeAmount3`, formatter: ['formatThousand'] },
    { title: '预付款冻结累加', field: 'frozenAmount', minWidth: 160, formatter: ['formatThousand'] },
    { title: '预付款可用余额', field: 'availableBalance', minWidth: 160, formatter: ['formatThousand'] },
    { title: '操作', field: 'active', minWidth: 140, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
})

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

async function getList(type) {
  gridOptions.loading = true
  try {
    const res = await feeList({
      pageNum: gridOptions.pagerConfig.currentPage,
      pageSize: gridOptions.pagerConfig.pageSize,
      ...query
    })

    res.rows.forEach(row => {
      if (row.summaryList && row.summaryList.length) {
        row.summaryList.forEach((item, index) => {
          row[`feeAmount${item.feeType}`] = item.feeAmount
        })
      }
    })

    gridOptions.data = res.rows
    gridOptions.pagerConfig.total = res.total * 1
  } catch (error) {
    console.error('获取列表失败:', error)
    ElMessage.error('获取列表失败')
  } finally {
    gridOptions.loading = false
  }
}

const handleDetail = row => {
