    { title: '统一信用代码', field: 'socialCreditCode', width: 280 },
    { title: '系统状态', field: 'status', align: 'center', slots: { default: 'statusRender' } },
    { title: '操作', field: 'active', width: 240, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
})

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

const data = reactive({
  queryParams: {
    pageNum: 1,
    pageSize: 10,
    dictName: undefined,
    dictType: undefined,
    status: undefined
  }
})
const { queryParams, form, rules } = toRefs(data)

const query = reactive({
  orgCode: '',
  orgName: ''
})
const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}
const searchOpt = ref([
  {
    type: 'input',
    label: '企业编码：',
    placeholder: '请输入',
    prop: 'orgCode'
  },
  { type: 'input', label: '企业名称：', placeholder: '请输入', prop: 'orgName' }
])

function getList() {
  gridOptions.loading = true
  console.log('gridOptions.pagerConfig1', gridOptions.pagerConfig.currentPage)
  console.log('gridOptions.pageSize1', gridOptions.pagerConfig.pageSize)
  enterpriseUserList({
    ...proxy.addDateRange(queryParams.value),
    ...query,
    pageNum: gridOptions.pagerConfig.currentPage,
    pageSize: gridOptions.pagerConfig.pageSize
  }).then(response => {
    gridOptions.data = response.rows
    gridOptions.pagerConfig.total = response.total * 1
    gridOptions.loading = false
  })
}

async function confirmDel(row) {
  try {
    await delEnterpriseUser([row.id])
    ElMessage.success('已删除')
    gridOptions.pagerConfig.currentPage = 1
    getList()
  } catch (error) {
    ElMessage.error('操作失败')
  }
}

function handleExport() {
  proxy.download(
    'system/role/export',
    {
      ...queryParams.value
    },
    `role_${new Date().getTime()}.xlsx`
  )
}

function handleSelectionChange(selection) {
  ids.value = selection.map(item => item.roleId)
  single.value = selection.length != 1
  multiple.value = !selection.length
}
function getUserGroupIds(data) {
  let list = []
  if (data && data.length) {
    data.map(v => {
      list.push(v.userGroupsName)
    })
  }

  return list.join(',')
}
async function confirmStatus(row) {
  try {
    await changeStatusEnterpriseUser({
      orgId: row.id,
      status: row.status === '0' ? '1' : '0'
    })
    ElMessage.success('操作成功')
    gridOptions.pagerConfig.currentPage = 1
    getList()
  } catch (error) {
    ElMessage.error('操作失败')
  }
}
function handleAdd() {
  router.push({ path: '/system/enterprise-users/add' })
}
const handleEdit = param => {
  proxy.openNewTagsView({
    name: 'Enterprise-users/edit'
  })
  router.push({
    path: '/system/enterprise-users/edit',
    query: { id: param.id }
  })
}
const handleDetail = param => {
  proxy.openNewTagsView({
    name: 'Enterprise-users/detail'
  })
  router.push({
    path: '/system/enterprise-users/detail',
    query: { id: param.id }
  })
}

onMounted(() => {
  getList()
  registerGrid('enterprise-users-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('enterprise-users-grid')
})
</script>
