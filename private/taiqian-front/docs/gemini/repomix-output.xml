<script setup>
import { ref, onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import Collapse from '@/components/Collapse'
import FileUpload from '@/components/FileUpload'
import { stockInDetail, submitApprove } from '@/api/deppon/loanAfter'
import { parseTime } from '@/utils/ruoyi'

const props = defineProps({
  id: {
    type: [String, Number],
    required: true
  },
  pageType: {
    type: String,
    default: ''
  }
})

const isDetail = ref(props.pageType == 3)
const formRef = ref()
const form = ref({
  loanAfterNo: '',
  approveStatusText: '',
  createTime: '',
  agentOrderNo: '',
  financeNo: '',
  loanAfterTypeText: '',
  warehouse: '',
  actualStorageDate: '',
  storageNo: '',
  goodsInfo: [],
  storageFile: []
})

const operationButtons = [
  { label: '海运', value: '1' },
  { label: '报关', value: '2' },
  { label: '入库', value: '3' },
  { label: '码头直提', value: '4' },
  { label: '堆场提货', value: '5' }
]

const formatFileList = (fileList = []) => {
  return fileList.map(file => ({
    name: file.fileName,
    url: file.fileUrl
  }))
}

onMounted(async () => {
  const { data } = await stockInDetail({ id: props.id })

  const approveStatusMap = {
    0: '待审批',
    1: '审批通过',
    2: '审批不通过'
  }

  form.value = {
    ...data,
    approveStatusText: approveStatusMap[data.approveStatus] || '-',
    loanAfterTypeText: operationButtons[data.loanAfterType - 1].label,
    createTime: parseTime(data.createTime),
    warehouse: data.warehouseName,
    actualStorageDate: data.stockInDate,
    storageNo: data.stockInNo,
    goodsInfo: data.loanAfterStockInGoods || [],
    storageFile: formatFileList(data.fileList)
  }
})

const rules = {
  storageFile: [{ required: true, message: '请上传入库单', trigger: 'change' }]
}

const getFormatFileList = () => {
  return form.value.storageFile.map(file => ({
    fileName: file.name,
    fileUrl: file.url,
    fileType: '114',
    fileSuffix: file.name.split('.').pop()
  }))
}

const submitForm = async () => {
  await formRef.value.validate(async valid => {
    if (valid) {
      const params = {
        id: props.id,
        fileList: getFormatFileList()
      }
      await submitApprove(params)
      ElMessage.success('提交成功')
      history.back()
    }
  })
}

const cancel = () => {
  history.back()
}
</script>

