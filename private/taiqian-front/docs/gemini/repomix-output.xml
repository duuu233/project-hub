<script setup>
import Collapse from '@/components/Collapse'
import FileUpload from '@/components/FileUpload'
import { ref, reactive, computed, onMounted, getCurrentInstance } from 'vue'
import { ElMessage } from 'element-plus'
import { useRouter, useRoute } from 'vue-router'
import { getDepositDetail, confirmSubmitDeposit, saveDraftDeposit } from '@/api/billing'
import { productSelectList } from '@/api/deppon/product'
import { borrowingEnterpriseSelectList } from '@/api/credit'

const { proxy } = getCurrentInstance()
const router = useRouter()
const route = useRoute()
const props = defineProps({
  pageType: {
    type: Number,
    default: 1
  }
})

const depositId = ref(route.query.id || '')
const isDetail = computed(() => props.pageType === 3)
const isEdit = computed(() => props.pageType === 2)

const form = ref({
  id: '',
  productId: '',
  productName: '',
  customerId: '',
  customerName: '',
  depositDate: '',
  depositAmount: null,
  remark: '',
  fileList: [],
  serialNo: '',
  status: 0
})

const productOptions = ref([])
const customerOptions = ref([])
const confirmDialogVisible = ref(false)

const rules = reactive({
  productId: [{ required: true, message: '请选择金融产品', trigger: 'change' }],
  customerId: [{ required: true, message: '请选择借款企业', trigger: 'change' }],
  depositDate: [{ required: true, message: '请选择存款日期', trigger: 'change' }],
  depositAmount: [{ required: true, message: '请输入预存金额', trigger: 'blur' }]
})

const getProductOptions = async () => {
  try {
    const res = await productSelectList()
    if (Array.isArray(res.data)) {
      productOptions.value = res.data.map(item => ({
        label: item.productName,
        value: item.id,
        productName: item.productName
      }))
    }
  } catch (error) {
    console.error('获取产品列表失败:', error)
  }
}

const getCustomerOptions = async () => {
  try {
    const res = await borrowingEnterpriseSelectList({ accessStatus: 1 })
    if (res && Array.isArray(res.data)) {
      customerOptions.value = res.data.map(item => ({
        label: item.orgName,
        value: item.orgId,
        orgName: item.orgName
      }))
    }
  } catch (error) {
    console.error('获取借款企业列表失败:', error)
  }
}

const handleProductChange = productId => {
  const selectedProduct = productOptions.value.find(item => item.value === productId)
  if (selectedProduct) {
    form.value.productName = selectedProduct.productName
  }
}

const handleCustomerChange = customerId => {
  const selectedCustomer = customerOptions.value.find(item => item.value === customerId)
  if (selectedCustomer) {
    form.value.customerName = selectedCustomer.orgName
  }
}

const fetchDetail = async () => {
  if (!depositId.value) return

  try {
    const res = await getDepositDetail({ id: depositId.value })
    if (res && res.data) {
      const detailData = res.data

      form.value.id = detailData.id
      form.value.productId = detailData.productId
      form.value.productName = detailData.productName
      form.value.customerId = detailData.customerId
      form.value.customerName = detailData.customerName
      form.value.depositDate = detailData.depositDate
      form.value.depositAmount = detailData.depositAmount
      form.value.remark = detailData.remark
      form.value.serialNo = detailData.serialNo
      form.value.status = detailData.status

      if (detailData.fileList && Array.isArray(detailData.fileList)) {
        form.value.fileList = detailData.fileList.map(file => ({
          fileName: file.fileName,
          fileUrl: file.fileUrl,
          name: file.fileName,
          url: file.fileUrl,
          sourceType: file.sourceType,
          fileType: file.fileType,
          fileSuffix: file.fileSuffix
        }))
      }
    }
  } catch (error) {
    console.error('获取详情失败', error)
    ElMessage.error('获取详情失败')
  }
}

const handleCancel = () => {
  router.push('/billing/prepayment')
}

const handleSave = async status => {
  const formRef = proxy.$refs.formRef
  const valid = await formRef.validate().catch(() => false)
  if (!valid) {
    ElMessage.error('表单验证失败，请检查必填项')
    return
  }

  if (status === 1) {

    confirmDialogVisible.value = true
    return
  }

  await submitForm(0)
}

const handleConfirmSubmit = async () => {
  confirmDialogVisible.value = false
  await submitForm(1)
}

const submitForm = async status => {
  const formData = prepareFormData(status)

  try {
    if (status === 1) {
      await confirmSubmitDeposit(formData)
      ElMessage.success('确认提交成功')
    } else {
      await saveDraftDeposit(formData)
      ElMessage.success('保存草稿成功')
    }
    router.push('/billing/prepayment')
  } catch (error) {
    console.error('操作失败', error)
    ElMessage.error('操作失败')
  }
}

const prepareFormData = status => {
  const formData = JSON.parse(JSON.stringify(form.value))

  formData.status = status

  if (formData.fileList && formData.fileList.length > 0) {
    formData.fileList = formData.fileList.map(file => ({
      fileName: file.fileName || file.name,
      fileUrl: file.fileUrl || file.url,
      sourceType: 52,
      fileType: 19,
      fileSuffix: file.fileName ? file.fileName.split('.').pop() : file.name ? file.name.split('.').pop() : ''
    }))
  }

  return formData
}

onMounted(async () => {
  await Promise.all([getProductOptions(), getCustomerOptions()])

  if (depositId.value) {
    await fetchDetail()
  }
})
</script>

