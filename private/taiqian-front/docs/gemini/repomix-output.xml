<script setup>
import { onMounted, ref, reactive } from 'vue'
import { ElMessage } from 'element-plus'
import TableSearch from '@/components/TableSearch'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'
import { supplierList } from '@/api/business'

const router = useRouter()
const { proxy } = getCurrentInstance()
const gridRef = ref()

const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const query = reactive({
  orgType: 2,
  orgName: ''
})

const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}

const searchOpt = ref([
  {
    type: 'input',
    label: '企业名称：',
    placeholder: '请输入',
    prop: 'orgName'
  }
])

const gridOptions = reactive({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true,
    slots: {
      buttons: 'toolbarButtons'
    }
  },
  columns: [
    { type: 'seq', width: 70 },
    { title: '客户号', field: 'orgCode', minWidth: 100, showOverflow: true },
    { title: '企业名称(品牌厂家)', field: 'orgName', minWidth: 100, showOverflow: true },
    { title: '地区', field: 'areaFullName', minWidth: 100, showOverflow: true },
    { title: '状态', field: 'delFlag', minWidth: 100, align: 'center', slots: { default: 'statusRender' } },
    { title: '创建时间', field: 'createTime', minWidth: 180, align: 'center', slots: { default: 'createTimeRender' } },
    { title: '修改时间', field: 'updateTime', minWidth: 180, align: 'center', slots: { default: 'updateTimeRender' } },
    { title: '操作', field: 'active', minWidth: 140, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
})

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

async function getList() {
  gridOptions.loading = true
  try {
    const res = await supplierList({
      pageNum: gridOptions.pagerConfig.currentPage,
      pageSize: gridOptions.pagerConfig.pageSize,
      ...query
    })

    gridOptions.data = res.rows
    gridOptions.pagerConfig.total = res.total * 1
  } catch (error) {
    console.error('获取列表失败:', error)
    ElMessage.error('获取列表失败')
  } finally {
    gridOptions.loading = false
  }
}

function handleAdd() {
  router.push({ path: 'merchants-supplier-add' })
}

const handleEdit = param => {
  proxy.openNewTagsView({
    name: 'merchants-supplier-edit'
  })
  router.push({
    path: 'merchants-supplier-edit',
    query: { id: param.id }
  })
}

const handleDetail = param => {
  proxy.openNewTagsView({
    name: 'merchants-supplier-detail'
  })
  router.push({
    path: 'merchants-supplier-detail',
    query: { id: param.id }
  })
}

onMounted(() => {
  getList()
  registerGrid('business-supplier-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('business-supplier-grid')
})
</script>

