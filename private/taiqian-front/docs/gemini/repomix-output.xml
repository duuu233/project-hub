<script setup>
import { parseTime } from '@/utils/ruoyi'
import { getCurrentInstance, ref, onMounted } from 'vue'
import { Download } from '@element-plus/icons-vue'
import { warehouseInfoDetail } from '@/api/business'
import { regulatoryWarehouseAccessDetail } from '@/api/access'
import dayjs from 'dayjs'
const { proxy } = getCurrentInstance()
const { access_status, registration_status } = proxy.useDict('access_status', 'registration_status')

const props = defineProps({
  taskData: {
    type: Object,
    default: () => ({})
  }
})

const detailData = ref({})
const warehouseDetail = ref({
  regulatoryWarehouseOrg: {},
  regulatoryAuthoritiesOrg: {},
  businessLicenseFile: [],
  regulatoryAgreementFile: []
})

const getDetail = async () => {
  try {
    const res = await regulatoryWarehouseAccessDetail(props.taskData.businessId)
    if (res.code === 200) {
      detailData.value = res.data

      if (res.data.regulatoryWarehouseId) {
        getWarehouseInfo(res.data.regulatoryWarehouseId)
      } else if (res.data.warehouseInfo && res.data.warehouseInfo.id) {
        getWarehouseInfo(res.data.warehouseInfo.id)
      }
    }
  } catch (error) {
    console.error('获取详情失败:', error)
  }
}

const getWarehouseInfo = async id => {
  try {
    const res = await warehouseInfoDetail(id)
    if (res.code === 200) {
      warehouseDetail.value = res.data

      warehouseDetail.value.regulatoryAuthoritiesOrg = {
        ...res.data.regulatoryAuthoritiesOrg,
        establishmentDate: res.data.regulatoryAuthoritiesOrg?.establishmentDate
          ? dayjs(res.data.regulatoryAuthoritiesOrg.establishmentDate).format('YYYY-MM-DD')
          : ''
      }

      warehouseDetail.value.businessLicenseFile = []
      warehouseDetail.value.regulatoryAgreementFile = []
      let fileList = res.data.fileList
      if (fileList && fileList.length) {
        fileList.forEach(v => {
          if (v.fileType === 10) {
            warehouseDetail.value.businessLicenseFile.push(v)
          }
          if (v.fileType === 16) {
            warehouseDetail.value.regulatoryAgreementFile.push(v)
          }
        })
      }
    }
  } catch (error) {
    console.error('获取仓库信息失败:', error)
  }
}

const handleDownload = file => {
  if (!file) return
  const fileUrl = file.fileUrl
  if (fileUrl) {
    window.open(window.location.origin + '/api-qianrong' + fileUrl)
  }
}

onMounted(() => {
  if (props.taskData?.businessId) {
    getDetail()
  }
})
</script>

