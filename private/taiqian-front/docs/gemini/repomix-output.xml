})

const rules = {
  serviceRate: [{ required: true, message: '请输入技术服务费比例', trigger: 'blur' }]
}

const hanldeDialogVisible = async (visible, orgId) => {
  dialogVisible.value = visible
  if (orgId) {
    formData.orgId = orgId
    await getLoanOrgAccessConfig(orgId).then(res => {
      if (res.code === 200) {
        const data = res.data
        if (data === null) {
          formData.serviceRate = undefined
        } else {
          formData.serviceRate = data.serviceRate * 1
        }
      } else {
        ElMessage.error(res.msg || '获取技术服务费配置失败')
      }
    })
  }
  if (!visible) {
    formRef.value.resetFields()
    formData.id = null
  }
}

const handleConfirm = async () => {
  if (!formRef.value) return
  await formRef.value.validate(async valid => {
    if (valid) {
      try {
        const res = await setLoanOrgAccessConfig(formData)
        if (res.code === 200) {
          ElMessage.success('技术服务费配置成功')
          hanldeDialogVisible(false)
        } else {
          ElMessage.error(res.msg || '操作失败')
        }
      } catch (error) {
        ElMessage.error('操作失败')
      }
    }
  })
}

defineExpose({
  hanldeDialogVisible
})
</script>
