    </el-dialog>

    <el-dialog v-model="levelDialogVisible" :title="levelDialogTitle" width="50%">
      <div class="level-config">
        <div class="approval-type">
          <div class="label">审批方式:</div>
          <div class="options">
            <el-radio-group v-model="currentLevel.multiInstanceType">
              <el-radio-button :label="'sequential'">依次审批</el-radio-button>
              <el-radio-button :label="'parallel'">会签</el-radio-button>
              <el-radio-button :label="'none'">或签</el-radio-button>
