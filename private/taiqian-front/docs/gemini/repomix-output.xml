const APP_SRC = path.join(FRONT_ROOT, 'apps/qianrong/src')
const VIEWS_DIR = path.join(APP_SRC, 'views')
const ROUTER_FILE = path.join(APP_SRC, 'router/index.js')
const BACKUP_DIR = path.join(__dirname, '.backup')

const API_PREFIX = '/api-qianrong'
const DEFAULT_BASE_URL = 'https://dev-qianrong.ftechain.com'
const DEFAULT_KEEP = ['system']
const LAYOUT_COMPONENTS = new Set(['Layout', 'ParentView', 'InnerLink'])
const ALWAYS_KEEP_VIEW_DIRS = ['system', 'monitor', 'tool', 'error', 'redirect']
const REQUEST_TIMEOUT_MS = 15000
const MENU_TYPE_LABEL = { M: '目录', C: '菜单', F: '按钮' }

const HELP = `用法: node scripts/prune-qianrong-routes.mjs [选项]

只保留「系统中心」，删除其余全部菜单(路由)，并删除这些菜单对应的 apps/qianrong/src/views 模块目录。
默认只是 dry-run：拉取服务端菜单、打印计划，不做任何修改。

选项:
  --execute            真正执行删除（不加则仅 dry-run）
  -y, --yes            执行前不再交互确认（非交互终端必须加）
  --local-only         只删本地 views 模块（仍会只读请求菜单列表，用来推导要删哪些模块）
  --remote-only        只删服务端菜单
  --keep <key>         要保留的根菜单，匹配 menuId / path / 名称，可重复；默认 system
  --base <url>         后端地址，默认取环境变量 QR_BASE_URL，否则 ${DEFAULT_BASE_URL}
  --token <jwt>        登录 token，默认取环境变量 QR_TOKEN（带不带 "Bearer " 前缀均可）
  --delay <ms>         每次删除请求之间的间隔，默认 50
  --max-fail <n>       累计失败 n 次后中止，默认 5
  -v, --verbose        打印每一条待删菜单
  -h, --help           显示帮助

执行顺序: 先删本地 views（可用 git 回滚），再删服务端菜单（不可回滚）。
服务端菜单按“子级先于父级”的顺序逐条删除（直接删父级会报错），删除前会把待删菜单完整备份到 scripts/.backup/。
脚本可重复执行：每次都以服务端当前数据为准重新计算。

示例:
  $env:QR_TOKEN = '<token>'
  node scripts/prune-qianrong-routes.mjs
  node scripts/prune-qianrong-routes.mjs --execute --local-only
  node scripts/prune-qianrong-routes.mjs --execute --remote-only
`

class CliError extends Error {}

function fail(message) {
  throw new CliError(message)
}

let baseUrl = ''
let token = ''

const sleep = ms => new Promise(resolve => setTimeout(resolve, ms))
const rel = target => path.relative(FRONT_ROOT, target).replace(/\\/g, '/')
const norm = value =>
  String(value ?? '')
    .trim()
    .replace(/^\/+/, '')
    .toLowerCase()

function pad(value, size) {
  const text = String(value ?? '')
  const width = [...text].reduce((sum, char) => sum + (char.charCodeAt(0) > 0xff ? 2 : 1), 0)
  return text + ' '.repeat(Math.max(0, size - width))
}

function parseOptions() {
  const { values } = parseArgs({
    options: {
      execute: { type: 'boolean', default: false },
      yes: { type: 'boolean', short: 'y', default: false },
      'local-only': { type: 'boolean', default: false },
      'remote-only': { type: 'boolean', default: false },
      keep: { type: 'string', multiple: true, default: [] },
      base: { type: 'string' },
      token: { type: 'string' },
      delay: { type: 'string', default: '50' },
      'max-fail': { type: 'string', default: '5' },
      verbose: { type: 'boolean', short: 'v', default: false },
      help: { type: 'boolean', short: 'h', default: false }
    }
  })
  return values
}

function toInt(name, value, min) {
  const number = Number(value)
  if (!Number.isInteger(number) || number < min) fail(`${name} 必须是 >= ${min} 的整数，收到：${value}`)
  return number
}

function normalizeToken(raw) {
  return String(raw ?? '')
    .trim()
    .replace(/^['"]|['"]$/g, '')
    .replace(/^authorization\s*:?\s*/i, '')
    .replace(/^bearer\s+/i, '')
    .trim()
}

async function call(method, apiPath, retries = 2) {
  let lastError
  for (let attempt = 0; attempt <= retries; attempt += 1) {
    try {
      const res = await fetch(`${baseUrl}${API_PREFIX}${apiPath}`, {
        method,
        headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json;charset=utf-8' },
        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS)
      })
      if (res.status >= 500 || res.status === 429) throw new Error(`HTTP ${res.status}`)
      const text = await res.text()
      try {
        return JSON.parse(text)
      } catch {
        fail(`${method} ${apiPath} 响应不是 JSON（HTTP ${res.status}）：${text.slice(0, 120)}`)
      }
    } catch (error) {
      if (error instanceof CliError) throw error
      lastError = error
      if (attempt < retries) await sleep(500 * (attempt + 1))
    }
  }
  fail(`${method} ${apiPath} 请求失败：${lastError?.cause?.code ?? lastError?.message ?? lastError}`)
}

function unwrap(body, what) {
  if (body?.code === 401) fail('登录态无效或已过期 (401)，请更新 token 后重试')
  if (body?.code !== 200) fail(`${what}失败：${body?.msg ?? '未知错误'} (code=${body?.code})`)
  return body
}

async function fetchMenus() {
  const body = unwrap(await call('GET', '/system/menu/list'), '获取菜单列表')
  if (!Array.isArray(body.data) || !body.data.length) fail('菜单列表为空或格式异常，已中止')
  return body.data
}

async function whoAmI() {
  try {
    const body = await call('GET', '/getInfo', 0)
    const user = body?.user ?? body?.data?.user
    if (!user) return '未知'
    return `${user.userName ?? ''}${user.nickName ? `（${user.nickName}）` : ''}` || '未知'
  } catch {
    return '未知'
  }
}

async function menuExists(id) {
  try {
    const body = await call('GET', `/system/menu/${encodeURIComponent(id)}`, 1)
    if (body?.code !== 200) return undefined
    return Boolean(body.data?.menuId)
  } catch {
    return undefined
  }
}

async function deleteMenu(id) {
  let failure
  try {
    const body = await call('DELETE', `/system/menu/${encodeURIComponent(id)}`)
    if (body?.code === 200) return { ok: true }
    if (body?.code === 401) return { ok: false, fatal: true, msg: '登录态无效或已过期 (401)' }
    failure = `${body?.msg ?? '未知错误'} (code=${body?.code})`
  } catch (error) {
    failure = error.message
  }
  if ((await menuExists(id)) === false) return { ok: true, note: '服务端已不存在' }
  return { ok: false, msg: failure }
}

function buildTree(rows) {
  const nodes = new Map()
  for (const raw of rows) {
    const id = String(raw.menuId)
    if (nodes.has(id)) fail(`菜单列表里出现重复的 menuId：${id}`)
    nodes.set(id, {
      raw,
      id,
      pid: String(raw.parentId ?? '0'),
      menuName: raw.menuName,
      menuType: raw.menuType,
      path: raw.path,
      component: raw.component,
      orderNum: raw.orderNum ?? 0,
      parent: null,
      children: []
    })
  }
  const roots = []
  for (const node of nodes.values()) {
    const parent = node.pid === node.id ? undefined : nodes.get(node.pid)
    if (parent) {
      node.parent = parent
      parent.children.push(node)
    } else {
      roots.push(node)
    }
  }
  const byOrder = (a, b) => a.orderNum - b.orderNum || Number(a.id) - Number(b.id)
  roots.sort(byOrder)
  nodes.forEach(node => node.children.sort(byOrder))
  return { nodes, roots }
}

const walkPre = (node, visit) => {
  visit(node)
  node.children.forEach(child => walkPre(child, visit))
}

const walkPost = (node, visit) => {
  node.children.forEach(child => walkPost(child, visit))
  visit(node)
}

function breadcrumb(node) {
  const names = []
  for (let current = node; current; current = current.parent) names.unshift(current.menuName)
  return names.join(' / ')
}

function countTypes(root) {
  const stat = { M: 0, C: 0, F: 0, other: 0, total: 0 }
  walkPre(root, node => {
    stat[['M', 'C', 'F'].includes(node.menuType) ? node.menuType : 'other'] += 1
    stat.total += 1
  })
  return stat
}

function pickKeepRoots(roots, keys) {
  const picked = []
  for (const key of keys) {
    const target = norm(key)
    const hits = roots.filter(root => [root.id, root.path, root.menuName, root.raw.routeName].some(value => norm(value) === target))
    if (!hits.length) fail(`--keep "${key}" 没有匹配到任何根菜单，已中止（避免误删「系统中心」）`)
    hits.forEach(root => !picked.includes(root) && picked.push(root))
  }
  return picked
}

function buildPlan(rows, keepKeys) {
  const { nodes, roots } = buildTree(rows)
  const keepRoots = pickKeepRoots(roots, keepKeys)
  const keepIds = new Set()
  keepRoots.forEach(root => walkPre(root, node => keepIds.add(node.id)))

  const deleteRoots = roots.filter(root => !keepRoots.includes(root))
  const order = []
  deleteRoots.forEach(root => walkPost(root, node => order.push(node)))

  if (order.some(node => keepIds.has(node.id))) fail('内部错误：待删除集合与保留集合有交集，已中止')
  if (order.length + keepIds.size !== nodes.size) fail('存在无法挂到菜单树上的记录（可能循环引用），已中止')
  return { nodes, keepRoots, keepIds, deleteRoots, order }
}

function viewModule(component) {
  const value = String(component ?? '')
    .trim()
    .replace(/^\/+/, '')
  if (!value || LAYOUT_COMPONENTS.has(value)) return null
  const first = value.split('/')[0]
  return /^[\w-]+$/.test(first) ? first : null
}

function routerStaticModules() {
  try {
    const source = fs.readFileSync(ROUTER_FILE, 'utf8')
    return new Set([...source.matchAll(/@\/views\/([\w-]+)/g)].map(match => match[1]))
  } catch {
    return new Set()
  }
}

function countFiles(dir) {
  let count = 0
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    count += entry.isDirectory() ? countFiles(path.join(dir, entry.name)) : 1
  }
  return count
}

function gitDirtyCount(dir) {
  try {
    const output = execFileSync('git', ['-C', FRONT_ROOT, 'status', '--porcelain', '--', rel(dir)], {
      encoding: 'utf8',
      windowsHide: true,
      stdio: ['ignore', 'pipe', 'ignore']
    })
    return output.split('\n').filter(Boolean).length
  } catch {
    return null
  }
}

function buildLocalPlan(plan) {
  const keptModules = new Set()
  plan.keepRoots.forEach(root =>
    walkPre(root, node => {
      const module = viewModule(node.component)
      if (module) keptModules.add(module)
    })
  )

  const menusByModule = new Map()
  for (const node of plan.order) {
    const module = viewModule(node.component)
    if (module) menusByModule.set(module, (menusByModule.get(module) ?? 0) + 1)
  }

  const protectedDirs = new Set([...ALWAYS_KEEP_VIEW_DIRS, ...keptModules, ...routerStaticModules()])
  const toDelete = []
  const skipped = []
  for (const [module, menus] of [...menusByModule].sort(([a], [b]) => a.localeCompare(b))) {
    const dir = path.join(VIEWS_DIR, module)
    if (protectedDirs.has(module)) skipped.push({ module, reason: '与保留路由/静态路由共用，不删除' })
    else if (!fs.existsSync(dir)) skipped.push({ module, reason: '本地没有该模块目录' })
    else toDelete.push({ module, dir, menus, files: countFiles(dir), dirty: gitDirtyCount(dir) })
  }

  const existing = fs.existsSync(VIEWS_DIR)
    ? fs
        .readdirSync(VIEWS_DIR, { withFileTypes: true })
        .filter(entry => entry.isDirectory())
        .map(entry => entry.name)
    : []
  const deleting = new Set(toDelete.map(item => item.module))
  return { toDelete, skipped, kept: existing.filter(name => !deleting.has(name)) }
}

function printPlan({ plan, localPlan, who, execute, doLocal, doRemote, verbose }) {
  const types = { M: 0, C: 0, F: 0 }
  plan.nodes.forEach(node => {
    if (node.menuType in types) types[node.menuType] += 1
  })

  console.log(`目标环境 : ${baseUrl}`)
  console.log(`当前账号 : ${who}`)
  console.log(`运行模式 : ${execute ? '执行' : 'dry-run（不会修改任何内容）'}${doLocal && doRemote ? '' : doLocal ? '，仅本地 views' : '，仅服务端菜单'}`)
  console.log(`菜单总数 : ${plan.nodes.size} 条（目录 ${types.M} / 菜单 ${types.C} / 按钮 ${types.F}），保留 ${plan.keepIds.size} 条，待删除 ${plan.order.length} 条`)

  console.log('\n[保留的根菜单]')
  for (const root of plan.keepRoots) {
    const stat = countTypes(root)
    console.log(`  ${root.menuName} (menuId=${root.id}, path=${root.path})  共 ${stat.total} 条（目录 ${stat.M} / 菜单 ${stat.C} / 按钮 ${stat.F}）`)
  }

  console.log(`\n[待删除的根菜单] ${plan.deleteRoots.length} 个${doRemote ? '' : '（本次不处理）'}`)
  for (const root of plan.deleteRoots) {
    const stat = countTypes(root)
    const orphan = root.pid !== '0' ? `  <- parentId=${root.pid}，未挂在任何菜单下` : ''
    console.log(`  ${pad(root.id, 6)}${pad(root.menuName, 14)}${pad(root.path, 20)}目录 ${stat.M} / 菜单 ${stat.C} / 按钮 ${stat.F}  共 ${stat.total}${orphan}`)
  }

  if (verbose) {
    console.log('\n[删除顺序（子级优先）]')
    plan.order.forEach((node, index) => console.log(`  ${String(index + 1).padStart(3)}. ${node.id} ${MENU_TYPE_LABEL[node.menuType] ?? node.menuType} ${breadcrumb(node)}`))
  }

  console.log(`\n[本地 views 模块]${doLocal ? '' : '（本次不处理）'}`)
  for (const item of localPlan.toDelete) {
    const dirty = item.dirty === null ? '，git 状态未知' : item.dirty ? `，注意：有 ${item.dirty} 项未提交改动，删除后无法用 git 恢复` : ''
    console.log(`  删除 views/${item.module}  （${item.files} 个文件，对应 ${item.menus} 条菜单${dirty}）`)
  }
  for (const item of localPlan.skipped) console.log(`  跳过 views/${item.module}  （${item.reason}）`)
  console.log(`  保留 views 下: ${localPlan.kept.join(', ') || '(无)'}`)
}

function assertDirectChildOfViews(dir) {
  const resolved = path.resolve(dir)
  if (path.dirname(resolved) !== VIEWS_DIR || !/^[\w-]+$/.test(path.basename(resolved))) fail(`拒绝删除 views 之外或非直接子目录的路径：${dir}`)
}

function removeLocal(localPlan) {
  console.log('\n== 删除本地 views 模块 ==')
  if (!localPlan.toDelete.length) console.log('  没有需要删除的模块目录')
  for (const item of localPlan.toDelete) {
    assertDirectChildOfViews(item.dir)
    fs.rmSync(item.dir, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 })
    if (fs.existsSync(item.dir)) fail(`删除失败：${rel(item.dir)}（可能被编辑器或 dev server 占用）。已中止，服务端菜单未改动`)
    console.log(`  已删除 ${rel(item.dir)}`)
  }
}

function writeBackup(plan) {
  fs.mkdirSync(BACKUP_DIR, { recursive: true })
  const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d+Z$/, 'Z')
  const file = path.join(BACKUP_DIR, `menus-deleted-${stamp}.json`)
  const content = {
    base: baseUrl,
    createdAt: new Date().toISOString(),
    keepRoots: plan.keepRoots.map(root => ({ menuId: root.id, menuName: root.menuName, path: root.path })),
    count: plan.order.length,
    menus: plan.order.map(node => node.raw)
  }
  fs.writeFileSync(file, `${JSON.stringify(content, null, 2)}\n`)
  return file
}

async function printRouters() {
  try {
    const body = await call('GET', '/getRouters', 0)
    const names = (body?.data ?? []).map(route => route.meta?.title ?? route.name)
    console.log(`当前账号可见的根路由 (${names.length}): ${names.join('、') || '(无)'}`)
  } catch (error) {
    console.log(`读取 getRouters 失败：${error.message}`)
  }
}

async function removeRemote(plan, { delay, maxFail }) {
  const backupFile = writeBackup(plan)
  const total = plan.order.length
  console.log(`\n== 删除服务端菜单（子级优先，共 ${total} 条）==`)
  console.log(`已备份待删菜单：${rel(backupFile)}`)

  const failed = []
  const skipped = []
  const blocked = new Set()
  const deletedIds = new Set()
  const width = String(total).length
  let okCount = 0
  let aborted = ''

  for (const [index, node] of plan.order.entries()) {
    const tag = `[${String(index + 1).padStart(width)}/${total}]`
    const label = `${node.id} ${MENU_TYPE_LABEL[node.menuType] ?? node.menuType} ${breadcrumb(node)}`
    if (blocked.has(node.id)) {
      skipped.push(node)
      console.log(`${tag} 跳过 ${label}（有子级未删除）`)
      continue
    }

    const result = await deleteMenu(node.id)
    if (result.ok) {
      okCount += 1
      deletedIds.add(node.id)
      console.log(`${tag} 已删除 ${label}${result.note ? `（${result.note}）` : ''}`)
    } else {
      failed.push({ node, msg: result.msg })
      console.log(`${tag} 失败 ${label}：${result.msg}`)
      for (let parent = node.parent; parent; parent = parent.parent) blocked.add(parent.id)
      if (result.fatal) {
        aborted = result.msg
        break
      }
      if (failed.length >= maxFail) {
        aborted = `累计失败 ${failed.length} 次，已中止（--max-fail ${maxFail}）`
        break
      }
    }
    if (delay) await sleep(delay)
  }

  console.log('\n== 校验 ==')
  let leftover = plan.order.filter(node => !deletedIds.has(node.id))
  let missingKept = []
  try {
    const remaining = new Set((await fetchMenus()).map(row => String(row.menuId)))
    leftover = plan.order.filter(node => remaining.has(node.id))
    missingKept = [...plan.keepIds].filter(id => !remaining.has(id))
    console.log(`成功 ${okCount}，失败 ${failed.length}，跳过 ${skipped.length}；服务端现存 ${remaining.size} 条（预期保留 ${plan.keepIds.size} 条）`)
  } catch (error) {
    console.log(`重新拉取菜单列表失败：${error.message}`)
  }

  if (missingKept.length) console.log(`严重: 保留集合中有 ${missingKept.length} 条菜单不存在了：${missingKept.join(', ')}`)
  if (failed.length) {
    console.log('失败明细:')
    failed.forEach(({ node, msg }) => console.log(`  ${node.id} ${breadcrumb(node)}：${msg}`))
  }
  if (leftover.length) {
    console.log(`仍未删除 ${leftover.length} 条:`)
    leftover.slice(0, 20).forEach(node => console.log(`  ${node.id} ${breadcrumb(node)}`))
    if (leftover.length > 20) console.log(`  ... 其余 ${leftover.length - 20} 条省略`)
  }
  await printRouters()

  if (aborted) console.log(`中止原因：${aborted}`)
  if (aborted || failed.length || skipped.length || leftover.length || missingKept.length) {
    process.exitCode = 1
    console.log('存在未完成项：处理原因后可直接重复执行本脚本继续。')
  } else {
    console.log('服务端菜单已精简完成。')
  }
}

async function confirmOrExit(message) {
  if (!process.stdin.isTTY) fail('当前不是交互终端，请确认计划无误后追加 --yes 再执行')
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout })
  try {
    const answer = await rl.question(`\n${message}\n输入 DELETE 确认继续: `)
    if (answer.trim() !== 'DELETE') fail('已取消，未做任何修改')
  } finally {
    rl.close()
  }
}

async function main() {
  const opts = parseOptions()
  if (opts.help) {
    process.stdout.write(HELP)
    return
  }
  if (opts['local-only'] && opts['remote-only']) fail('--local-only 与 --remote-only 不能同时使用')

  baseUrl = String(opts.base || process.env.QR_BASE_URL || DEFAULT_BASE_URL)
    .trim()
    .replace(/\/+$/, '')
  token = normalizeToken(opts.token || process.env.QR_TOKEN)
  if (!token) fail('缺少 token：请设置环境变量 QR_TOKEN 或传入 --token')

  const doLocal = !opts['remote-only']
  const doRemote = !opts['local-only']
  const delay = toInt('--delay', opts.delay, 0)
  const maxFail = toInt('--max-fail', opts['max-fail'], 1)

  const who = await whoAmI()
  const plan = buildPlan(await fetchMenus(), opts.keep.length ? opts.keep : DEFAULT_KEEP)
  const localPlan = buildLocalPlan(plan)
  printPlan({ plan, localPlan, who, execute: opts.execute, doLocal, doRemote, verbose: opts.verbose })

  if (!opts.execute) {
    console.log('\n[dry-run] 未做任何修改。确认计划无误后，追加 --execute 执行。')
    return
  }

  const localCount = doLocal ? localPlan.toDelete.length : 0
  const remoteCount = doRemote ? plan.order.length : 0
  if (!localCount && !remoteCount) {
    console.log('\n没有需要处理的内容。')
    return
  }
  if (!opts.yes) {
    await confirmOrExit(`即将在 ${baseUrl} 以「${who}」身份执行：删除本地 views 模块 ${localCount} 个、删除服务端菜单 ${remoteCount} 条（不可恢复）。`)
  }

  if (doLocal) removeLocal(localPlan)
  if (doRemote) await removeRemote(plan, { delay, maxFail })
}

main().catch(error => {
  console.error(`错误: ${error.message}`)
  if (!(error instanceof CliError) && !String(error.code ?? '').startsWith('ERR_PARSE_ARGS')) console.error(error.stack)
  process.exitCode = 1
})
