<script setup>
import { parseTime } from '@/utils/ruoyi'
import { getCurrentInstance, ref, onMounted, computed, watch } from 'vue'
import { borrowingEnterpriseCreditDetail } from '@/api/credit'
import { multiplyWithPrecision } from '@/utils/index'
const { proxy } = getCurrentInstance()
const { registration_status } = proxy.useDict('registration_status')
const credit_status = [
  { value: '0', label: '待生效' },
  { value: '1', label: '生效中' },
  { value: '2', label: '已过期' }
]

const props = defineProps({
  taskData: {
    type: Object,
    default: () => ({})
  }
})

const emit = defineEmits(['update'])

const detailData = ref({})
const formData = ref({
  creditLimit: '',
  displayCreditLimit: '',
  interestRate: '',
  displayInterestRate: '',
  creditDateStart: '',
  creditDateEnd: ''
})
const formErrors = ref({
  creditLimit: '',
  interestRate: '',
  creditDateStart: '',
  creditDateEnd: ''
})

const isApprovalMode = computed(() => {
  return props.taskData?.activeTab === 'todo' && props.taskData?.isFinish === 0
})

const disableStartDate = time => {
  if (!formData.value.creditDateEnd) return false
  return time > new Date(formData.value.creditDateEnd)
}

const disableEndDate = time => {
  if (!formData.value.creditDateStart) return false
  return time < new Date(formData.value.creditDateStart)
}

const formatCreditLimit = value => {
  if (value === undefined || value === null || value === '') return '-'
  return (parseFloat(value) / 10000).toFixed(2)
}

const formatInterestRate = value => {
  if (value === undefined || value === null || value === '') return '-'
  return (parseFloat(value) * 100).toFixed(2)
}

watch(
  () => formData.value.displayCreditLimit,
  newVal => {
    if (newVal === '' || newVal === null || newVal === undefined) {
      formData.value.creditLimit = ''
    } else {
      formData.value.creditLimit = parseFloat(newVal) * 10000
    }
  }
)

watch(
  () => formData.value.displayInterestRate,
  newVal => {
    if (newVal === '' || newVal === null || newVal === undefined) {
      formData.value.interestRate = ''
    } else {
      formData.value.interestRate = parseFloat(newVal) / 100
    }
  }
)

watch(
  () => formData.value.creditDateStart,
  newVal => {
    if (newVal && formData.value.creditDateEnd) {
      if (new Date(newVal) >= new Date(formData.value.creditDateEnd)) {
        formData.value.creditDateEnd = ''
      }
    }
  }
)

watch(
  () => formData.value.creditDateEnd,
  newVal => {
    if (newVal && formData.value.creditDateStart) {
      if (new Date(newVal) <= new Date(formData.value.creditDateStart)) {
        formErrors.value.creditDateEnd = '结束日期必须晚于开始日期'
      } else {
        formErrors.value.creditDateEnd = ''
      }
    }
  }
)

watch(
  detailData,
  newVal => {
    if (newVal) {
      formData.value = {
        creditLimit: newVal.creditLimit || '',
        displayCreditLimit: newVal.creditLimit ? formatCreditLimit(newVal.creditLimit) : '',
        interestRate: newVal.interestRate || '',
        displayInterestRate: newVal.interestRate ? formatInterestRate(newVal.interestRate) : '',
        creditDateStart: newVal.creditDateStart ? parseTime(newVal.creditDateStart, '{y}-{m}-{d}') : '',
        creditDateEnd: newVal.creditDateEnd ? parseTime(newVal.creditDateEnd, '{y}-{m}-{d}') : ''
      }

      validateAndUpdate()
    }
  },
  { deep: true }
)

watch(
  formData,
  () => {
    validateAndUpdate()
  },
  { deep: true }
)

const validateAndUpdate = () => {
  Object.keys(formErrors.value).forEach(key => {
    formErrors.value[key] = ''
  })

  let isValid = true

  if (!formData.value.displayCreditLimit) {
    formErrors.value.creditLimit = '请输入授信额度'
    isValid = false
  } else if (isNaN(formData.value.displayCreditLimit) || Number(formData.value.displayCreditLimit) <= 0) {
    formErrors.value.creditLimit = '请输入有效的授信额度'
    isValid = false
  }

  if (!formData.value.displayInterestRate) {
    formErrors.value.interestRate = '请输入融资利率'
    isValid = false
  } else if (
    isNaN(formData.value.displayInterestRate) ||
    Number(formData.value.displayInterestRate) < 0 ||
    Number(formData.value.displayInterestRate) > 100
  ) {
    formErrors.value.interestRate = '请输入有效的融资利率'
    isValid = false
  }

  if (!formData.value.creditDateStart) {
    formErrors.value.creditDateStart = '请选择授信开始日期'
    isValid = false
  }

  if (!formData.value.creditDateEnd) {
    formErrors.value.creditDateEnd = '请选择授信结束日期'
    isValid = false
  } else if (
    formData.value.creditDateStart &&
    formData.value.creditDateEnd &&
    new Date(formData.value.creditDateEnd) <= new Date(formData.value.creditDateStart)
  ) {
    formErrors.value.creditDateEnd = '结束日期必须晚于开始日期'
    isValid = false
  }

  emit('update', {
    creditLimit: formData.value.creditLimit,
    interestRate: formData.value.interestRate,
    creditDateStart: formData.value.creditDateStart,
    creditDateEnd: formData.value.creditDateEnd,
    isValid: isValid
  })
}

const getDetail = async () => {
  try {
    const res = await borrowingEnterpriseCreditDetail(props.taskData.businessId)
    if (res.code === 200) {
      detailData.value = res.data
    }
  } catch (error) {
    console.error('获取详情失败:', error)
  }
}

const handleDownload = file => {
  if (!file) return
  const fileUrl = Array.isArray(file) ? file[0].fileUrl : file.fileUrl
  if (fileUrl) {
    window.open(window.location.origin + '/api-qianrong' + fileUrl)
  }
}

onMounted(() => {
  if (props.taskData?.businessId) {
    getDetail()
  }
})
</script>

