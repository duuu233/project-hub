import { onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import { coreEnterpriseDetail as coreEnterpriseDetailApi } from '@/api/business'
import { useRouter } from 'vue-router'
import dayjs from 'dayjs'
const { push, currentRoute, back, replace } = useRouter()
const { proxy } = getCurrentInstance()
const { access_status, registration_status } = proxy.useDict('access_status', 'registration_status')

const _props = defineProps({
  pageType: Number,
  isDynamic: Boolean
})
const form = ref({})
const orgInfo = ref({})
const enumData = reactive({
  orgList: []
})
const formRef = ref()

async function getDetails() {
  try {
    const res = await coreEnterpriseAccessDetailBy(currentRoute.value.query.id)
    form.value = res.data
    await coreEnterpriseDetail(res.data.id)
  } catch (error) {
    console.log(error)
  }
}
const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      const submitData = {
        ...form.value,
        ...orgInfo.value,
        businessAddress: orgInfo.value.areaFullName
      }
      delete submitData.id
      if (_props.pageType === 1) {
        await coreEnterpriseAccessApply(submitData)
      }
      if (_props.pageType === 2) {

        await coreEnterpriseAccessApply(submitData)
      }
      ElMessage.success('操作成功')
      setTimeout(() => {
        proxy.toList({
          path: `access-core-enterprise`,
          listName: 'Access-core-enterprise'
        })
      }, 300)
    } else {
      console.log('error submit!', fields)
    }
  })
}
onMounted(async () => {
  await getEnumData()
  if (_props.pageType !== 1) {
    getDetails()
  }
})
function changeOrgId(id) {
  if (id) {
    coreEnterpriseDetail(id)
  }
}
async function getEnumData() {
  try {
    const res = await coreEnterpriseAccessDropDown({})
    enumData.orgList = res.data || []
  } catch (error) {
    console.log(error)
  }
}

async function coreEnterpriseDetail(id) {
  try {
    const res = await coreEnterpriseDetailApi(id)
    form.value.orgId = res.data.id
    orgInfo.value = res.data
    if (res.data.businessLicenseUrl.length) {
      orgInfo.value.businessLicenseUrl = res.data.businessLicenseUrl[0].fileUrl
    }
    if (res.data.legalCardFrontFile.length) {
      orgInfo.value.legalCardFrontFile = res.data.legalCardFrontFile[0].fileUrl
    }
    if (res.data.legalCardBackFile.length) {
      orgInfo.value.legalCardBackFile = res.data.legalCardBackFile[0].fileUrl
    }
  } catch (error) {
    console.log(error)
  }
}

const rules = reactive({
  creditInvestigation: [
    {
      required: false,
      message: '请输入征信相关信息',
      trigger: 'blur'
    }
  ],
  taxAdministration: [
    {
      required: false,
