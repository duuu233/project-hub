<template>
  <div class="app-container qr-list-page">
    <TableSearch :query="query" :options="searchOpt" :search="handleSearch" />

    <vxe-grid ref="gridRef" v-bind="gridOptions" v-on="gridEvents" class="qr-list-grid" v-list-grid="{ grid: gridRef }">
      <template #toolbarButtons>
        <ListToolbarTitle :total="gridOptions.pagerConfig?.total" />
        <el-button type="primary" class="handle-add-btn-index" v-hasPermi="['system:config:add']" plain icon="CirclePlus" @click="handleAdd"
          >新增</el-button
        >
      </template>
      <template #configTypeRender="{ row }">
        <dict-tag :options="sys_yes_no" :value="row.configType" />
      </template>
      <template #createTimeRender="{ row }">
        <span>{{ parseTime(row.createTime) }}</span>
      </template>
      <template #active="{ row }">
        <ListRowActions>
          <el-button link type="primary" @click="handleUpdate(row)" v-hasPermi="['system:config:edit']">修改</el-button>
          <el-button link type="primary" @click="handleDelete(row)" v-hasPermi="['system:config:remove']">删除</el-button>
        </ListRowActions>
      </template>
    </vxe-grid>

    <el-dialog :title="title" v-model="open" width="500px" append-to-body>
      <el-form ref="configRef" :model="form" :rules="rules" label-width="auto">
        <el-form-item label="参数名称" prop="configName">
          <el-input v-model="form.configName" placeholder="请输入参数名称" />
        </el-form-item>
        <el-form-item label="参数键名" prop="configKey">
          <el-input v-model="form.configKey" placeholder="请输入参数键名" />
        </el-form-item>
        <el-form-item label="参数键值" prop="configValue">
          <el-input v-model="form.configValue" placeholder="请输入参数键值" />
        </el-form-item>
        <el-form-item label="系统内置" prop="configType">
          <el-radio-group v-model="form.configType">
            <el-radio v-for="dict in sys_yes_no" :key="dict.value" :label="dict.value">{{ dict.label }}</el-radio>
          </el-radio-group>
        </el-form-item>
        <el-form-item label="备注" prop="remark">
          <el-input v-model="form.remark" type="textarea" placeholder="请输入内容" />
        </el-form-item>
      </el-form>
      <template #footer>
        <div class="dialog-footer">
          <el-button type="primary" @click="submitForm">确 定</el-button>
          <el-button @click="cancel">取 消</el-button>
        </div>
      </template>
