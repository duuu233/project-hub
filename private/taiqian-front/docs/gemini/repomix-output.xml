    { title: '账单状态', field: 'status', minWidth: 120, slots: { default: 'statusRender' } },
    { title: '创建时间', field: 'createTime', minWidth: 160, formatter: ['formatTime'] },
    { title: '操作', field: 'active', minWidth: 140, fixed: 'right', align: 'center', slots: { default: 'active' } }
