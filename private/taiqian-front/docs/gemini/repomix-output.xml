        <div class="task-name">
          <div class="label">任务名称:</div>
          <el-input v-model="currentLevel.taskName" placeholder="请输入任务名称" />
        </div>

        <div class="approvers-selector">
          <div class="label">审批人员:</div>
          <div class="clear-btn">
            <el-button size="small" @click="clearApprovers">清空</el-button>
