// 产业配置页面用到的枚举。
// 金融场景、融资对象服务端没有对应字典，取值来自后端接口文档（产业配置新增编辑参数）；
// 产业项目、PC 页面类型、账号注册方式使用字典：industry_project / industry_pc_page_type / industry_register_mode。

export const FINANCE_SCENE_OPTIONS = [
  { label: '应收账款融资', value: 0 },
  { label: '存货融资', value: 1 },
  { label: '预付款融资', value: 2 }
]

export const FINANCE_TARGET_OPTIONS = [
  { label: '采购方/经销商', value: 0 },
  { label: '采购方/选矿厂', value: 1 },
  { label: '供应商', value: 2 }
]

// 根据值取选项文案，找不到返回空字符串；兼容数字/字符串取值混用
export const optionLabel = (options, value) => options?.find(item => String(item.value) === String(value))?.label ?? ''
