            <div class="no-approvers" v-if="!selectedUserIds.length && !selectedRoleIds.length">未选择审批人员</div>
          </div>

          <div class="add-approvers">
            <div class="approver-type">
              <el-radio v-model="approverType" :label="'member'" @change="handleApproverTypeChange">指定成员</el-radio>
              <el-radio v-model="approverType" :label="'role'" @change="handleApproverTypeChange">角色</el-radio>
              <el-tooltip content="即选择后面的所有人员，为动态人员（角色将会相应响应人员）" placement="top">
                <i class="el-icon-question" style="margin-left: 5px"></i>
              </el-tooltip>
            </div>

            <div class="selector-container">
              <div class="selector-section" style="flex: 1">
                <div class="section-title">选择人员:</div>
                <div class="search-box">
                  <el-input v-model="searchKeyword" placeholder="搜索成员" v-if="approverType === 'member'" clearable />
                  <el-input v-model="searchKeyword" placeholder="搜索角色" v-else clearable />
                </div>
                <div class="options-list">
                  <div v-if="approverType === 'member'">
                    <el-checkbox
                      v-for="item in filteredMembers"
                      :key="item.userId"
                      :label="item.userId"
                      :checked="selectedUserIds.includes(item.userId)"
                      @change="val => handleUserSelect(val, item.userId)"
                    >
                      {{ item.userName }}
                    </el-checkbox>
                  </div>
                  <div v-else>
                    <el-checkbox
                      v-for="item in filteredRoles"
                      :key="item.roleId"
                      :label="item.roleId"
                      :checked="selectedRoleIds.includes(item.roleId)"
                      @change="val => handleRoleSelect(val, item.roleId)"
                    >
                      {{ item.roleName }} ({{ item.memberCount || 3 }})
                    </el-checkbox>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <template #footer>
        <span class="dialog-footer">
          <el-button @click="levelDialogVisible = false">取消</el-button>
          <el-button type="primary" @click="saveLevelConfig" v-hasPermi="['audit:deployAuditTask']">提交保存</el-button>
        </span>
      </template>
    </el-dialog>
  </div>
</template>

<script setup name="ApprovalConfig">
import { getApprovalList, getApprovalFlowList, saveApprovalFlow, modelTaskCandidateList } from '@/api/task/approval'
import { listUser } from '@/api/system/user'
import { listRole } from '@/api/system/role'
import { onMounted, onUnmounted, reactive, ref, computed, toRefs } from 'vue'
import { ElMessage, ElMessageBox } from 'element-plus'
import TableSearch from '@/components/TableSearch'

const dataList = ref([])
const total = ref(0)

const data = reactive({
  queryParams: {
    pageNum: 1,
    pageSize: 10
  }
})
const { queryParams } = toRefs(data)

const query = reactive({
  auditKey: '',
  auditName: '',
  modelKey: '',
  isOpenAudit: '',
  status: ''
})

const gridOptions = reactive({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: { resizable: true },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  proxyConfig: {
    ajax: {
      query: ({ page }) => {
        return getList(page.pageSize, page.currentPage)
      }
    }
  },
  rowConfig: { isHover: true },
  toolbarConfig: { custom: true, refresh: false, zoom: true, slots: { buttons: 'toolbarButtons' } },
  columns: [
    { type: 'seq', width: 70 },
    { title: '审核事件', field: 'auditKey', minWidth: 120, showOverflow: true },
    { title: '审核事件名称', field: 'auditName', minWidth: 120, showOverflow: true },
    { title: '是否开启审核流', field: 'isOpenAudit', align: 'center', minWidth: 120, slots: { default: 'isOpenAuditRender' } },
    { title: '配置状态', field: 'status', align: 'center', minWidth: 120, slots: { default: 'statusRender' } },
    { title: '更新时间', field: 'updateTime', align: 'center', minWidth: 120, slots: { default: 'updateTimeRender' } },
    { title: '操作', field: 'active', fixed: 'right', align: 'center', minWidth: 120, slots: { default: 'active' } }
  ],
  data: []
})

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
  }
}

const searchOpt = ref([
  {
    type: 'input',
    label: '审核事件：',
    placeholder: '请输入审核事件',
    prop: 'auditKey'
  },
  {
    type: 'input',
    label: '审核事件名称：',
    placeholder: '请输入审核事件名称',
    prop: 'auditName'
  },
  {
    type: 'input',
    label: '审核模型：',
    placeholder: '请输入审核模型',
    prop: 'modelKey'
  },
  {
    type: 'select',
    label: '审核流状态：',
    placeholder: '全部',
    prop: 'isOpenAudit',
    opts: [
      { label: '全部', value: '' },
      { label: '已开启', value: 1 },
      { label: '未开启', value: 0 }
    ]
  },
  {
    type: 'select',
    label: '配置状态：',
    placeholder: '全部',
    prop: 'status',
    opts: [
      { label: '全部', value: '' },
      { label: '已配置', value: 1 },
      { label: '未配置', value: 0 }
    ]
  }
])

const dialogVisible = ref(false)
const currentRow = ref({})
const flowList = ref([])

const levelDialogVisible = ref(false)
const levelDialogTitle = ref('添加审核层级')
const currentLevel = ref({
  level: '',
  multiInstanceType: 'none',
  taskName: '',
  candidateUserList: [],
  candidateRoleList: [],
  userNameList: [],
  sort: 0
})
const editingIndex = ref(-1)

const approverType = ref('member')
const searchKeyword = ref('')
const selectedUserIds = ref([])
const selectedRoleIds = ref([])

const userList = ref([])
const roleList = ref([])

const fetchUserList = async () => {
  try {
    const res = await listUser({
      pageNum: 1,
      pageSize: 1000
    })
    if (res.code === 200) {
      userList.value = res.rows || []
    } else {
      ElMessage.error('获取用户列表失败')
    }
  } catch (error) {
    console.error('获取用户列表异常', error)
    ElMessage.error('获取用户列表异常')
  }
}

const fetchRoleList = async () => {
  try {
    const res = await listRole({
      pageNum: 1,
      pageSize: 1000
    })
    if (res.code === 200) {
      roleList.value = res.rows || []
    } else {
      ElMessage.error('获取角色列表失败')
    }
  } catch (error) {
    console.error('获取角色列表异常', error)
    ElMessage.error('获取角色列表异常')
  }
}

const filteredMembers = computed(() => {
  if (!searchKeyword.value) return userList.value
  return userList.value.filter(item => item.userName && item.userName.toLowerCase().includes(searchKeyword.value.toLowerCase()))
})

const filteredRoles = computed(() => {
  if (!searchKeyword.value) return roleList.value
  return roleList.value.filter(item => item.roleName && item.roleName.toLowerCase().includes(searchKeyword.value.toLowerCase()))
})

const handleApproverTypeChange = () => {
  searchKeyword.value = ''
}

const handleUserSelect = (checked, userId) => {
  if (checked) {
    if (!selectedUserIds.value.includes(userId)) {
      selectedUserIds.value.push(userId)
    }
  } else {
    const index = selectedUserIds.value.indexOf(userId)
    if (index !== -1) {
      selectedUserIds.value.splice(index, 1)
    }
  }
}

const handleRoleSelect = (checked, roleId) => {
  if (checked) {
    if (!selectedRoleIds.value.includes(roleId)) {
      selectedRoleIds.value.push(roleId)
    }
  } else {
    const index = selectedRoleIds.value.indexOf(roleId)
    if (index !== -1) {
      selectedRoleIds.value.splice(index, 1)
    }
  }
}

const getUserNameById = userId => {
  const user = userList.value.find(u => u.userId === userId)
  return user ? user.userName : userId
}

const getRoleNameById = roleId => {
  const role = roleList.value.find(r => r.roleId === roleId)
  return role ? role.roleName : roleId
}

const getApprovalTypeLabel = type => {
  const types = {
    sequential: '依次审批',
    parallel: '会签',
    none: '或签'
  }
  return types[type] || '或签'
}

const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}

async function getList(type) {
  gridOptions.loading = true
  const response = await getApprovalList({
    pageNum: gridOptions.pagerConfig.currentPage,
    pageSize: gridOptions.pagerConfig.pageSize,
    ...query
  })
  dataList.value = response.rows || []
  total.value = response.total || 0
  gridOptions.loading = false
  if (type === 'edit') {
    gridOptions.data = response.rows || []
  }
  return {
    result: response.rows || [],
    page: {
      total: response.total || 0
    }
  }
}

const handleConfig = row => {
  currentRow.value = { ...row }
  dialogVisible.value = true

  if (!row.modelKey) return

  getApprovalFlowList({ modelKey: row.modelKey })
    .then(async response => {
      if (response.code === 200) {
        const list = response.data.list || []
        flowList.value = []

        for (let i = 0; i < list.length; i++) {
          const item = list[i]

          let candidateUsers = []
          let candidateRoles = []
          let userNames = []

          try {
            const candidateRes = await modelTaskCandidateList({
              taskKey: item.taskKey,
              modelKey: row.modelKey
            })

            if (candidateRes.code === 200 && candidateRes.data) {
              if (candidateRes.data.user && Array.isArray(candidateRes.data.user)) {
                candidateUsers = candidateRes.data.user.map(u => u.userId)
                const userNameItems = candidateRes.data.user.map(u => u.userName)
                userNames = userNames.concat(userNameItems)
              }

              if (candidateRes.data.role && Array.isArray(candidateRes.data.role)) {
                candidateRoles = candidateRes.data.role.map(r => r.roleId)
                const roleNameItems = candidateRes.data.role.map(r => `${r.roleName}(角色)`)
                userNames = userNames.concat(roleNameItems)
              }
            }
          } catch (err) {
            console.error(`获取任务${item.taskKey}的候选人失败:`, err)
          }

          flowList.value.push({
            level: i + 1,
            multiInstanceType: item.multiInstanceType || 'none',
            candidateUserList: candidateUsers,
            candidateRoleList: candidateRoles,
            userNameList: userNames,
            taskKey: item.taskKey,
            taskName: item.taskName,
            taskId: item.taskId,
            sort: item.orderBy || i + 1
          })
        }

        flowList.value.sort((a, b) => a.sort - b.sort)
      } else {
        ElMessage.error(response.msg || '获取审核流程列表失败')
        flowList.value = []
      }
    })
    .catch(() => {
      ElMessage.error('获取审核流程列表失败')
      flowList.value = []
    })
}

const handleAddLevel = () => {
  levelDialogTitle.value = '添加审核层级'
  currentLevel.value = {
    level: flowList.value.length + 1,
    multiInstanceType: 'none',
    taskName: '',
    candidateUserList: [],
    candidateRoleList: [],
    userNameList: [],
    sort: flowList.value.length > 0 ? Math.max(...flowList.value.map(item => item.sort)) + 1 : 1
  }
  selectedUserIds.value = []
  selectedRoleIds.value = []
  searchKeyword.value = ''
  approverType.value = 'member'
  editingIndex.value = -1
  levelDialogVisible.value = true
}

const handleEditLevel = (row, index) => {
  levelDialogTitle.value = '编辑审核层级'
  currentLevel.value = { ...row }

  if (!currentLevel.value.candidateUserList) currentLevel.value.candidateUserList = []
  if (!currentLevel.value.candidateRoleList) currentLevel.value.candidateRoleList = []
  if (!currentLevel.value.userNameList) currentLevel.value.userNameList = []

  selectedUserIds.value = [...currentLevel.value.candidateUserList]
  selectedRoleIds.value = [...currentLevel.value.candidateRoleList]

  searchKeyword.value = ''
  approverType.value = 'member'
  editingIndex.value = index
  levelDialogVisible.value = true
}

const handleDeleteLevel = index => {
  ElMessageBox.confirm('确定要删除该审核层级吗？', '提示', {
    confirmButtonText: '确定',
    cancelButtonText: '取消',
    type: 'warning'
  })
    .then(() => {
      flowList.value.splice(index, 1)
      flowList.value.forEach((item, idx) => {
        item.level = idx + 1
        item.sort = idx + 1
      })
      ElMessage.success('删除成功')
    })
    .catch(() => {})
}

const handleMoveUp = index => {
  if (index > 0) {
    const temp = { ...flowList.value[index] }
    flowList.value[index] = { ...flowList.value[index - 1] }
    flowList.value[index - 1] = { ...temp }

    flowList.value[index].level = index + 1
    flowList.value[index - 1].level = index

    const tempSort = flowList.value[index].sort
    flowList.value[index].sort = flowList.value[index - 1].sort
    flowList.value[index - 1].sort = tempSort
  }
}

const handleMoveDown = index => {
  if (index < flowList.value.length - 1) {
    const temp = { ...flowList.value[index] }
    flowList.value[index] = { ...flowList.value[index + 1] }
    flowList.value[index + 1] = { ...temp }

    flowList.value[index].level = index + 1
    flowList.value[index + 1].level = index + 2

    const tempSort = flowList.value[index].sort
    flowList.value[index].sort = flowList.value[index + 1].sort
    flowList.value[index + 1].sort = tempSort
  }
}

const clearApprovers = () => {
  selectedUserIds.value = []
  selectedRoleIds.value = []
}

const removeUser = userId => {
  const index = selectedUserIds.value.indexOf(userId)
  if (index !== -1) {
    selectedUserIds.value.splice(index, 1)
  }
}

const removeRole = roleId => {
  const index = selectedRoleIds.value.indexOf(roleId)
  if (index !== -1) {
    selectedRoleIds.value.splice(index, 1)
  }
}

const saveLevelConfig = () => {
  if (selectedUserIds.value.length === 0 && selectedRoleIds.value.length === 0) {
    ElMessage.warning('请至少选择一个审批人员或角色')
    return
  }

  if (!currentLevel.value.taskName) {
    ElMessage.warning('请输入任务名称')
    return
  }

  currentLevel.value.candidateUserList = [...selectedUserIds.value]
  currentLevel.value.candidateRoleList = [...selectedRoleIds.value]

  const userNames = selectedUserIds.value.map(userId => getUserNameById(userId))
  const roleNames = selectedRoleIds.value.map(roleId => `${getRoleNameById(roleId)}(角色)`)
  currentLevel.value.userNameList = [...userNames, ...roleNames]

  if (editingIndex.value === -1) {
    flowList.value.push({ ...currentLevel.value })
  } else {
    flowList.value[editingIndex.value] = { ...currentLevel.value }
  }

  levelDialogVisible.value = false
}

const handleSaveFlow = () => {
  if (flowList.value.length === 0) {
    ElMessage.warning('请至少添加一个审核层级')
    return
  }

  flowList.value.forEach((item, index) => {
    if (!item.sort) {
      item.sort = index + 1
    }
  })

  const params = {
    auditConfigId: currentRow.value.auditConfigId,
    userTaskList: flowList.value.map(item => {
      return {
        taskKey: item.taskKey,
        taskName: item.taskName,
        multiInstanceType: item.multiInstanceType,
        orderBy: item.sort,
        candidateUserList: item.candidateUserList,
        candidateRoleList: item.candidateRoleList
      }
    })
  }

  saveApprovalFlow(params)
    .then(response => {
      if (response.code === 200) {
        ElMessage.success('保存成功')
        dialogVisible.value = false
        getList()
      } else {
        ElMessage.error(response.msg || '保存失败')
      }
    })
    .catch(() => {
      ElMessage.error('保存失败，请稍后重试')
    })
}

const handleDialogClosed = () => {
  flowList.value = []
  currentRow.value = {}
}

onMounted(() => {
  getList()
  fetchUserList()
  fetchRoleList()
})

onUnmounted(() => {
  flowList.value = []
  userList.value = []
  roleList.value = []
})
</script>

<style scoped>
.not-configured {
  color: #f56c6c;
