})

const query = reactive({
  contractNo: '',
  orgName: '',
  contractName: '',
  signStatus: '',
  signTimeStart: '',
  signTimeEnd: ''
})

const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
