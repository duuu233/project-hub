<script setup>
import { ref, reactive, computed, watch } from 'vue'
import { commonCurrency } from '@/api/common'
import { cloneDeep } from 'lodash-es'
import { coreEnterpriseAccountList, coreEnterpriseAccountListSet } from '@/api/credit'
import { ElMessage } from 'element-plus'
const { pageType } = defineProps(['pageType'])
const dialogVisible = ref(false)
const form = ref({
  bankAccountList: [{}]
})
const formRef = ref()
const enumData = reactive({
  currencyList: []
})
async function getData(id) {
  const res = await coreEnterpriseAccountList({ id })
  form.value.id = id
  form.value.creditId = id
  setBankAccountList(res.data)
}
function setBankAccountList(list) {
  let bankAccountList = []
  if (list.length) {
    list.map(v => {
      if (v.type === 1) {
        for (let key in v) {
          form.value[key] = v[key]
        }
      } else if (v.type === 2) {
        for (let key in v) {
          form.value[key + '2'] = v[key]
        }
      } else {
        bankAccountList.push(v)
      }
    })
  }
  form.value.bankAccountList = bankAccountList
}
async function hanldeDialogVisible(value) {
  await getEnumData()
  dialogVisible.value = value
}
async function getEnumData() {
  try {
    const res2 = await commonCurrency({})

    enumData.currencyList = res2.data || []
  } catch (error) {
    console.log(error)
  }
}

const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      const submitData = cloneDeep(form.value)

      submitData.bankAccountList.map(v => {
        v.type = 3
        v.currencySymbol = enumData.currencyList.find(o => o.currencyName === v.currency).currencySymbol
      })
      submitData.bankAccountList = submitData.bankAccountList.concat([
        {
          bankAccount: submitData.bankAccount,
          openingBank: submitData.openingBank,
          collectionName: submitData.collectionName,
          currency: submitData.currency,
          bankNo: submitData.bankNo,
          type: 1,
          currencySymbol: enumData.currencyList.find(o => o.currencyName === submitData.currency).currencySymbol,
          creditId: form.value.creditId
        },
        {
          bankAccount: submitData.bankAccount2,
          openingBank: submitData.openingBank2,
          collectionName: submitData.collectionName2,
          currency: submitData.currency2,
          bankNo: submitData.bankBranchNo2,
          type: 2,
          currencySymbol: enumData.currencyList.find(o => o.currencyName === submitData.currency).currencySymbol,
          creditId: form.value.creditId
        }
      ])
      await coreEnterpriseAccountListSet(submitData.bankAccountList)
      ElMessage.success('操作成功')

      setTimeout(() => {
        dialogVisible.value = false
      }, 300)
    } else {
      console.log('error submit!', fields)
    }
  })
}
function confirmDel(index, type) {
  form.value[type].splice(index, 1)
}
const rules = reactive({
