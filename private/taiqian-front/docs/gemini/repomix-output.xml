  try {
    const res = await industryDetail(currentRoute.value.query.id)
    form.value = res.data
  } catch (error) {
    console.log(error)
  }
}
const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      const submitData = cloneDeep(form.value)
      if (_props.pageType === 1) {
        await industryAdd(submitData)
      } else {
        await industryEdit(submitData)
      }

      ElMessage.success('操作成功')
      setTimeout(() => {
        proxy.toList({
          path: `industry-list`,
          listName: 'industry-list'
        })
      }, 300)
    } else {
      console.log('error submit!', fields)
    }
  })
}

onMounted(async () => {
  if (_props.pageType !== 1) {
    getDetails()
  }
})

const rules = reactive({
