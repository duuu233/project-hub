<template>
  <el-form ref="formRef" :model="form" :rules="rules" label-width="auto" :label-position="pageType === 3 ? 'right' : 'top'">
    <Collapse title="H5登录页配置">
      <el-row :gutter="20">
        <el-col :span="8">
          <el-form-item label="站点名称" prop="siteName" required>
            <el-input :disabled="pageType === 3" style="width: 220px" v-model="form.siteName" placeholder="请输入站点名称" />
          </el-form-item>
        </el-col>

        <el-col :span="8">
          <el-form-item label="站点logo" prop="logoUrl" required>
            <ImageUpload
              v-model="form.logoUrl"
              :isShowTip="false"
              :limit="1"
              :disabled="pageType === 3"
              style="width: 220px"
              tip="支持PNG、jpg格式，只能有一份"
            />
          </el-form-item>
        </el-col>

        <el-col :span="8">
          <el-form-item label="用户协议" prop="userAgreementUrl" required>
            <FileUpload
              v-model="form.userAgreementUrl"
              :disabled="pageType === 3"
              style="width: 220px"
              :limit="1"
              listType="file"
              accept=".pdf,.doc,.docx,.txt"
              tip="支持pdf、word、txt格式，只能有一份"
            />
          </el-form-item>
        </el-col>

        <el-col :span="8">
          <el-form-item label="隐私协议" prop="privacyAgreementUrl" required>
            <FileUpload
              v-model="form.privacyAgreementUrl"
              :disabled="pageType === 3"
              style="width: 220px"
              :limit="1"
              listType="file"
              accept=".pdf,.doc,.docx,.txt"
              tip="支持pdf、word格式，只能有一份"
            />
          </el-form-item>
        </el-col>
      </el-row>
    </Collapse>

    <el-form-item>
      <div style="padding: 20px 0 0 20px" v-if="pageType !== 3">
        <el-button v-throttle type="info" @click="router.back()" size="large">取消</el-button>
        <el-button v-throttle type="primary" @click="submit" size="large">提交</el-button>
      </div>
    </el-form-item>
  </el-form>
</template>

<script setup>
import Collapse from '@/components/Collapse'
import ImageUpload from '@/components/ImageUpload'
import { ref, reactive, onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import router from '@/router'
import { getH5Config, saveOrUpdateH5Config } from '@/api/system/h5config'
const baseUrl = '/api-qianrong'
const _props = defineProps({
  pageType: Number
})

const formRef = ref()
const form = ref({
  siteName: '',
  logoUrl: '',
  userAgreementUrl: '',
  privacyAgreementUrl: ''
})

const rules = reactive({
  siteName: [{ required: true, message: '请输入站点名称', trigger: 'blur' }],
  logoUrl: [{ required: true, message: '请上传站点logo', trigger: 'change' }],
  userAgreementUrl: [{ required: true, message: '请上传用户协议', trigger: 'change' }],
  privacyAgreementUrl: [{ required: true, message: '请上传隐私协议', trigger: 'change' }]
})

const getDetail = async () => {
  try {
    const res = await getH5Config()
    if (res.code === 200) {
      form.value = {
        ...res.data,
        logoUrl: res.data.logoUrl
          ? [
              {
                name: '站点logo',
                url: baseUrl + res.data.logoUrl
              }
            ]
          : [],
        privacyAgreementUrl: res.data.privacyAgreementUrl
          ? [
              {
                fileName: '隐私协议',
                fileUrl: res.data.privacyAgreementUrl
              }
            ]
          : [],
        userAgreementUrl: res.data.userAgreementUrl
          ? [
              {
                fileName: '用户协议',
                fileUrl: res.data.userAgreementUrl
              }
            ]
          : []
      }
    }
  } catch (error) {}
}

const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      try {
        let logoUrl = ''
        if (Array.isArray(form.value.logoUrl)) {
          logoUrl = form.value.logoUrl[0].url.replace(/^\/api-qianrong/, '') || ''
        } else {
          logoUrl = form.value.logoUrl.replace(/^\/api-qianrong/, '')
        }
        const submitData = {
          ...form.value,
          logoUrl,
          privacyAgreementUrl: form.value.privacyAgreementUrl?.[0]?.fileUrl || '',
          userAgreementUrl: form.value.userAgreementUrl?.[0]?.fileUrl || ''
        }
        const res = await saveOrUpdateH5Config(submitData)
        if (res.code === 200) {
          ElMessage.success('操作成功')
          getDetail()

        }
      } catch (error) {
        ElMessage.error('操作失败')
      }
    } else {
    }
  })
}

onMounted(() => {
  getDetail()
})
</script>

