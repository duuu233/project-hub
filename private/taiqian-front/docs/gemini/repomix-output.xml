                <el-button v-if="row.id % 2" link type="primary" @click="handleAction('预付款预警配置', row)">预付款预警配置</el-button>
                <el-popconfirm v-if="row.id % 2" title="确定删除这条示例数据吗？" @confirm="handleDelete(row)">
                  <template #reference><el-button v-hasPermi="['demo:delete']" link type="primary">删除</el-button></template>
