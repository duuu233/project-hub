<file path="apps/qianrong/src/views/system/all-system/template/handleDetail.vue">
<template>
  <el-form label-position="top" class="qr-detail-page" ref="formRef" scroll-to-error :model="form" :rules="rules" label-width="auto">
    <DetailHeaderCard v-if="+pageType === 3" title="系统详情" subtitle="查看系统的基本配置信息" :fields="detailHeaderFields" />
    <Collapse title="系统信息">
      <el-form-item label="系统名称" prop="systemName">
        <el-input v-model="form.systemName" placeholder="请输入系统名称" :style="{ width: 240 + 'px' }" :disabled="props.pageType == 3" />
      </el-form-item>
    </Collapse>

    <BottomFixedBtnsBox>
      <el-button type="info" @click="cancel" size="large">{{ +pageType === 3 ? '返回' : '取消' }}</el-button>
      <el-button v-if="props.pageType !== 3" type="primary" @click="submit" size="large">确定</el-button>
    </BottomFixedBtnsBox>
  </el-form>
</template>

<script setup>
import DetailHeaderCard from '@/components/DetailHeaderCard/index.vue'
import { headerTime } from '@/components/DetailHeaderCard/utils'
import BottomFixedBtnsBox from '@/components/BottomFixedBtnsBox/index.vue'
import { onMounted, ref } from 'vue'
import { useRouter } from 'vue-router'
import Collapse from '@/components/Collapse'
import { ElMessage } from 'element-plus'
import { addSystem, editSystem, getDetail } from '@/api/system/system'

const router = useRouter()

const form = ref({
  id: '',
  systemName: ''
})

const rules = {
  systemName: [{ required: true, message: '请输入系统名称', trigger: 'blur' }]
}

const props = defineProps({
  pageType: {
    type: Number,
    default: 0
  }
})

const formRef = ref()

onMounted(async () => {
  if (props.pageType !== 1) {
    const res = await getDetail({
      id: router.currentRoute.value.query.id
    })
    form.value = {
      ...res.data
    }
  }
})

const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      const data = {
        ...form.value
      }
      try {
        if (props.pageType === 1) {
          await addSystem(data)
          ElMessage.success('添加成功')
        } else {
          await editSystem(data)
          ElMessage.success('编辑成功')
        }
        router.push('/system/all-system')
      } catch (error) {
        ElMessage.error('操作失败: ' + error.message)
      }
    } else {
      console.log('validation failed', fields)
    }
  })
}

const cancel = () => {
  router.go(-1)
}
const detailHeaderFields = computed(() => {
  const data = form.value
  return [
    { label: '系统编号', value: data.id },
    { label: '系统名称', value: data.systemName },
    { label: '创建时间', value: headerTime(data.createTime) }
  ]
})
</script>
