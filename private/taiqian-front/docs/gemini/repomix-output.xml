const { entry_port } = proxy.useDict('entry_port')

const props = defineProps({
  id: {
    type: [String, Number],
    required: true
  },
  pageType: {
    type: String,
    default: ''
  }
})

const isDetail = ref(props.pageType == 3)
const operationButtons = [
  { label: '海运', value: '1' },
  { label: '报关', value: '2' },
  { label: '入库', value: '3' },
  { label: '码头直提', value: '4' },
  { label: '堆场提货', value: '5' }
]
const formRef = ref()
const form = ref({
  loanAfterNo: '',
  approveStatus: '',
  approveStatusText: '',
  createTime: '',
  agentOrderNo: '',
  financeNo: '',
  purchaseNo: '',
  deliveryNo: '',
  customsNo: '',
  entryPort: '',
  dischargeDate: '',
  customs: [],
  tax: [],
  shipInfoList: [],
  transportType: ''
})

const formatFileList = (fileList = []) => {
  const customs = []
  const tax = []

  fileList.forEach(file => {
    const fileItem = {
      name: file.fileName,
      url: file.fileUrl
    }

    if (file.fileType == '111') {
      customs.push(fileItem)
    } else if (file.fileType == '112') {
      tax.push(fileItem)
    }
  })

  return {
    customs,
    tax
  }
}

const getFormatFileList = () => {
  const fileList = []

  form.value.customs.forEach(file => {
    fileList.push({
      fileName: file.name,
      fileUrl: file.url,
      fileType: '111',
      fileSuffix: file.name.split('.').pop()
    })
  })

  form.value.tax.forEach(file => {
    fileList.push({
      fileName: file.name,
      fileUrl: file.url,
      fileType: '112',
      fileSuffix: file.name.split('.').pop()
    })
  })

  return fileList
}

onMounted(async () => {
  const { data } = await customsClearDetail({ id: props.id })
  const { customs, tax } = formatFileList(data.fileList)

  const approveStatusMap = {
    0: '待审批',
    1: '审批通过',
    2: '审批不通过'
  }

  const loanAfterTypeMap = {
    1: '海运',
    2: '报关',
    3: '入库',
    4: '码头提货',
    5: '堆场提货'
  }

  const transportType = data.shipInfoList?.[0]?.transportType

  form.value = {
    ...data,
    approveStatusText: approveStatusMap[data.approveStatus] || '-',
    loanAfterTypeText: loanAfterTypeMap[data.loanAfterType],
    loanAfterTypeText: operationButtons[data.loanAfterType - 1].label,
    customs,
    tax,
    transportType
  }
})

const rules = {
  customs: [{ required: true, message: '请上传报关单', trigger: 'change' }],
  tax: [{ required: true, message: '请上传税费单', trigger: 'change' }]
}

const submitForm = async () => {
  await formRef.value.validate(async valid => {
    if (valid) {
      const params = {
        id: props.id,
        fileList: getFormatFileList()
      }
      await submitApprove(params)
      ElMessage.success('提交成功')
      history.back()
    }
  })
}

const cancel = () => {
  history.back()
}
</script>

