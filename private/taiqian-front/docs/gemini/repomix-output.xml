    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

async function getList() {
  gridOptions.loading = true
  try {
    const res = await billList({
      ...query,
      pageNum: gridOptions.pagerConfig.currentPage,
      pageSize: gridOptions.pagerConfig.pageSize
    })

    gridOptions.data = res.rows
    gridOptions.pagerConfig.total = res.total * 1
  } catch (error) {
    console.error('获取列表失败:', error)
    ElMessage.error('获取列表失败')
  } finally {
    gridOptions.loading = false
  }
}

function handleExport() {
  proxy.download(
    '/api-qianrong/bill/export',
    {
      ...query
    },
    `费用对账单_${new Date().getTime()}.xlsx`,
    {
      headers: { 'Content-Type': 'application/json' }
    }
  )
}
async function computeExport() {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      proxy.$modal.loading(`下载中...`)
      await proxy.download(
        '/api-qianrong/bill/trial/export',
        {
          ...form.value
        },
        `费用对账单_${new Date().getTime()}.xlsx`,
        {
          headers: { 'Content-Type': 'application/json' }
        }
      )
      proxy.$modal.closeLoading(`下载中...`)
    }
  })
}
async function handleProductId(id) {
  if (!id) return
  const res = await getProductDetail(id)

  if (res.data?.feeInfo?.length) {
    let list = res.data.feeInfo
    list.map(item => {
      if (item.feeTypeValue === '2') {
        form.value.serveFeeRatio = multiplyWithPrecision(item.feeRatio, 100)
      }
      if (item.feeTypeValue === '3') {
        form.value.supervisionFeeRatio = multiplyWithPrecision(item.feeRatio, 100)
      }
    })
  } else {
    ElMessage.warning('获取金融产品费率失败')
  }
  console.log('res', res)
}
async function submit() {
  await billFormRef.value.validate(async (valid, fields) => {
    if (valid) {
      await billListPay(billForm.value)
      ElMessage.success('提交成功')
      dialogVisibleBill.value = false
    }
  })
}

const handleDetail = row => {
  proxy.openNewTagsView({
    name: 'statement-list-detail'
  })
  router.push({
    path: 'statement-list-detail',
    query: {
      id: row.id
    }
  })
}

onMounted(() => {
  getEnumData()
  getList()
  registerGrid('statement-list-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('statement-list-grid')
})
const rules = reactive({
  productId: [
    {
      required: true,
      message: '请选择金融产品',
      trigger: 'change'
    }
  ],
  period: [
    {
      required: true,
      message: '请选择对账月份',
      trigger: 'change'
    }
  ]
})

function showDialogVisibleBill(row) {
  let billItem = cloneDeep(row)
  billItem.totalFee = billItem.technicalServiceFee + billItem.dataSupervisionFee
  billItem.billId = billItem.id
  delete billItem.id
  billForm.value = billItem

  dialogVisibleBill.value = true
}
async function getEnumData() {
  try {
    const res = await productSelectList({})
    enumData.productList = res.data || []
    enumData.productList.map(v => {
      v.label = v.productName
      v.value = v.productName
    })
    searchOpt.value[2].opts = enumData.productList
    console.log('enumData.productList', enumData.productList)
  } catch (error) {
    console.log(error)
  }
}
</script>

