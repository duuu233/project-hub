<file path="scripts/strip-comments.mjs">
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const __dirname = path.dirname(fileURLToPath(import.meta.url))
const ROOT = path.resolve(__dirname, '..')

const TARGET_EXTS = new Set(['.ts', '.tsx', '.js', '.jsx', '.mjs', '.cjs', '.vue', '.scss', '.css', '.html', '.json', '.jsonc'])
const SKIP_DIRS = new Set(['.git', '.idea', '.vscode', '.cursor', 'cache', 'coverage', 'dist', 'memory', 'node_modules'])
const JSON_ONLY_EXTS = new Set(['.json', '.jsonc'])
const CSS_EXTS = new Set(['.css', '.scss'])

function parseArgs(args) {
  const options = { check: false, dryRun: false, help: false, targets: [] }

  for (let i = 0; i < args.length; i += 1) {
    const arg = args[i]
    if (arg === '--check') options.check = true
    else if (arg === '--dry-run') options.dryRun = true
    else if (arg === '--all') options.targets.push('.')
    else if (arg === '--help' || arg === '-h') options.help = true
    else if (arg === '--target') options.targets.push(args[++i])
    else options.targets.push(arg)
  }

  if (!options.targets.length) options.targets = ['.']
  return options
}

function printHelp() {
  process.stdout.write(`Usage: node scripts/strip-comments.mjs [options] [paths...]

Options:
  --target <path>  Add a file or directory target. Can be used multiple times.
  --all            Scan the entire project root (same as passing ".").
  --dry-run        Print files that would change without writing.
  --check          Do not write. Exit with code 1 when comments can be stripped.
  -h, --help       Show this help.

By default the script scans the entire project (excluding node_modules, dist,
.git, etc.). Pass specific paths to narrow the scope.

Examples:
  npm run strip-comments
  npm run strip-comments:dry-run
  npm run strip-comments -- src/views/order
  npm run strip-comments:check
`)
}

function toRelative(filePath) {
  return path.relative(ROOT, filePath).replace(/\\/g, '/')
}

function walk(dir, files = []) {
  if (!fs.existsSync(dir)) return files

  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name)
    if (entry.isDirectory()) {
      if (!SKIP_DIRS.has(entry.name)) walk(full, files)
    } else if (TARGET_EXTS.has(path.extname(entry.name))) {
      files.push(full)
    }
  }

  return files
}

function collectFiles(targets) {
  const files = []
  const seen = new Set()

  for (const target of targets) {
    if (!target) continue

    const resolved = path.resolve(ROOT, target)
    if (!fs.existsSync(resolved)) {
      throw new Error(`Target not found: ${target}`)
    }

    const stat = fs.statSync(resolved)
    const nextFiles = stat.isDirectory()
      ? walk(resolved)
      : TARGET_EXTS.has(path.extname(resolved))
        ? [resolved]
        : []

    for (const file of nextFiles) {
      if (seen.has(file)) continue
      seen.add(file)
      files.push(file)
    }
  }

  return files
}

function stripJsLikeComments(src) {
  let out = ''
  let i = 0
  const len = src.length
  const stack = [{ kind: 'code', braceDepth: 0 }]
  let prevNonWs = ''

  function top() {
    return stack[stack.length - 1]
  }

  function canStartRegex(prevChar) {
    if (!prevChar) return true
    if (/[\w)\]]/.test(prevChar)) return false
    return true
  }

  while (i < len) {
    const ctx = top()
    const ch = src[i]
    const next = src[i + 1]

    if (ctx.kind === 'code') {
      if (ch === "'" || ch === '"') {
        out += ch
        prevNonWs = ch
        i++
        const quote = ch
        while (i < len) {
          const c = src[i]
          out += c
          if (c === '\\' && i + 1 < len) {
            out += src[i + 1]
            i += 2
            continue
          }
          if (c === quote) {
            i++
            prevNonWs = quote
            break
          }
          if (c === '\n') {
            i++
            break
          }
          i++
        }
        continue
      }

      if (ch === '`') {
        out += ch
        prevNonWs = ch
        stack.push({ kind: 'template' })
        i++
        continue
      }

      if (ch === '/' && next === '/') {
        while (i < len && src[i] !== '\n') i++
        continue
      }

      if (ch === '/' && next === '*') {
        i += 2
        while (i < len && !(src[i] === '*' && src[i + 1] === '/')) i++
        if (i < len) i += 2
        continue
      }

      if (ch === '/' && canStartRegex(prevNonWs)) {
        const start = i
        out += ch
        i++

        while (i < len) {
          const rc = src[i]
          if (rc === '\\' && i + 1 < len) {
            out += rc + src[i + 1]
            i += 2
            continue
          }
          if (rc === '[') {
            out += rc
            i++
            while (i < len && src[i] !== ']') {
              if (src[i] === '\\' && i + 1 < len) {
                out += src[i] + src[i + 1]
                i += 2
                continue
              }
              out += src[i]
              i++
            }
            if (i < len) {
              out += src[i]
              i++
            }
            continue
          }
          if (rc === '/') {
            out += rc
            i++
            while (i < len && /[gimsuy]/.test(src[i])) {
              out += src[i]
              i++
            }
            break
          }
          if (rc === '\n') {
            out = out.slice(0, -(i - start))
            out += src.slice(start, i + 1)
            i++
            break
          }
          out += rc
          i++
        }
        prevNonWs = '/'
        continue
      }

      if (ch === '{') {
        ctx.braceDepth++
        out += ch
        prevNonWs = ch
        i++
        continue
      }

      if (ch === '}') {
        if (ctx.braceDepth > 0) {
          ctx.braceDepth--
          out += ch
          prevNonWs = ch
          i++
          continue
        }
        if (stack.length > 1 && stack[stack.length - 2].kind === 'template') {
          stack.pop()
          out += ch
          prevNonWs = ch
          i++
          continue
        }
        out += ch
        prevNonWs = ch
        i++
        continue
      }

      out += ch
      if (!/\s/.test(ch)) prevNonWs = ch
      i++
      continue
    }

    if (ctx.kind === 'template') {
      if (ch === '\\' && i + 1 < len) {
        out += ch + src[i + 1]
        i += 2
        continue
      }
      if (ch === '$' && next === '{') {
        out += '${'
        stack.push({ kind: 'code', braceDepth: 0 })
        i += 2
        prevNonWs = '{'
        continue
      }
      if (ch === '`') {
        out += ch
        stack.pop()
        prevNonWs = '`'
        i++
        continue
      }
      out += ch
      i++
      continue
    }

    out += ch
    i++
  }

  return out
}

function stripCssComments(src) {
  return src.replace(/\/\*[\s\S]*?\*\//g, '')
}

function stripHtmlComments(src) {
  return src.replace(/<!--[\s\S]*?-->/g, '')
}

function stripJsonComments(src) {
  let out = ''
  let i = 0
  const len = src.length

  while (i < len) {
    const ch = src[i]

    if (ch === '"') {
      out += ch
      i++
      while (i < len) {
        const c = src[i]
        out += c
        if (c === '\\' && i + 1 < len) {
          out += src[i + 1]
          i += 2
          continue
        }
        i++
        if (c === '"') break
      }
      continue
    }

    if (ch === '/' && src[i + 1] === '/') {
      while (i < len && src[i] !== '\n') i++
      continue
    }

    if (ch === '/' && src[i + 1] === '*') {
      i += 2
      while (i < len && !(src[i] === '*' && src[i + 1] === '/')) i++
      if (i < len) i += 2
      continue
    }

    out += ch
    i++
  }

  return out
}

function findBlock(src, tagName) {
  const openRe = new RegExp(`<${tagName}(\\s[^>]*)?>`, 'g')
  const closeTag = `</${tagName}>`
  const openMatch = openRe.exec(src)
  if (!openMatch) return null

  const openStart = openMatch.index
  const openEnd = openStart + openMatch[0].length
  let depth = 1
  let pos = openEnd
  const nestedOpenRe = new RegExp(`<${tagName}(\\s[^>]*)?>`, 'g')

  while (pos < src.length) {
    nestedOpenRe.lastIndex = pos
    const nextOpen = nestedOpenRe.exec(src)
    const nextClose = src.indexOf(closeTag, pos)
    if (nextClose === -1) return null

    if (nextOpen && nextOpen.index < nextClose) {
      depth++
      pos = nextOpen.index + nextOpen[0].length
      continue
    }

    depth--
    if (depth === 0) {
      return {
        openTag: openMatch[0],
        openStart,
        openEnd,
        closeStart: nextClose,
        closeEnd: nextClose + closeTag.length,
        body: src.slice(openEnd, nextClose)
      }
    }
    pos = nextClose + closeTag.length
  }

  return null
}

function findAllBlocks(src, tagName) {
  const blocks = []
  let cursor = 0

  while (cursor < src.length) {
    const tail = src.slice(cursor)
    const found = findBlock(tail, tagName)
    if (!found) break
    blocks.push({
      openStart: found.openStart + cursor,
      openEnd: found.openEnd + cursor,
      closeStart: found.closeStart + cursor,
      closeEnd: found.closeEnd + cursor,
      openTag: found.openTag,
      body: found.body
    })
    cursor = found.closeEnd + cursor
  }

  return blocks
}

function stripHtmlCommentsOutsideBlocks(src) {
  const blocks = [...findAllBlocks(src, 'script'), ...findAllBlocks(src, 'style')]
    .sort((a, b) => a.openStart - b.openStart)
  let result = ''
  let cursor = 0

  for (const block of blocks) {
    result += stripHtmlComments(src.slice(cursor, block.openStart))
    result += src.slice(block.openStart, block.closeEnd)
    cursor = block.closeEnd
  }

  result += stripHtmlComments(src.slice(cursor))
  return result
}

function processVueFile(src) {
  const edits = []
  const template = findBlock(src, 'template')
  const script = findBlock(src, 'script')
  const styles = findAllBlocks(src, 'style')

  if (template) {
    edits.push({
      start: template.openEnd,
      end: template.closeStart,
      replacement: stripHtmlComments(template.body)
    })
  }

  if (script) {
    edits.push({
      start: script.openEnd,
      end: script.closeStart,
      replacement: stripJsLikeComments(script.body)
    })
  }

  for (const block of styles) {
    edits.push({
      start: block.openEnd,
      end: block.closeStart,
      replacement: stripJsLikeComments(block.body)
    })
  }

  edits.sort((a, b) => b.start - a.start)
  let result = src
  for (const edit of edits) {
    result = result.slice(0, edit.start) + edit.replacement + result.slice(edit.end)
  }
  return result
}

function processHtmlFile(src) {
  const scripts = findAllBlocks(src, 'script').map(block => ({
    start: block.openEnd,
    end: block.closeStart,
    replacement: stripJsLikeComments(block.body)
  }))
  const styles = findAllBlocks(src, 'style').map(block => ({
    start: block.openEnd,
    end: block.closeStart,
    replacement: stripJsLikeComments(block.body)
  }))
  const edits = [...scripts, ...styles].sort((a, b) => b.start - a.start)
  let result = src
  for (const edit of edits) {
    result = result.slice(0, edit.start) + edit.replacement + result.slice(edit.end)
  }
  return stripHtmlCommentsOutsideBlocks(result)
}

function trimExcessBlankLines(src) {
  return src
    .replace(/^\s*\n+/, '')
    .replace(/[ \t]+(\r?\n)/g, '$1')
    .replace(/(\r?\n){3,}/g, '$1$1')
}

function processFile(filePath, options) {
  const original = fs.readFileSync(filePath, 'utf8')
  const ext = path.extname(filePath)
  let next

  if (ext === '.vue') next = processVueFile(original)
  else if (ext === '.html') next = processHtmlFile(original)
  else if (JSON_ONLY_EXTS.has(ext)) next = stripJsonComments(original)
  else if (CSS_EXTS.has(ext)) next = stripCssComments(original)
  else next = stripJsLikeComments(original)

  next = trimExcessBlankLines(next)
  if (next !== original) {
    if (!options.check && !options.dryRun) {
      fs.writeFileSync(filePath, next, 'utf8')
    }
    return true
  }

  return false
}

const options = parseArgs(process.argv.slice(2))
if (options.help) {
  printHelp()
  process.exit(0)
}

const files = collectFiles(options.targets)
let changed = 0

for (const f of files) {
  try {
    if (processFile(f, options)) {
      changed++
      if (options.check || options.dryRun) {
        process.stdout.write(`[change] ${toRelative(f)}\n`)
      }
    }
  } catch (err) {
    process.stderr.write(`[FAIL] ${toRelative(f)}: ${err.message}\n`)
  }
}

const action = options.check ? 'checked' : options.dryRun ? 'dry-run' : 'processed'
process.stdout.write(`Strip comments ${action} ${files.length} files, changed ${changed}.\n`)

if (options.check && changed > 0) {
  process.exitCode = 1
}
