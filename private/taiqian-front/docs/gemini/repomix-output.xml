import { industryList as industryListApi } from '@/api/industry'
import BottomFixedBtnsBox from '@/components/BottomFixedBtnsBox'
import { listCurrency } from '@/api/system/currency'
import { supplierAdd, supplierDetail, supplierEdit } from '@/api/business'
import AreaCascader from '@/components/AreaCascader'
const { currentRoute, back } = useRouter()
const { proxy } = getCurrentInstance()
const { registration_status } = proxy.useDict('registration_status')
const _props = defineProps({
  pageType: Number
})
const enumData = reactive({
  industryList: []
})
const currencyList = ref([])
const form = ref({
  sysOrg: {
    orgType: 2,
    currencyCode: 'CNY'
  }
})

const formRef = ref()
const cascaderRef = ref()

async function getDetails() {
  try {
    const { data } = await supplierDetail(currentRoute.value.query.id)
    const { sysOrg, businessLicenseFile = [], legalCardFrontFile = [], legalCardBackFile = [] } = data

    form.value.sysOrg = { ...sysOrg, registrationStatus: String(sysOrg.registrationStatus) }
    form.value.cascader = [sysOrg.provinceCode, sysOrg.cityCode, sysOrg.areaCode].filter(Boolean)

    form.value.businessLicenseFile = businessLicenseFile[0]?.fileUrl || ''
    form.value.legalCardFrontFile = legalCardFrontFile[0]?.fileUrl || ''
    form.value.legalCardBackFile = legalCardBackFile[0]?.fileUrl || ''
  } catch (error) {
    ElMessage.error('获取详情失败')
  }
}

const submit = async () => {
  const valid = await formRef.value.validate().catch(() => false)
  if (!valid) return

  if (form.value.cascader?.length) {
    const [provinceCode, cityCode, areaCode] = form.value.cascader
    Object.assign(form.value.sysOrg, {
      areaFullName: cascaderRef.value.getNames().join('-'),
      provinceCode,
      cityCode,
      areaCode: areaCode || ''
    })
  }
  if (form.value.sysOrg.currencyCode) {
    form.value.sysOrg.currencyName = currencyList.value.find(o => o.currencyCode === form.value.sysOrg.currencyCode)?.currencyName || ''
  }
  const submitData = {
    sysOrg: form.value.sysOrg,
    businessLicenseFile: [],
    legalCardFrontFile: [],
    legalCardBackFile: []
  }

  if (form.value.businessLicenseFile) {
    submitData.businessLicenseFile.push({
      fileName: '营业执照',
      fileUrl: form.value.businessLicenseFile,
      fileType: 10,
      fileSuffix: '',
      sourceType: 0
    })
  }

  if (form.value.legalCardFrontFile) {
    submitData.legalCardFrontFile.push({
      fileName: '法人身份证正面',
      fileUrl: form.value.legalCardFrontFile,
      fileType: 11,
      fileSuffix: '',
      sourceType: 0
    })
  }

  if (form.value.legalCardBackFile) {
    submitData.legalCardBackFile.push({
      fileName: '法人身份证反面',
      fileUrl: form.value.legalCardBackFile,
      fileType: 12,
      fileSuffix: '',
      sourceType: 0
    })
  }
  submitData.sysOrg.projectName = enumData.industryList.find(o => o.id === submitData.sysOrg.projectId)?.projectName || ''
  try {
    if (_props.pageType === 1) {
      await supplierAdd(submitData)
    } else {
      submitData.sysOrg.id = currentRoute.value.query.id
      await supplierEdit(submitData)
    }
    ElMessage.success('操作成功')
    setTimeout(() => {
      proxy.toList({
        path: 'merchants-supplier',
        listName: 'merchants-supplier'
      })
    }, 300)
  } catch (error) {
    ElMessage.error('提交失败')
  }
}

onMounted(async () => {
  await getEnumData()
  await getListCurrency()
  if (_props.pageType !== 1) {
    await getDetails()
  }
})

const reg = /^(?:[\u4e00-\u9fa5·]{2,16})$/
const validateContacts = (rule, value, callback) => {
  setTimeout(() => {
    if (!value) {
      callback(new Error('请输入联系人'))
    } else if (value && !reg.test(value)) {
      callback(new Error('请输入正确的名称'))
    } else {
      callback()
    }
  }, 500)
}
const reg1 = /^(?:(?:\+|00)86)?1\d{10}$/
const validatePhone = (rule, value, callback) => {
  setTimeout(() => {
    if (!value) {
      callback(new Error('请输入联系方式'))
    } else if (value && !reg1.test(value)) {
      callback(new Error('请输入正确的手机号'))
    } else {
