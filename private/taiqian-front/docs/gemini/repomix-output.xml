            fileUrl: form.value.loanOrg.busPremisesPhotoFiles
          }
        ]
        if (submitData.account && submitData.account.length) {
          submitData.account = submitData.account[0]
        }
        if (_props.pageType === 1) {
          await loanOrgAdd(submitData)
        }
        if (_props.pageType === 2) {
          await loanOrgEdit(submitData)
        }
