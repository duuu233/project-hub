    if (!form.value.areaCode) {
      form.value.cascader.pop()
    }
    form.value.registrationStatus = form.value.registrationStatus + ''
    form.value.businessLicenseUrl = res.data.businessLicenseUrl?.length ? res.data.businessLicenseUrl[0].fileUrl : ''
    form.value.legalCardFrontFile = res.data.legalCardFrontFile?.length ? res.data.legalCardFrontFile[0].fileUrl : ''
    form.value.legalCardBackFile = res.data.legalCardBackFile?.length ? res.data.legalCardBackFile[0].fileUrl : ''
  } catch (error) {
    console.log(error)
  }
}
const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      const submitData = cloneDeep(form.value)
      if (submitData.cascader && form.value.cascader.length) {
        submitData.areaFullName = cascaderRef.value.getNames().join('-')
        submitData.provinceCode = submitData.cascader[0]
        submitData.cityCode = submitData.cascader[1]
        submitData.areaCode = submitData.cascader[2] || ''
      }
      submitData.projectName = enumData.industryList.find(o => o.id === submitData.projectId)?.projectName || ''
      submitData.businessLicenseUrl = [
        {
          fileName: '营业执照',
