<script setup name="Financial-products-list">
import { onMounted, ref, reactive, onUnmounted } from 'vue'
import { ElMessage } from 'element-plus'
import TableSearch from '@/components/TableSearch'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'
import { InfoFilled } from '@element-plus/icons-vue'
import {
  getFinanceProductList,
  updateFinanceProductStatus,
  getFinanceProductFee,
  getFinanceProductFeeResult,
  getFinanceProductPrepay
} from '@/api/deppon/product'

const router = useRouter()
const { proxy } = getCurrentInstance()
const { fee_type } = proxy.useDict('fee_type')
const gridRef = ref()

const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const dialogVisible = ref(false)
const currentRow = ref(null)

const feeConfigVisible = ref(false)
const feeConfigForm = ref([])
const feeConfigLoading = ref(false)
const currentFeeRow = ref(null)

const prepayConfigVisible = ref(false)
const prepayConfigForm = ref({
  prePayLimit: null
})
const prepayConfigLoading = ref(false)
const currentPrepayRow = ref(null)

const query = reactive({
  productName: '',
  bankName: ''
})

const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}

const searchOpt = ref([
  {
    type: 'input',
    label: '产品名称：',
    placeholder: '请输入',
    prop: 'productName'
  },
  {
    type: 'input',
    label: '合作机构：',
    placeholder: '请输入',
    prop: 'bankName'
  }
])

const gridOptions = reactive({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true,
    slots: {
      buttons: 'toolbarButtons'
    }
  },
  columns: [
    { type: 'seq', width: 70 },
    { title: '金融产品类型', field: 'type', minWidth: 120, slots: { default: 'typeRender' } },
    { title: '产品名称', field: 'productName', minWidth: 120, showOverflow: true },
    { title: '合作机构', field: 'bankName', minWidth: 220, showOverflow: true },
    { title: '金融产品状态', field: 'status', minWidth: 120, align: 'center', slots: { default: 'statusRender' } },
    { title: '合作期限', field: 'productCooperateStartTime', minWidth: 280, slots: { default: 'cooperateTimeRender' } },
    { title: '创建人', field: 'userName', minWidth: 120 },
    { title: '创建时间', field: 'createTime', minWidth: 180, align: 'center', slots: { default: 'createTimeRender' } },
    { title: '修改时间', field: 'updateTime', minWidth: 180, align: 'center', slots: { default: 'updateTimeRender' } },
    { title: '操作', field: 'active', minWidth: 280, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
})

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

async function getList() {
  gridOptions.loading = true
  try {
    const res = await getFinanceProductList({
      pageNum: gridOptions.pagerConfig.currentPage,
      pageSize: gridOptions.pagerConfig.pageSize,
      ...query
    })

    gridOptions.data = res.rows
    gridOptions.pagerConfig.total = res.total * 1
  } catch (error) {
    console.error('获取列表失败:', error)
    ElMessage.error('获取列表失败')
  } finally {
    gridOptions.loading = false
  }
}

function handleAdd() {
  router.push({ path: '/products/financial-products/add' })
}

function handleEdit(row) {
  proxy.openNewTagsView({
    name: 'Financial-products/edit'
  })
  router.push({
    path: '/products/financial-products/edit',
    query: { id: row.id }
  })
}

function handleDetail(row) {
  proxy.openNewTagsView({
    name: 'Financial-products/detail'
  })
  router.push({
    path: '/products/financial-products/detail',
    query: { id: row.id }
  })
}

function showStatusModal(row) {
  currentRow.value = row
  dialogVisible.value = true
}

function handleClose() {
  dialogVisible.value = false
  currentRow.value = null
}

async function handleStatusConfirm() {
  try {
    await updateFinanceProductStatus({
      id: currentRow.value.id,
      status: +currentRow.value.status === 0 ? 1 : 0
    })
    ElMessage.success('操作成功')
    dialogVisible.value = false
    currentRow.value = null
    getList()
  } catch (error) {
    console.error('操作失败:', error)
    ElMessage.error('操作失败')
  }
}

async function showFeeConfigModal(row) {
  currentFeeRow.value = row
  try {
    const res = await getFinanceProductFeeResult({ id: row.id })
    if (res.data && res.data.length > 0) {
      feeConfigForm.value = res.data.map(item => ({
        ...item,
        feeRatio: item.feeRatio * 100,
        status: String(item.status)
      }))
    } else {
      initFeeConfig()
    }
    feeConfigVisible.value = true
  } catch (error) {
    console.error('获取费用配置失败:', error)
    initFeeConfig()
    feeConfigVisible.value = true
  }
}

function initFeeConfig() {
  if (fee_type.value && fee_type.value.length > 0) {
    feeConfigForm.value = fee_type.value.map(item => ({
      feeExpress: item.remark || '',
      feeRatio: null,
      feeTypeName: item.label,
      feeTypeValue: item.value,
      financeProductId: currentFeeRow.value?.id || null,
      status: '0'
    }))
  }
}

function handleFeeTypeChange(value, index) {
  const selectedFeeType = fee_type.value.find(item => item.value === value)
  if (selectedFeeType) {
    feeConfigForm.value[index].feeTypeName = selectedFeeType.label
    feeConfigForm.value[index].feeExpress = selectedFeeType.remark || ''
  }
}

function handleFeeConfigClose() {
  feeConfigVisible.value = false
  currentFeeRow.value = null
  feeConfigForm.value = []
}

async function handleFeeConfigConfirm() {
  try {
    feeConfigLoading.value = true
    const submitData = feeConfigForm.value.map(item => ({
      ...item,
      feeRatio: item.feeRatio / 100,
      financeProductId: currentFeeRow.value.id
    }))
    await getFinanceProductFee(submitData)
    ElMessage.success('费用配置保存成功')
    feeConfigVisible.value = false
    currentFeeRow.value = null
    feeConfigForm.value = []
  } catch (error) {
    console.error('费用配置保存失败:', error)
    ElMessage.error('费用配置保存失败')
  } finally {
    feeConfigLoading.value = false
  }
}

function showPrepayConfigModal(row) {
  currentPrepayRow.value = row
  prepayConfigForm.value.prePayLimit = row.prePayLimit || null
  prepayConfigVisible.value = true
}

function handlePrepayConfigClose() {
  prepayConfigVisible.value = false
  currentPrepayRow.value = null
  prepayConfigForm.value.prePayLimit = null
}

async function handlePrepayConfigConfirm() {
  try {
    prepayConfigLoading.value = true
    await getFinanceProductPrepay({
      id: currentPrepayRow.value.id,
      prePayLimit: prepayConfigForm.value.prePayLimit
    })
    ElMessage.success('预付款预警配置保存成功')
    prepayConfigVisible.value = false
    currentPrepayRow.value = null
    prepayConfigForm.value.prePayLimit = null
    getList()
  } catch (error) {
    console.error('预付款预警配置保存失败:', error)
    ElMessage.error('预付款预警配置保存失败')
  } finally {
    prepayConfigLoading.value = false
  }
}

onMounted(() => {
  getList()
  registerGrid('financial-products-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('financial-products-grid')
})
</script>

