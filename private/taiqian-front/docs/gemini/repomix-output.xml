      </template>
    </vxe-grid>
  </div>
</template>

<script setup>
import { onMounted, ref, reactive, onUnmounted } from 'vue'
import { ElMessage } from 'element-plus'
import TableSearch from '@/components/TableSearch'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'
import { InfoFilled } from '@element-plus/icons-vue'
import { tenantCostList, tenantCostDel } from '@/api/tenant'
import dayjs from 'dayjs'
const router = useRouter()
const { proxy } = getCurrentInstance()
const { regulatory_type } = proxy.useDict('regulatory_type')
const gridRef = ref()

const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const query = reactive({
  orgName: ''
})

const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}

const searchOpt = ref([
  {
    type: 'input',
    label: '租户名称：',
    placeholder: '请输入',
    prop: 'orgName'
  }
])

const gridOptions = reactive({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true,
    slots: {
      buttons: 'toolbarButtons'
    }
  },
  columns: [
    { type: 'seq', width: 70 },
    { title: '流水号', field: 'feeNo', minWidth: 140 },
    { title: '租户', field: 'orgName', minWidth: 100, showOverflow: true },
    { title: 'SAAS费用', field: 'payAmount', minWidth: 100, formatter: ['formatThousand'] },
    { title: '使用有效期', field: 'startDate', minWidth: 200, showOverflow: true, slots: { default: 'deadlineRender' } },
    { title: '状态', field: 'status', minWidth: 100, align: 'center', slots: { default: 'statusRender' } },

    { title: '操作', field: 'active', minWidth: 140, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
})

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}
async function confirmDel(row) {
  try {
    await tenantCostDel(row.id)
    ElMessage.success('已删除')
    gridOptions.pagerConfig.currentPage = 1
    getList()
  } catch (error) {}
}
async function getList() {
  gridOptions.loading = true
  try {
    const res = await tenantCostList({
      pageNum: gridOptions.pagerConfig.currentPage,
      pageSize: gridOptions.pagerConfig.pageSize,
      ...query
    })

    gridOptions.data = res.rows
    gridOptions.pagerConfig.total = res.total * 1
  } catch (error) {
    console.error('获取列表失败:', error)
    ElMessage.error('获取列表失败')
  } finally {
    gridOptions.loading = false
  }
}

function handleAdd() {
  router.push({ path: 'tenant-cost-add' })
}

const handleEdit = param => {
  proxy.openNewTagsView({
    name: 'tenant-cost-edit'
  })
  router.push({
    path: 'tenant-cost-edit',
    query: { id: param.id || '0' }
  })
}

const handleDetail = param => {
  proxy.openNewTagsView({
    name: 'tenant-cost-detail'
  })
  router.push({
    path: 'tenant-cost-detail',
    query: { id: param.id }
  })
}

onMounted(() => {
  getList()
  registerGrid('tenant-cost-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('tenant-cost-grid')
})
</script>

