<script setup>
import { onMounted, ref, reactive, onUnmounted } from 'vue'
import { ElMessage } from 'element-plus'
import { borrowingEnterpriseCreditList } from '@/api/credit'
import TableSearch from '@/components/TableSearch'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'
import { formatThousand } from '@/utils/index'

const router = useRouter()
const { proxy } = getCurrentInstance()
const { credit_status, approve_status } = proxy.useDict('credit_status', 'approve_status')
const gridRef = ref()

const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const query = reactive({
  orgName: ''
})
const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}

const searchOpt = ref([
  {
    type: 'input',
    label: '企业名称：',
    placeholder: '请输入企业名称',
    prop: 'orgName'
  }
])

const gridOptions = reactive({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true,
    slots: {
      buttons: 'toolbarButtons'
    }
  },
  columns: [
    { type: 'seq', width: 70 },
    { title: '授信编号', field: 'creditNo', minWidth: 260 },
    { title: '企业名称', field: 'orgName', minWidth: 280, showOverflow: true },
    { title: '产品名称', field: 'productName', minWidth: 200 },
    { title: '注册地址', field: 'areaFullName', minWidth: 280, showOverflow: true },
    { title: '授信状态', field: 'creditStatus', minWidth: 120, align: 'center', slots: { default: 'creditStatusRender' } },
    { title: '审批状态', field: 'approveStatus', minWidth: 180, align: 'center', slots: { default: 'approveStatusRender' } },
    { title: '授信期限', field: 'creditStartTime', minWidth: 280, slots: { default: 'creditDateRender' } },
    { title: '授信金额(万元)', field: 'creditLimit', minWidth: 160, slots: { default: 'creditLimitRender' } },
    { title: '创建时间', field: 'createTime', minWidth: 180, align: 'center', slots: { default: 'createTimeRender' } },
    { title: '操作', field: 'active', minWidth: 140, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
})

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

async function getList() {
  gridOptions.loading = true
  try {
    const res = await borrowingEnterpriseCreditList({
      pageNum: gridOptions.pagerConfig.currentPage,
      pageSize: gridOptions.pagerConfig.pageSize,
      ...query
    })

    gridOptions.data = res.rows
    gridOptions.pagerConfig.total = res.total * 1
  } catch (error) {
    console.error('获取列表失败:', error)
    ElMessage.error('获取列表失败')
  } finally {
    gridOptions.loading = false
  }
}

function handleAdd() {
  router.push({ path: 'credit-borrowing-enterprise-add' })
}

function handleDetail(row) {
  proxy.openNewTagsView({
    name: 'Credit-borrowing-enterprise-detail'
  })
  router.push({
    path: 'credit-borrowing-enterprise-detail',
    query: { id: row.id, businessKey: row.creditNo }
  })
}

function handleExport() {
  proxy.download(
    '/api-qianrong/loanOrgCredit/export',
    {
      ...query
    },

    `借款企业授信_${new Date().getTime()}.xlsx`,
    {
      headers: { 'Content-Type': 'application/json' }
    }
  )
}
onMounted(() => {
  getList()
  registerGrid('credit-borrowing-enterprise-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('credit-borrowing-enterprise-grid')
})
</script>

