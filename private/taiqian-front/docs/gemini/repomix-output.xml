<script setup>
import Collapse from '@/components/Collapse'
import { InfoFilled } from '@element-plus/icons-vue'
import AreaCascader from '@/components/AreaCascader'
import { tenantCostEdit, tenantCostAdd, tenantCostDetail, tenantOrgList } from '@/api/tenant'
import { onMounted, watchEffect } from 'vue'
import { ElMessage } from 'element-plus'
import { cloneDeep } from 'lodash-es'
import dayjs from 'dayjs'
import { useRouter } from 'vue-router'
const { push, currentRoute, back, replace } = useRouter()
const { proxy } = getCurrentInstance()
const _props = defineProps({
  pageType: Number
})
const form = ref({
  operatorList: [],
  regulatoryWarehouseOrg: {}
})
const enumData = reactive({
  tenantList: []
})
const formRef = ref()

async function getDetails() {
  try {
    const res = await tenantCostDetail(currentRoute.value.query.id)

    form.value = res.data
    if (form.value.startDate && form.value.endDate) {
      let startDate = dayjs(form.value.startDate).format('YYYY-MM-DD')
      let endDate = dayjs(form.value.endDate).format('YYYY-MM-DD')
      form.value.timeList = [startDate, endDate]
    }
  } catch (error) {
    console.log(error)
  }
}
const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      const submitData = cloneDeep(form.value)
      let orgItem = enumData.tenantList.find(o => o.orgId === submitData.orgId)

      submitData.orgName = orgItem.tenantName
      submitData.startDate = submitData.timeList[0]
      submitData.endDate = submitData.timeList[1]
      if (submitData.fileList && submitData.fileList.length) {
        submitData.fileList.forEach(v => {
          v.fileType = 20
          v.sourceType = 2
        })
      }
      if (_props.pageType === 1) {
        await tenantCostAdd(submitData)
      }

      if (_props.pageType === 2) {
        submitData.id = currentRoute.value.query.id
        await tenantCostEdit(submitData)
      }

      ElMessage.success('操作成功')
      setTimeout(() => {
        proxy.toList({
          path: `tenant-cost`,
          listName: 'tenant-cost'
        })
      }, 300)
    } else {
      console.log('error submit!', fields)
    }
  })
}
async function getEnumData() {
  try {
    const res = await tenantOrgList({})
    enumData.tenantList = res.data || []
  } catch (error) {
    console.log(error)
  }
}
onMounted(async () => {
  getEnumData()

  if (_props.pageType !== 1) {
    getDetails()
  }
})

const rules = reactive({
  orgId: [
    {
      required: true,
      message: '请选择租户',
      trigger: 'change'
    }
  ],

  payDate: [
    {
      required: true,
      message: '请选择缴费日期',
      trigger: 'change'
    }
  ],

  payAmount: [
    {
      required: true,
      message: '请输入缴费金额',
      trigger: 'blur'
    }
  ],

  userCount: [
    {
      required: true,
      message: '请输入用户数量',
      trigger: 'blur'
    }
  ],

  timeList: [
    {
      type: 'array',
      required: true,
      message: '请选择使用期限',
      trigger: 'change'
    }
  ]
})
</script>
