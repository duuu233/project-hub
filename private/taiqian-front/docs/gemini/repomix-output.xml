import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'
import { warehouseInfoList } from '@/api/business'

const router = useRouter()
const { proxy } = getCurrentInstance()
const { regulatory_type } = proxy.useDict('regulatory_type')
const gridRef = ref()

const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const query = reactive({
  warehouseName: ''
})

const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}

const searchOpt = ref([
  {
    type: 'input',
    label: '监管仓名称：',
    placeholder: '请输入',
    prop: 'warehouseName'
  }
])

const gridOptions = reactive({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true,
    slots: {
      buttons: 'toolbarButtons'
    }
  },
  columns: [
    { type: 'seq', width: 70 },
    { title: '客户号', field: 'orgCode', minWidth: 100 },
    { title: '产业项目', field: 'projectName', minWidth: 100 },
    { title: '监管仓库名称', field: 'orgName', minWidth: 100, showOverflow: true },
    { title: '监管仓库名称(德邦)', field: 'depponWarehouseName', minWidth: 140, showOverflow: true },
    { title: '监管仓类型', field: 'regulatoryType', minWidth: 100, slots: { default: 'regulatoryTypeRender' } },
    { title: '地区', field: 'areaFullName', minWidth: 100, showOverflow: true },
    { title: '状态', field: 'status', minWidth: 100, align: 'center', slots: { default: 'statusRender' } },
    { title: '创建时间', field: 'createTime', minWidth: 200, align: 'center', slots: { default: 'createTimeRender' } },
    { title: '操作', field: 'active', minWidth: 140, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
})

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

async function getList() {
  gridOptions.loading = true
  try {
    const res = await warehouseInfoList({
      pageNum: gridOptions.pagerConfig.currentPage,
      pageSize: gridOptions.pagerConfig.pageSize,
      ...query
    })

    gridOptions.data = res.rows
    gridOptions.pagerConfig.total = res.total * 1
  } catch (error) {
    console.error('获取列表失败:', error)
    ElMessage.error('获取列表失败')
  } finally {
    gridOptions.loading = false
  }
}

function handleAdd() {
  router.push({ path: 'business-supervision-warehouse-add' })
}

const handleEdit = param => {
  proxy.openNewTagsView({
    name: 'Business-supervision-warehouse-edit'
  })
  router.push({
    path: 'business-supervision-warehouse-edit',
    query: { id: param.id || '0' }
  })
}

const handleDetail = param => {
  proxy.openNewTagsView({
    name: 'Business-supervision-warehouse-detail'
  })
  router.push({
    path: 'business-supervision-warehouse-detail',
    query: { id: param.id }
  })
}

onMounted(() => {
  getList()
  registerGrid('business-supervision-warehouse-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('business-supervision-warehouse-grid')
})
</script>

