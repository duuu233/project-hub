<script setup>
import Collapse from '@/components/Collapse'
import { cloneDeep } from 'lodash-es'
import { onMounted } from 'vue'
import { capitalOrgSave, bankEdit, capitalOrgDetail } from '@/api/business'
import { ElMessage } from 'element-plus'
import { useRouter } from 'vue-router'
import AreaCascader from '@/components/AreaCascader'
const { currentRoute, back } = useRouter()
const { proxy } = getCurrentInstance()
const { bank_type } = proxy.useDict('bank_type')
const _props = defineProps({
  pageType: Number
})
const form = ref({
  capitalType: 1,
  orgType: 0,
  fundInfo: {}
})
const cascaderRef = ref()
const formRef = ref()

async function getDetails() {
  try {
    const res = await capitalOrgDetail(currentRoute.value.query.id)
    form.value = res.data
    form.value.fundInfo.bankType = form.value.fundInfo.bankType + ''
    form.value.fundInfo.fundType = form.value.fundInfo.fundType * 1
    form.value.cascader = [form.value.provinceCode, form.value.cityCode, form.value.areaCode]
    if (!form.value.areaCode) {
      form.value.cascader.pop()
    }
  } catch (error) {
    console.log(error)
  }
}
const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      const submitData = cloneDeep(form.value)

      if (submitData.cascader && submitData.cascader.length) {
        submitData.areaFullName = cascaderRef.value.getNames().join('-')
        submitData.provinceCode = submitData.cascader[0]
        submitData.cityCode = submitData.cascader[1]
        submitData.areaCode = submitData.cascader[2] || ''
      }

