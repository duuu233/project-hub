      } else if (loginForm.value.loginType === '2') {
        ElMessage.error('当前没有监管方企业')
      } else if (loginForm.value.loginType === '3') {
        ElMessage.error('当前没有银行企业')
      }
    }

    if (orgList.value.length > 0) {
      loginForm.value.orgId = orgList.value[0].id
      await getRoleList()
    }
  } catch (error) {
    orgList.value = []
    ElMessage.error('获取企业列表失败')
  } finally {
    orgLoading.value = false
  }
}

const getRoleList = async () => {
  if (!loginForm.value.orgId || !loginForm.value.username) return

  roleLoading.value = true
  try {
    const res = await loginRoleList({
      orgId: loginForm.value.orgId,
      username: loginForm.value.username
    })
    roleList.value = res.data || []

    if (roleList.value.length === 1) {
      loginForm.value.roleId = roleList.value[0].roleId
    }
  } catch (error) {
    ElMessage.error('获取角色列表失败')
    roleList.value = []
  } finally {
    roleLoading.value = false
  }
}

const handleOrgChange = async () => {
  loginForm.value.roleId = ''
  roleList.value = []
  await getRoleList()
}

async function handleLogin() {
  if (!loginForm.value.username) {
    ElMessage.error('请输入您的手机号')
    hasWatchExecuted.value = false
    return
  }
  if (loginForm.value.username !== 'admin' && !resPhone.test(loginForm.value.username)) {
    ElMessage.error('请输入正确的手机号')
    hasWatchExecuted.value = false
    return
  }
  if (!loginForm.value.password) {
    ElMessage.error('请输入您的密码')
    hasWatchExecuted.value = false
    return
  }

  loading.value = true

  try {
    if (!loginForm.value.orgId) {
      hasWatchExecuted.value = true
      await getOrgList()
      if (!loginForm.value.orgId) {
        loading.value = false
        return
      }
    }

    if (!hasWatchExecuted.value && loginForm.value.orgId && roleList.value.length === 0) {
      await getRoleList()
    }

    if (roleList.value.length > 0 && !loginForm.value.roleId) {
      ElMessage.error('请选择角色')
      loading.value = false
      hasWatchExecuted.value = false
      return
    }

    loginForm.value.passwordByBase64 = encode(loginForm.value.username + '_' + loginForm.value.password)

    await userStore.login(loginForm.value)

    const query = route.query
    const otherQueryParams = Object.keys(query).reduce((acc, cur) => {
      if (cur !== 'redirect') {
        acc[cur] = query[cur]
      }
      return acc
    }, {})

    if (redirect.value) {
      const decodedRedirect = safeDecodeURIComponent(redirect.value)
      router.replace(decodedRedirect)
    } else {
      router.push({ path: '/', query: otherQueryParams })
    }
  } catch (error) {
    loading.value = false
    hasWatchExecuted.value = false
    return
  }
}
</script>

