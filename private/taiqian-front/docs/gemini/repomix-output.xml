import { getLoginSettingList } from '@/api/system/config'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'

const router = useRouter()
const { proxy } = getCurrentInstance()
const baseUrl = '/api-qianrong'
const gridRef = ref()

const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const pageTypeOptions = ref([
  { label: '平台', value: 0 },
  { label: '租户', value: 1 },
  { label: '监管方', value: 2 },
  { label: '银行', value: 3 }
])

const gridOptions = reactive({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true,
    slots: {
      buttons: 'toolbarButtons'
    }
  },
  columns: [
    { type: 'seq', width: 70 },
    { title: '页面类型', field: 'pageType', minWidth: 120, slots: { default: 'pageTypeRender' } },
    { title: '域名', field: 'domain', minWidth: 200, showOverflow: true },
    { title: '大标题', field: 'bigTitle', minWidth: 150, showOverflow: true },
    { title: '小标题', field: 'smallTitle', minWidth: 150, showOverflow: true },
    { title: '背景图', field: 'logo', minWidth: 100, align: 'center', slots: { default: 'logoRender' } },
    { title: '登录框X坐标', field: 'loginPathX', minWidth: 120, align: 'center' },
    { title: '登录框Y坐标', field: 'loginPathY', minWidth: 120, align: 'center' },
    { title: '创建时间', field: 'createTime', minWidth: 180, align: 'center', slots: { default: 'createTimeRender' } },
    { title: '操作', field: 'active', minWidth: 180, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
})

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

async function getList() {
  gridOptions.loading = true
  try {
    const res = await getLoginSettingList({
      pageNum: gridOptions.pagerConfig.currentPage,
      pageSize: gridOptions.pagerConfig.pageSize
    })

    gridOptions.data = res.rows
    gridOptions.pagerConfig.total = +res.total
  } catch (error) {
    console.error('获取列表失败:', error)
    ElMessage.error('获取列表失败')
  } finally {
    gridOptions.loading = false
  }
}

function handleAdd() {
  router.push({ path: '/system/config-login/add' })
}

function handleEdit(row) {
  router.push({
    path: '/system/config-login/edit',
    query: { id: row.id }
  })
}

function handleDetail(row) {
  router.push({
    path: '/system/config-login/detail',
    query: { id: row.id }
  })
}

onMounted(() => {
  getList()
  registerGrid('system-config-login-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('system-config-login-grid')
})
</script>

