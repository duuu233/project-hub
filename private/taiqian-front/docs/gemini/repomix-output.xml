<script setup>
import { parseTime } from '@/utils/ruoyi'
import { getCurrentInstance, ref, onMounted } from 'vue'
import { Download } from '@element-plus/icons-vue'
import { getCouponDetail } from '@/api/coupon'

const { proxy } = getCurrentInstance()
const { registration_status } = proxy.useDict('registration_status')
const statusMap = ref(
    {
    0: '待生效',
    1: '已生效',
    2: '已过期',
    3: '已作废'
  }
  )

const props = defineProps({
  taskData: {
    type: Object,
    default: () => ({})
  }
})

const detailData = ref({})

const getDetail = async () => {
  try {
    const res = await getCouponDetail(props.taskData.businessId)
    if (res.code === 200) {
      detailData.value = res.data
    }
  } catch (error) {
    console.error('获取详情失败:', error)
  }
}

const handleDownload = file => {
  if (!file) return
  const fileUrl = Array.isArray(file) ? file[0].fileUrl : file.fileUrl
  if (fileUrl) {
    window.open(window.location.origin + '/api-qianrong' + fileUrl)
  }
}

function getCouponTypeName(couponType) {
  const couponTypeMap = {
    1: '代金券',
    2: '折扣券'
  }
  return couponTypeMap[couponType] || '-'
}

function getBusinessTypeName(businessType) {
  const businessTypeMap = {
    1: '所有费用',
    2: '技术服务费',
    3: '数据监管费'
  }
  return businessTypeMap[businessType] || '-'
}

function getDistributionMethodName(method) {
  const methodMap = {
    1: '自动发放',
    2: '手动发放'
  }
  return methodMap[method] || '-'
}

function getDistributionTargetName(target) {
  const targetMap = {
    1: '全部客户',
    2: '部分客户'
  }
  return targetMap[target] || '-'
}

function getAssignmentMethodName(method) {
  const methodMap = {
    1: '平均分配',
    2: '指定数量'
  }
  return methodMap[method] || '-'
}
function getSelectedCustomersText() {
  if (!detailData.value.assignmentList || detailData.value.assignmentList.length === 0) {
    return '-'
  }
  if (detailData.value.assignmentList.length <= 3) {
    return detailData.value.assignmentList.map(item => item.customerName).join('、')
  } else {
    return `${detailData.value.assignmentList
      .slice(0, 3)
      .map(item => item.customerName)
      .join('、')} 等${detailData.value.assignmentList.length}个客户`
  }
}

function formatCouponValue(couponData) {
  if (!couponData.value) return '-'

  if (couponData.couponType === 1) {

    return `${couponData.value} 元`
  } else if (couponData.couponType === 2) {

    return `${(couponData.value * 10).toFixed(1)} 折`
  }

  return '-'
}

onMounted(() => {
  if (props.taskData?.businessId) {
    getDetail()
  }
})
</script>

