import { fileURLToPath, URL } from 'node:url'

const source = name => fileURLToPath(new URL('./src/examples/modules-demo/' + name, import.meta.url))

// 此配置仅用于静态验收；正式应用继续使用 vite.config.js。
export default defineConfig({
  define: { __QIANRONG_MODULES_DEMO__: true },
  plugins: [vue(), AutoImport({ imports: ['vue', 'vue-router', 'pinia'], dts: false }), {
    name: 'modules-demo-boundary',
    configureServer(server) {
      server.middlewares.use((req, res, next) => {
        if (!['GET', 'HEAD'].includes(req.method) || /^\/(api-|prod-api|stage-api|system-service)/.test(req.url)) {
          res.statusCode = 403
          res.end('Static preview only')
          return
        }
        next()
      })
    }
  }],
  resolve: {
    alias: [
      { find: /^@\/utils\/request(?:\.js)?$/, replacement: source('request.js') },
      { find: /^@\/store\/modules\/user(?:\.js)?$/, replacement: source('user-store.js') },
      { find: /^@\/utils\/auth(?:\.js)?$/, replacement: source('auth.js') },
      { find: /^@\/api\/system\/dict\/data(?:\.js)?$/, replacement: source('dict-data.js') },
      { find: /^@\/router(?:\/index\.js)?$/, replacement: source('router.js') },
      { find: '@', replacement: fileURLToPath(new URL('./src', import.meta.url)) }
    ],
    extensions: ['.js', '.vue', '.json']
