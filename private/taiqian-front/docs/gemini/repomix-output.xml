<script setup name="Coupon-record/detail">
import { ref, onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import { useRouter, useRoute } from 'vue-router'
import Collapse from '@/components/Collapse'
import { getCouponInstanceDetail } from '@/api/coupon'

const router = useRouter()
const route = useRoute()
const { proxy } = getCurrentInstance()

const detail = ref({})
const loading = ref(false)

async function getDetail() {
  if (!route.query.id) {
    ElMessage.error('缺少优惠券实例ID')
    router.back()
    return
  }

  loading.value = true
  try {
    const res = await getCouponInstanceDetail(route.query.id)
    detail.value = res.data || {}
  } catch (error) {
    console.error('获取优惠券实例详情失败:', error)
    ElMessage.error('获取优惠券实例详情失败')
    router.back()
  } finally {
    loading.value = false
  }
}

function getCouponTypeName(couponType) {
  const couponTypeMap = {
    1: '代金券',
    2: '折扣券'
  }
  return couponTypeMap[couponType] || '-'
}

function getBusinessTypeName(businessType) {
  const businessTypeMap = {
    1: '所有费用',
    2: '技术服务费',
    3: '数据监管费'
  }
  return businessTypeMap[businessType] || '-'
}

function getStatusName(status) {
  const statusMap = {
    0: '待生效',
    1: '待使用',
    2: '已过期',
    3: '已作废',
    4: '已使用'
  }
  return statusMap[status] || '-'
}

function getStatusType(status) {
  const typeMap = {
    0: 'info',
    1: 'warning',
    2: 'warning',
    3: 'danger',
    4: 'success'
  }
  return typeMap[status] || 'info'
}

function formatDate(dateString) {
  if (!dateString) return '-'
  return dateString.split(' ')[0]
}

function formatCouponValue(couponData) {
  if (!couponData.value) return '-'

  if (couponData.couponType === 1) {

    return `${couponData.value} 元`
  } else if (couponData.couponType === 2) {

    return `${(couponData.value * 10).toFixed(1)} 折`
  }

  return '-'
}

function handleBack() {
  setTimeout(() => {
    proxy.toList({
      path: `/coupon/coupon-record`,
      listName: 'Coupon-record'
    })
  }, 300)
}

onMounted(() => {
  getDetail()
})
</script>

