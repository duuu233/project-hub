            />
          </el-form-item>
        </el-col>

        <el-col :span="8">
          <el-form-item label="登录框X坐标" prop="loginPathX" required>
            <el-input-number
              v-model="form.loginPathX"
              :disabled="pageType === 3"
              style="width: 220px"
              placeholder="请输入X坐标"
              :min="0"
              :max="100"
            />
          </el-form-item>
        </el-col>

        <el-col :span="8">
          <el-form-item label="登录框Y坐标" prop="loginPathY" required>
            <el-input-number
              v-model="form.loginPathY"
