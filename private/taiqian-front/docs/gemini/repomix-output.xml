                </div>
              </div>
            </div>
          </div>

          <div class="input-group">
            <div class="input-row full-width">
              <div class="input-field-wrapper">
                <input
                  v-model="loginForm.password"
                  :type="showPassword ? 'text' : 'password'"
                  class="input-field"
                  autocomplete="off"
                  @input="preventSpace($event, 'password')"
                  placeholder="请输入密码"
                />
                <div class="password-toggle" @click="togglePassword">
                  <svg-icon :icon-class="showPassword ? 'eye-open' : 'eye'" class="password-icon" />
                </div>
              </div>
            </div>
          </div>

          <div class="auth-actions">
            <button class="action-button primary-action" :class="{ loading: loading }" @click="handleLogin">
              <span v-if="!loading">登 录</span>
              <span v-else>{{ loadingType === 0 ? '登 录 中...' : '请 求 中...' }}</span>
            </button>

            <div v-if="register" class="secondary-action">
              <router-link class="registration-link" :to="'/register'">立即注册</router-link>
            </div>
          </div>
