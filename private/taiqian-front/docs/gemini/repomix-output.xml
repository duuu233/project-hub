    if (_props.pageType === 1) {
      const res = await listDept()
      deptOptions.value = proxy.handleTree(res.data, 'deptId')
    } else {
      const res = await listDeptExcludeChild(router.currentRoute.value.query.id)
      deptOptions.value = proxy.handleTree(res.data, 'deptId')
    }
  } catch (error) {
    console.log(error)
  }
}
async function getData() {
