          <template #default="scope">
            {{ scope.row.userNameList ? scope.row.userNameList.join(', ') : '' }}
          </template>
        </el-table-column>
        <el-table-column label="操作" align="center" width="280">
          <template #default="scope">
            <el-button link type="primary" @click="handleDeleteLevel(scope.$index)">删除</el-button>
            <el-button link type="primary" @click="handleEditLevel(scope.row, scope.$index)">审核配置</el-button>
            <el-button link type="primary" @click="handleMoveUp(scope.$index)" :disabled="scope.$index === 0">上移</el-button>
            <el-button link type="primary" @click="handleMoveDown(scope.$index)" :disabled="scope.$index === flowList.length - 1">下移</el-button>
          </template>
