const { proxy } = getCurrentInstance()
const { stock_out_type, logistics_code, source_platform_code } = proxy.useDict('stock_out_type', 'logistics_code', 'source_platform_code')

const props = defineProps({
  taskData: {
    type: Object,
    default: () => ({})
  }
})

const stockOutData = ref({})

const getDetail = async () => {
  try {
    if (!props.taskData?.businessId) return

    const res = await stockOutDetail(props.taskData.businessId)
    if (res.code === 200 || res.code === 0) {
      stockOutData.value = res.data || {}

      if (!stockOutData.value.stockOutPlanSenderinfo) stockOutData.value.stockOutPlanSenderinfo = {}
      if (!stockOutData.value.stockOutPlanReceiverinfo) stockOutData.value.stockOutPlanReceiverinfo = {}

      const senderInfo = stockOutData.value.stockOutPlanSenderinfo
      if (senderInfo && !senderInfo.areaFullName && (senderInfo.province || senderInfo.city || senderInfo.area)) {
        const areaIds = [senderInfo.province, senderInfo.city, senderInfo.area].filter(Boolean)
        try {
          senderInfo.areaFullName = (await getAreaFullNameByIds(areaIds)) || '-'
        } catch (error) {
          console.error('获取发货方地区名称失败:', error)
          senderInfo.areaFullName = areaIds.join('-') || '-'
        }
      }

      const receiverInfo = stockOutData.value.stockOutPlanReceiverinfo
      if (receiverInfo && !receiverInfo.areaFullName && (receiverInfo.province || receiverInfo.city || receiverInfo.area)) {
        const areaIds = [receiverInfo.province, receiverInfo.city, receiverInfo.area].filter(Boolean)
        try {
          receiverInfo.areaFullName = (await getAreaFullNameByIds(areaIds)) || '-'
        } catch (error) {
          console.error('获取收货方地区名称失败:', error)
          receiverInfo.areaFullName = areaIds.join('-') || '-'
        }
      }
    }
  } catch (error) {
    console.error('获取出库详情失败:', error)
  }
}

const handleDownload = file => {
  if (!file || !file.fileUrl) return

  window.open(window.location.origin + '/api-qianrong' + file.fileUrl)
}

onMounted(() => {
  if (props.taskData?.businessId) {
    getDetail()
  }
})
</script>

