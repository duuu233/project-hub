const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      try {
        const submitData = cloneDeep(form.value)
        if (submitData.cascader && form.value.cascader.length) {
          submitData.baseOrg.areaFullName = cascaderRef.value.getNames().join('-')
          submitData.baseOrg.provinceCode = submitData.cascader[0]
          submitData.baseOrg.cityCode = submitData.cascader[1]
          submitData.baseOrg.areaCode = submitData.cascader[2] || ''
        }
        if (submitData.marketings && submitData.marketings.length) {
          submitData.marketings.forEach((v, i) => {
            if (v.cascader && v.cascader.length) {
              v.areaFullName = cascaderRefsList.value[i].getNames().join('-')
              v.provinceCode = v.cascader[0]
              v.cityCode = v.cascader[1]
              v.areaCode = v.cascader[2] || ''
            }
          })
        }

        submitData.loanOrg.busLicenseFiles = [
          {
            fileName: '营业执照',
            fileUrl: form.value.loanOrg.busLicenseFiles
          }
        ]
        submitData.loanOrg.legalIdCardFront = [
