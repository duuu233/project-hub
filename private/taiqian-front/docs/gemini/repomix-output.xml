<script setup>
import Collapse from '@/components/Collapse'
import { warehouseInfoDetail } from '@/api/business'
import { regulatoryWarehouseAccessAdd, regulatoryWarehouseAccessDetail, regulatoryWarehouseSelectList } from '@/api/access'
import { onMounted, watchEffect } from 'vue'
import { ElMessage } from 'element-plus'
import { useRouter } from 'vue-router'
import ApprovalTable from '@/components/ApprovalTable'
import dayjs from 'dayjs'
import { cloneDeep } from 'lodash-es'
const { push, currentRoute, back, replace } = useRouter()
const { proxy } = getCurrentInstance()
const _props = defineProps({
  pageType: Number,
  isDynamic: Boolean
})

const { access_status, registration_status } = proxy.useDict('access_status', 'registration_status')
const form = ref({})
const formRef = ref()

const supervisionWarehouseInfo = ref({
  regulatoryWarehouseOrg: {},
  regulatoryAuthoritiesOrg: {}
})
const enumData = reactive({
  supervisoryPartyList: [],
  supervisionWarehouseList: []
})
function getYardCode(data) {
  if (!data) return
  let list = data.split(',')
  if (!list.length) return
  list = list.filter(o => o)
  return list.join(',')
}
async function getDetails() {
  try {
    const res = await regulatoryWarehouseAccessDetail(currentRoute.value.query.id)

    form.value = res.data

    changeSupervisionWarehouse(form.value.regulatoryWarehouseId)
  } catch (error) {
    console.log(error)
  }
}
const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      if (_props.pageType === 1) {
        await regulatoryWarehouseAccessAdd(form.value)
      }
      if (_props.pageType === 2) {
        form.value.id = currentRoute.value.query.id
        await regulatoryWarehouseAccessAdd(form.value)
      }
      ElMessage.success('操作成功')
      setTimeout(() => {
        proxy.toList({
          path: `access-supervision-warehouse`,
          listName: 'Access-supervision-warehouse'
        })
      }, 300)
    } else {
      console.log('error submit!', fields)
    }
  })
}
onMounted(async () => {
  await getEnumData()
  if (_props.pageType !== 1) {
    getDetails()
  }
})

function changeSupervisionWarehouse(v) {
  if (v) getWarehouseInfo(v)
}

async function getEnumData() {
  try {
    const res1 = await regulatoryWarehouseSelectList({ status: 0, pageSize: 500, pageNum: 1 })

    enumData.supervisionWarehouseList = res1.rows || []
  } catch (error) {
    console.log(error)
  }
}

async function getWarehouseInfo(id) {
  try {
    const res = await warehouseInfoDetail(id)
    supervisionWarehouseInfo.value = res.data
    supervisionWarehouseInfo.value.businessLicenseFile = []
    supervisionWarehouseInfo.value.regulatoryAgreementFile = []
    let fileList = res.data.fileList
    if (fileList && fileList.length) {
      fileList.map(v => {
        if (v.fileType === 10) {
          supervisionWarehouseInfo.value.businessLicenseFile = v.fileUrl
        }
        if (v.fileType === 16) {
          supervisionWarehouseInfo.value.regulatoryAgreementFile.push(v)
        }
      })
    }
  } catch (error) {
    console.log(error)
  }
}
const rules = reactive({
  regulatoryWarehouseId: [
    {
      required: true,
      message: '请选择选择监管仓库',
      trigger: 'change'
    }
  ]
})
</script>
