          {{ row.status === 0 ? '草稿' : '已确认' }}
        </el-tag>
      </template>
      <template #active="{ row }">
        <el-button v-hasPermi="['deposit:save']" link type="primary" @click="handleEdit(row)" v-if="row.status === 0">编辑</el-button>
        <el-button v-hasPermi="['deposit:del']" link type="primary" @click="handleDelete(row)" v-if="row.status === 0">删除</el-button>
        <el-button v-hasPermi="['deposit:detail']" link type="primary" @click="handleDetail(row)">详情</el-button>
      </template>
    </vxe-grid>
  </div>
</template>

<script setup>
import { onMounted, ref, reactive, onUnmounted } from 'vue'
import { getDepositList, deleteDraftDeposit } from '@/api/billing'
import TableSearch from '@/components/TableSearch'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'
import { formatThousand } from '@/utils/index'

const router = useRouter()
const { proxy } = getCurrentInstance()
const gridRef = ref()

const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const query = reactive({
  serialNo: '',
  customerName: '',
  productName: ''
})

const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  getList('handleSearch')
}

const searchOpt = ref([
  {
    type: 'input',
    label: '融资企业名称：',
    placeholder: '请输入融资企业名称',
    prop: 'customerName'
  }
])

const gridOptions = reactive({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true,
    slots: {
      buttons: 'toolbarButtons'
    }
  },
  columns: [
    { type: 'seq', width: 70, title: '序号' },
    { title: '流水号', field: 'serialNo', minWidth: 200, showOverflow: true },
    { title: '融资企业名称', field: 'customerName', minWidth: 200, showOverflow: true },
    { title: '金融产品名称', field: 'productName', minWidth: 160, showOverflow: true },
    { title: '预存金额', field: 'depositAmount', minWidth: 120, slots: { default: 'depositAmountRender' } },
    { title: '状态', field: 'status', minWidth: 100, align: 'center', slots: { default: 'statusRender' } },
    { title: '创建时间', field: 'createTime', minWidth: 180, align: 'center', slots: { default: 'createTimeRender' } },
    { title: '操作', field: 'active', minWidth: 180, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
})

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

async function getList(type) {
  gridOptions.loading = true
  try {
    const response = await getDepositList({
      pageNum: gridOptions.pagerConfig.currentPage,
      pageSize: gridOptions.pagerConfig.pageSize,
      ...query
    })

    gridOptions.data = response.rows
    gridOptions.pagerConfig.total = +response.total
  } catch (error) {
    console.error('获取列表失败:', error)
    ElMessage.error('获取列表失败')
  } finally {
    gridOptions.loading = false
  }
}

function handleAdd() {
  router.push({ path: '/billing/prepayment/add' })
}

function handleEdit(row) {
  router.push({
    path: '/billing/prepayment/edit',
    query: { id: row.id }
  })
}

function handleDelete(row) {
  proxy.$modal.confirm('确认删除该预付款存款记录吗？').then(() => {
    deleteDraftDeposit({ id: row.id }).then(() => {
      proxy.$modal.msgSuccess('删除成功')
      getList('handleSearch')
    })
  })
}

const handleDetail = param => {
  router.push({
    path: '/billing/prepayment/detail',
    query: { id: param.id }
  })
}

onMounted(() => {
  getList()
  registerGrid('billing-prepayment-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('billing-prepayment-grid')
})
</script>

