<script setup>
import { ref, reactive, computed, watch } from 'vue'
import { cloneDeep, uniqBy } from 'lodash-es'

import { ElMessage } from 'element-plus'
import { financeRefineryAccountDetail, financeRefineryAccountConfig, productDropDownList, loanOrgDetail, loanOrgEdit } from '@/api/business'
const _props = defineProps({})
const dialogVisible = ref(false)
const form = ref({
  account: [{}]
})
const formRef = ref()
const enumData = reactive({
  productList: []
})
async function getData(id) {
  const res = await loanOrgDetail(id)
  form.value = res.data

  if (res.data.account) {
    form.value.account = [res.data.account]
  } else {
    form.value.account = [{}]
  }
}

async function hanldeDialogVisible(value) {
  await getEnumData()
  dialogVisible.value = value
}

const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      let accountLength = form.value.account.length
      if (accountLength == 0) {
        ElMessage.warning('请至少配置一组银行信息')
        return
      }
      const submitData = cloneDeep(form.value)
      submitData.account = submitData.account[0]
      await loanOrgEdit(submitData)
      ElMessage.success('操作成功')
      setTimeout(() => {
        dialogVisible.value = false
      }, 300)
    } else {
      console.log('error submit!', fields)
    }
  })
}
async function getEnumData() {
  try {
    const res1 = await productDropDownList({ status: 0, pageSize: 500, pageNum: 1 })

    enumData.productList = res1.data || []
  } catch (error) {
    console.log(error)
  }
}
const rules = reactive({})
function confirmDel(index, type) {
  form.value[type].splice(index, 1)
}

defineExpose({ hanldeDialogVisible, getData })
</script>
