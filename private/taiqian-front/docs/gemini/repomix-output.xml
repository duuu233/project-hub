<template>
  <div class="app-container">
    <TableSearch :query="query" :options="searchOpt" :search="handleSearch" />

    <vxe-grid ref="gridRef" v-bind="gridOptions" v-on="gridEvents">
      <template #toolbarButtons>
        <el-button type="primary" icon="Plus" v-hasPermi="['coupon:add']" @click="handleAdd">新增优惠券</el-button>
        <el-button type="" icon="Download" @click="handleExport">导出</el-button>
      </template>
      <template #couponTypeRender="{ row }">
        <el-tag :type="row.couponType === 2 ? 'success' : 'primary'">{{ getCouponTypeName(row.couponType) }}</el-tag>
      </template>
      <template #businessTypeRender="{ row }">
        <span>{{ getBusinessTypeName(row.businessType) }}</span>
      </template>
      <template #valueRender="{ row }">
        <span>{{ formatCouponValue(row) }}</span>
      </template>
      <template #validPeriodRender="{ row }">
        <span>{{ formatDate(row.validStartTime) }} — {{ formatDate(row.validEndTime) }}</span>
      </template>
      <template #distributionMethodRender="{ row }">
        <span>{{ getDistributionMethodName(row.issuanceMethod) }}</span>
      </template>
      <template #statusRender="{ row }">
        <el-tag :type="getStatusType(row.status)">{{ getStatusName(row.status) }}</el-tag>
      </template>
      <template #active="{ row }">
        <el-button link type="primary" v-hasPermi="['coupon:detail']" @click="handleDetail(row)">详情</el-button>
        <el-button v-if="row.status !== 3" link type="primary" v-hasPermi="['coupon:invalidate']" @click="handleEdit(row)">作废</el-button>
      </template>
    </vxe-grid>

    <el-dialog v-model="dialogVisible" title="作废" width="400px">
      <p>作废优惠券后，融资客户将不再享受折扣，请确认是否作废？</p>
      <template #footer>
        <span class="dialog-footer">
          <el-button @click="dialogVisible = false">取消</el-button>
          <el-button type="primary" @click="confirmDisable">作废</el-button>
        </span>
      </template>
    </el-dialog>
  </div>
</template>

<script setup name="Coupon-list">
import { onMounted, ref, reactive, onUnmounted } from 'vue'
import { ElMessage } from 'element-plus'
import TableSearch from '@/components/TableSearch'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'
import { getCouponList, invalidateCoupon } from '@/api/coupon'

const router = useRouter()
const { proxy } = getCurrentInstance()
const gridRef = ref()
const dialogVisible = ref(false)
const currentRow = ref(null)

const couponTypeDict = ref([
  { label: '代金券', value: 1 },
  { label: '折扣券', value: 2 }
])

const businessTypeDict = ref([
  { label: '所有费用', value: 1 },
  { label: '技术服务费', value: 2 },
  { label: '数据监管费', value: 3 }
])

const distributionMethodDict = ref([
  { label: '自动发放', value: 1 },
  { label: '手动发放', value: 2 }
])

const statusDict = ref([
  { label: '未生效', value: 0 },
  { label: '已生效', value: 1 },
  { label: '已过期', value: 2 },
  { label: '已作废', value: 3 }
])

const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const query = reactive({
  couponName: '',
  couponType: '',
  businessType: '',
  productName: '',
  validStartTime: '',
  validEndTime: ''
})

const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}

const searchOpt = ref([
  {
    type: 'input',
    label: '优惠券名称：',
    placeholder: '请输入',
    prop: 'couponName'
  },
  {
    type: 'select',
    label: '优惠券类型：',
    opts: [{ label: '全部', value: '' }, ...couponTypeDict.value],
    placeholder: '请选择',
    prop: 'couponType'
  },
  {
    type: 'select',
    label: '业务类型：',
    opts: [{ label: '全部', value: '' }, ...businessTypeDict.value],
    placeholder: '请选择',
    prop: 'businessType'
  },
  {
    type: 'input',
    label: '金融产品：',
    placeholder: '请输入',
    prop: 'productName'
  },
  {
    type: 'daterange',
    label: '有效期间：',
    searchProps: ['validStartTime', 'validEndTime'],
    format: 'YYYY-MM-DD'

  }
])

const gridOptions = reactive({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true,
    slots: {
      buttons: 'toolbarButtons'
    }
  },
  columns: [
    { type: 'seq', width: 55, title: '序号' },
    { title: '优惠券编号', field: 'couponNo', minWidth: 180, showOverflow: true },
    { title: '优惠券名称', field: 'couponName', minWidth: 180, showOverflow: true },
    { title: '优惠券类型', field: 'couponType', minWidth: 120, align: 'center', slots: { default: 'couponTypeRender' } },
    { title: '金融产品', field: 'productName', minWidth: 150, showOverflow: true },
    { title: '业务类型', field: 'businessType', minWidth: 120, align: 'center', slots: { default: 'businessTypeRender' } },
    { title: '优惠值内容', field: 'value', minWidth: 120, align: 'center', slots: { default: 'valueRender' } },
    { title: '有效期限', field: 'validPeriod', minWidth: 200, slots: { default: 'validPeriodRender' } },
    { title: '发放方式', field: 'issuanceMethod', minWidth: 120, align: 'center', slots: { default: 'distributionMethodRender' } },
    { title: '发放总量(张)', field: 'totalCount', minWidth: 120, align: 'center' },
    { title: '状态', field: 'status', minWidth: 100, align: 'center', slots: { default: 'statusRender' } },
    { title: '操作', field: 'active', minWidth: 150, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
})

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

async function getList() {
  gridOptions.loading = true
  try {
    const res = await getCouponList({
      pageNum: gridOptions.pagerConfig.currentPage,
      pageSize: gridOptions.pagerConfig.pageSize,
      ...query
    })

    gridOptions.data = res.rows || []
    gridOptions.pagerConfig.total = res.total * 1
  } catch (error) {
    console.error('获取列表失败:', error)
    ElMessage.error('获取列表失败')
  } finally {
    gridOptions.loading = false
  }
}

function getCouponTypeName(value) {
  const item = couponTypeDict.value.find(item => item.value === value)
  return item ? item.label : '-'
}

function getBusinessTypeName(value) {
  const item = businessTypeDict.value.find(item => item.value === value)
  return item ? item.label : '-'
}

function getDistributionMethodName(value) {
  const item = distributionMethodDict.value.find(item => item.value === value)
  return item ? item.label : '-'
}

function getStatusName(value) {
  const item = statusDict.value.find(item => item.value === value)
  return item ? item.label : '-'
}

function getStatusType(value) {
  const typeMap = {
    0: 'warning',
    1: 'success',
    2: 'warning',
    3: 'danger'
  }
  return typeMap[value] || 'info'
}

function formatDate(dateString) {
  if (!dateString) return '-'
  return dateString.split(' ')[0]
}

function formatCouponValue(row) {
  if (!row.value) return '-'

  if (row.couponType === 1) {

    return `${row.value} 元`
  } else if (row.couponType === 2) {

    return `${(row.value * 10).toFixed(1)} 折`
  }

  return '-'
}

function handleAdd() {
  router.push('/coupon/coupon-list/create')
}

function handleDetail(row) {
  router.push({
    path: '/coupon/coupon-list/detail',
    query: { id: row.id }
  })
}

function handleEdit(row) {
  currentRow.value = row
  dialogVisible.value = true
}

async function confirmDisable() {
  try {
    await invalidateCoupon(currentRow.value.id)
    ElMessage.success(`优惠券 ${currentRow.value.couponName} 已作废`)
    dialogVisible.value = false
    currentRow.value = null
    getList()
  } catch (error) {
    console.error('作废优惠券失败:', error)
    ElMessage.error('作废优惠券失败')
  }
}

function handleExport() {
  proxy.download(
    '/api-qianrong/coupon/export',
    {
      ...query,
      pageNum: gridOptions.pagerConfig.currentPage,
      pageSize: gridOptions.pagerConfig.pageSize
    },
    `优惠券列表_${new Date().getTime()}.xlsx`,
    {
      headers: { 'Content-Type': 'application/json' }
    }
  )
}

onMounted(() => {
  getList()
  registerGrid('coupon-list-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('coupon-list-grid')
})
</script>

<style lang="scss" scoped>
.app-container {
  background: #fff;
  border-radius: 4px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}

:deep(.vxe-table) {
  border-radius: 4px;
  overflow: hidden;
}

:deep(.el-button--primary.is-plain) {
  border-color: #165dff;
  color: #165dff;

  &:hover {
