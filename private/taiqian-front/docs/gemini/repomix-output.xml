      trigger: 'blur'
    }
  ],
  cascader: [
    {
      required: true,
      type: 'Array',
      message: '请选择注册地区',
      trigger: 'change'
    }
  ],
  'sysOrg.registrationStatus': [
    {
      required: true,
      message: '请选择登记状态',
      trigger: 'change'
    }
  ]
})

async function getEnumData() {
  try {
    const res2 = await industryListApi({ pageSize: 500, pageNum: 1 })
    enumData.industryList = res2.rows || []
  } catch (error) {
    console.log(error)
  }
}
</script>
