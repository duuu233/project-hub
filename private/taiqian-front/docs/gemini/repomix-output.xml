    <div class="auth-footer">
      <span>© 深圳泰乾数字科技有限公司</span>
    </div>
  </div>
</template>

<script setup>
import { ref, watch, onMounted, onBeforeUnmount } from 'vue'
import { useRoute, useRouter } from 'vue-router'
import { encode } from 'js-base64'
import useUserStore from '@/store/modules/user'
import { ElMessage } from 'element-plus'
import { loginOrgList, loginRoleList } from '@/api/login'

const userStore = useUserStore()
const route = useRoute()
const router = useRouter()

const loading = ref(false)
const loadingType = ref(0)
const register = ref(false)
const redirect = ref(undefined)
const showPassword = ref(false)
const orgLoading = ref(false)
const roleLoading = ref(false)
const props = defineProps({
  loginType: {
    type: String,
    default: '0'
  }
})

const loginForm = ref({
  username: '',
  password: '',
  loginType: props.loginType || '0',
  orgId: '',
  roleId: '',
  deptIdList: []
})

const orgList = ref([])
const roleList = ref([])
const hasWatchExecuted = ref(false)

const handleKeyDown = e => {
  if (e.key === 'Enter') {
    handleLogin()
  }
}

onMounted(() => {
  if (!localStorage.getItem('loginType') || !props.loginType) {
    localStorage.setItem('loginType', loginForm.value.loginType || '0')
  }
  document.addEventListener('keydown', handleKeyDown)

  setTimeout(() => {
    if (!hasWatchExecuted.value && loginForm.value.username && loginForm.value.loginType !== '') {
      if (loginForm.value.username === 'admin' || resPhone.test(loginForm.value.username)) {
        getOrgList()
      }
    }
  }, 100)
})

onBeforeUnmount(() => {
  document.removeEventListener('keydown', handleKeyDown)
  clearTimeout(window.getOrgListTimer)
})

const togglePassword = () => {
  showPassword.value = !showPassword.value
}

const preventSpace = (event, field) => {
  loginForm.value[field] = loginForm.value[field].replace(/\s/g, '')
}

const resPhone = /^1[3|4|5|6|7|8|9][0-9]\d{8}$/

watch(
  route,
  newRoute => {
    redirect.value = newRoute.query && newRoute.query.redirect
  },
  { immediate: true }
)

function safeDecodeURIComponent(value) {
  try {
    return decodeURIComponent(value)
  } catch (error) {
    return value
  }
}

watch(
  () => loginForm.value.username,
  newUsername => {
    loginForm.value.orgId = ''
    loginForm.value.roleId = ''
    orgList.value = []
    roleList.value = []

    if (!newUsername) {
      return
    }

    if (newUsername !== 'admin' && !resPhone.test(newUsername)) {
      return
    }

    if (loginForm.value.loginType !== '') {
      hasWatchExecuted.value = true
      getOrgList()
    }
  }
)

watch(
  () => loginForm.value.loginType,
  newLoginType => {
    localStorage.setItem('loginType', newLoginType)

    loginForm.value.orgId = ''
    loginForm.value.roleId = ''
    orgList.value = []
    roleList.value = []

    if (loginForm.value.username && (loginForm.value.username === 'admin' || resPhone.test(loginForm.value.username)) && newLoginType !== '') {
      hasWatchExecuted.value = true
      getOrgList()
    }
  }
)

const getOrgList = async () => {
  if (!loginForm.value.username || loginForm.value.loginType === '') return

  orgLoading.value = true
  try {
    const res = await loginOrgList({
      loginType: loginForm.value.loginType,
      username: loginForm.value.username
    })
    orgList.value = res.data || []

    if (res.data.length === 0) {
      if (loginForm.value.loginType === '0') {
        ElMessage.error('当前没有平台企业')
      } else if (loginForm.value.loginType === '1') {
        ElMessage.error('当前没有租户企业')
      } else if (loginForm.value.loginType === '2') {
        ElMessage.error('当前没有监管方企业')
      } else if (loginForm.value.loginType === '3') {
        ElMessage.error('当前没有银行企业')
      }
    }

    if (orgList.value.length > 0) {
      loginForm.value.orgId = orgList.value[0].id
      await getRoleList()
    }
  } catch (error) {
    orgList.value = []
    ElMessage.error('获取企业列表失败')
  } finally {
    orgLoading.value = false
  }
}

const getRoleList = async () => {
  if (!loginForm.value.orgId || !loginForm.value.username) return

  roleLoading.value = true
  try {
    const res = await loginRoleList({
      orgId: loginForm.value.orgId,
      username: loginForm.value.username
    })
    roleList.value = res.data || []
  } catch (error) {
    ElMessage.error('获取角色列表失败')
    roleList.value = []
  } finally {
    roleLoading.value = false
  }
}

const handleOrgChange = async () => {
  loginForm.value.roleId = ''
  roleList.value = []
  await getRoleList()
}

async function handleLogin() {
  if (!loginForm.value.username) {
    ElMessage.error('请输入您的手机号')
    hasWatchExecuted.value = false
    return
  }
  if (loginForm.value.username !== 'admin' && !resPhone.test(loginForm.value.username)) {
    ElMessage.error('请输入正确的手机号')
    hasWatchExecuted.value = false
    return
  }
  if (loginForm.value.loginType === '') {
    ElMessage.error('请选择企业类型')
    hasWatchExecuted.value = false
    return
  }
  if (!loginForm.value.password) {
    ElMessage.error('请输入您的密码')
    hasWatchExecuted.value = false
    return
  }

  loading.value = true

  try {
    if (!loginForm.value.orgId) {
      hasWatchExecuted.value = true
      await getOrgList()
      if (!loginForm.value.orgId) {
        loading.value = false
        return
      }
    }

    if (!hasWatchExecuted.value && loginForm.value.orgId && roleList.value.length === 0) {
      await getRoleList()
    }

    if (roleList.value.length > 0 && !loginForm.value.roleId) {
      ElMessage.error('请选择角色')
      loading.value = false
      hasWatchExecuted.value = false
      return
    }

    loginForm.value.passwordByBase64 = encode(loginForm.value.username + '_' + loginForm.value.password)

    await userStore.login(loginForm.value)

    const query = route.query
    const otherQueryParams = Object.keys(query).reduce((acc, cur) => {
      if (cur !== 'redirect') {
        acc[cur] = query[cur]
      }
      return acc
    }, {})

    if (redirect.value) {
      const decodedRedirect = safeDecodeURIComponent(redirect.value)
      router.replace(decodedRedirect)
    } else {
      router.push({ path: '/', query: otherQueryParams })
    }
  } catch (error) {
    loading.value = false
    hasWatchExecuted.value = false
    return
  }
}
</script>

