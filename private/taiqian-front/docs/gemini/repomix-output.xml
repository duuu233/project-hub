        return
      }
      let id = currentRoute.value.query.id
      const submitData = cloneDeep(form.value)
      submitData.tenantSysConfig.tenantId = id
      let userAgreementList = submitData.tenantSysConfig.userAgreement
      if (userAgreementList && userAgreementList.length) {
