    name: 'merchants-borrowing-enterprise-edit'
  })
  router.push({
    path: 'merchants-borrowing-enterprise-edit',
    query: { id: param.orgId }
  })
}

const handleDetail = param => {
  proxy.openNewTagsView({
    name: 'merchants-borrowing-enterprise-detail'
  })
  router.push({
    path: 'merchants-borrowing-enterprise-detail',
    query: { id: param.orgId }
  })
}

function handleAccount(param) {
  accountConfigRef.value.hanldeDialogVisible(true)
  accountConfigRef.value.getData(param.id)
}

onMounted(() => {
  getList()
  registerGrid('business-borrowing-enterprise-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('business-borrowing-enterprise-grid')
})
</script>

