<script setup>
import { ref, onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import Collapse from '@/components/Collapse'
import { dockDeliveryDetail, submitApprove } from '@/api/deppon/loanAfter'
import { parseTime } from '@/utils/ruoyi'

const props = defineProps({
  id: {
    type: [String, Number],
    required: true
  },
  pageType: {
    type: String,
    default: ''
  }
})
const operationButtons = [
  { label: '海运', value: '1' },
  { label: '报关', value: '2' },
  { label: '入库', value: '3' },
  { label: '码头直提', value: '4' },
  { label: '堆场提货', value: '5' }
]
const isDetail = ref(props.pageType == 3)
const formRef = ref()
const form = ref({
  loanAfterNo: '',
  postLoanStatus: '',
  createTime: '',
  agentOrder: '',
  financeNo: '',
  postLoanType: '',
  deliveryNo: '',
  deliveryDate: '',
  containerInfo: [],
  vehicleInfo: []
})

onMounted(async () => {
  const { data } = await dockDeliveryDetail({ id: props.id })

  const approveStatusMap = {
    0: '待审批',
    1: '审批通过',
    2: '审批不通过'
  }

  form.value = {
    ...data,
    approveStatusText: approveStatusMap[data.approveStatus] || '-',
    loanAfterTypeText: operationButtons[data.loanAfterType - 1].label,
    agentOrder: data.deliveryOrderNo,
    postLoanType: data.stockOutType,
    deliveryNo: data.deliveryOrderNo,
    deliveryDate: data.stockOutDate,
    containerInfo: data.containers || [],
    vehicleInfo: data.cars || [],
    createTime: parseTime(data.createTime),
    deliveryDate: parseTime(data.stockOutDate)
  }
})

const submitForm = async () => {
  await formRef.value.validate(async valid => {
    if (valid) {
      const params = {
        id: props.id,
        fileList: []
      }
      await submitApprove(params)
      ElMessage.success('提交成功')
      history.back()
    }
  })
}

const cancel = () => {
  history.back()
}
</script>

