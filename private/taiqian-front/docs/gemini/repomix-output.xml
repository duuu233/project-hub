<file path="apps/qianlian/src/assets/styles/index.scss">
@import './variables.module.scss';
@import './mixin.scss';
@import './transition.scss';
@import './element-ui.scss';
@import './sidebar.scss';
@import './btn.scss';
@import './ruoyi.scss';

body {
  height: 100%;
  margin: 0;
  -moz-osx-font-smoothing: grayscale;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  font-family: Helvetica Neue, Helvetica, PingFang SC, Hiragino Sans GB, Microsoft YaHei, Arial, sans-serif;
}

label {
  font-weight: 700;
}

html {
  height: 100%;
  box-sizing: border-box;
}

#app {
  height: 100%;
}

*,
*:before,
*:after {
  box-sizing: inherit;
}

.no-padding {
  padding: 0px !important;
}

.padding-content {
  padding: 4px 0;
}

a:focus,
a:active {
  outline: none;
}

a,
a:focus,
a:hover {
  cursor: pointer;
  color: inherit;
  text-decoration: none;
}

div:focus {
  outline: none;
}

.fr {
  float: right;
}

.fl {
  float: left;
}

.pr-5 {
  padding-right: 5px;
}

.pl-5 {
  padding-left: 5px;
}

.block {
  display: block;
}

.pointer {
  cursor: pointer;
}

.inlineBlock {
  display: block;
}

.clearfix {
  &:after {
    visibility: hidden;
    display: block;
    font-size: 0;
    content: ' ';
    clear: both;
    height: 0;
  }
}

aside {
  background: #eef1f6;
  padding: 8px 24px;
  margin-bottom: 20px;
  border-radius: 2px;
  display: block;
  line-height: 32px;
  font-size: 16px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
    sans-serif;
  color: #2c3e50;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;

  a {
    color: #337ab7;
    cursor: pointer;

    &:hover {
      color: rgb(32, 160, 255);
    }
  }
}

.app-container {

  background-color: #fff;
  min-height: calc(100vh - 136px);

  .handle-box-index {
    text-align: right;
    padding: 20px 20px 0 20px;
    background-color: #fff;
    width: 100%;
  }

  .handle-add-btn-index {
    background-color: #fff;
    min-width: 104px;

    padding: 0 15px;

    height: 36px;
    line-height: 36px;
    color: #165dff;

    border: 1px solid #165dff;
    border-radius: 0px;
    display: inline-flex;

    align-items: center;

    white-space: nowrap;

    span {
      margin-left: 11px;
      line-height: 36px;
      height: 36px;
    }

    .el-icon {
      font-size: 20px;
    }
  }
}

.table-list-index {
  background-color: #fff;
  padding: 20px;

  .el-button+.el-button {
    margin-left: 0;
  }

  .el-table {
    width: 100%;
    font-size: 14px;
    border-radius: 4px;
    border: 1px solid #e9ecef;
    overflow: hidden;

    .el-table__header-wrapper th {
      background-color: #f8f9fa !important;
      font-weight: 500;
      color: #333;
      height: 48px;
      padding: 12px 0;
      border-bottom: 1px solid #e9ecef;
      border-right: 1px solid #e9ecef;
      font-size: 14px;

      &:last-child {
        border-right: none;
      }

      .cell {
        padding: 0 12px;
        display: flex;
        align-items: center;
        height: 100%;
      }
    }

    .el-table__cell {
      padding: 12px 0;

      .cell {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        width: 100%;
        line-height: 1.5;
        position: relative;

        &:hover::after {
          content: attr(title);
          position: absolute;
          left: 0;
          top: 100%;
          background: rgba(0, 0, 0, 0.8);
          color: #fff;
          padding: 5px 10px;
          border-radius: 4px;
          font-size: 12px;
          z-index: 999;
          white-space: normal;
          max-width: 300px;
          word-break: break-all;
        }
      }
    }

    .el-table__body {
      td {
        padding: 12px;
        border-bottom: 1px solid #e9ecef;
        border-right: 1px solid #e9ecef;

        &:last-child {
          border-right: none;
        }

        .cell {
          padding: 0;
        }
      }

      .el-tag {
        border-radius: 4px;
        padding: 4px 8px;

        &--info {
          font-weight: 600;
        }
      }

      .el-button--primary {
        color: #165dff;
        padding: 6px 12px;
        border-radius: 4px;
      }
    }

    tr:hover>td {
      background-color: #f5f7fa !important;
    }
  }

  @media screen and (max-width: 768px) {
    padding: 10px;

    .el-table {
      width: 100%;
      overflow-x: auto;

      &::before {
        content: '';
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 1px;
        background-color: #ebeef5;
      }
    }
  }
}

.el-table {
  .cell[title] {
    position: relative;

    &:hover::after {
      content: attr(title);
      position: absolute;
      left: 0;
      top: 100%;
      background: rgba(0, 0, 0, 0.8);
      color: #fff;
      padding: 5px 10px;
      border-radius: 4px;
      font-size: 12px;
      z-index: 999;
      white-space: pre-wrap;
      max-width: 300px;
      word-break: break-all;
      user-select: text;
      cursor: text;
      pointer-events: auto;
    }
  }
}

@media screen and (max-width: 768px) {
  .el-table {
    .cell[title] {
      &:hover::after {
        max-width: 200px;
        left: 50%;
        transform: translateX(-50%);
        white-space: normal;
      }
    }
  }
}

.el-table {
  .cell {
    -webkit-touch-callout: default;
    -webkit-user-select: text;
  }
}

.el-table {
  .cell {
    &[title] {
      cursor: copy;

      &::before {
        content: attr(title);
        position: absolute;
        left: -9999px;
        height: 1px;
        overflow: hidden;
        user-select: text;
      }
    }
  }
}

.components-container {
  margin: 30px 50px;
  position: relative;
}

.text-center {
  text-align: center;
}

.sub-navbar {
  height: 50px;
  line-height: 50px;
  position: relative;
  width: 100%;
  text-align: right;
  padding-right: 20px;
  transition: 600ms ease position;
  background: linear-gradient(90deg, rgba(32, 182, 249, 1) 0%, rgba(32, 182, 249, 1) 0%, rgba(33, 120, 241, 1) 100%, rgba(33, 120, 241, 1) 100%);

  .subtitle {
    font-size: 20px;
    color: #fff;
  }

  &.draft {
    background: #d0d0d0;
  }

  &.deleted {
    background: #d0d0d0;
  }
}

.link-type,
.link-type:focus {
  color: #337ab7;
  cursor: pointer;

  &:hover {
    color: rgb(32, 160, 255);
  }
}

.filter-container {
  padding-bottom: 10px;

  .filter-item {
    display: inline-block;
    vertical-align: middle;
    margin-bottom: 10px;
  }
}

.el-table__body {
  .el-button--primary {
    color: #165dff;
  }

  .el-tag--success {

  }

  .el-tag--info {
    font-weight: 700;
  }
}

.el-table .el-table__header-wrapper th {
  background-color: #f8f9fa !important;
  border-bottom: 1px solid #e9ecef;
  border-right: 1px solid #e9ecef;

  &:last-child {
    border-right: none;
  }
}

.list-add-btn {
  color: #165dff;
  border: 1px solid #165dff;
  border-radius: 0;

  .el-icon {
    width: 1.4em;
    height: 1.4em;

    svg {
      width: 100%;
      height: 100%;
    }
  }

}

.star {
  &::before {
    display: inline-block;
    margin-right: 4px;
    color: #ff4d4f;
    font-size: 13px;
