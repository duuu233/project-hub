<script setup>
import Collapse from '@/components/Collapse'
import { onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import { useRouter } from 'vue-router'
import { regulatoryAuthoritiesOrgAdd, regulatoryAuthoritiesOrgDetail } from '@/api/business'
import AreaCascader from '@/components/AreaCascader'
import dayjs from 'dayjs'
const { currentRoute, back } = useRouter()
const { proxy } = getCurrentInstance()
const { registration_status } = proxy.useDict('registration_status')
const _props = defineProps({
  pageType: Number
})
const form = ref({})

const formRef = ref()
const cascaderRef = ref()

async function getDetails() {
  try {
    const { data } = await regulatoryAuthoritiesOrgDetail({
      id: currentRoute.value.query.id
    })

    const { regulatoryAuthoritiesOrg, fileList = [], businessManager, businessManagerPhone, contactEmail } = data

    Object.assign(form.value, {
      ...regulatoryAuthoritiesOrg,
      orgName: regulatoryAuthoritiesOrg.orgName,
      orgAbbreviation: regulatoryAuthoritiesOrg.orgSimpleName,
      socialCreditCode: regulatoryAuthoritiesOrg.socialCreditCode,
      registeredAddress: regulatoryAuthoritiesOrg.address,
      registrationStatus: String(regulatoryAuthoritiesOrg.registrationStatus),
      establishDate: regulatoryAuthoritiesOrg.establishmentDate,
      registeredCapital: regulatoryAuthoritiesOrg.registeredCapital,
      businessScope: regulatoryAuthoritiesOrg.businessScope,
      legalName: regulatoryAuthoritiesOrg.legalName,
      legalIdCard: regulatoryAuthoritiesOrg.legalIdNumber,
      legalPhone: regulatoryAuthoritiesOrg.legalPhone,
      controllerName: regulatoryAuthoritiesOrg.actualControllerName,
      controllerIdCard: regulatoryAuthoritiesOrg.actualControllerIdNumber,
      controllerPhone: regulatoryAuthoritiesOrg.actualControllerPhone,
      businessManager,
      businessManagerPhone,
      email: contactEmail,
      cascader: [regulatoryAuthoritiesOrg.provinceCode, regulatoryAuthoritiesOrg.cityCode, regulatoryAuthoritiesOrg.areaCode].filter(Boolean)
    })

    fileList.forEach(file => {
      switch (file.fileType) {
        case 17:
          form.value.orgLogo = file.fileUrl
          break
        case 10:
          form.value.businessLicenseFile = file.fileUrl
          break
        case 16:
          form.value.regulatoryAgreementFileList = [
            {
              fileName: '监管协议文件',
              fileUrl: file.fileUrl
            }
          ]
          break
      }
    })
  } catch (error) {
    ElMessage.error('获取详情失败')
  }
}

const submit = async () => {
  const valid = await formRef.value.validate().catch(() => false)
  if (!valid) return

  const submitData = {
    businessManager: form.value.businessManager,
    businessManagerPhone: form.value.businessManagerPhone,
    contactEmail: form.value.email,
    fileList: [],
    regulatoryAuthoritiesOrg: {
      orgName: form.value.orgName,
      orgSimpleName: form.value.orgAbbreviation,
      socialCreditCode: form.value.socialCreditCode,
      address: form.value.registeredAddress,
      registrationStatus: form.value.registrationStatus,
      establishmentDate: form.value.establishDate,
      registeredCapital: form.value.registeredCapital,
      businessScope: form.value.businessScope,
      legalName: form.value.legalName,
      legalIdNumber: form.value.legalIdCard,
      legalPhone: form.value.legalPhone,
      actualControllerName: form.value.controllerName,
      actualControllerIdNumber: form.value.controllerIdCard,
      actualControllerPhone: form.value.controllerPhone
    }
  }

  if (form.value.cascader?.length) {
    const [provinceCode, cityCode, areaCode] = form.value.cascader
    Object.assign(submitData.regulatoryAuthoritiesOrg, {
      areaFullName: cascaderRef.value.getNames().join('-'),
      provinceCode,
      cityCode,
      areaCode: areaCode || ''
    })
  }

  const fileMapping = [
    { key: 'orgLogo', type: 17, name: '监管方LOGO' },
    { key: 'businessLicenseFile', type: 10, name: '营业执照' },
    {
      key: 'regulatoryAgreementFileList',
      type: 16,
      name: '监管协议',
      getUrl: list => list?.[0]?.fileUrl
    }
  ]

  fileMapping.forEach(({ key, type, name, getUrl }) => {
    const value = form.value[key]
    const url = getUrl ? getUrl(value) : value
    if (url) {
      submitData.fileList.push({
        fileName: name,
        fileUrl: url,
        fileType: type,
        fileSuffix: '',
        sourceType: 0
      })
    }
  })

  if (_props.pageType === 2) {
    submitData.regulatoryAuthoritiesOrg.id = currentRoute.value.query.id
  }

  try {
    await regulatoryAuthoritiesOrgAdd(submitData)
    ElMessage.success('操作成功')
    setTimeout(() => {
      proxy.toList({
        path: 'business-supervisory-party',
        listName: 'Business-supervisory-party'
      })
    }, 300)
  } catch (error) {
    ElMessage.error('提交失败')
  }
}

onMounted(async () => {
  if (_props.pageType !== 1) {
    getDetails()
  }
})

const reg = /^(?:[\u4e00-\u9fa5·]{2,16})$/
const validateContacts = (rule, value, callback) => {
  setTimeout(() => {
    if (!value) {
      callback(new Error('请输入联系人'))
    } else if (value && !reg.test(value)) {
      callback(new Error('请输入正确的名称'))
    } else {
      callback()
    }
  }, 500)
}
const reg1 = /^(?:(?:\+|00)86)?1\d{10}$/
const validatePhone = (rule, value, callback) => {
  setTimeout(() => {
    if (!value) {
      callback(new Error('请输入联系方式'))
    } else if (value && !reg1.test(value)) {
      callback(new Error('请输入正确的手机号'))
    } else {
      callback()
    }
  }, 500)
}
const reg2 =
  /^\d{6}((((((19|20)\d{2})(0[13-9]|1[012])(0[1-9]|[12]\d|30))|(((19|20)\d{2})(0[13578]|1[02])31)|((19|20)\d{2})02(0[1-9]|1\d|2[0-8])|((((19|20)([13579][26]|[2468][048]|0[48]))|(2000))0229))\d{3})|((((\d{2})(0[13-9]|1[012])(0[1-9]|[12]\d|30))|((\d{2})(0[13578]|1[02])31)|((\d{2})02(0[1-9]|1\d|2[0-8]))|(([13579][26]|[2468][048]|0[048])0229))\d{2}))(\d|X|x)$/
const validateIdCard = (rule, value, callback) => {
  setTimeout(() => {
    if (!value) {
      callback(new Error('请输入身份证号'))
    } else if (value && !reg2.test(value)) {
      callback(new Error('请输入有效的身份证号'))
    } else {
      callback()
    }
  }, 500)
}
const rules = reactive({
  orgName: [
    {
      required: true,
      message: '请输入监管方名称',
      trigger: 'blur'
    }
  ],
  socialCreditCode: [
    {
      required: true,
      message: '请输入统一社会信用代码',
      trigger: 'blur'
    }
  ],
  cascader: [
    {
      required: true,
      type: 'Array',
      message: '请选择注册地区',
      trigger: 'change'
    }
  ],
  registrationStatus: [
    {
      required: true,
      message: '请选择登记状态',
      trigger: 'change'
    }
  ]
})
</script>
