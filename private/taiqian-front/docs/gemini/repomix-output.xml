<script setup>
import { parseTime } from '@/utils/ruoyi'
import { ref, onMounted, watch, getCurrentInstance } from 'vue'
import { Download, ArrowDown, ArrowUp } from '@element-plus/icons-vue'
import { financeDetail } from '@/api/finance'
import { getPurchaseOrderDetail } from '@/api/contract'
import { multiplyWithPrecision } from '@/utils/index'
const { proxy } = getCurrentInstance()
const { order_status, finance_status } = proxy.useDict('order_status', 'finance_status')
const props = defineProps({
  taskData: {
    type: Object,
    default: () => ({})
  }
})

const formatCurrency = value => {
  const num = parseFloat(value)
  if (isNaN(num)) return '0.00'
  return num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
}

const getApplicantTypeName = type => {
  return type === 1 ? '法人' : type === 2 ? '实际控制人' : ''
}

const emit = defineEmits(['update'])

const financeData = ref({})
const orderData = ref({})
const orderExpanded = ref(false)

const formData = ref({
  sysSuggestAmount: ''
})
const formErrors = ref({
  sysSuggestAmount: ''
})

const toggleOrderDetails = () => {
  orderExpanded.value = !orderExpanded.value
}

const validateAndUpdate = () => {

  Object.keys(formErrors.value).forEach(key => {
    formErrors.value[key] = ''
  })

  let isValid = true

  if (formData.value.sysSuggestAmount === '' || formData.value.sysSuggestAmount === null || formData.value.sysSuggestAmount === undefined) {
    formErrors.value.sysSuggestAmount = '请输入平台推荐金额'
    isValid = false
  } else if (formData.value.sysSuggestAmount <= 0) {
    formErrors.value.sysSuggestAmount = '平台推荐金额必须大于0'
    isValid = false
  } else if (formData.value.sysSuggestAmount > financeData.value.applyAmount) {
    formErrors.value.sysSuggestAmount = '平台推荐金额不能大于申请推荐金额'
    isValid = false
  }

  emit('update', {
    sysSuggestAmount: formData.value.sysSuggestAmount,
    isValid: isValid
  })
}

const getOrderDetail = async businessId => {
  try {
    if (!businessId) return

    const res = await getPurchaseOrderDetail(businessId)
    if (res.code === 200 || res.code === 0) {
      orderData.value = res.data || {}

      if (orderData.value.financeId) {
        getFinanceDetail(orderData.value.financeId)
      }
    }
  } catch (error) {
    console.error('获取合同详情失败:', error)
  }
}

const getFinanceDetail = async financeId => {
  try {
    if (!financeId) return

    const res = await financeDetail(financeId)
    if (res.code === 200 || res.code === 0) {
      financeData.value = res.data || {}
      formData.value.sysSuggestAmount = res.data.applyAmount || ''
      validateAndUpdate()
    }
  } catch (error) {
    console.error('获取融资详情失败:', error)
  }
}

const handleDownload = file => {
  if (!file || !file.fileUrl) return

  window.open(window.location.origin + '/api-qianrong' + file.fileUrl)
}

watch(
  () => props.taskData?.businessId,
  newVal => {
    if (newVal) {
      getOrderDetail(newVal)
    }
  }
)

watch(
  formData,
  () => {
    validateAndUpdate()
  },
  { deep: true }
)

onMounted(() => {
  if (props.taskData?.businessId) {
    getOrderDetail(props.taskData.businessId)
  }
})
</script>

