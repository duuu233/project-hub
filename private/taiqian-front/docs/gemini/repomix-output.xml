    type: String,
    default: '0'
  }
})

const pageConfig = ref({
  bigTitle: '',
  smallTitle: '',
  logo: '',
  pageType: '0',
  loginPathX: 0,
  loginPathY: 0
})

const loginForm = ref({
  username: '',
  password: '',
  loginType: props.loginType,
  orgId: '',
  roleId: '',
  deptIdList: []
})

const orgList = ref([])
const roleList = ref([])
const hasWatchExecuted = ref(false)

const wrapperStyle = computed(() => {
  const baseUrl = '/api-qianrong'
  const style = {}

  if (pageConfig.value.logo) {
    style.backgroundImage = `url(${baseUrl}${pageConfig.value.logo})`
  } else {
    style.backgroundImage = "url('@/assets/images/login-bg.png')"
  }

  return style
})

const containerStyle = computed(() => {
