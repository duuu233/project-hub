<script setup>
import Collapse from '@/components/Collapse'

import { borrowingEnterpriseAccessApply, borrowingEnterpriseAccessDetail, selectLoanOrgs, getProductDetail } from '@/api/access'
import {
  loanOrgDetail,
  loanOrgList as loanOrgListApi,
  productDropDownList,
  getLoanOrgAccessConfig as getLoanOrgAccessConfigApi
} from '@/api/business'

import { onMounted, watchEffect } from 'vue'
import { ElMessage } from 'element-plus'
import { useRouter } from 'vue-router'
import ApprovalTable from '@/components/ApprovalTable'
import dayjs from 'dayjs'
const { push, currentRoute, back, replace } = useRouter()
const { proxy } = getCurrentInstance()
const { access_status } = proxy.useDict('access_status')
const { user_source } = proxy.useDict('user_source')
const _props = defineProps({
  pageType: Number,
  isDynamic: Boolean
})
const form = ref({})
const loanOrgAccessConfig = ref()
const productInfo = ref()
const orgInfo = ref()
const formRef = ref()
const enumData = reactive({
  loanOrgList: [],
  productDropDownList: [],
  applicantList: []
})
async function getLoanOrgAccessConfig() {
  try {
    const res = await getLoanOrgAccessConfigApi(currentRoute.value.query.orgId)
    loanOrgAccessConfig.value = res.data
  } catch (error) {
    console.log(error)
  }
}
async function getDetails() {
  try {
    const res = await borrowingEnterpriseAccessDetail(currentRoute.value.query.id)
    form.value = res.data
    await getOrgInfo(res.data.loanOrgId)
    await getProductInfo(res.data.productId)
  } catch (error) {
    console.log(error)
  }
}
const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      form.value.orgName = orgInfo.value.baseOrg.orgName
      form.value.orgId = orgInfo.value.baseOrg.id
      form.value.productName = enumData.productDropDownList.find(o => o.id === form.value.productId).productName

      form.value.socialCreditNumber = orgInfo?.value.baseOrg.socialCreditCode
      form.value.accessStatus = 0
      if (_props.pageType === 1) {
        await borrowingEnterpriseAccessApply(form.value)
      }
      if (_props.pageType === 2) {
        form.value.id = currentRoute.value.query.id
        await borrowingEnterpriseAccessApply(form.value)
      }
      ElMessage.success('操作成功')
      setTimeout(() => {
        proxy.toList({
          path: `access-borrowing-enterprise`,
          listName: 'Access-borrowing-enterprise'
        })
      }, 300)
    } else {
      console.log('error submit!', fields)
    }
  })
}
onMounted(async () => {
  await getEnumData()

  if (_props.pageType !== 1) {
    getDetails()
    getLoanOrgAccessConfig()
  }
})
function changeOrg(id) {
  if (id) getOrgInfo(id)
}
async function getEnumData() {
  try {
    const res = await selectLoanOrgs({ pageSize: 500, pageNum: 1 })

    enumData.loanOrgList = res.data || []

    const res1 = await productDropDownList({ status: 0, pageSize: 500, pageNum: 1 })

    enumData.productDropDownList = res1.data || []
  } catch (error) {
    console.log(error)
  }
}

async function getOrgInfo(id) {
  try {
    const res = await loanOrgDetail(id)

    orgInfo.value = res.data

    enumData.applicantList = []

    form.value.loanOrgName = res.data.baseOrg.orgName || ''

    enumData.applicantList = [
      {
        applicantType: 1,
        applicantTypeName: '法人',
        applicantName: res.data?.baseOrg.legalName,
        applicantCertifyNo: res.data?.baseOrg.legalIdNumber,
        applicantPhone: res.data?.baseOrg.legalPhone,
        id: 0
      },
      {
        applicantType: 2,
        applicantTypeName: '实际控制人',
        applicantName: res.data?.baseOrg.actualControllerName,
        applicantCertifyNo: res.data?.baseOrg.actualControllerIdNumber,
        applicantPhone: res.data?.baseOrg.actualControllerPhone,
        id: 1
      }
    ]
    enumData.applicantList.map(v => {
      if (v.applicantName === form.value.applicantName) {
        form.value.applicantId = v.id
        form.value.applicantTypeName = v.applicantTypeName
      }
    })
  } catch (error) {
    console.log(error)
  }
}
async function getProductInfo(id) {
  try {
    const res = await getProductDetail(id)

    productInfo.value = res.data

    form.value.productName = res.data.productName
    form.value.productId = res.data.id
  } catch (error) {
    console.log(error)
  }
}
function changeProduct(id) {
  if (id) getProductInfo(id)
}
function changeApplicantId(index) {
  form.value = {
    ...form.value,
    ...enumData.applicantList[index]
  }
}
const rules = reactive({
  loanOrgId: [
    {
      required: true,
      message: '请选择借款企业',
      trigger: 'change'
    }
  ],
  productId: [
    {
      required: true,
      message: '请选择金融产品',
      trigger: 'change'
    }
  ],
  applicantId: [
    {
      required: true,
      message: '请选择申请人',
      trigger: 'change'
    }
  ]
})
</script>
