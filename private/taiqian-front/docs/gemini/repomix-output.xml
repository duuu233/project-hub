<file path="apps/qianrong/src/assets/styles/btn.scss">
@import './variables.module.scss';

@mixin colorBtn($color) {
  background: $color;

  &:hover {
    color: $color;

    &:before,
    &:after {
      background: $color;
    }
  }
}

.blue-btn {
  @include colorBtn($blue)
}

.light-blue-btn {
  @include colorBtn($light-blue)
}

.red-btn {
  @include colorBtn($red)
}

.pink-btn {
  @include colorBtn($pink)
}

.green-btn {
  @include colorBtn($green)
}

.tiffany-btn {
  @include colorBtn($tiffany)
}

.yellow-btn {
  @include colorBtn($yellow)
}

.pan-btn {
  font-size: 14px;
  color: #fff;
  padding: 14px 36px;
  border-radius: 8px;
  border: none;
  outline: none;
  transition: 600ms ease all;
  position: relative;
  display: inline-block;

  &:hover {
    background: #fff;

    &:before,
    &:after {
      width: 100%;
      transition: 600ms ease all;
    }
  }

  &:before,
  &:after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    height: 2px;
    width: 0;
    transition: 400ms ease all;
  }

  &::after {
    right: inherit;
    top: inherit;
    left: 0;
    bottom: 0;
  }
}

.custom-button {
  display: inline-block;
  line-height: 1;
  white-space: nowrap;
  cursor: pointer;
  background: #fff;
  color: #fff;
  -webkit-appearance: none;
  text-align: center;
  box-sizing: border-box;
  outline: 0;
  margin: 0;
  padding: 10px 15px;
  font-size: 14px;
  border-radius: 4px;
}
</file>

<file path="apps/qianrong/src/assets/styles/design-tokens.scss">
@font-face {
  font-family: 'Qianrong Sans';
  src: url('/fonts/QianrongSans-subset.woff2') format('woff2');
  font-weight: 250 900;
  font-style: normal;
  font-display: swap;
}

// 列表与详情共用令牌，修改规范时从此处开始。

:root {
  --qr-text-title: #0b1f35;
  --qr-text-body: #29415c;
  --qr-text-muted: rgba(41, 65, 92, 0.6);
  --qr-text-placeholder: #9baabd;
  --qr-text-invert: #ffffff;

  --qr-color-brand: #1771dc;
  --qr-color-brand-strong: #075fdc;
  --qr-color-brand-light: #147cf7;
  --qr-color-brand-surface: #edf5ff;
  --qr-color-success: #0eb879;
  --qr-color-warning: #f29a2e;
  --qr-color-danger: #e84b58;
  --qr-color-info: #16b8c9;
  --qr-color-purple: #7b6bf4;

  --qr-gradient-brand: linear-gradient(135deg, #147cf7 0%, #075fdc 100%);
  --qr-gradient-success: linear-gradient(135deg, #45bb37 0%, #2fa923 100%);
  --qr-gradient-icon: linear-gradient(135deg, #1a84f4 0%, #0866df 100%);
  --qr-surface-workspace: #f8fbff;
  --qr-gradient-workspace: linear-gradient(180deg, var(--qr-surface-workspace) 0%, #edf3fa 100%);

  --qr-surface: #ffffff;
  --qr-surface-soft: #fbfdff;
  --qr-surface-tint: #f3f6fa;
  --qr-surface-page: #f6f9fd;
  --qr-surface-panel: rgba(255, 255, 255, 0.97);
  --qr-surface-bar: rgba(255, 255, 255, 0.96);
  --qr-surface-header: rgba(255, 255, 255, 0.88);
  --qr-surface-table-head: #f5f8fc;
  --qr-surface-row-odd: #fafbfe;

  --qr-border: #d8e4ef;
  --qr-border-light: #dfe9f4;
  --qr-border-card: #dce7f3;
  --qr-border-panel: #e2ebf5;
  --qr-border-strong: #cad9ea;
  --qr-border-row: #e7eef6;
  --qr-border-section: #e5edf5;

  --qr-shadow-card: 0 3px 3px rgba(16, 51, 91, 0.035);
  --qr-shadow-btn: 0 2px 6px rgba(10, 49, 91, 0.02);
  --qr-shadow-brand: 0 5px 12px rgba(15, 105, 229, 0.14);
  --qr-shadow-success: 0 4px 11px rgba(54, 172, 43, 0.12);
  --qr-shadow-bar: 0 -5px 16px rgba(21, 61, 105, 0.04);
  --qr-shadow-drawer: -9px 0 24px rgba(34, 67, 105, 0.09);
  --qr-shadow-sticky-col: -3px 0 18.8px rgba(16, 51, 91, 0.25);

  --qr-radius-card: 16px;
  --qr-radius-tab: 14px;
  --qr-radius-section: 14px;
  --qr-radius-aside: 13px;
  --qr-radius-table: 10px;
  --qr-radius-control: 9px;
  --qr-radius-sm: 8px;
  --qr-radius-badge: 7px;
  --qr-radius-check: 2px;

  --qr-size-control: 40px;
  --qr-size-btn: 38px;
  --qr-size-btn-sm: 33px;
  --qr-size-btn-icon: 30px;
  --qr-size-badge: 25px;
  --qr-size-tab-bar: 45px;
  --qr-size-section-title: 54px;
  --qr-size-table-head: 42px;
  --qr-size-table-row: 60px;
  --qr-size-pager: 60px;
  --qr-size-footer-bar: 66px;
  --qr-size-aside: 310px;
  --qr-size-ai-drawer: 390px;

  --qr-layout-navbar: 76px;
  --qr-layout-tags-view: 46px;
  --qr-layout-content-max: 3360px;

  --qr-font-sans: 'Qianrong Sans', 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif;

  --qr-font-page-title: 700 26px/30px var(--qr-font-sans);
  --qr-font-detail-title: 400 25px/29px var(--qr-font-sans);
  --qr-font-section: 500 16px/24px var(--qr-font-sans);
  --qr-font-tab: 500 14px/21px var(--qr-font-sans);
  --qr-font-value: 500 14px var(--qr-font-sans);
  --qr-font-label: 500 13px/20px var(--qr-font-sans);
  --qr-font-table: 400 13px/19.5px var(--qr-font-sans);
  --qr-font-emphasis: 700 12px/18px var(--qr-font-sans);
  --qr-font-caption: 400 12px/18px var(--qr-font-sans);
  --qr-font-time: 400 11px/17px var(--qr-font-sans);

  --qr-stepper-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='24' viewBox='0 0 16 24' fill='none'><path d='M5 8L8 5L11 8M5 16L8 19L11 16' stroke='%23000' stroke-width='1.1' stroke-linecap='round' stroke-linejoin='round'/></svg>");

  --qr-tag-blue-bg: #edf5ff;
  --qr-tag-blue-text: #1771dc;
  --qr-tag-cyan-bg: rgba(11, 156, 169, 0.1);
  --qr-tag-cyan-text: #0b9ca9;
  --qr-tag-green-bg: rgba(10, 155, 98, 0.1);
  --qr-tag-green-text: #0a9b62;
  --qr-tag-orange-bg: rgba(237, 139, 24, 0.1);
  --qr-tag-orange-text: #ed8b18;
  --qr-tag-red-bg: rgba(227, 72, 85, 0.1);
  --qr-tag-red-text: #e34855;
  --qr-tag-gray-bg: #f3f6f9;
  --qr-tag-gray-text: #29415c;

  --qr-notice-bg: linear-gradient(90deg, #fff6e9 0%, #fffaf3 100%);
  --qr-notice-border: #f7d5a5;
  --qr-notice-text: #c96f0d;
}

:root {
  --el-color-primary: #1771dc;
  --el-color-primary-light-3: #5d9ce7;
  --el-color-primary-light-5: #8bb8ee;
  --el-color-primary-light-7: #b9d4f5;
  --el-color-primary-light-8: #d1e3f8;
  --el-color-primary-light-9: #e8f1fc;
  --el-color-primary-dark-2: #125ab0;

  --el-color-success: var(--qr-color-success);
  --el-color-warning: var(--qr-color-warning);
  --el-color-danger: var(--qr-color-danger);
  --el-color-error: var(--qr-color-danger);
  --el-color-info: #6b7d92;

  --el-text-color-primary: var(--qr-text-title);
  --el-text-color-regular: var(--qr-text-body);
  --el-text-color-secondary: var(--qr-text-muted);
  --el-text-color-placeholder: var(--qr-text-placeholder);

  --el-border-color: var(--qr-border);
  --el-border-color-light: var(--qr-border-light);
  --el-border-color-lighter: var(--qr-border-card);
  --el-fill-color-light: var(--qr-surface-tint);
  --el-disabled-bg-color: var(--qr-surface-tint);
  --el-disabled-border-color: var(--qr-border);
  --el-fill-color-blank: var(--qr-surface);

  --el-border-radius-base: var(--qr-radius-control);
  --el-border-radius-small: var(--qr-radius-sm);
  --el-font-size-base: 13px;
  --el-font-family: var(--qr-font-sans);
}

:root {
  --qr-font: var(--qr-font-sans);
  --qr-brand: var(--qr-color-brand);
  --qr-text: var(--qr-text-body);
  --qr-title: var(--qr-text-title);
  --qr-muted: var(--qr-text-muted);
  --qr-card-border: var(--qr-border-panel);
  --qr-row-border: var(--qr-border-row);
  --qr-card-radius: var(--qr-radius-card);
  --qr-card-gap: 12px;
  --qr-content-max: var(--qr-layout-content-max);
  --qr-layout-sidebar: 0px;
}
</file>

<file path="apps/qianrong/src/assets/styles/detail-page.scss">
// 页面根节点接入 qr-detail-page，所有取值由共用令牌维护。

$qr-form-four-columns: 2344px;
$qr-form-two-columns: 940px;
$qr-form-one-column: 620px;

@mixin qr-one-cell-width($label) {
  container-type: inline-size;

  > .el-form-item__content {
    flex: 0 1 calc((100cqw + 20px) / 3 - 20px - #{$label});
    max-width: calc((100cqw + 20px) / 3 - 20px - #{$label});
  }

  @container (min-width: #{$qr-form-four-columns}) {
    > .el-form-item__content {
      flex-basis: calc((100cqw + 20px) / 4 - 20px - #{$label});
      max-width: calc((100cqw + 20px) / 4 - 20px - #{$label});
    }
  }

  @container (max-width: #{$qr-form-two-columns - 1px}) {
    > .el-form-item__content {
      flex-basis: calc((100cqw + 20px) / 2 - 20px - #{$label});
      max-width: calc((100cqw + 20px) / 2 - 20px - #{$label});
    }
  }

  @container (max-width: #{$qr-form-one-column - 1px}) {
    > .el-form-item__content {
      flex-basis: calc(100cqw - #{$label});
      max-width: calc(100cqw - #{$label});
    }
  }

  > .el-form-item__content > :is(.el-input, .el-select, .el-date-editor, .el-input-number, .el-cascader, .el-textarea):only-child {
    width: 100% !important;
  }
}

.qr-detail-page.qr-detail-page {
  --el-component-size: var(--qr-size-control);
  --el-component-size-small: 32px;
  --el-component-size-large: var(--qr-size-control);
  --el-border-radius-base: var(--qr-radius-control);

  background: transparent;
  font: var(--qr-font-table);
  color: var(--qr-text-body);

  .flex-main {
    scrollbar-width: none;
    -ms-overflow-style: none;

    &::-webkit-scrollbar {
      width: 0;
      height: 0;
    }
  }

  .tab-box {
    padding: 12px 0;
    background: transparent;
  }

  .el-affix--fixed .tab-box {
    background: rgba(248, 251, 255, 0.92);
    backdrop-filter: blur(8px);
  }

  .tab-box .el-segmented {
    --el-segmented-bg-color: var(--qr-surface);
    --el-segmented-padding: 0;
    --el-segmented-color: #4c6279;
    --el-segmented-item-selected-color: #0c70df;
    --el-segmented-item-hover-color: #0c70df;
    --el-segmented-item-hover-bg-color: transparent;
    --el-segmented-item-active-bg-color: transparent;

    width: 100%;
    min-height: var(--qr-size-tab-bar);
    padding: 0 8px;
    border: 1px solid #e1eaf4;
    border-radius: var(--qr-radius-tab);
    box-shadow: var(--qr-shadow-card);
    font: var(--qr-font-tab);
  }

  .tab-box .el-segmented__item-selected {
    top: auto;
    bottom: 0;
    height: 3px !important;
    border-left: 12px solid transparent;
    border-right: 12px solid transparent;
    border-radius: 4px;
    background: linear-gradient(90deg, #0d6fe5 0%, #2c8eff 100%);
    background-clip: content-box;
    box-shadow: none;
  }

  .tab-box .el-segmented__item {
    flex: 0 0 auto;
    padding: 0 17px;
    border-radius: 0;
  }

  .collapse-box {
    margin: 0 0 12px;
    padding: 0;
    background: var(--qr-surface);
    border: 1px solid var(--qr-border-light);
    border-radius: var(--qr-radius-section);
    box-shadow: var(--qr-shadow-card);
  }

  .collapse-title-box {
    height: var(--qr-size-section-title);
    padding: 0 16px;
    border-bottom: 1px solid var(--qr-border-section);

    .trapezoid {
      width: 3px;
      height: 18px;
      border-radius: 4px;
      transform: none;
      background: linear-gradient(180deg, #1284f6 0%, #0d64d8 100%);
      box-shadow: 0 0 10px rgba(24, 121, 231, 0.28);
    }

    .collapse-title {
      margin-left: 10px;
      font: var(--qr-font-section);
      color: var(--qr-text-body);
    }
  }

  .collapse-sub-box {
    padding: 0;
    background: transparent;
  }

  .collapse-sub-title-box {
    height: 44px;
    padding: 0 2px;
    border-bottom: none;

    .trapezoid {
      width: 3px;
      height: 13px;
      border-radius: 4px;
      transform: none;
      background: #197fe9;
      box-shadow: none;
    }

    .collapse-title {
      margin-left: 8px;
      font: var(--qr-font-tab);
      font-weight: 400;
      color: var(--qr-text-body);
    }
  }

  .collapse-content-box {
    padding: 18px;
  }

  .collapse-sub-box .collapse-content-box {
    padding: 8px 0 0;
  }

  .qr-section-note {
    margin-left: 10px;
    font: var(--qr-font-caption);
    color: var(--qr-text-muted);
  }

  .el-form-item {
    margin-bottom: 18px;
  }

  .el-form-item__label {
    height: var(--qr-size-control);
    align-items: center;
    font: var(--qr-font-label);
    line-height: 18px;
    white-space: normal;
    text-align: right;
    color: var(--qr-text-body);
  }

  .el-form-item__content {
    line-height: var(--qr-size-control);
  }

  .el-form-item__label-wrap > .el-form-item__label {
    white-space: nowrap;
  }

  .el-form-item--label-top .el-form-item__label {
    height: auto;
    margin-bottom: 8px;
    font: var(--qr-font-label);
    line-height: 20px;
  }

  .el-col > .el-form-item > .el-form-item__content > :is(
      .el-input,
      .el-select,
      .el-date-editor,
      .el-input-number,
      .el-cascader,
      .el-textarea,
      .el-autocomplete,
      .el-tree-select
    ):only-child {
    width: 100% !important;
  }

  .collapse-content-box {
    container-type: inline-size;
  }

  @container (min-width: #{$qr-form-four-columns}) {
    .el-row:not(:is(.el-dialog, .el-drawer) *) > .el-col-8 {
      flex: 0 0 25%;
      max-width: 25%;
    }
  }

  @container (max-width: #{$qr-form-two-columns - 1px}) {
    .el-row:not(:is(.el-dialog, .el-drawer) *) > :is(.el-col-8, .el-col-6) {
      flex: 0 0 50%;
      max-width: 50%;
    }
  }

  @container (max-width: #{$qr-form-one-column - 1px}) {
    .el-row:not(:is(.el-dialog, .el-drawer) *) > :is(.el-col-8, .el-col-6, .el-col-12) {
      flex: 0 0 100%;
      max-width: 100%;
    }
  }

  .el-form-item__content:has(> .qr-combo-main) {
    flex-wrap: nowrap;
    gap: 8px;
  }

  .el-form-item__content > .qr-combo-main {
    flex: 1 1 0;
    width: auto !important;
    min-width: 0;
  }

  $qr-form-control-types: '.el-input, .el-select, .el-date-editor, .el-input-number, .el-cascader, .el-textarea';

  .collapse-content-box > .el-form-item:not(.el-form-item--label-top):has(> .el-form-item__content > :is(#{$qr-form-control-types})) {
    @include qr-one-cell-width(100px);
  }

  .collapse-content-box > .el-form-item.el-form-item--label-top:has(> .el-form-item__content > :is(#{$qr-form-control-types})) {
    @include qr-one-cell-width(0px);
  }

  .el-select__wrapper {
    min-height: var(--qr-size-control);
  }

  .el-input__wrapper,
  .el-select__wrapper,
  .el-textarea__inner {
    border-radius: var(--qr-radius-control);
    background: var(--qr-surface);
    box-shadow: 0 0 0 1px var(--qr-border) inset;
    transition: 0.18s cubic-bezier(0.22, 0.8, 0.26, 1);

    &:hover {
      box-shadow: 0 0 0 1px var(--qr-border-strong) inset;
    }
  }

  .el-input__wrapper.is-focus,
  .el-select__wrapper.is-focused,
  .el-textarea__inner:focus {
    box-shadow:
      0 0 0 1px #6caaff inset,
      0 0 0 3px rgba(38, 129, 241, 0.09);
  }

  .el-input.is-disabled .el-input__wrapper,
  .el-select__wrapper.is-disabled,
  .el-textarea.is-disabled .el-textarea__inner,
  .el-range-editor.is-disabled,
  .el-input-number.is-disabled .el-input__wrapper {
    background: var(--qr-surface-tint);
    box-shadow: 0 0 0 1px var(--qr-border) inset;
  }

  .el-input.is-disabled .el-input__inner,
  .el-textarea.is-disabled .el-textarea__inner,
  .el-range-editor.is-disabled .el-range-input {
    color: var(--qr-text-body);
    -webkit-text-fill-color: var(--qr-text-body);
  }

  .el-select__wrapper.is-disabled .el-select__selected-item:not(.is-transparent) {
    color: var(--qr-text-body);
  }

  .el-input-number {
    .el-input__wrapper {
      padding: 1px 34px 1px 12px;
    }

    .el-input__inner {
      text-align: left;
    }

    .el-input-number__increase,
    .el-input-number__decrease {
      right: 12px;
      left: auto;
      width: 16px;
      height: 12px;
      background: transparent;
      border: none;
      border-radius: 0;
      color: var(--qr-text-muted);

      background-color: currentColor;
      -webkit-mask: var(--qr-stepper-mask) no-repeat;
      mask: var(--qr-stepper-mask) no-repeat;
      -webkit-mask-size: 16px 24px;
      mask-size: 16px 24px;

      .el-icon {
        display: none;
      }

      &:hover {
        color: var(--qr-color-brand);
      }

      &.is-disabled {
        color: var(--qr-text-placeholder);
      }
    }

    .el-input-number__increase {
      top: 8px;
      bottom: auto;
      -webkit-mask-position: top;
      mask-position: top;
    }

    .el-input-number__decrease {
      bottom: 8px;
      top: auto;
      -webkit-mask-position: bottom;
      mask-position: bottom;
    }
  }

  .el-table .el-input-number {
    .el-input-number__increase {
      top: 6px;
    }

    .el-input-number__decrease {
      bottom: 6px;
    }
  }

  .el-textarea__inner {
    height: var(--qr-size-control) !important;
    min-height: var(--qr-size-control) !important;
    padding: 10px 12px;
  }

  .el-input__inner,
  .el-select__placeholder,
  .el-textarea__inner {
    font: var(--qr-font-label);
  }

  .el-input__inner::placeholder,
  .el-textarea__inner::placeholder {
    color: var(--qr-text-placeholder);
  }

  .el-switch {
    --el-switch-on-color: #1679ea;
    --el-switch-off-color: #d8e1eb;
  }

  .el-switch__core {
    width: 38px;
    min-width: 38px;
    height: 22px;
    border-radius: 11px;
    border-color: transparent;
  }

  .el-switch__core .el-switch__action {
    left: 2px;
    width: 16px;
    height: 16px;
    box-shadow: 0 2px 5px rgba(19, 54, 89, 0.18);
  }

  .el-switch.is-checked .el-switch__core .el-switch__action {
    left: calc(100% - 18px);
  }

  .el-radio {
    --el-radio-input-border-color-hover: #0075ff;
    font: var(--qr-font-label);
  }

  .el-radio__inner {
    width: 13px;
    height: 13px;
    border-color: var(--qr-text-muted);
  }

  .el-radio__input.is-checked .el-radio__inner {
    background: var(--qr-surface);
    border-color: #0075ff;

    &::after {
      width: 8px;
      height: 8px;
      background: #0075ff;
    }
  }

  .el-radio__label {
    font: var(--qr-font-label);
    color: var(--qr-text-body);
  }

  .el-table {
    --el-table-border-color: #e6edf5;
    --el-table-header-bg-color: var(--qr-surface-table-head);
    --el-table-header-text-color: var(--qr-text-body);
    --el-table-text-color: var(--qr-text-body);
    --el-table-row-hover-bg-color: #f5f9ff;

    border: 1px solid #e2eaf3;
    border-radius: var(--qr-radius-table);
    font: var(--qr-font-table);
  }

  .el-table {
    width: 100% !important;
  }

  .el-table,
  .el-table__inner-wrapper {
    overflow: hidden;
  }

  .el-table th.el-table__cell {
    height: var(--qr-size-table-head);
    padding: 0;
    background: var(--qr-surface-table-head) !important;
    font: 500 12px/18px var(--qr-font-sans);
    color: #516880;
  }

  .el-table td.el-table__cell {
    height: var(--qr-size-table-row);
    border-bottom-color: #e7eef5;
    font: 400 12px/18.6px var(--qr-font-sans);
    color: #36506a;
  }

  .el-table__footer td.el-table__cell {
    height: var(--qr-size-table-head);
    background: var(--qr-surface-table-head);
    font: 400 12px/18.6px var(--qr-font-sans);
    color: #36506a;
  }

  .el-table .el-table__row:nth-child(2n),
  .el-table .el-table__row:nth-child(odd) {
    background: var(--qr-surface);
  }

  .el-descriptions__body {
    overflow: hidden;
    background: var(--qr-surface);
    border: 1px solid #e2eaf3;
    border-radius: var(--qr-radius-table);
  }

  .el-descriptions__table.is-bordered .el-descriptions__cell {
    padding: 11px 12px;
    border: 0;
    border-right: 1px solid var(--qr-border-row);
    border-bottom: 1px solid var(--qr-border-row);
  }

  .el-descriptions__table.is-bordered tr:last-child .el-descriptions__cell {
    border-bottom: 0;
  }

  .el-descriptions__table.is-bordered .el-descriptions__cell:last-child {
    border-right: 0;
  }

  .el-descriptions__label.is-bordered-label {
    font: var(--qr-font-table);
    font-weight: 400;
    color: var(--qr-text-muted);
    background: var(--qr-surface-table-head);
  }

  .el-descriptions__content.is-bordered-content {
    font: var(--qr-font-value);
    color: var(--qr-text-body);
  }

  .el-descriptions__label:not(.is-bordered-label) {
    font: var(--qr-font-table);
    color: var(--qr-text-muted);
  }

  .el-descriptions__content:not(.is-bordered-content) {
    font: var(--qr-font-value);
    color: var(--qr-text-body);
  }

  .el-descriptions__header .el-descriptions__title {
    font: var(--qr-font-tab);
    color: var(--qr-text-body);
  }

  .table-el-form-item {
    margin: 0 !important;

    .el-form-item__content {
      margin: 0 !important;
    }
  }

  .el-table {
    .el-input__wrapper,
    .el-select__wrapper,
    .el-date-editor.el-input .el-input__wrapper {
      height: 36px;
      min-height: 36px;
      padding: 0 12px;
      font: 400 12px/18.6px var(--qr-font-sans);
    }

    .el-input__inner,
    .el-select__placeholder {
      font: 400 12px/18.6px var(--qr-font-sans);
      color: #2e4862;
    }

    .el-input.is-disabled .el-input__inner {
      color: #9aa8b7;
      -webkit-text-fill-color: #9aa8b7;
    }

    .cell > .el-button.is-link + .el-button.is-link {
      margin-left: 14px;
    }

    .el-switch {
      height: 18px;
    }

    .el-switch__core {
      width: 32px;
      min-width: 32px;
      height: 18px;
    }

    .el-switch__core .el-switch__action {
      width: 12px;
      height: 12px;
    }

    .el-switch.is-checked .el-switch__core .el-switch__action {
      left: calc(100% - 14px);
    }
  }

  .el-button {
    height: var(--qr-size-btn);
    padding: 0 15px;
    border-radius: var(--qr-radius-control);
    font: var(--qr-font-label);
  }

  .el-button:not(.el-button--primary):not(.el-button--success):not(.el-button--warning):not(.el-button--danger):not(.el-button--info):not(.is-link):not(.is-text) {
    border-color: var(--qr-btn-border, var(--qr-border-card));
    background: var(--qr-surface);
    color: var(--qr-text-body);
    box-shadow: var(--qr-shadow-btn);
  }

  .el-button--small {
    height: var(--qr-size-btn-sm);
    padding: 0 10px;
    border-radius: var(--qr-radius-sm);
    font: var(--qr-font-emphasis);
    font-weight: 500;
  }

  .el-button--large {
    height: var(--qr-size-btn);
    font: var(--qr-font-label);
  }

  .el-button--primary {
    background: var(--qr-gradient-brand);
    border-color: transparent;
    color: var(--qr-text-invert);
    box-shadow: var(--qr-shadow-brand);

    &:hover,
    &:focus {
      background: var(--qr-gradient-brand);
      border-color: transparent;
      color: var(--qr-text-invert);
      box-shadow: 0 11px 24px rgba(15, 105, 229, 0.31);
    }
  }

  .el-button--success {
    background: var(--qr-gradient-success);
    border-color: transparent;
    color: var(--qr-text-invert);
    box-shadow: var(--qr-shadow-success);

    &:hover,
    &:focus {
      background: var(--qr-gradient-success);
      border-color: transparent;
      color: var(--qr-text-invert);
    }
  }

  .el-button--danger {
    background: var(--qr-color-danger);
    border-color: transparent;
    color: var(--qr-text-invert);
  }

  .el-button--warning {
    background: var(--qr-color-warning);
    border-color: transparent;
    color: var(--qr-text-invert);
  }

  .el-button.is-link {
    height: auto;
    padding: 0 6px;
    background: transparent;
    border: none;
    box-shadow: none;
    font: var(--qr-font-emphasis);
  }

  .el-button.is-link.el-button--primary {
    color: var(--qr-color-brand);
  }

  .el-button.is-link.el-button--danger {
    color: var(--qr-tag-red-text);
  }

  .el-tag {
    height: var(--qr-size-badge);
    padding: 0 8px;
    border: none;
    border-radius: var(--qr-radius-badge);
    font: var(--qr-font-caption);
    font-weight: 500;
    line-height: 1;

    &.el-tag--primary {
      background: var(--qr-tag-blue-bg);
      color: var(--qr-tag-blue-text);
    }

    &.el-tag--success {
      background: var(--qr-tag-green-bg);
      color: var(--qr-tag-green-text);
    }

    &.el-tag--warning {
      background: var(--qr-tag-orange-bg);
      color: var(--qr-tag-orange-text);
    }

    &.el-tag--danger {
      background: var(--qr-tag-red-bg);
      color: var(--qr-tag-red-text);
    }

    &.el-tag--info {
      background: var(--qr-tag-gray-bg);
      color: var(--qr-tag-gray-text);
    }
  }

  .el-alert {
    padding: 11px 14px;
    border-radius: var(--qr-radius-control);

    &.el-alert--warning.is-light {
      background: var(--qr-notice-bg);
      border: 1px solid var(--qr-notice-border);
    }

    &.el-alert--warning .el-alert__title,
    &.el-alert--warning .el-alert__description,
    &.el-alert--warning .el-alert__icon,
    &.el-alert--warning .el-alert__close-btn {
      color: var(--qr-notice-text);
      font-weight: 700;
    }

    .el-alert__title {
      font-size: 12px;
      line-height: 19.8px;
    }
  }

  .upload-item .upload-label {
    span {
      font: var(--qr-font-label);
      color: var(--qr-text-body);
    }

    .required {
      color: var(--qr-color-danger);
    }
  }

  .el-empty__description p {
    font: var(--qr-font-caption);
    color: var(--qr-text-muted);
  }

}

.qr-detail-header {
  margin-bottom: 12px;
}

.qr-detail-header:has(+ .el-affix) {
  margin-bottom: 0;
}


.qr-detail-header {

  background: var(--qr-surface);
  border: 1px solid #dce8f5;
  border-radius: var(--qr-radius-card);
  box-shadow: var(--qr-shadow-card);
}

.qr-detail-header__top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  padding: 16px 18px 13px;
}

.qr-detail-header__title {
  margin: 0;
  font: var(--qr-font-detail-title);
  letter-spacing: -0.016em;
  color: var(--qr-text-body);
}

.qr-detail-header__subtitle {
  margin: 5px 0 0;
  font: var(--qr-font-table);
  color: var(--qr-text-muted);
}

.qr-detail-header__actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: none;
}

.qr-detail-header__notice {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 18px;
  padding: 10px 12px;
  background: #eef5ff;
  border: 1px solid #d7e7fb;
  border-radius: var(--qr-radius-control);
  font: var(--qr-font-caption);
  color: var(--qr-text-body);
}

.qr-detail-header__notice-label {
  font: var(--qr-font-emphasis);
  color: var(--qr-color-brand);
}

.qr-detail-header__fields {
  display: flex;
  margin-top: 12px;
  background: rgba(255, 255, 255, 0.72);
  border-top: 1px solid var(--qr-border-card);
  border-radius: 0 0 var(--qr-radius-card) var(--qr-radius-card);
}

.qr-detail-header__cell {
  flex: 1 1 0;
  min-width: 0;
  padding: 13px 14px;
  border-right: 1px solid #e6edf5;

  &:last-child {
    border-right: none;
  }
}

.qr-detail-header {
  container-type: inline-size;
}

@container (max-width: 1299px) {
  .qr-detail-header__fields:has(> .qr-detail-header__cell:nth-child(7)) {
    flex-wrap: wrap;

    > .qr-detail-header__cell {
      flex: 0 0 25%;

      &:nth-child(4n) {
        border-right: none;
      }

      &:nth-child(n + 5) {
        border-top: 1px solid #e6edf5;
      }
    }
  }
}

.qr-detail-header__label {
  display: block;
  font: var(--qr-font-caption);
  color: var(--qr-text-muted);
}

.qr-detail-header__value {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 5px;
  min-height: 21px;
}

.qr-detail-header__text {
  font: 400 14px/21px var(--qr-font-sans);
  color: var(--qr-text-body);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qr-detail-header__tag {
  display: inline-flex;
  align-items: center;
  height: 23px;
  padding: 0 8px;
  border-radius: var(--qr-radius-badge);
  border: 1px solid transparent;
  font: 700 11px/16.5px var(--qr-font-sans);
  white-space: nowrap;

  &.is-blue {
    background: #e9f3ff;
    border-color: #bfdbff;
    color: var(--qr-color-brand);
  }
  &.is-gray {
    background: var(--qr-tag-gray-bg);
    border-color: #d5e0ea;
    color: var(--qr-text-body);
  }
  &.is-green {
    background: #eaf9f2;
    border-color: #bfe7d4;
    color: var(--qr-tag-green-text);
  }
  &.is-cyan {
    background: var(--qr-tag-cyan-bg);
    border-color: rgba(11, 156, 169, 0.25);
    color: var(--qr-tag-cyan-text);
  }
  &.is-orange {
    background: #fff3e4;
    border-color: #ffd7a4;
    color: #dd8518;
  }
  &.is-red {
    background: #fff0f2;
    border-color: #f8c4cb;
    color: #df3d4c;
  }
}

.qr-detail-header__extra,
.qr-detail-header__text.is-blue,
.qr-detail-header__text.is-orange,
.qr-detail-header__text.is-red,
.qr-detail-header__text.is-green {
  font: 400 14px/21px var(--qr-font-sans);
  white-space: nowrap;
}

.qr-detail-header__extra.is-blue,
.qr-detail-header__text.is-blue {
  color: var(--qr-color-brand);
}
