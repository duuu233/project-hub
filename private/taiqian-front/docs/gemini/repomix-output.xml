<script setup>
import { onMounted, ref, reactive, onUnmounted, getCurrentInstance } from 'vue'
import { ElMessage } from 'element-plus'
import { useRouter } from 'vue-router'
import TableSearch from '@/components/TableSearch'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'
import { regulatoryAuthoritiesOrgList } from '@/api/business'
import { parseTime } from '@/utils/ruoyi'

const router = useRouter()
const { proxy } = getCurrentInstance()
const gridRef = ref()

const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const query = reactive({
  orgName: ''
})

const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  const $grid = gridRef.value
  if ($grid) {
    $grid.commitProxy('query')
  }
}

const searchOpt = ref([
  {
    type: 'input',
    label: '监管方名称：',
    placeholder: '请输入',
    prop: 'orgName'
  }
])

const gridOptions = reactive({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: true,
    zoom: true,
    slots: {
      buttons: 'toolbarButtons'
    }
  },
  proxyConfig: {
    response: {
      result: 'result',
      total: 'total'
    },
    ajax: {
      query: ({ page }) => {
        return getList(page)
      }
    }
  },
  columns: [
    { type: 'seq', width: 70 },
    { title: '客户号', field: 'orgCode', minWidth: 100 },
    { title: '监管方名称', field: 'orgName', minWidth: 100, showOverflow: true },
    { title: '地区', field: 'areaFullName', minWidth: 100, showOverflow: true },
    { title: '状态', field: 'status', minWidth: 100, align: 'center', slots: { default: 'statusRender' } },
    { title: '创建时间', field: 'createTime', minWidth: 200, align: 'center', slots: { default: 'createTimeRender' } },
    { title: '操作', field: 'active', minWidth: 140, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ]
})

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

async function getList() {
  gridOptions.loading = true
  try {
    const res = await regulatoryAuthoritiesOrgList({
      pageNum: gridOptions.pagerConfig.currentPage,
      pageSize: gridOptions.pagerConfig.pageSize,
      ...query
    })

    return new Promise(resolve => {
      resolve({
        total: res.total * 1,
        result: res.rows
      })
    })
  } catch (error) {
    console.error('获取列表失败:', error)
    ElMessage.error('获取列表失败')
    return new Promise(resolve => {
      resolve({
        total: 0,
        result: []
      })
    })
  } finally {
    gridOptions.loading = false
  }
}

function handleAdd() {
  router.push({ path: 'business-supervisory-party-add' })
}

const handleEdit = param => {
  proxy.openNewTagsView({
    name: 'Business-supervisory-party-edit'
  })
  router.push({
    path: 'business-supervisory-party-edit',
    query: { id: param.orgId }
  })
}

const handleDetail = param => {
  proxy.openNewTagsView({
    name: 'Business-supervisory-party-detail'
  })
  router.push({
    path: 'business-supervisory-party-detail',
    query: { id: param.orgId }
  })
}

onMounted(() => {
  registerGrid('business-supervisory-party-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('business-supervisory-party-grid')
})
</script>

