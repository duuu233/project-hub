              </el-table>
              <pagination
                v-show="expandDataMap[props.row.financeNo].total > 0"
                :total="expandDataMap[props.row.financeNo].total"
                v-model:page="expandDataMap[props.row.financeNo].pageNum"
                v-model:limit="expandDataMap[props.row.financeNo].pageSize"
                @pagination="obj => handleExpandPagination(obj, props.row)"
              />
            </div>
          </template>
        </el-table-column>
        <el-table-column type="index" label="序号" width="55" />
        <el-table-column prop="financeNo" label="融资编号" width="220" />
        <el-table-column prop="financeOrgName" label="融资企业名称" width="280" />
        <el-table-column prop="" label="贷后编号" width="120">
          <template #default="scope">
            {{ '-' }}
          </template>
        </el-table-column>
        <el-table-column prop="" label="贷后事项类型" width="120">
          <template #default="scope">
            {{ '-' }}
          </template>
        </el-table-column>
        <el-table-column prop="productName" label="产品名称" width="160" />
        <el-table-column prop="agentOrderNo" label="代理订单编号" width="200" />
        <el-table-column prop="purchaseNo" label="采购订单号" width="120" />
        <el-table-column prop="loanAmount" label="放款金额" width="120">
          <template #default="scope">
            {{ formatAmount(scope.row.loanAmount) }}
          </template>
        </el-table-column>
        <el-table-column prop="" label="贷后审批状态" width="120">
          <template #default="scope">
            {{ '-' }}
          </template>
        </el-table-column>
        <el-table-column prop="createTime" label="创建时间" width="160" />
        <el-table-column label="操作" width="300" fixed="right">
          <template #default="scope">
            <el-button
              v-hasPermi="[
                'finance:loanAfter:oceanShipDetail',
                'finance:loanAfter:customsClearDetail',
                'finance:loanAfter:stockInDetail',
                'finance:loanAfter:dockDeliveryDetail',
                'finance:loanAfter:stockOutDetail'
              ]"
              v-for="btn in getOperationButtons(scope.row)"
              :key="btn.type"
              type="primary"
              link
              :class="{ active: isActiveButton(scope.row, btn.type) }"
              @click="handleOperation(btn.type, scope.row)"
            >
              {{ btn.label }}
            </el-button>
          </template>
        </el-table-column>
      </el-table>

      <pagination v-show="total > 0" :total="total" v-model:page="queryParams.pageNum" v-model:limit="queryParams.pageSize" @pagination="getList" />
    </div>
  </div>
</template>

<script setup>
import { ref, onMounted, reactive } from 'vue'
import { useRouter } from 'vue-router'
import { ElMessage } from 'element-plus'
import TableSearch from '@/components/TableSearch'
import Pagination from '@/components/Pagination'
import { mainList, detailList } from '@/api/deppon/loanAfter'

const router = useRouter()
const mainTableRef = ref(null)
const loading = ref(false)
const total = ref(0)
const mainTableData = ref([])
const currentExpandedRow = ref(null)
const currentExpandedType = ref(null)

const getDetailButtonText = approveStatus => {
  return approveStatus == null || approveStatus == 2 ? '提交审批' : '详情'
}

const operationButtons = [
  { label: '海运', type: '1', path: '/post-loan/loan-list/ocean-freight' },
  { label: '报关', type: '2', path: '/post-loan/loan-list/customs-clearance' },
  { label: '入库', type: '3', path: '/post-loan/loan-list/warehouse' },
  { label: '码头直提', type: '4', path: '/post-loan/loan-list/pick-up-terminal' },
  { label: '堆场提货', type: '5', path: '/post-loan/loan-list/direct-yard' }
]
function getOperationButtons(row) {
  if (row.transportType === 1) {
    return [
      { label: '海运', type: '1', path: '/post-loan/loan-list/ocean-freight' },
      { label: '报关', type: '2', path: '/post-loan/loan-list/customs-clearance' },

      { label: '码头直提', type: '4', path: '/post-loan/loan-list/pick-up-terminal' }
    ]
  }
  if (row.transportType === 2) {
    return [
      { label: '海运', type: '1', path: '/post-loan/loan-list/ocean-freight' },
      { label: '报关', type: '2', path: '/post-loan/loan-list/customs-clearance' },
      { label: '入库', type: '3', path: '/post-loan/loan-list/warehouse' },

      { label: '堆场提货', type: '5', path: '/post-loan/loan-list/direct-yard' }
    ]
  }
}
const routeMap = {
  1: '/post-loan/loan-list/ocean-freight',
  2: '/post-loan/loan-list/customs-clearance',
  3: '/post-loan/loan-list/warehouse',
  4: '/post-loan/loan-list/pick-up-terminal',
  5: '/post-loan/loan-list/direct-yard'
}

const expandDataMap = reactive({})
const loadingMap = reactive({})

const queryParams = reactive({
  pageNum: 1,
  pageSize: 10
})

const query = reactive({
  financeNo: '',
  orgName: ''
})

const searchOpt = ref([
  {
    type: 'input',
    label: '融资编号：',
    placeholder: '请输入融资编号',
    prop: 'financeNo'
  },
  {
    type: 'input',
    label: '企业名称：',
    placeholder: '请输入企业名称',
    prop: 'orgName'
  }
])

const formatAmount = amount => {
  return Number(amount).toLocaleString('zh-CN', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  })
}

const getStatusType = status => {
  const statusMap = {
    0: 'warning',
    1: 'success',
    2: 'danger'
  }
  return statusMap[status] || 'info'
}

const getStatusText = status => {
  const statusMap = {
    0: '待审批',
    1: '审批通过',
    2: '审批不通过'
  }
  return statusMap[status] || '-'
}

const isActiveButton = (row, type) => {
  return currentExpandedRow.value === row && currentExpandedType.value === type
}

const getList = async () => {
  loading.value = true
  try {
    const response = await mainList({
      ...queryParams,
      ...query
    })
    mainTableData.value = response.rows
    total.value = +response.total
  } catch (error) {
    ElMessage.error('获取数据失败')
  } finally {
    loading.value = false
  }
}

const fetchExpandData = async (row, type, pageNum = 1, pageSize = 10) => {
  loadingMap[row.financeNo] = true
  try {
    const response = await detailList({
      loanAfterMainId: row.id,
      loanAfterType: type,
      pageNum,
      pageSize
    })
    expandDataMap[row.financeNo] = {
      list: response.rows,
      total: +response.total,
      pageNum: pageNum,
      pageSize: pageSize
    }
  } catch (error) {
    ElMessage.error('获取详情数据失败')
    expandDataMap[row.financeNo] = { list: [], total: 0, pageNum: 1, pageSize: 10 }
  } finally {
    loadingMap[row.financeNo] = false
  }
}

const handleSearch = () => {
  queryParams.pageNum = 1
  getList()
}

const handleOperation = async (type, row) => {
  currentExpandedRow.value = row
  currentExpandedType.value = type
  await mainTableRef.value.toggleRowExpansion(row, true)
  await fetchExpandData(row, type)
}

const handleExpandPagination = ({ page, limit }, row) => {
  fetchExpandData(row, currentExpandedType.value, page, limit)
}

const handleExpandChange = (row, expanded) => {
  if (!expanded) {
    delete expandDataMap[row.financeNo]
    currentExpandedRow.value = null
    currentExpandedType.value = null
  } else {
    fetchExpandData(row, currentExpandedType.value)
  }
}

const handleDetail = row => {
  if (!row.loanAfterType) {
    ElMessage.warning('请选择贷后单项类型')
    return
  }

  const path = routeMap[row.loanAfterType]
  if (path) {
    router.push({
      path: `${path}`,
      query: {
        id: row.id,
        pageType: row.approveStatus == null || row.approveStatus == 2 ? 2 : 3,
        approveStatus: row.approveStatus,
        loanAfterType: row.loanAfterType
      }
    })
  }
}

onMounted(() => {
  getList()
})
</script>

