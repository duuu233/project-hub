<script setup>
import { onMounted, ref, reactive, onUnmounted } from 'vue'
import { ElMessage } from 'element-plus'
import TableSearch from '@/components/TableSearch'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'
import { coreEnterpriseList } from '@/api/business'

const router = useRouter()
const { proxy } = getCurrentInstance()
const gridRef = ref()

const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const query = reactive({
  orgName: ''
})
const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}

const searchOpt = ref([
  {
    type: 'input',
    label: '企业名称：',
    placeholder: '请输入',
    prop: 'orgName'
  }
])

const gridOptions = reactive({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true,
    slots: {
      buttons: 'toolbarButtons'
    }
  },
  columns: [
    { type: 'seq', width: 70 },
    { title: '客户号', field: 'orgCode', minWidth: 100 },
    { title: '产业项目', field: 'projectName', minWidth: 100 },
    { title: '企业名称', field: 'orgName', minWidth: 100, showOverflow: true },
    { title: '地区', field: 'areaFullName', minWidth: 100, showOverflow: true },
    { title: '状态', field: 'status', minWidth: 100, align: 'center', slots: { default: 'statusRender' } },
    { title: '创建时间', field: 'createTime', minWidth: 200, align: 'center', slots: { default: 'createTimeRender' } },
    { title: '操作', field: 'active', minWidth: 140, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
})

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

async function getList() {
  gridOptions.loading = true
  try {
    const res = await coreEnterpriseList({
      pageNum: gridOptions.pagerConfig.currentPage,
      pageSize: gridOptions.pagerConfig.pageSize,
      orgType: 0,
      ...query
    })

    gridOptions.data = res.rows
    gridOptions.pagerConfig.total = res.total * 1
  } catch (error) {
    console.error('获取列表失败:', error)
    ElMessage.error('获取列表失败')
  } finally {
    gridOptions.loading = false
  }
}

function handleAdd() {
  router.push({ path: 'merchants-core-enterprise-add' })
}

function handleEdit(row) {
  proxy.openNewTagsView({
    name: 'merchants-core-enterprise-edit'
  })
  router.push({
    path: 'merchants-core-enterprise-edit',
    query: { id: row.id }
  })
}

function handleDetail(row) {
  proxy.openNewTagsView({
    name: 'merchants-core-enterprise-detail'
  })
  router.push({
    path: 'merchants-core-enterprise-detail',
    query: { id: row.id }
  })
}

onMounted(() => {
  getList()
  registerGrid('business-core-enterprise-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('business-core-enterprise-grid')
})
</script>

