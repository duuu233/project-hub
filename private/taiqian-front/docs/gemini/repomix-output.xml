              fileName: item.agencyOperationsFileName,
              fileUrl: item.agencyOperationsFileUrl
            }
          ]
        }
        if (item.operationsDateStart && item.operationsDateEnd && item.operationsType != 2) {
          item.timeList = [item.operationsDateStart, item.operationsDateEnd]
        } else {
          item.timeList = []
        }
      })
    }
  } catch (error) {
    console.log(error)
  }
}
const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      if (!form.value.agencyOperationProductVos.length) {
        ElMessage.warning('请至少配置一条代运营信息')
        return
      }
      const submitData = cloneDeep(form.value)
      submitData.tenantName = getName('orgId', 'tenantName', submitData.tenantId, enumData.tenantList)
      submitData.agencyOperationsName = getName('id', 'orgName', submitData.agencyOperationsId, enumData.orgList)
      submitData.agencyOperationProductVos.forEach(item => {
        if (item.agencyOperationsFile && item.agencyOperationsFile.length) {
          item.agencyOperationsFileUrl = item.agencyOperationsFile[0].fileUrl
          item.agencyOperationsFileName = item.agencyOperationsFile[0].fileName
        }
        item.operationsType = item.operationsType * 1
        item.productName = getName('id', 'projectName', item.productId, enumData.industryList)
        if (item.timeList && item.timeList.length == 2 && item.operationsType != 2) {
          item.operationsDateStart = item.timeList[0]
          item.operationsDateEnd = item.timeList[1]
        } else {
          item.operationsDateStart = undefined
          item.operationsDateEnd = undefined
        }

        item.fincnceProductNo = getName('id', 'projectName', item.fincnceProductId, enumData.fincnceProductList)
        item.regulatoryAuthoritiesName = getName('orgId', 'orgName', item.regulatoryAuthoritiesId, enumData.regulatoryAuthoritiesList)
      })

      await agencyOperationsAdd(submitData)
      ElMessage.success('操作成功')
      setTimeout(() => {
        proxy.toList({
          path: `tenant-operations`,
          listName: 'tenant-operations'
        })
      }, 300)
    } else {
      console.log('error submit!', fields)
    }
  })
}
function getName(idKey = 'id', nameKey = 'name', id, list) {
  let item = list.find(o => o[idKey] === id) || {}

  return item[nameKey]
}
async function getEnumData() {
  try {
    const res = await tenantOrgList({})
    enumData.tenantList = res.data || []

    const res1 = await enterpriseUserList({ pageSize: 500, pageNum: 1 })
    enumData.orgList = res1.rows || []
    enumData.orgList = enumData.orgList.filter(o => o.orgType == 100)

    const res2 = await industryListApi({ pageSize: 500, pageNum: 1 })
    enumData.industryList = res2.rows || []

    const res3 = await productDropDownList({ pageSize: 500, pageNum: 1 })
    enumData.fincnceProductList = res3.data || []

    const res4 = await regulatoryAuthoritiesSelectList({ pageSize: 500, pageNum: 1 })
    enumData.regulatoryAuthoritiesList = res4.data || []
  } catch (error) {
    console.log(error)
  }
}
function changeOperationsType(v, item) {
  if (v == 2) {
    item.timeList = []
    item.agencyOperationsFile = []
  }
}
async function changeFincnceProductId(v, item) {
