              :min="0"
              :max="100"
            />
          </el-form-item>
        </el-col>
      </el-row>
    </Collapse>

    <el-form-item>
      <div style="padding: 20px 0 0 20px" v-if="pageType !== 3">
        <el-button v-throttle type="info" @click="router.back()" size="large">取消</el-button>
        <el-button v-throttle type="primary" @click="submit" size="large">提交</el-button>
      </div>
    </el-form-item>
