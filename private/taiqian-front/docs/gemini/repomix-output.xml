  couponType: 2,
  productId: '',
  productName: '',
  businessType: 2,
  value: '',
  validStartTime: '',
  validEndTime: '',
  issuanceMethod: 1,
  issuanceTarget: 2,
  assignmentMethod: 1,
  avgCount: '',
  selectedCustomers: [],
  assignmentList: []
})

const validTime = ref([])

const productList = ref([])
const customerList = ref([])

const rules = reactive({
  couponName: [{ required: true, message: '请输入优惠券名称', trigger: 'blur' }],
  couponType: [{ required: true, message: '请选择优惠券类型', trigger: 'change' }],
  productId: [{ required: true, message: '请选择金融产品', trigger: 'change' }],
  businessType: [{ required: true, message: '请选择业务类型', trigger: 'change' }],
  value: [{ required: true, message: '请输入优惠值', trigger: 'blur' }],
  validStartTime: [{ required: true, message: '请选择有效期间', trigger: 'change' }],
  validEndTime: [{ required: true, message: '请选择有效期间', trigger: 'change' }],
  issuanceMethod: [{ required: true, message: '请选择发放方式', trigger: 'change' }],
  issuanceTarget: [{ required: true, message: '请选择发放对象', trigger: 'change' }],
  assignmentMethod: [{ required: true, message: '请选择分配方式', trigger: 'change' }],
  selectedCustomers: [
    {
      validator: (rule, value, callback) => {
        if (form.issuanceTarget === 2 && (!value || value.length === 0)) {
          callback(new Error('请选择客户'))
        } else {
          callback()
        }
      },
      trigger: 'change'
    }
  ],
  avgCount: [
    {
      validator: (rule, value, callback) => {
        if (form.assignmentMethod === 1 && (!value || value <= 0)) {
          callback(new Error('请输入平均发放数量'))
        } else {
          callback()
        }
      },
      trigger: 'blur'
    }
  ],
  assignmentList: [
    {
      validator: (rule, value, callback) => {
        if (form.assignmentMethod === 2 && form.issuanceTarget === 2) {
          if (!value || value.length === 0) {
            callback(new Error('请选择客户并设置分配数量'))
          } else {
            const hasEmptyCount = value.some(item => !item.totalCount || item.totalCount <= 0)
            if (hasEmptyCount) {
              callback(new Error('请为所有选择的客户设置分配数量'))
            } else {
              callback()
            }
          }
        } else {
          callback()
        }
      },
      trigger: 'blur'
    }
  ]
})

async function getProductList() {
  try {
    const res = await productDropDownList({ pageSize: 500, pageNum: 1, status: 0 })
    productList.value = res.data || []
  } catch (error) {
    console.error('获取金融产品列表失败:', error)
    ElMessage.error('获取金融产品列表失败')
  }
}

async function getCustomerList() {
  try {
    const res = await getCreditPassOrgList({
      productId: form.productId
    })
    customerList.value = res.data || []
  } catch (error) {
    console.error('获取客户列表失败:', error)
    ElMessage.error('获取客户列表失败')
  }
}

function handleProductChange(value) {
  const product = productList.value.find(item => item.id === value)
  if (product) {
    form.productName = product.productName
  }
  form.selectedCustomers = []
  form.assignmentList = []
  customerList.value = []

  if (value) {
    getCustomerList()
  }
}

function handleValidTimeChange(value) {
  if (value && value.length === 2) {
    form.validStartTime = value[0]
    form.validEndTime = value[1]
  } else {
    form.validStartTime = ''
    form.validEndTime = ''
  }
  formRef.value && formRef.value.validateField('validStartTime')
  formRef.value && formRef.value.validateField('validEndTime')
}

function handleDistributionTargetChange(value) {
  if (value === 1) {
    form.selectedCustomers = []
    form.assignmentList = []
    form.assignmentMethod = 1
  } else if (value === 2) {
    if (!form.productId) {
      ElMessage.warning('请先选择金融产品')
      form.issuanceTarget = 1
      return
    }
    form.selectedCustomers = []
    form.assignmentList = []
  }
}

function handleCustomerChange(values) {
  form.assignmentList = values.map(orgId => {
    const customer = customerList.value.find(item => item.orgId === orgId)
    return {
      customerId: orgId,
      customerName: customer ? customer.orgName : '',
      totalCount: 0
    }
  })
}

function handleAssignmentMethodChange(value) {
  if (value === 1) {
    form.assignmentList.forEach(item => {
      item.totalCount = 0
    })
    form.avgCount = ''
    formRef.value && formRef.value.clearValidate('assignmentList')
  } else if (value === 2) {
    form.avgCount = ''
    formRef.value && formRef.value.clearValidate('avgCount')
  }
}

function handleAssignmentCountChange() {
  formRef.value && formRef.value.validateField('assignmentList')
}

async function handleSubmit() {
  try {
    await formRef.value.validate()

    let submitData = { ...form }

    if (form.issuanceTarget === 1) {
      submitData.assignmentList = []
    } else if (form.issuanceTarget === 2) {
      if (form.assignmentMethod === 1) {
        submitData.assignmentList = form.selectedCustomers.map(orgId => {
          const customer = customerList.value.find(item => item.orgId === orgId)
          return {
            customerId: orgId,
            customerName: customer ? customer.orgName : '',
            totalCount: form.avgCount
          }
        })
      } else if (form.assignmentMethod === 2) {
        submitData.assignmentList = form.assignmentList
      }
    }

    delete submitData.selectedCustomers

    await addCoupon(submitData)
    ElMessage.success('优惠券创建成功')
    handleCancel()
  } catch (error) {
    console.error('创建优惠券失败:', error)
    if (error !== 'cancel') {
      ElMessage.error('创建优惠券失败')
    }
  }
}

function handleCancel() {
  setTimeout(() => {
    proxy.toList({
      path: `/coupon/coupon-list`,
      listName: 'Coupon-list'
    })
  }, 300)
}

onMounted(() => {
  getProductList()
})
</script>

