        transform: rotate(360deg);
      }
    }

    @keyframes pulse {

      0%,
      100% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
      }

      50% {
        transform: translate(-50%, -50%) scale(1.5);
        opacity: 0.7;
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes logoFloat {

      0%,
      100% {
        transform: translateY(0px) scale(1);
      }

      50% {
        transform: translateY(-10px) scale(1.05);
      }
    }

    @keyframes progressLoad {
      0% {
        width: 0%;
      }

      60% {
        width: 75%;
      }

      100% {
        width: 100%;
      }
    }

    @keyframes textPulse {

      0%,
      100% {
        opacity: 0.8;
      }

      50% {
        opacity: 1;
      }
    }

    @keyframes backgroundRotate {
      0% {
        transform: rotate(0deg);
      }

      100% {
        transform: rotate(360deg);
      }
    }

    @keyframes particleFloat {

      0%,
      100% {
        transform: translateY(0px) scale(1);
        opacity: 0.3;
      }

      33% {
        transform: translateY(-20px) scale(1.2);
        opacity: 0.6;
      }

      66% {
        transform: translateY(-10px) scale(0.8);
        opacity: 0.4;
      }
    }

    @media (max-width: 768px) {
      .loading-title {
        font-size: 24px;
      }

      .loading-subtitle {
        font-size: 14px;
        margin-bottom: 40px;
      }

      .loading-logo {
        width: 60px;
        height: 60px;
        margin-bottom: 20px;
      }

      .loader {
        width: 50px;
        height: 50px;
      }

      .progress-container {
        width: 160px;
      }
    }

    .loading-logo {

      opacity: 1;
    }
  </style>
</head>

<body>
  <div id="app-loading">
    <div class="particles">
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
    </div>
    <div class="loading-content">
      <img src="/logo-mini.png" alt="Company Logo" class="loading-logo" />
      <h1 class="loading-title">链数融亁</h1>
      <p class="loading-subtitle">数智科技，赋能产业</p>
      <div class="loader-container">
        <div class="loader"></div>
      </div>
      <div class="progress-container">
        <div class="progress-bar"></div>
      </div>
      <div class="loading-text">正在加载系统...</div>
    </div>
  </div>

  <div id="app"></div>

  <script>

    (function () {

      function hideLoading() {
        const loadingEl=document.getElementById('app-loading');
        const appEl=document.getElementById('app');

        if (loadingEl&&appEl) {

          appEl.classList.add('loaded');

          loadingEl.classList.add('hidden');

          setTimeout(() => {
            loadingEl.remove();
            document.body.style.overflow='';
          }, 800);
        }
      }

      let minLoadTime=window.__EMBEDDED_ENTRY_LOADING__ ? 0 : 1200;
      let startTime=Date.now();
      let isReady=false;

      function onPageReady() {
        isReady=true;
        let elapsed=Date.now()-startTime;
        let remaining=Math.max(0, minLoadTime-elapsed);

        setTimeout(hideLoading, remaining);
      }

      if (document.readyState==='loading') {
        document.addEventListener('DOMContentLoaded', onPageReady);
      } else {
        onPageReady();
      }

      setTimeout(function () {
        if (!isReady) {
          onPageReady();
        }
      }, 5000);

      window.hideAppLoading=hideLoading;
    })();
  </script>

  <script type="module" src="/src/main.js"></script>
</body>

