<script setup>
import { ref, onMounted, computed } from 'vue'
import { getFinanceProductDetail } from '@/api/deppon/product'
import Collapse from '@/components/Collapse'
import { useRouter, useRoute } from 'vue-router'
import { getCurrentInstance } from 'vue'
import { multiplyWithPrecision } from '@/utils/index'
const router = useRouter()
const route = useRoute()
const { proxy } = getCurrentInstance()
const { product_type, repayment_entry_type, rpa_data } = proxy.useDict('product_type', 'repayment_entry_type', 'rpa_data')

const detail = ref({
  superviseInfo: [],
  feeInfo: []
})

const superviseTableData = computed(() => {
  if (!detail.value.superviseInfo || detail.value.superviseInfo.length === 0) {
    return []
  }
  return detail.value.superviseInfo.map(item => ({
    coreOrgName: item.coreOrgName || '-',
    superviseName: item.superviseName || '-',
    superviseWarehouseName: item.superviseWarehouseName || '-',
    superviseProtocolNo: item.superviseProtocolNo || '-'
  }))
})

onMounted(() => {
  fetchProductDetail()
})

const fetchProductDetail = async () => {
  try {
    const res = await getFinanceProductDetail({
      id: route.query.id
    })
    detail.value = res.data
  } catch (error) {
    console.error('获取详情失败', error)
  }
}

const getStatusText = status => {
  return status == 0 ? '已生效' : '已失效'
}

const getProductTypeText = type => {
  const found = product_type.value.find(item => item.value === String(type))
  return found ? found.label : '-'
}

const getRepayEntryTypeText = type => {
  const found = repayment_entry_type.value.find(item => item.value === String(type))
  return found ? found.label : '-'
}

const getRpaDataText = dataCode => {
  if (!dataCode) return '-'
  const found = rpa_data.value.find(item => item.value === String(dataCode))
  return found ? found.label : '-'
}
function getProjectInfoText(items) {
  if (!items || items.length === 0) {
    return ''
  }
  let nameList = []
  items.forEach(v => {
    nameList.push(v.projectName)
  })
  return nameList.join(',')
}
const formatAmount = amount => {
  if (!amount && amount !== 0) return '-'
  return (amount / 10000).toFixed(2)
}

const formatRate = rate => {
  if (!rate && rate !== 0) return '-'

  const num = multiplyWithPrecision(rate, 100)
  return num.toFixed(2)
}

const formatFeeRate = rate => {
  if (!rate && rate !== 0) return '-'
  return (rate * 100).toFixed(2)
}

const formatPrePayLimit = limit => {
  if (!limit && limit !== 0) return '-'
  return limit.toFixed(2)
}

const goBack = () => {
  router.back()
}
</script>

