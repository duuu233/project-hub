<script setup>
import { ref, onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import { useRouter, useRoute } from 'vue-router'
import Collapse from '@/components/Collapse'
import { getCouponDetail } from '@/api/coupon'

const router = useRouter()
const route = useRoute()
const { proxy } = getCurrentInstance()

const detail = ref({})
const loading = ref(false)

async function getDetail() {
  if (!route.query.id) {
    ElMessage.error('缺少优惠券ID')
    router.back()
    return
  }

  loading.value = true
  try {
    const res = await getCouponDetail(route.query.id)
    detail.value = res.data || {}
  } catch (error) {
    console.error('获取优惠券详情失败:', error)
    ElMessage.error('获取优惠券详情失败')
    router.back()
  } finally {
    loading.value = false
  }
}

function getCouponTypeName(couponType) {
  const couponTypeMap = {
    1: '代金券',
    2: '折扣券'
  }
  return couponTypeMap[couponType] || '-'
}

function getBusinessTypeName(businessType) {
  const businessTypeMap = {
    1: '所有费用',
    2: '技术服务费',
    3: '数据监管费'
  }
  return businessTypeMap[businessType] || '-'
}

function getDistributionMethodName(method) {
  const methodMap = {
    1: '自动发放',
    2: '手动发放'
  }
  return methodMap[method] || '-'
}

function getDistributionTargetName(target) {
  const targetMap = {
    1: '全部客户',
    2: '部分客户'
  }
  return targetMap[target] || '-'
}

function getAssignmentMethodName(method) {
  const methodMap = {
    1: '平均分配',
    2: '指定数量'
  }
  return methodMap[method] || '-'
}

function getSelectedCustomersText() {
  if (!detail.value.assignmentList || detail.value.assignmentList.length === 0) {
    return '-'
  }
  if (detail.value.assignmentList.length <= 3) {
    return detail.value.assignmentList.map(item => item.customerName).join('、')
  } else {
    return `${detail.value.assignmentList
      .slice(0, 3)
      .map(item => item.customerName)
      .join('、')} 等${detail.value.assignmentList.length}个客户`
  }
}

function formatCouponValue(couponData) {
  if (!couponData.value) return '-'

  if (couponData.couponType === 1) {

    return `${couponData.value} 元`
  } else if (couponData.couponType === 2) {

    return `${(couponData.value * 10).toFixed(1)} 折`
  }

  return '-'
}

function handleBack() {
  proxy.toList({
    path: `/coupon/coupon-list`,
    listName: 'Coupon-list'
  })
}

onMounted(() => {
  getDetail()
})
</script>

