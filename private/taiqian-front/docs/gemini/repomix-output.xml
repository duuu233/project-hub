const dialogVisible = ref(false)
const operatorList = ref([])
const orgId = ref(null)

const handleConfigH5 = async row => {
  orgId.value = row.orgId
  dialogVisible.value = true
  try {
    const res = await userLoginH5UserByOrgId({ orgId: row.orgId })
    operatorList.value = res.data || []
    operatorList.value.forEach(item => {
      item.isNew = false
    })
  } catch (error) {
    console.error('获取操作员列表失败:', error)
    ElMessage.error('获取操作员列表失败')
  }
}

const addH5Operator = () => {
  let item
  if (operatorList.value.length) {
    item = operatorList.value[0]
  }
  operatorList.value.push({
    phone: '',
    userName: '',
    userType: 1,
    resource: 0,
    isNew: true,
    orgId: item.orgId,
    orgName: item.orgName
  })
}
async function handleInitContract(item) {
  const res = await loanOrgInitContract({ orgId: item.orgId, productId: item.productId, type: 0 })

  if (res.code === 200) {
    ElMessage.success(res.msg)
  }
}
const confirmConfig = async () => {
  const hasEmpty = operatorList.value.some(item => !item.phone || !item.userName)
  if (hasEmpty) {
    ElMessage.warning('请填写完整的手机号和昵称')
    return
  }

  const phoneRegex = /^1[3-9]\d{9}$/
  const hasInvalidPhone = operatorList.value.some(item => !phoneRegex.test(item.phone))
  if (hasInvalidPhone) {
    ElMessage.warning('请输入正确的手机号格式')
    return
  }

  try {
    if (operatorList.value.length === 0) {
      ElMessage.warning('没有需要保存的新操作员')
      return
    }
    let orgId = operatorList.value[0].orgId
    let orgName = operatorList.value[0].orgName
    operatorList.value.map(item => {
      return {
        ...item,
        orgId,
        orgName
      }
    })
    await userLoginH5UserAdd({
      list: operatorList.value.filter(item => +item.userType != 0)
    })
    ElMessage.success('配置成功')
    dialogVisible.value = false
  } catch (error) {
    console.error('配置失败:', error)
    ElMessage.error('配置失败')
  }
}

function handleExport() {
