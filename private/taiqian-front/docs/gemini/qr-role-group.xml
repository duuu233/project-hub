        </el-form-item>
        <div class="qr-system-list">
          <button v-for="name in form.selectedSystem" :key="name" type="button" :class="{ 'is-active': activeName === name }" @click="selectSystemTab(name)">{{ name }}</button>
        </div>
      </Collapse>
      <Collapse title="菜单权限配置" class="qr-permission-tree">
        <el-alert
          :style="{ width: '240px' }"
          v-if="!form.groupsSystemMenuDTOList || !form.groupsSystemMenuDTOList.length"
          title="请先选择关联系统"
          type="info"
        />
        <el-tabs v-else v-model="activeName" @tab-click="handleClick" class="qr-permission-tabs">
          <el-tab-pane v-for="(item, index) in form.selectedSystem" :key="index" :label="item" :name="item">
            <div class="tab-content">
              <el-checkbox
                :disabled="pageType === 3"
                v-model="form.groupsSystemMenuDTOList[index].deptExpand"
                @change="val => handleCheckedTreeExpand(val, index)"
              >
                展开/折叠
              </el-checkbox>
              <el-checkbox
                :disabled="pageType === 3"
                v-model="form.groupsSystemMenuDTOList[index].deptNodeAll"
                @change="val => handleCheckedTreeNodeAll(val, index)"
              >
                全选/全不选
              </el-checkbox>
              <el-tree
                class="tree-border"
                :data="form.groupsSystemMenuDTOList[index].deptOptions"
                show-checkbox
                default-expand-all
                ref="deptRef"
                node-key="id"
                empty-text="加载中，请稍候"
                :props="treeProps"
                @check="handleNodeCheck"
              ></el-tree>
            </div>
          </el-tab-pane>
        </el-tabs>
      </Collapse>
