<script setup>
import LinkedSystemSelect from '@/components/LinkedSystemSelect/index.vue'
import DetailHeaderCard from '@/components/DetailHeaderCard/index.vue'
import { headerTime, dictTagField } from '@/components/DetailHeaderCard/utils'
import Collapse from '@/components/Collapse'
import BottomFixedBtnsBox from '@/components/BottomFixedBtnsBox'
import { addRole, updateRole, getRole } from '@/api/system/role'
import { systemList as systemListApi, menuTreeList as menuTreeListApi } from '@/api/system/user-group'
import { roleMenuTreeselect, treeselect as menuTreeselect } from '@/api/system/menu'
import { filterTreeIds } from '@/utils/treeUtils'
import { onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import { cloneDeep } from 'lodash-es'

import { useRouter } from 'vue-router'
const { push, currentRoute, back, replace } = useRouter()
import router from '@/router'
const _props = defineProps({
  pageType: Number
})
const form = ref({
  roleSystems: [],
  status: '0'
})
const { proxy } = getCurrentInstance()
const { sys_normal_disable } = proxy.useDict('sys_normal_disable')

const deptRef = ref(null)
const formRef = ref()
const systemList = ref([])
const menuOptions = ref([])
const checkedKeysList = ref([])
const filterCheckedKeysList = ref([])
const menuRef = ref()
const activeName = ref()
const treeProps = {
  label: 'label',
  children: 'children',
  disabled: 'disabled'
}
async function getDetails() {
  try {
    const res = await getRole(currentRoute.value.query.id)
    form.value = res.data
    form.value.roleSort = Number(form.value.roleSort)
    form.value.selectedSystem = getSelectedSystem(res.data.roleSystems)

    if (!activeName.value && form.value.selectedSystem.length) {
      activeName.value = form.value.selectedSystem[0]
    }

    if (form.value.roleSystems.length) {
      form.value.roleSystems.forEach((v, index) => {
        filterCheckedKeysList.value.push(filterTreeIds(v.menuOptions, v.menuIds))
      })
    }

    if (filterCheckedKeysList.value && filterCheckedKeysList.value.length) {
      filterCheckedKeysList.value.forEach((v, index) => {
        nextTick(() => {
          menuRef.value[index].setCheckedKeys(v)
        })
      })
    }
    if (_props.pageType === 3) {
      if (!form.value.roleSystems || !form.value.roleSystems.length) return
      form.value.roleSystems.forEach((v, index) => {
        tTreeDisabled(form.value.roleSystems[index].menuOptions)
      })
    }
  } catch (error) {
    console.log(error)
  }
}
const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      if (!form.value.roleSystems.length) {
        ElMessage.warning('没有关联系统')
        return
      }
      let submitData = cloneDeep(form.value)
      let roleSystems = []

      submitData.roleSystems.forEach((v, index) => {
        let item = {
          systemId: v.systemId,
          menuIds: getMenuAllCheckedKeys(menuRef.value[index])
        }
        roleSystems.push(item)
      })
      submitData.roleSystems = roleSystems
      if (_props.pageType === 1) {
        await addRole(submitData)
      }
      if (_props.pageType === 2) {
        await updateRole(submitData)
      }
      ElMessage.success('操作成功')
      setTimeout(() => {
        proxy.toList({
          path: `/system/role`,
          listName: 'Role'
        })
      }, 300)
    } else {
      console.log('error submit!', fields)
    }
  })
}
function changeSystem(v) {
  if (!activeName.value && v.length) {
    activeName.value = v[0]
  }
  if (v.length) {
    v.forEach((item, index) => {
      let menus = systemList.value.filter(o => o.systemName == item)[0].menus
      let systemId = systemList.value.filter(o => o.systemName == item)[0].systemId
      form.value.roleSystems[index] = {
        menuOptions: menus,
        systemId,
        deptCheckStrictly: true,
        deptNodeAll: false,
        deptExpand: true
      }
    })
  }
}
onMounted(async () => {
  await getSystemList()
  if (_props.pageType !== 1) {
    getDetails()
  }
})
async function getSystemList() {
  const res = await menuTreeListApi({})
  systemList.value = res.data || []
  if (systemList.value.length === 1) {
    form.value.selectedSystem = [systemList.value[0].systemName]
    changeSystem([systemList.value[0].systemName])
  }
}

function handleCheckedTreeExpand(value, type, index) {
  if (type == 'menu') {
    let treeList = form.value.roleSystems[index].menuOptions
    for (let i = 0; i < treeList.length; i++) {
      menuRef.value[index].store.nodesMap[treeList[i].id].expanded = value
    }
  } else if (type == 'dept') {
    let treeList = deptOptions.value
    for (let i = 0; i < treeList.length; i++) {
      deptRef.value.store.nodesMap[treeList[i].id].expanded = value
    }
  }
}

function handleCheckedTreeNodeAll(value, type, index) {
  if (type == 'menu') {
    menuRef.value[index].setCheckedNodes(value ? form.value.roleSystems[index].menuOptions : [])
  } else if (type == 'dept') {
    deptRef.value.setCheckedNodes(value ? deptOptions.value : [])
  }
}

function getMenuAllCheckedKeys(ref) {

  let checkedKeys = ref.getCheckedKeys()

  let halfCheckedKeys = ref.getHalfCheckedKeys()
  checkedKeys.unshift.apply(checkedKeys, halfCheckedKeys)
  return checkedKeys
}

function getSelectedSystem(data) {
  if (!data || !data.length) return
  let selectedSystem = []

  data.forEach(v => {
    systemList.value.forEach(value => {
      if (value.systemId === v.systemId) {
        v.menuOptions = value.menus
        v.deptCheckStrictly = true
        v.deptNodeAll = false
        v.deptExpand = true
        selectedSystem.push(value.systemName)
      }
    })
  })
  return selectedSystem
}
function tTreeDisabled(treeData) {
  if (treeData && treeData.length) {
    treeData.forEach(v => {
      v.disabled = true
      if (v.children && v.children.length) {
        tTreeDisabled(v.children)
      }
    })
  }
}
const rules = reactive({
  roleName: [{ required: true, message: '角色名称不能为空', trigger: 'blur' }],

  roleSort: [{ required: true, message: '角色顺序不能为空', trigger: 'blur' }]
})
const detailHeaderFields = computed(() => {
  const data = form.value
  return [
    { label: '角色编号', value: data.roleId },
    { label: '角色名称', value: data.roleName },
    { label: '角色顺序', value: data.roleSort },
    dictTagField('状态', sys_normal_disable, data.status),
    { label: '创建时间', value: headerTime(data.createTime) }
  ]
})
function selectSystemTab(name) {
  activeName.value = name

}

// 选择确认前只改弹框草稿；保留仍关联系统的原生树勾选状态。
async function onLinkedSystemsChange(selected, previous) {
  const checked = new Map(previous.map((name, index) => [name, menuRef.value[index]?.getCheckedKeys() || []]))
  changeSystem(selected)
  if (!selected.includes(activeName.value)) activeName.value = selected[0]
  if (!selected.length) form.value.roleSystems = []
  form.value.roleSystems.splice(selected.length)
  await nextTick()
  selected.forEach((name, index) => {
    menuRef.value[index]?.setCheckedKeys(checked.get(name) || [])
  })
}
</script>
