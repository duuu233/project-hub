    path: '/system/role/edit',
    query: { id: row.roleId }
  })
  return
  reset()
  const roleId = row.roleId || ids.value

  getRole(roleId).then(response => {
    form.value = response.data
    form.value.roleSort = Number(form.value.roleSort)
    form.value.selectedSystem = getSelectedSystem(response.data.roleSystems)
    if (!activeName.value && form.value.selectedSystem.length) {
      activeName.value = form.value.selectedSystem[0]
    }
    setCheckedKeys(form.value.roleSystems)

    open.value = true
    if (filterCheckedKeysList.value && filterCheckedKeysList.value.length) {
