        </el-form-item>
        <div class="qr-system-list">
          <button v-for="name in form.selectedSystem" :key="name" type="button" :class="{ 'is-active': activeName === name }" @click="selectSystemTab(name)">{{ name }}</button>
        </div>
      </Collapse>
      <Collapse title="菜单权限配置" class="qr-permission-tree">
        <div class="roleSystems-box" style="padding: 0 20px 20px 0">
          <el-alert :style="{ width: 240 + 'px' }" v-if="!form.roleSystems || !form?.roleSystems.length" title="请先选择关联系统" type="info" />
          <el-tabs v-else v-model="activeName" class="qr-permission-tabs">
            <template v-for="(item, index) in form.selectedSystem">
              <div class="tab-item-box">
                <el-tab-pane :label="item" :name="item">
                  <el-checkbox
                    :disabled="pageType === 3"
                    v-model="form.roleSystems[index].deptExpand"
                    @change="handleCheckedTreeExpand($event, 'menu', index)"
                    >展开/折叠</el-checkbox
                  >
                  <el-checkbox
                    :disabled="pageType === 3"
                    v-model="form.roleSystems[index].deptNodeAll"
                    @change="handleCheckedTreeNodeAll($event, 'menu', index)"
                    >全选/全不选</el-checkbox
                  >
                  <el-tree
                    class="tree-border"
                    :data="form.roleSystems[index].menuOptions"
                    show-checkbox
                    default-expand-all
                    ref="menuRef"
                    node-key="id"
                    empty-text="加载中，请稍候"
                    :props="treeProps"
                  ></el-tree>
