<script>
import { defineComponent, h, cloneVNode, Fragment, Comment, Text } from 'vue'
import { ElButton, ElDropdown, ElDropdownMenu, ElDropdownItem } from 'element-plus'

const flatten = nodes => nodes.flatMap(node => node.type === Fragment ? flatten(node.children || []) : node.type === Comment || (node.type === Text && !String(node.children).trim()) ? [] : [node])
const allowed = node => (node.dirs || []).every(binding => {
  if (typeof binding.dir.isAllowed === 'function') return binding.dir.isAllowed(binding.value)
  return true
})
const reference = node => typeof node.children?.reference === 'function' ? flatten(node.children.reference()).filter(allowed) : null
const nodeText = node => {
  if (Array.isArray(node)) return node.map(nodeText).join('')
  if (typeof node === 'string' || typeof node === 'number') return String(node)
  if (node?.type === Text || typeof node?.children === 'string') return node.children || ''
  const slot = node?.children?.reference || node?.children?.default
  return typeof slot === 'function' ? nodeText(slot()) : Array.isArray(node?.children) ? nodeText(node.children) : ''
}
const tone = node => {
  const button = reference(node)?.[0] || node
  if (['danger', 'warning', 'success', 'info'].includes(button.props?.type)) return button.props.type
  const label = nodeText(node)
  if (/删除|移除|作废|注销|解绑|清空/.test(label)) return 'danger'
  if (/取消|撤销|撤回|禁用|停用|终止|中止|驳回|退回|拒绝|冻结/.test(label)) return 'warning'
  if (/启用|恢复|解冻|确认|通过|同意|提交/.test(label)) return 'success'
  return 'brand'
}
export default defineComponent({
  name: 'ListRowActions',
  props: { inlineLimit: { type: Number, default: 3 } },
  setup(props, { slots }) {
    return () => {
      const visible = flatten(slots.default?.() || []).filter(allowed).filter(node => {
        const refs = reference(node)
        return refs === null || refs.length > 0
      })
      const limit = Math.max(0, props.inlineLimit)
      const renderAction = (node, index) => h('span', { class: ['qr-row-action', `qr-action-${tone(node)}`], key: node.key ?? index }, [cloneVNode(node)])
      const direct = visible.slice(0, limit).map(renderAction)
      if (visible.length > limit) direct.push(h('span', { class: 'qr-row-action qr-row-more', key: 'more' }, [
        h(ElDropdown, { trigger: 'click', hideOnClick: false, popperClass: 'qr-row-actions-menu' }, {
          default: () => h(ElButton, { link: true, type: 'primary', 'aria-label': '更多操作' }, () => '更多'),
          dropdown: () => h(ElDropdownMenu, null, () => visible.slice(limit).map((node, index) => h(ElDropdownItem, {
            key: node.key ?? index, disabled: (reference(node)?.[0] || node).props?.disabled
          }, () => renderAction(node, index))))
        })
      ]))
      return h('div', { class: 'qr-row-actions' }, direct)
    }
  }
})
</script>
