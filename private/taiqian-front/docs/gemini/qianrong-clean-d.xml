<script setup>
import { computed, reactive, ref } from 'vue'
import TableSearch from '@/components/TableSearch/index.vue'
import BottomFixedBtnsBox from '@/components/BottomFixedBtnsBox/index.vue'
import ListToolbarTitle from '@/components/ListToolbarTitle/index.vue'
import ListRowActions from '@/components/ListRowActions/index.vue'
import { withListGridStyle, listGrid as vListGrid } from '@/utils/listGrid'

const collapsed = ref(false), sidebarHidden = ref(false), allowDelete = ref(true), lastAction = ref(''), gridRef = ref()
// 仅用于演示权限变化。业务页面继续使用应用已注册的 v-hasPermi。
const vHasPermi = { isAllowed: value => !value.includes('demo:delete') || allowDelete.value }
const query = reactive({ companyNo: '', companyName: '', status: '', created: [], customer: '', product: '', updated: '', month: '', area: [], startTime: '', endTime: '' })
const searchOptions = [
  { label: '企业编号', prop: 'companyNo', type: 'input', placeholder: '请输入编号' },
  { label: '企业名称', prop: 'companyName', type: 'input', placeholder: '请输入企业名称' },
  { label: '状态', prop: 'status', type: 'select', placeholder: '全部状态', opts: [{ label: '启用', value: 1 }, { label: '禁用', value: 0 }] },
  { label: '创建时间', prop: 'created', type: 'daterange', format: 'YYYY-MM-DD', searchProps: ['startTime', 'endTime'] },
  { label: '联系人', prop: 'customer', type: 'input', placeholder: '请输入联系人' },
  { label: '金融产品', prop: 'product', type: 'select', placeholder: '全部产品', opts: [{ label: '普惠融资', value: '普惠融资' }, { label: '供应链融资', value: '供应链融资' }] },
  { label: '更新时间', prop: 'updated', type: 'date', format: 'YYYY-MM-DD' },
  { label: '账期', prop: 'month', type: 'month', advanced: true },
  { label: '地区', prop: 'area', type: 'cascader', advanced: true, options: [{ value: 'shanghai', label: '上海', children: [{ value: 'pudong', label: '浦东新区' }] }] }
]
const allRows = ref(Array.from({ length: 67 }, (_, i) => ({ id: i + 1, companyNo: 'QR202610' + String(i + 1).padStart(4, '0'),
  companyName: i % 3 === 0 ? `泰乾示例数字科技有限公司 ${i + 1}` : `示例企业 ${i + 1}`, status: i % 2, customer: `联系人 ${i + 1}`,
  amount: (12345.67 * (i + 1)).toLocaleString('zh-CN', { minimumFractionDigits: 2 }), created: '2026-10-' + String(i % 28 + 1).padStart(2, '0'), product: i % 2 ? '普惠融资' : '供应链融资', updated: '2026-10-11', month: '2026-10', area: ['shanghai', 'pudong'] })))
const filtered = computed(() => allRows.value.filter(row => (!query.companyNo || row.companyNo.includes(query.companyNo)) &&
  (!query.companyName || row.companyName.includes(query.companyName)) && (query.status === '' || row.status === query.status) &&
  (!query.customer || row.customer.includes(query.customer)) && (!query.month || row.month === query.month) &&
  (!query.product || row.product === query.product) && (!query.updated || row.updated === query.updated) &&
  (!query.area?.length || query.area.every((value, index) => row.area[index] === value)) &&
  (!query.created?.length || (row.created >= query.created[0] && row.created <= query.created[1]))))
const gridOptions = reactive(withListGridStyle({
  border: false, stripe: false, columnConfig: { resizable: true }, rowConfig: { isHover: true },
  toolbarConfig: { custom: true, zoom: true, slots: { buttons: 'toolbarButtons' } },
  pagerConfig: { total: 0, currentPage: 1, pageSize: 10, pageSizes: [10, 20, 50], layouts: ['PrevPage', 'Number', 'NextPage', 'Sizes', 'FullJump', 'Total'] },
  columns: [
    { type: 'seq', title: '序号', width: 60, align: 'center' },
    { field: 'companyNo', title: '企业编号', minWidth: 180, slots: { default: 'companyNo' } },
    { field: 'companyName', title: '企业名称', minWidth: 260, showOverflow: true },
    { field: 'customer', title: '联系人', minWidth: 130 },
    { field: 'amount', title: '可用余额（元）', minWidth: 170, align: 'right' },
    { field: 'status', title: '状态', width: 90, align: 'center', slots: { default: 'status' } },
    { field: 'created', title: '创建时间', minWidth: 150, align: 'center' },
    { field: 'active', title: '操作', fixed: 'right', width: 230, slots: { default: 'active' } }
  ], data: []
}))
function loadRows() {
  const pager = gridOptions.pagerConfig
  pager.total = filtered.value.length
  pager.currentPage = Math.min(pager.currentPage, Math.max(1, Math.ceil(pager.total / pager.pageSize)))
  gridOptions.data = filtered.value.slice((pager.currentPage - 1) * pager.pageSize, pager.currentPage * pager.pageSize)
}
function handleSearch() { gridOptions.pagerConfig.currentPage = 1; loadRows() }
function handlePageChange({ currentPage, pageSize }) { Object.assign(gridOptions.pagerConfig, { currentPage, pageSize }); loadRows() }
function handleAction(action, row) { lastAction.value = `${action}${row ? '：' + row.companyNo : ''}` }
function handleDelete(row) { allRows.value = allRows.value.filter(item => item.id !== row.id); handleAction('已删除', row); loadRows() }
loadRows()
defineExpose({ query, searchOptions, gridOptions, gridRef, handleSearch, loadRows, allowDelete, collapsed, sidebarHidden })
</script>

