              placeholder="请选择用户组类别"
              :style="{ width: 240 + 'px' }"
            >
              <el-option v-for="item in user_groups_type" :key="item.value" :label="item.label" :value="item.value" />
            </el-select>
          </el-form-item>
        </el-col>

      </el-row>
    </Collapse>
    <div class="qr-permission-layout">
      <Collapse title="关联系统" class="qr-permission-systems">
        <el-form-item v-if="pageType !== 3" aria-label="关联系统" prop="selectedSystem">
          <LinkedSystemSelect v-model="form.selectedSystem" :options="systemList" :disabled="pageType === 3" @change="onLinkedSystemsChange" @remove-tag="removeSystem" />
        </el-form-item>
        <div class="qr-system-list">
          <button v-for="name in form.selectedSystem" :key="name" type="button" :class="{ 'is-active': activeName === name }" @click="selectSystemTab(name)">{{ name }}</button>
        </div>
      </Collapse>
      <Collapse title="菜单权限配置" class="qr-permission-tree">
        <el-alert
          :style="{ width: '240px' }"
          v-if="!form.groupsSystemMenuDTOList || !form.groupsSystemMenuDTOList.length"
          title="请先选择关联系统"
          type="info"
        />
        <el-tabs v-else v-model="activeName" @tab-click="handleClick" class="qr-permission-tabs">
          <el-tab-pane v-for="(item, index) in form.selectedSystem" :key="index" :label="item" :name="item">
            <div class="tab-content">
              <el-checkbox
                :disabled="pageType === 3"
                v-model="form.groupsSystemMenuDTOList[index].deptExpand"
                @change="val => handleCheckedTreeExpand(val, index)"
              >
                展开/折叠
              </el-checkbox>
              <el-checkbox
                :disabled="pageType === 3"
                v-model="form.groupsSystemMenuDTOList[index].deptNodeAll"
                @change="val => handleCheckedTreeNodeAll(val, index)"
              >
                全选/全不选
              </el-checkbox>
              <el-tree
                class="tree-border"
                :data="form.groupsSystemMenuDTOList[index].deptOptions"
                show-checkbox
                default-expand-all
                ref="deptRef"
                node-key="id"
                empty-text="加载中，请稍候"
                :props="treeProps"
                @check="handleNodeCheck"
              ></el-tree>
            </div>
          </el-tab-pane>
        </el-tabs>
      </Collapse>
    </div>
    <BottomFixedBtnsBox>
      <el-button v-throttle type="info" @click="router.back()" size="large">{{ +pageType === 3 ? '返回' : '取消' }}</el-button>
      <el-button v-if="pageType !== 3" v-throttle type="primary" @click="submit" size="large">提交</el-button>
    </BottomFixedBtnsBox>
  </el-form>
</template>

<script setup>
import LinkedSystemSelect from '@/components/LinkedSystemSelect/index.vue'
import DetailHeaderCard from '@/components/DetailHeaderCard/index.vue'
import { headerTime, dictTagField } from '@/components/DetailHeaderCard/utils'
import BottomFixedBtnsBox from '@/components/BottomFixedBtnsBox/index.vue'
import { ref, reactive, onMounted, watchEffect, getCurrentInstance, nextTick } from 'vue'
import { useRouter } from 'vue-router'
import { ElMessage } from 'element-plus'
import { cloneDeep } from 'lodash-es'
import Collapse from '@/components/Collapse'
import { treeselect as menuTreeselect } from '@/api/system/menu'
import { systemList as systemListApi, addUserGroups, editUserGroups, detailUserGroups } from '@/api/system/user-group'

const { currentRoute } = useRouter()
const router = useRouter()
const props = defineProps({
  pageType: Number
})

const form = ref({
  groupsSystemMenuDTOList: [],
  selectedSystem: [],
  status: 0
})

const treeProps = {
  label: 'label',
  children: 'children',
  disabled: 'disabled'
}

const formRef = ref()
const deptOptions = ref([])
const systemList = ref([])
const activeName = ref()
const deptRef = ref([])

const rules = reactive({
  userGroupsName: [{ required: true, message: '请输入用户组名称', trigger: 'blur' }],
  userGroupsType: [{ required: true, message: '请选择用户组类别', trigger: 'change' }],
  selectedSystem: [{ required: true, message: '请选择关联系统', trigger: 'change' }]
})

const { proxy } = getCurrentInstance()
const { user_groups_type } = proxy.useDict('user_groups_type')

watchEffect(() => {
  if ((props.pageType === 1 || props.pageType === 2) && form.value.selectedSystem && form.value.selectedSystem.length) {
    form.value.groupsSystemMenuDTOList = form.value.selectedSystem.map(name => ({
      deptOptions: deptOptions.value,
      deptCheckStrictly: false,
      deptNodeAll: false,
      deptExpand: true,
      menuList: [],
      systemName: name
    }))
  }
})

function changeSystem(v) {
  if (!activeName.value && v.length) {
    activeName.value = v[0]
  }
}

function removeSystem(v) {
  if (v && form.value.groupsSystemMenuDTOList && form.value.groupsSystemMenuDTOList.length) {
    form.value.groupsSystemMenuDTOList = form.value.groupsSystemMenuDTOList.filter(value => value.systemName !== v)
  }
}

async function getSystemList() {
  const res = await systemListApi({ status: 0, pageNum: 1, pageSize: 500 })
  systemList.value = res.rows || []
  if (systemList.value.length === 1) {
    form.value.selectedSystem = [systemList.value[0].systemName]
    activeName.value = form.value.selectedSystem[0]
  }
}

async function getDetails() {
  try {
    const res = await detailUserGroups({
      id: currentRoute.value.query.id
    })

    form.value = res.data
    form.value.selectedSystem = []
    form.value.userGroupsType = form.value.userGroupsType + ''
    form.value.groupsSystemMenuDTOList = form.value.groupsSystemMenuDTOList || []

    if (form.value.groupsSystemMenuDTOList.length) {
      form.value.groupsSystemMenuDTOList.forEach((v, index) => {
        v.deptOptions = deptOptions.value
        v.deptCheckStrictly = false
        v.deptNodeAll = false
        v.deptExpand = true
        let names = systemList.value.filter(item => v.systemId === item.id)
        if (names.length) {
          form.value.selectedSystem.push(names[0].systemName)
        }
        v.systemName = form.value.selectedSystem[index]
        nextTick(() => {
          deptRef.value[index].setCheckedKeys(filterParentNodes(v.menuList, form.value.groupsSystemMenuDTOList[index].deptOptions))
          if (props.pageType === 3) {
            tTreeDisabled(form.value.groupsSystemMenuDTOList[index].deptOptions)
          }
        })
      })

      if (!activeName.value && form.value.selectedSystem.length) {
        activeName.value = form.value.selectedSystem[0]
      }
    }
  } catch (error) {
    ElMessage.error('获取详情失败')
  }
}

function filterParentNodes(menuList, treeData) {
  return menuList.filter(id => !isParent(treeData, id))
}

function isParent(tree, id) {
  const stack = [...tree]
  while (stack.length) {
    const node = stack.pop()
    if (node.id === id && node.children && node.children.length > 0) {
      return true
    }
    if (node.children) {
      stack.push(...node.children)
    }
  }
  return false
}

function getMenuAllCheckedKeys(ref) {
  const checkedNodes = ref.getCheckedNodes(false, true)

  function getAllParentIds(nodeId) {
    const parentIds = []
    let currentNode = ref.getNode(nodeId)

    while (currentNode && currentNode.data.parentId !== 0) {
      parentIds.push(currentNode.data.id)
      currentNode = ref.getNode(currentNode.data.parentId)
    }

    return parentIds
  }

  const allIds = checkedNodes.flatMap(item => {
    const parentIds = getAllParentIds(item.parentId)
    return [item.id, item.parentId, ...parentIds]
  })

  const ids = [...new Set(allIds)].filter(item => item !== '0' && item !== 0 && item)

  return ids
}

const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      let submitData = cloneDeep(form.value)
      submitData.groupsSystemMenuDTOList = []

      if (!form.value.selectedSystem.length) {
        ElMessage.warning('请选择关联系统')
        return
      }

      delete submitData.selectedSystem

      let hasEmptyMenu = false
      let emptySystemNames = []

      form.value.groupsSystemMenuDTOList.forEach((v, index) => {
        const systemName = form.value.selectedSystem[index]
        const systemId = systemList.value.find(o => o.systemName === systemName)?.id
        let menuList = getMenuAllCheckedKeys(deptRef.value[index])

        if (menuList.length === 0) {
          hasEmptyMenu = true
          emptySystemNames.push(systemName)
        }

        let item = {
          systemId: systemId,
          menuList: menuList
        }
        submitData.groupsSystemMenuDTOList.push(item)
      })

      if (hasEmptyMenu) {
        ElMessage.warning(`系统 "${emptySystemNames.join(',')}" 至少需要选择一个菜单`)
        return
      }

      try {
        if (props.pageType === 1) {
          await addUserGroups(submitData)
        }
        if (props.pageType === 2) {
          await editUserGroups(submitData)
        }
        ElMessage.success('操作成功')

        setTimeout(() => {
          proxy.toList({
            path: `/system/user-group`,
            listName: 'User-group'
          })

        }, 300)
      } catch (error) {
        ElMessage.error('操作失败：' + error.message)
      }
    } else {
    }
  })
}

function handleClick(tab) {
  updateMenuList()
}

function updateMenuList() {
  let list = form.value.groupsSystemMenuDTOList
  if (list && list.length) {
    list.forEach((v, i) => {
      v.menuList = getMenuAllCheckedKeys(deptRef.value[i])
      v.systemName = form.value.selectedSystem[i]
    })
  }
}

async function getMenuTreeselect() {
  const res = await menuTreeselect()
  deptOptions.value = res.data
}

function tTreeDisabled(treeData) {
  if (treeData && treeData.length) {
    treeData.forEach(v => {
      v.disabled = true
      if (v.children && v.children.length) {
        tTreeDisabled(v.children)
      }
    })
  }
}

function handleCheckedTreeExpand(value, index) {
  let treeList = form.value.groupsSystemMenuDTOList[index].deptOptions
  for (let i = 0; i < treeList.length; i++) {
    deptRef.value[index].store.nodesMap[treeList[i].id].expanded = value
  }
}

function handleCheckedTreeNodeAll(value, index) {
  deptRef.value[index].setCheckedNodes(value ? form.value.groupsSystemMenuDTOList[index].deptOptions : [])
}

function handleNodeCheck(data, checked) {
  const currentSystemIndex = form.value.selectedSystem.findIndex(system => system === activeName.value)
  if (currentSystemIndex !== -1) {
    form.value.groupsSystemMenuDTOList[currentSystemIndex].menuList = getMenuAllCheckedKeys(deptRef.value[currentSystemIndex])
  }
}

onMounted(async () => {
  try {
    await getSystemList()
    await getMenuTreeselect()
    if (props.pageType !== 1) {
      await getDetails()
    }
  } catch (error) {
    ElMessage.error('初始化失败')
  }
})
const detailHeaderFields = computed(() => {
  const data = form.value
  return [
    { label: '用户组编号', value: data.userGroupsCode },
    { label: '用户组名称', value: data.userGroupsName },
    dictTagField('用户组类别', user_groups_type, data.userGroupsType),
    dictTagField('状态', { 0: '启用中', 1: '已禁用' }, data.status),
    { label: '创建时间', value: headerTime(data.createTime) }
  ]
})
function selectSystemTab(name) {
  activeName.value = name
  handleClick()
}

// 选择确认前只改弹框草稿；保留仍关联系统的原生树勾选状态。
async function onLinkedSystemsChange(selected, previous) {
  const checked = new Map(previous.map((name, index) => [name, deptRef.value[index]?.getCheckedKeys() || []]))
  changeSystem(selected)
  if (!selected.includes(activeName.value)) activeName.value = selected[0]
  if (!selected.length) form.value.groupsSystemMenuDTOList = []

  await nextTick()
  selected.forEach((name, index) => {
    deptRef.value[index]?.setCheckedKeys(checked.get(name) || [])
  })
}
</script>

