<file path="apps/qianrong/src/plugins/eventBus.js">
class EventBus {
  constructor() {
    this.events = {}
    this.debug = false
  }

  setDebug(enabled) {
    this.debug = enabled
  }

  on(eventName, callback) {
    if (!this.events[eventName]) {
      this.events[eventName] = []
    }
    this.events[eventName].push(callback)

    if (this.debug) {
      console.log(`[EventBus] 添加监听器: ${eventName}, 当前监听器数量: ${this.events[eventName].length}`)
    }
  }

  off(eventName, callback) {
    if (!this.events[eventName]) return

    if (!callback) {

      const count = this.events[eventName].length
      delete this.events[eventName]
      if (this.debug) {
        console.log(`[EventBus] 清除所有监听器: ${eventName}, 清除数量: ${count}`)
      }
      return
    }

    const originalLength = this.events[eventName].length
    this.events[eventName] = this.events[eventName].filter(cb => cb !== callback)

    if (this.events[eventName].length === 0) {
      delete this.events[eventName]
    }

    if (this.debug) {
      console.log(`[EventBus] 移除监听器: ${eventName}, 移除前: ${originalLength}, 移除后: ${this.events[eventName]?.length || 0}`)
    }
  }

  emit(eventName, ...args) {
    if (!this.events[eventName]) {
      if (this.debug) {
        console.log(`[EventBus] 触发事件但无监听器: ${eventName}`)
      }
      return
    }

    if (this.debug) {
      console.log(`[EventBus] 触发事件: ${eventName}, 监听器数量: ${this.events[eventName].length}`, args)
    }

    this.events[eventName].forEach(callback => {
      try {
        callback(...args)
      } catch (error) {
        console.error(`Error in event listener for ${eventName}:`, error)
      }
    })
  }

  clear() {
    const eventNames = Object.keys(this.events)
    this.events = {}

    if (this.debug) {
      console.log(`[EventBus] 清除所有事件监听器, 清除事件: ${eventNames.join(', ')}`)
    }
  }

  getStats() {
    const stats = {}
    Object.keys(this.events).forEach(eventName => {
      stats[eventName] = this.events[eventName].length
    })
    return stats
  }

  printStats() {
    const stats = this.getStats()
    console.table(stats)
  }
}

const eventBus = new EventBus()

if (process.env.NODE_ENV === 'development') {
  eventBus.setDebug(true)

  window.__eventBus__ = eventBus
}

export default {
  install(app) {

    app.config.globalProperties.$eventBus = eventBus
    app.provide('eventBus', eventBus)
  }
}

export { eventBus }
</file>

