  const rawRedirect =
    typeof redirect === 'string' && redirect.trim()
      ? redirect.trim()
      : typeof redirect?.fullPath === 'string' && redirect.fullPath
        ? redirect.fullPath
        : getCurrentLocationPath()

  if (!rawRedirect) {
    return '/'
  }

  try {
    const resolvedUrl = new URL(rawRedirect, window.location.origin)
    if (resolvedUrl.pathname === '/login') {
      const nestedRedirect = resolvedUrl.searchParams.get('redirect')
      return nestedRedirect ? safeDecodeURIComponent(nestedRedirect) : '/'
    }
  } catch (error) {}

  return rawRedirect
}

export function buildLoginRouteLocation(redirect) {
  const resolvedRedirect = resolveLoginRedirectPath(redirect)
  return {
    path: '/login',
    query: resolvedRedirect ? { redirect: resolvedRedirect } : {}
  }
}

export function buildLoginHref(redirect) {
  const resolvedRedirect = resolveLoginRedirectPath(redirect)
  return resolvedRedirect ? `/login?redirect=${encodeURIComponent(resolvedRedirect)}` : '/login'
}

export function redirectToLogin({ router, next, redirect, replace = true } = {}) {
  const routeLocation = buildLoginRouteLocation(redirect)

  if (isLocalDevelopmentLoginMode()) {
    if (typeof next === 'function') {
      next(routeLocation)
      return routeLocation
    }

    if (router) {
      return replace ? router.replace(routeLocation) : router.push(routeLocation)
    }
  }

  window.location.assign(buildLoginHref(redirect))
  if (typeof next === 'function') {
    next(false)
  }
  return routeLocation
}
