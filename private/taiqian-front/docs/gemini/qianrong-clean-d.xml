<script setup name="Notice">
import { withListGridStyle, listGrid as vListGrid } from '@/utils/listGrid'
import ListToolbarTitle from '@/components/ListToolbarTitle/index.vue'
import ListRowActions from '@/components/ListRowActions/index.vue'

import { listNotice, getNotice, delNotice, addNotice, updateNotice } from '@/api/system/notice'
import TableSearch from '@/components/TableSearch'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'
const { proxy } = getCurrentInstance()
const { sys_notice_status, sys_notice_type } = proxy.useDict('sys_notice_status', 'sys_notice_type')
const gridRef = ref()

const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const open = ref(false)
const ids = ref([])
const single = ref(true)
const multiple = ref(true)
const title = ref('')

const query = reactive({})
const handleSearch = () => {
  queryParams.value.pageNum = 1
  getList()
}

const searchOpt = ref([
  {
    type: 'input',
    label: '公告标题：',
    placeholder: '请输入',
    prop: 'noticeTitle'
  },
  { type: 'input', label: '操作人员：', placeholder: '请输入', prop: 'createBy' },
  { type: 'select', label: '类型：', opts: sys_notice_type, placeholder: '请选择', prop: 'noticeType' }
])

const data = reactive({
  form: {},
  queryParams: {
    pageNum: 1,
    pageSize: 10,
    noticeTitle: undefined,
    createBy: undefined,
    noticeType: undefined
  },
  rules: {
    noticeTitle: [{ required: true, message: '公告标题不能为空', trigger: 'blur' }],
    noticeType: [{ required: true, message: '公告类型不能为空', trigger: 'change' }]
  }
})

const { queryParams, form, rules } = toRefs(data)

const gridOptions = reactive(withListGridStyle({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true,
    slots: {
      buttons: 'toolbarButtons'
    }
  },
  columns: [
    { type: 'seq', width: 70 },
    { title: '公告编号', field: 'noticeId', minWidth: 70, showOverflow: true },
    { title: '公告标题', field: 'noticeTitle', minWidth: 200, showOverflow: true },
    { title: '公告类型', field: 'noticeType', minWidth: 100, align: 'center', slots: { default: 'noticeTypeRender' } },
    { title: '状态', field: 'status', minWidth: 100, align: 'center', slots: { default: 'statusRender' } },
    { title: '创建者', field: 'createBy', minWidth: 100, align: 'center' },
    { title: '创建时间', field: 'createTime', minWidth: 100, align: 'center', slots: { default: 'createTimeRender' } },
    { title: '操作', field: 'active', minWidth: 150, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
}))

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    queryParams.value.pageNum = currentPage
    queryParams.value.pageSize = pageSize
    getList()
  },
  checkboxChange({ records }) {
    handleSelectionChange(records)
  },
  checkboxAll({ records }) {
    handleSelectionChange(records)
  }
}

function getList() {
  gridOptions.loading = true
  listNotice({
    ...queryParams.value,
    ...query
  }).then(response => {
    gridOptions.data = response.rows
    gridOptions.pagerConfig.total = response.total * 1
    gridOptions.pagerConfig.currentPage = queryParams.value.pageNum
    gridOptions.pagerConfig.pageSize = queryParams.value.pageSize
    gridOptions.loading = false
  })
}

function cancel() {
  open.value = false
  reset()
}

function reset() {
  form.value = {
    noticeId: undefined,
    noticeTitle: undefined,
    noticeType: undefined,
    noticeContent: undefined,
    status: '0'
  }
  proxy.resetForm('noticeRef')
}

function handleSelectionChange(selection) {
  ids.value = selection.map(item => item.noticeId)
  single.value = selection.length != 1
  multiple.value = !selection.length
}

function handleAdd() {
  reset()
  open.value = true
  title.value = '添加公告'
}

function handleUpdate(row) {
  reset()
  getNotice(row.noticeId).then(response => {
    form.value = response.data
    open.value = true
    title.value = '修改公告'
  })
}

function submitForm() {
  proxy.$refs['noticeRef'].validate(valid => {
    if (valid) {
      if (form.value.noticeId != undefined) {
        updateNotice(form.value).then(response => {
          proxy.$modal.msgSuccess('修改成功')
          open.value = false
          getList()
        })
      } else {
        addNotice(form.value).then(response => {
          proxy.$modal.msgSuccess('新增成功')
          open.value = false
          getList()
        })
      }
    }
  })
}

function handleDelete(row) {
