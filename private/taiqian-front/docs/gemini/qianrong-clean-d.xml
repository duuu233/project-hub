    (function () {
      function isRunningInIframe() {
        try {
          return window.self !== window.top
        } catch (error) {
          return true
        }
      }

      try {
        var searchParams = new URLSearchParams(window.location.search || '')
        var source = String(searchParams.get('source') || '').trim().toLowerCase()
        var isEmbeddedEntry = searchParams.get('embed') === '1'
        var nestedFrom = String(searchParams.get('from') || '').trim()
        var referrer = String(document.referrer || '').toLowerCase()

        if (!isEmbeddedEntry && nestedFrom) {
          try {
            var nestedUrl = new URL(decodeURIComponent(nestedFrom), window.location.origin)
            isEmbeddedEntry = nestedUrl.searchParams.get('embed') === '1'
            if (!source) {
              source = String(nestedUrl.searchParams.get('source') || '').trim().toLowerCase()
            }
          } catch (error) {}
        }

        if (
          isEmbeddedEntry ||
          isRunningInIframe() ||
          source === 'data-integration' ||
          source === 'dataintegration' ||
          source === 'sjjc' ||
          referrer.indexOf('dataintegration') > -1 ||
          referrer.indexOf('data-integration') > -1
