<file path="apps/qianrong/src/components/Upload/multiple-image/index.vue">
<template>
  <div class="upload-box">
    <el-upload
      :key="uploadKey"
      action="/api-qianrong/upload/name/file/upload"
      list-type="picture-card"
      v-model:file-list="fileListCom"
      :multiple="uploadParams.multiple"
      :accept="uploadParams.accept"
      :disabled="uploadParams.disabled"
      :on-error="handleError"
      :limit="uploadParams.limit"
      :before-upload="beforeUpload"
      :on-success="handleSuccess"
      :auto-upload="true"
      :class="{
        hide: fileListCom.length >= uploadParams.limit || uploadParams.disabled
      }"
    >
      <el-icon><Plus /></el-icon>
      <template #file="{ file }">
        <div>
          <img class="el-upload-list__item-thumbnail" :src="file.url" alt="" />
          <span class="el-upload-list__item-actions">
            <span class="el-upload-list__item-preview" @click="handlePictureCardPreview(file)">
              <el-icon><zoom-in /></el-icon>
            </span>
            <span v-if="!uploadParams.disabled" class="el-upload-list__item-delete" @click="handleRemove(file)">
              <el-icon><Delete /></el-icon>
            </span>
          </span>
        </div>
      </template>
    </el-upload>

    <el-radio-group v-model="radio1" class="ml-4" v-if="!uploadParams.disabled && uploadParams.limit > 1" @change="radioChange">
      <div v-for="(item, index) in fileListCom" :key="index" class="radio-item">
        <el-radio :label="index" size="large">设为主图</el-radio>
      </div>
    </el-radio-group>
    <el-dialog v-model="dialogVisible">
      <img w-full :src="dialogImageUrl" alt="Preview Image" />
    </el-dialog>
  </div>
</template>

<script setup>
import { reactive, ref, watchEffect, computed } from 'vue'
import { Delete, Plus, ZoomIn } from '@element-plus/icons-vue'
import { ElMessage } from 'element-plus'

const props = defineProps({
  fileList: {
    type: Array,
    default: () => []
  },
  limit: {
    type: Number,
    default: 6
  },
  acceptSize: {
    type: Number,
    default: 10
  },
  disabled: {
    type: Boolean,
    default: false
  }
})

const emit = defineEmits(['update:fileList'])

const baseUrl = '/api-qianrong'
const uploadKey = ref(0)
const radio1 = ref(0)
const uploadParams = reactive({
  accept: '.jpg,.jpeg,.png,.gif.JPG,.JPEG,.PNG,.GIF',
  limit: props.limit,
  acceptSize: props.acceptSize,
  disabled: props.disabled,
  multiple: false
})

const uploadList = ref([])
const fileListCom = computed({
  get() {
    return props.fileList || uploadList.value
  },
  set(value) {
    uploadList.value = value
    emit('update:fileList', value)
  }
})

const dialogImageUrl = ref('')
const dialogVisible = ref(false)

function handleSuccess(response, file) {
  const fileItem = {
    name: response.data.name,
    url: baseUrl + response.data.url
  }
  fileListCom.value = [...fileListCom.value, fileItem]
  ElMessage.success('上传成功')
}

function handleRemove(file) {
  const url = file.response ? baseUrl + file.response.data.url : file.url
  fileListCom.value = fileListCom.value.filter(v => v.url !== url)
}

function handleError() {
  ElMessage.error('上传失败')
}

function handlePictureCardPreview(file) {
  dialogImageUrl.value = file.url
  dialogVisible.value = true
}

watchEffect(() => {
  if (props.fileList && props.fileList.length) {
    uploadList.value = props.fileList
  }
})

function beforeUpload(file) {
  if (file.size > uploadParams.acceptSize * 1024 * 1024) {
    ElMessage.error(`请上传${uploadParams.acceptSize}MB以内的文件`)
    return false
  }
  return true
}

function radioChange(val) {
  const oldVal = radio1.value
  if (val !== oldVal) {
    const temp = fileListCom.value[val]
    fileListCom.value[val] = fileListCom.value[oldVal]
    fileListCom.value[oldVal] = temp
