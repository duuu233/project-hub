import Collapse from '@/components/Collapse'

import { addMenu, delMenu, getMenu, listMenu, updateMenu } from '@/api/system/menu'
import SvgIcon from '@/components/SvgIcon'
import IconSelect from '@/components/IconSelect'
import { onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import { cloneDeep } from 'lodash-es'
import { useRouter } from 'vue-router'
const { push, currentRoute, back, replace } = useRouter()
const _props = defineProps({
  pageType: Number
})
const form = ref({
  status: '0',
  isCache: '0'
})
const { proxy } = getCurrentInstance()
const { sys_show_hide, sys_normal_disable } = proxy.useDict('sys_show_hide', 'sys_normal_disable')
const menuOptions = ref()
const formRef = ref()
const iconSelectRef = ref(null)
async function getDetails() {
  try {
    const res = await getMenu(currentRoute.value.query.id)
    form.value = res.data
  } catch (error) {
    console.log(error)
  }
}
const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      if (_props.pageType === 1) {
        await addMenu(form.value)
      }
      if (_props.pageType === 2) {
        await updateMenu(form.value)
      }
      ElMessage.success('操作成功')
      setTimeout(() => {
        proxy.toList({
          path: `/system/menu`,
          listName: 'Menu'
        })
      }, 300)
    } else {
      console.log('error submit!', fields)
    }
  })
}

onMounted(async () => {
  await getTreeselect()
  let parentId = currentRoute.value.query.parentId
  if (parentId) {
    form.value.parentId = parentId
  }

  if (_props.pageType !== 1) {
    getDetails()
  }
})

async function getTreeselect() {
  menuOptions.value = []
  await listMenu().then(response => {
    const menu = { menuId: '0', menuName: '主类目', children: [] }
    menu.children = proxy.handleTree(response.data, 'menuId')
    menuOptions.value.push(menu)
    console.log(' menuOptions.value22', menuOptions.value)
  })
}

function showSelectIcon() {
  iconSelectRef.value.reset()
}

function selected(name) {
  form.value.icon = name
}
const rules = reactive({
  menuName: [{ required: true, message: '菜单名称不能为空', trigger: 'blur' }],
  orderNum: [{ required: true, message: '菜单顺序不能为空', trigger: 'blur' }],
  path: [{ required: true, message: '路由地址不能为空', trigger: 'blur' }]
})
const detailHeaderFields = computed(() => {
  const data = form.value
  return [
    { label: '菜单编号', value: data.menuId },
    { label: '菜单名称', value: data.menuName },
    dictTagField('菜单类型', { M: '目录', C: '菜单', F: '按钮' }, data.menuType, {}),
    { label: '路由地址', value: data.path },
