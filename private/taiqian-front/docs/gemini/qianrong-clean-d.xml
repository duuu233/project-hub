export function filterTreeIds(tree, idSet, idKey = 'id', childrenKey = 'children') {
  if (!tree || !Array.isArray(tree) || !idSet || !Array.isArray(idSet)) {
    return []
  }

  const idSetMap = new Set(idSet)
  const result = new Set()

  function checkAllDescendants(node) {
    if (!node) return false

    if (!idSetMap.has(node[idKey])) {
      return false
    }

    if (!node[childrenKey] || !Array.isArray(node[childrenKey]) || node[childrenKey].length === 0) {
      return true
    }

    for (const child of node[childrenKey]) {
      if (!checkAllDescendants(child)) {
        return false
      }
    }

    return true
  }

  function traverse(nodes) {
    if (!Array.isArray(nodes)) return

    for (const node of nodes) {
      if (checkAllDescendants(node)) {
        result.add(node[idKey])
      }

      if (node[childrenKey] && Array.isArray(node[childrenKey])) {
        traverse(node[childrenKey])
      }
    }
  }

  traverse(tree)

  return Array.from(result)
}
