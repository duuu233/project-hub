<file path="apps/qianrong/src/components/TableSearch/index.vue">
<template>
  <section ref="card" class="search-container qr-search-card" :style="{ '--qr-search-columns': columnCount }">
    <el-form ref="searchRef" :model="query" label-position="top" @submit.prevent="runSearch">
      <div class="qr-search-main">
        <div class="qr-search-fields">
          <el-form-item v-for="item in mainOptions" :key="item.prop" :label="labelText(item)" :prop="item.prop" :style="fieldStyle(item)">
            <SearchField :query="query" :item="item" />
          </el-form-item>
        </div>
        <div class="qr-search-actions">
          <el-button class="qr-search-submit" type="primary" :icon="Search" @click="runSearch">搜索</el-button>
          <el-button class="qr-search-reset" :icon="Refresh" @click="resetForm">重置</el-button>
        </div>
      </div>
      <div v-if="showAll && extraOptions.length" class="qr-search-fields qr-search-advanced">
        <el-form-item v-for="item in extraOptions" :key="item.prop" :label="labelText(item)" :prop="item.prop" :style="fieldStyle(item)">
          <SearchField :query="query" :item="item" />
        </el-form-item>
      </div>
    </el-form>
    <div v-if="selected.length" class="qr-search-tags" aria-label="已选条件">
      <span>已选条件</span>
      <el-tag v-for="item in selected" :key="item.prop" :closable="!item.disabled" @close="clearField(item)">{{ labelText(item) }}：{{ displayValue(item) }}</el-tag>
    </div>
    <button v-if="extraOptions.length" class="qr-search-toggle" type="button" :aria-expanded="showAll" @click="showAll = !showAll">
      {{ showAll ? '收起筛选' : '更多筛选' }}<el-icon><ArrowUp v-if="showAll" /><ArrowDown v-else /></el-icon>
    </button>
  </section>
</template>

<script setup>
import { computed, ref, watch, watchEffect, onMounted, onBeforeUnmount, nextTick } from 'vue'
import { Search, Refresh, ArrowDown, ArrowUp } from '@element-plus/icons-vue'
import dayjs from 'dayjs'
import SearchField from './SearchField.vue'

const props = defineProps({
  query: { type: Object, required: true },
  options: { type: Array, required: true },
  search: { type: Function, default: () => {} },
  reset: { type: Function, default: null }
})
const card = ref(), searchRef = ref(), width = ref(1000), showAll = ref(false)
const initial = new Map()
const copy = value => value instanceof Date ? new Date(value) : Array.isArray(value) ? value.map(copy)
  : value && typeof value === 'object' ? Object.fromEntries(Object.entries(value).map(([key, item]) => [key, copy(item)])) : value
watch(() => props.options, options => options.forEach(item => {
  if (!initial.has(item.prop)) initial.set(item.prop, copy(props.query[item.prop]))
}), { immediate: true, deep: true })
const columnCount = computed(() => {
  const w = width.value
  const desired = w < 560 ? 1 : w < 900 ? 3 : w < 1472 ? 4 : w < 2272 ? 5 : w < 3072 ? 6 : 7
  // 留出搜索/重置位置，普通控件至少 200px；窄容器自动减列。
  const available = w - 28 - (w > 600 ? 184 : 0)
  return Math.max(1, Math.min(desired, Math.floor((available + 16) / 216)))
})
const fieldSpan = item => Math.min(columnCount.value, Math.max(1, Number(item.span) || 1))
const mainOptions = computed(() => {
  let used = 0
  return props.options.filter(item => {
    if (item.advanced || used + fieldSpan(item) > columnCount.value) return false
    used += fieldSpan(item)
    return true
  })
})
const extraOptions = computed(() => props.options.filter(item => !mainOptions.value.includes(item)))
const fieldStyle = item => ({ gridColumn: `span ${fieldSpan(item)}` })
const labelText = item => String(item.label || ' ').replace(/[：:]$/, '')
const hasValue = value => value !== '' && value !== undefined && value !== null && (!Array.isArray(value) || value.length > 0)
const selected = computed(() => props.options.filter(item => hasValue(props.query[item.prop])))
const displayValue = item => {
  const value = props.query[item.prop]
  if (item.type === 'select') return item.opts?.find(opt => opt.value === value)?.label ?? value
  if (item.type === 'daterange') return value.map(v => dayjs(v).format('YYYY-MM-DD')).join(' 至 ')
  if (item.type === 'date') return dayjs(value).format('YYYY-MM-DD')
  if (item.type === 'cascader') {
    const values = Array.isArray(value) ? value : [value]
    const valueKey = item.props?.value || 'value', labelKey = item.props?.label || 'label', childrenKey = item.props?.children || 'children'
    const find = (nodes, v) => {
      for (const node of nodes || []) {
        if (node[valueKey] === v) return node[labelKey]
        const nested = find(node[childrenKey], v)
        if (nested !== undefined) return nested
      }
    }
    return values.map(v => find(item.options, v) ?? v).join(' / ')
  }
  return String(value)
}
const runSearch = async () => { await nextTick(); props.search() }
const clearField = async item => { if (item.disabled) return; props.query[item.prop] = item.type === 'daterange' || item.type === 'cascader' ? [] : ''; await runSearch() }
const resetForm = async () => {
  // 高级条件未挂载在表单时，resetFields 不会重置它们，因此按初始值重置全部配置项。
  props.options.forEach(item => { props.query[item.prop] = copy(initial.get(item.prop)) })
  searchRef.value?.clearValidate()
  await nextTick()
  if (props.reset) props.reset()
  else await runSearch()
}
watchEffect(() => props.options.forEach(item => {
  if (item.type !== 'daterange' || !item.searchProps || item.searchProps.length < 2) return
  const value = props.query[item.prop]
  props.query[item.searchProps[0]] = value?.length === 2 ? dayjs(value[0]).format('YYYY-MM-DD HH:mm:ss') : ''
  props.query[item.searchProps[1]] = value?.length === 2 ? dayjs(value[1]).format('YYYY-MM-DD') + ' 23:59:59' : ''
}))
let observer, resizeFrame = 0
onMounted(() => {
  observer = new ResizeObserver(entries => {
    const nextWidth = entries[0].contentRect.width + 28
    if (Math.abs(nextWidth - width.value) < .5) return
    cancelAnimationFrame(resizeFrame)
    resizeFrame = requestAnimationFrame(() => { width.value = nextWidth })
  })
  observer.observe(card.value)
})
onBeforeUnmount(() => { observer?.disconnect(); cancelAnimationFrame(resizeFrame) })
defineExpose({ resetForm, runSearch })
</script>
