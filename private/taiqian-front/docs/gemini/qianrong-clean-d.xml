        </el-form-item>
        <div class="qr-system-list">
          <button v-for="name in form.selectedSystem" :key="name" type="button" :class="{ 'is-active': activeName === name }" @click="selectSystemTab(name)">{{ name }}</button>
        </div>
      </Collapse>
      <Collapse title="菜单权限配置" class="qr-permission-tree">
        <div class="roleSystems-box" style="padding: 0 20px 20px 0">
          <el-alert :style="{ width: 240 + 'px' }" v-if="!form.roleSystems || !form?.roleSystems.length" title="请先选择关联系统" type="info" />
          <el-tabs v-else v-model="activeName" class="qr-permission-tabs">
