const source = name => fileURLToPath(new URL('./src/examples/modules-demo/' + name, import.meta.url))

// 此配置仅用于静态验收；正式应用继续使用 vite.config.js。
export default defineConfig({
  define: { __QIANRONG_MODULES_DEMO__: true },
  plugins: [vue(), AutoImport({ imports: ['vue', 'vue-router', 'pinia'], dts: false }), {
    name: 'modules-demo-boundary',
