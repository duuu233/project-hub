import axios from 'axios'
import { ElNotification, ElMessageBox, ElMessage, ElLoading } from 'element-plus'
import { getToken } from '@/utils/auth'
import errorCode from '@/utils/errorCode'
import { tansParams, blobValidate } from '@/utils/ruoyi'
import cache from '@/plugins/cache'
import { saveAs } from 'file-saver'
import { redirectToLogin } from '@/utils/loginRedirect'
import { isEmbeddedModeRoute } from '@/utils/embed'
import useUserStore from '@/store/modules/user'

let downloadLoadingInstance
let uploadLoadingInstance
export let isRelogin = { show: false }

axios.defaults.headers['Content-Type'] = 'application/json;charset=utf-8'
const service = axios.create({
  baseURL: '',
  timeout: 10000
})

service.interceptors.request.use(
  config => {
    const isToken = (config.headers || {}).isToken === false
    const isRepeatSubmit = (config.headers || {}).repeatSubmit === false
    if (getToken() && !isToken) {
      config.headers['Authorization'] = 'Bearer ' + getToken()
    }
    if (config.method === 'get' && config.params) {
      let url = config.url + '?' + tansParams(config.params)
      url = url.slice(0, -1)
      config.params = {}
      config.url = url
    }
    if (!isRepeatSubmit && (config.method === 'post' || config.method === 'put')) {
      const requestObj = {
        url: config.url,
        data: typeof config.data === 'object' ? JSON.stringify(config.data) : config.data,
        time: new Date().getTime()
      }
      const requestSize = Object.keys(JSON.stringify(requestObj)).length
      const limitSize = 5 * 1024 * 1024
      if (requestSize >= limitSize) {
        console.warn(`[${config.url}]: ` + '请求数据大小超出允许的5M限制，无法进行防重复提交验证。')
        return config
      }

      const sessionObj = cache.session.getJSON('sessionObj') || {}
      const requestKey = `${config.url}:${requestObj.data}`

      if (sessionObj[requestKey]) {
        const lastRequest = sessionObj[requestKey]
        const interval = 1000
        if (requestObj.time - lastRequest.time < interval) {
          const message = '请求正在处理，请勿重复提交'
          if (isRepeatSubmit) {
            return Promise.reject(new Error(message))
          }
        }
      }

      sessionObj[requestKey] = requestObj
      cache.session.setJSON('sessionObj', sessionObj)
    }
    return config
  },
  error => {
    console.log(error)
    Promise.reject(error)
  }
)

service.interceptors.response.use(
  res => {
    const code = res.data.code || 200
    const msg = errorCode[code] || res.data.msg || errorCode['default']
    if (res.request.responseType === 'blob' || res.request.responseType === 'arraybuffer') {
      return res.data
    }
    if (code === 401) {
      if (isEmbeddedModeRoute()) {
        return Promise.reject('无效的会话，或者会话已过期，请重新登录。')
      }
      if (!isRelogin.show) {
        isRelogin.show = true
        ElMessageBox.confirm('登录状态已过期，您可以继续留在该页面，或者重新登录', '系统提示', {
          confirmButtonText: '重新登录',
          cancelButtonText: '取消',
          type: 'warning'
        })
          .then(() => {
            isRelogin.show = false
            useUserStore()
              .logOut()
              .then(() => {
                redirectToLogin({ redirect: window.location.pathname + window.location.search + window.location.hash })
              })
          })
          .catch(() => {
            isRelogin.show = false
          })
      }
      return Promise.reject('无效的会话，或者会话已过期，请重新登录。')
    } else if (code === 500) {
      ElMessage({ message: msg, type: 'error' })
      return Promise.reject(new Error(msg))
    } else if (code === 601) {
      ElMessage({ message: msg, type: 'warning' })
      return Promise.reject(new Error(msg))
    } else if (code !== 200) {
      ElNotification.error({ title: msg })
      return Promise.reject('error')
    } else {
      return Promise.resolve(res.data)
    }
  },
  error => {
    console.log('err' + error)
    let { message } = error
    if (message == 'Network Error') {
      message = '后端接口连接异常'
    } else if (message.includes('timeout')) {
      message = '系统接口请求超时'
    } else if (message.includes('Request failed with status code')) {
      message = '系统接口' + message.substr(message.length - 3) + '异常'
    }
    ElMessage({ message: message, type: 'error', duration: 5 * 1000 })
    return Promise.reject(error)
  }
)

export function download(url, params, filename, config) {
  downloadLoadingInstance = ElLoading.service({
    text: '正在下载数据，请稍候',
    background: 'rgba(0, 0, 0, 0.7)'
  })
  const isJsonType = (config?.headers?.['Content-Type'] || '').includes('application/json')
  const requestConfig = {
    headers: {
      ...(config?.headers || {})
    },
    responseType: 'blob',
    ...config
  }
  let requestParams = params
  if (!isJsonType) {
    requestConfig.transformRequest = [
      params => {
        return tansParams(params)
      }
    ]
    if (!requestConfig.headers['Content-Type']) {
      requestConfig.headers['Content-Type'] = 'application/x-www-form-urlencoded'
    }
  }
  return service
    .post(url, requestParams, requestConfig)
    .then(async data => {
      const isBlob = blobValidate(data)
      if (isBlob) {
        const blob = new Blob([data])
        saveAs(blob, filename)
      } else {
        const resText = await data.text()
        const rspObj = JSON.parse(resText)
        const errMsg = errorCode[rspObj.code] || rspObj.msg || errorCode['default']
        ElMessage.error(errMsg)
      }
      downloadLoadingInstance.close()
    })
    .catch(r => {
      console.error(r)
      ElMessage.error('下载文件出现错误，请联系管理员！')
      downloadLoadingInstance.close()
    })
}

export function upload(url, file, params = {}, config = {}) {
  uploadLoadingInstance = ElLoading.service({
    text: '正在上传文件，请稍候',
    background: 'rgba(0, 0, 0, 0.7)'
  })

  const formData = new FormData()
  formData.append('file', file)

  Object.keys(params).forEach(key => {
    formData.append(key, params[key])
  })

  const requestConfig = {
    headers: {
      'Content-Type': 'multipart/form-data',
      ...(config?.headers || {})
    },
    ...config
  }

  return service
    .post(url, formData, requestConfig)
    .then(data => {
      uploadLoadingInstance.close()
      ElMessage.success('文件上传成功')
      return Promise.resolve(data)
    })
    .catch(error => {
      console.error(error)
      ElMessage.error('文件上传失败，请联系管理员！')
      uploadLoadingInstance.close()
      return Promise.reject(error)
    })
}

export default service
