      <el-button v-if="props.pageType !== 3" type="primary" @click="submit" size="large">确定</el-button>
    </BottomFixedBtnsBox>
  </el-form>
</template>

<script setup>
import DetailHeaderCard from '@/components/DetailHeaderCard/index.vue'
import { headerTime } from '@/components/DetailHeaderCard/utils'
import BottomFixedBtnsBox from '@/components/BottomFixedBtnsBox/index.vue'
import { onMounted, ref } from 'vue'
import { useRouter } from 'vue-router'
import Collapse from '@/components/Collapse'
import { ElMessage } from 'element-plus'
import { addSystem, editSystem, getDetail } from '@/api/system/system'

const router = useRouter()

const form = ref({
  id: '',
  systemName: ''
})

const rules = {
  systemName: [{ required: true, message: '请输入系统名称', trigger: 'blur' }]
}

const props = defineProps({
  pageType: {
    type: Number,
    default: 0
  }
})

const formRef = ref()

onMounted(async () => {
  if (props.pageType !== 1) {
    const res = await getDetail({
      id: router.currentRoute.value.query.id
    })
    form.value = {
      ...res.data
    }
  }
})

const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
