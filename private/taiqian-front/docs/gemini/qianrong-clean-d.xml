            <div class="qr-column-settings-list">
              <el-checkbox v-for="column in columns" :key="column.key" :model-value="visible(column.key)" :disabled="column.locked" @change="value => setVisible(column.key, value)">{{ column.label }}</el-checkbox>
            </div>
            <el-button link type="primary" @click="restoreColumns">恢复默认</el-button>
          </el-popover>
          <el-button :icon="fullscreen ? Close : FullScreen" :aria-label="fullscreen ? '退出全屏' : '全屏'" @click="fullscreen = !fullscreen">{{ fullscreen ? '退出全屏' : '全屏' }}</el-button>
        </div>
      </div>
