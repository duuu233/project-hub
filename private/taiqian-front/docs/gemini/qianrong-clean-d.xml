}

function readEmbeddedSourceFromParams(params) {
  for (const key of ['source', 'fromSystem', 'from_system', 'system', 'sys', 'origin']) {
    const value = normalizeSourceCode(params.get(key))
    if (value) {
      return value
    }
  }
  return ''
}

function saveEmbeddedSource(source) {
  const value = normalizeSourceCode(source)
  if (!value || typeof window === 'undefined') {
    return
  }
  try {
    window.sessionStorage.setItem(EMBED_SOURCE_SESSION_KEY, value)
  } catch (e) {

  }
}

function hasSsoEntryParams(params = getSearchParams()) {
  return (
    SSO_ENTRY_PARAM_KEYS.some(key => params.has(key)) ||
    SYSTEM_CONFIGS.some(config => params.has(config.tokenKey))
  )
}

export function markSsoEntryContext() {
  if (typeof window === 'undefined') {
    return
  }
  try {
    window.sessionStorage.setItem(SSO_ENTRY_SESSION_KEY, '1')
  } catch (e) {

  }
}

export function clearSsoEntryContext() {
  if (typeof window === 'undefined') {
    return
  }
  try {
    window.sessionStorage.removeItem(SSO_ENTRY_SESSION_KEY)
  } catch (e) {

  }
}

export function isSsoEntryContext() {
  if (typeof window === 'undefined') {
    return false
  }

  if (hasSsoEntryParams()) {
    markSsoEntryContext()
    return true
  }

  try {
    return window.sessionStorage.getItem(SSO_ENTRY_SESSION_KEY) === '1'
  } catch (e) {
    return false
  }
}

export function isDataIntegrationEmbeddedMode() {
  if (typeof window === 'undefined') {
    return false
  }

  const params = getSearchParams()
  if (params.get(EXTERNAL_IFRAME_EMBED_KEY) !== EXTERNAL_IFRAME_EMBED_VALUE) {
    return false
  }

  const source = readEmbeddedSourceFromParams(params)
  if (source) {
    saveEmbeddedSource(source)
    return source === DATA_INTEGRATION_SOURCE
  }

  if (document.referrer) {
    try {
      const referrerUrl = new URL(document.referrer, window.location.origin)
      const host = String(referrerUrl.hostname || '').toLowerCase()
      if (host.includes('dataintegration') || host.includes('data-integration')) {
        saveEmbeddedSource(DATA_INTEGRATION_SOURCE)
        return true
      }
    } catch (e) {

    }
  }

  try {
    return normalizeSourceCode(window.sessionStorage.getItem(EMBED_SOURCE_SESSION_KEY)) === DATA_INTEGRATION_SOURCE
  } catch (e) {
    return false
  }
}

function pickFirstNonEmpty(values = []) {
  for (const value of values) {
    if (typeof value !== 'string') {
      continue
    }

    const trimmed = value.trim()
    if (trimmed) {
      return trimmed
    }
  }

  return ''
}

function safeParseJson(value) {
  if (typeof value !== 'string') {
    return undefined
  }

  const normalizedValue = value.trim()
  if (!normalizedValue) {
    return undefined
  }

  const candidates = [normalizedValue]
  try {
    const decoded = decodeURIComponent(normalizedValue)
    if (decoded && decoded !== normalizedValue) {
      candidates.push(decoded)
    }
  } catch (e) {

  }

  for (const candidate of candidates) {
    try {
      return JSON.parse(candidate)
    } catch (e) {

    }
  }

  return undefined
}

function isSerializedJson(value = '') {
  const normalizedValue = String(value || '').trim()
  return (
    (normalizedValue.startsWith('{') && normalizedValue.endsWith('}')) ||
    (normalizedValue.startsWith('[') && normalizedValue.endsWith(']'))
  )
}

function resolveToken(...values) {
  for (const value of values) {
    if (typeof value !== 'string') {
      continue
    }

    const trimmed = value.trim()
    if (trimmed && !isSerializedJson(trimmed)) {
      return trimmed
    }
  }

  return ''
}

function parseUserPayload(value) {
  if (value === undefined || value === null || value === '') {
    return undefined
  }
  if (typeof value === 'object') {
    return value
  }
  if (typeof value !== 'string') {
    return undefined
  }

  const normalizedValue = value.trim()
  if (!isSerializedJson(normalizedValue)) {
    return undefined
  }

  return safeParseJson(normalizedValue)
}

function getDirectQuerySystemItems(searchParams) {
  return SYSTEM_CONFIGS.map(config => {
    const token = pickFirstNonEmpty((config.queryTokenKeys || [config.tokenKey]).map(key => searchParams.get(key)))
    const cookieToken = pickFirstNonEmpty((config.queryCookieTokenKeys || []).map(key => searchParams.get(key)))

    if (!token && !cookieToken) {
      return null
    }

    return {
      code: config.code,
      token,
      cookieToken,
      userData: config.code === 'ldqx' ? parseUserPayload(searchParams.get('sso_user')) : undefined
    }
  }).filter(Boolean)
}

function normalizeSystemItem(item = {}) {
  const code = normalizeSsoSystemCode(item.code || item.type || item.systemCode || item.system || item.systemName || item.name)
  const config = SYSTEM_CONFIG_MAP[code]

  if (!config) {
    return null
  }

  const ajaxResult = item.ajaxResult && typeof item.ajaxResult === 'object' ? item.ajaxResult : {}
  const token = resolveToken(item.token, item.accessToken, item.access_token, item.sso_token, ajaxResult.token)
  const cookieToken = resolveToken(item.cookieToken, item.cookie_token, item.sso_cookie_token, ajaxResult.tokenKey)
  const userData =
    parseUserPayload(item.userData) ??
    parseUserPayload(item.user) ??
    parseUserPayload(item.sso_user) ??
    parseUserPayload(ajaxResult.data)

  return {
    code,
    label: config.label,
    token,
    cookieToken,
    userData,
    url: item.url || item.systemUrl || item.system_url || getSsoSystemUrls()[code] || ''
  }
}

function getQuerySystemItems(searchParams) {
  const result = []
  const listKeys = ['sso_systems', 'ssoSystems', 'systems', 'systemList', 'tokenList', 'systemTokenList', 'tokenResponseList', 'ssoTokenList']

  listKeys.forEach(key => {
    const parsedValue = safeParseJson(searchParams.get(key))

    if (Array.isArray(parsedValue)) {
      result.push(...parsedValue)
      return
    }

    if (parsedValue && Array.isArray(parsedValue.list)) {
      result.push(...parsedValue.list)
      return
    }

    if (parsedValue && Array.isArray(parsedValue.data)) {
      result.push(...parsedValue.data)
    }
  })

  result.push(...getDirectQuerySystemItems(searchParams))
  return result.map(normalizeSystemItem).filter(Boolean)
}

function persistSystemTokens(systemList = []) {
  systemList.forEach(item => {
    const config = SYSTEM_CONFIG_MAP[item.code]
    if (!config) {
      return
    }

    const persistedToken = item.cookieToken || item.token
    if (persistedToken) {
      Cookies.set(config.tokenKey, persistedToken, { path: '/' })
    }

    if (item.code === 'ldqx' && item.token && item.userData !== undefined) {
      Cookies.set(
        LDQX_USER_COOKIE_KEY,
        encodeURIComponent(JSON.stringify({ token: item.token, user: item.userData || null })),
        { path: '/' }
      )
    }
  })
}

export function normalizeSsoSystemCode(systemCode) {
  const normalizedValue = String(systemCode || '').trim()
  return SYSTEM_CODE_ALIASES[normalizedValue] || SYSTEM_CODE_ALIASES[normalizedValue.toLowerCase()] || normalizedValue
}

export function getRuntimeEnvironment() {
  const hostname = window.location.hostname
  if (hostname === 'localhost' || hostname.includes('dev-')) return 'dev'
  if (hostname.includes('test-')) return 'test'
  return 'prod'
}

export function getSsoSystemUrls() {
  const environment = getRuntimeEnvironment()
  const domainMap = {
    ldqx: {
      dev: 'https://dev-ldqx.ftechain.com',
      test: 'https://test-ldqx.ftechain.com',
      prod: 'https://ldqx.ftechain.com'
    },
    lsrq: {
      dev: 'https://dev-deppon.ftechain.com',
      test: 'https://test-deppon.ftechain.com',
      prod: 'https://lsrq.ftechain.com'
    },
    tqzk: {
      dev: 'https://dev-tqzk.ftechain.com',
      test: 'https://test-tqzk.ftechain.com',
      prod: 'https://tqzk.ftechain.com'
    },
    'data-integration': {
      dev: 'https://dev-dataintegration.ftechain.com',
      test: 'https://test-dataintegration.ftechain.com',
      prod: 'https://dataintegration.ftechain.com'
    }
  }

  return Object.fromEntries(
    Object.entries(domainMap).map(([code, envMap]) => [code, envMap[environment] || envMap.prod])
  )
}

function absorbUrlTokens() {
  try {
    const searchParams = new URLSearchParams(window.location.search)
    if (hasSsoEntryParams(searchParams)) {
      markSsoEntryContext()
    }

    const querySystems = getQuerySystemItems(searchParams)
    if (querySystems.length) {
      persistSystemTokens(querySystems)
    }

    SYSTEM_CONFIGS.forEach(config => {
      const tokenFromUrl = pickFirstNonEmpty((config.queryTokenKeys || [config.tokenKey]).map(key => searchParams.get(key)))
      if (tokenFromUrl && !Cookies.get(config.tokenKey)) {
        Cookies.set(config.tokenKey, tokenFromUrl, { path: '/' })
      }
    })
  } catch (e) {

  }
}

export function syncSsoSystemContext() {
  absorbUrlTokens()
  return getAccessibleSsoSystems()
}

export function getAccessibleSsoSystems() {
  return SYSTEM_CONFIGS.map(config => {
    const token = Cookies.get(config.tokenKey) || ''
    if (!token) {
      return null
    }

    return {
      code: config.code,
      label: config.label,
      token,
      url: getSsoSystemUrls()[config.code] || ''
    }
  }).filter(Boolean)
}

export function getCurrentSsoSystemCode() {
  return getCurrentSystemCodeFromHost()
}

export function getCurrentSsoSystemLabel() {
  const currentCode = getCurrentSsoSystemCode()
  return SYSTEM_CONFIG_MAP[currentCode]?.label || ''
}

export function buildLdqxRedirectUrl() {
  const systemUrls = getSsoSystemUrls()
  const ldqxCookieToken = Cookies.get(SYSTEM_CONFIG_MAP.ldqx.tokenKey) || ''
  const ldqxUserData = getLdqxUserData()
  const token = ldqxUserData?.token || ''
  const userData = ldqxUserData?.user

  if (!ldqxCookieToken && !token && userData === undefined) {
    return systemUrls.ldqx || ''
  }

  const baseUrl = new URL('/user/login', systemUrls.ldqx || '/').toString()
  const params = new URLSearchParams()

  if (token) {
    params.set('sso_token', token)
  }

  if (ldqxCookieToken) {
    params.set('sso_cookie_token', ldqxCookieToken)
  }

  if (userData !== undefined) {
    params.set('sso_user', JSON.stringify(userData))
  }

  const queryString = params.toString()
  return queryString ? `${baseUrl}?${queryString}` : baseUrl
}

export function buildSsoSystemOpenUrl(systemCode) {
  const normalizedCode = normalizeSsoSystemCode(systemCode)

  if (normalizedCode === 'ldqx') {
    return buildLdqxRedirectUrl()
  }

  const currentCode = getCurrentSsoSystemCode()
  if (normalizedCode === currentCode) {
    return ''
  }

  const baseUrl = getSsoSystemUrls()[normalizedCode] || ''
  if (!baseUrl) return ''

  try {
    const resolvedUrl = new URL(baseUrl)
    const systems = getAccessibleSsoSystems()
    systems.forEach(item => {
      const config = SYSTEM_CONFIG_MAP[item.code]
      if (config && item.token) {
        resolvedUrl.searchParams.set(config.tokenKey, item.token)
      }
    })
    return appendEmbedQuery(resolvedUrl.toString())
  } catch (e) {
    return appendEmbedQuery(baseUrl)
  }
}

export function openSsoSystemWindow(systemCode) {
  const nextUrl = buildSsoSystemOpenUrl(systemCode)

  if (!nextUrl) {
    return ''
  }

  window.open(nextUrl, '_blank')
  return nextUrl
}
