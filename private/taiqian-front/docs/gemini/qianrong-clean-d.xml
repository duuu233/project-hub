<script setup name="Data">
import ListPageHeader from '@/components/ListPageHeader/index.vue'
import { withListGridStyle, listGrid as vListGrid } from '@/utils/listGrid'
import ListToolbarTitle from '@/components/ListToolbarTitle/index.vue'
import ListRowActions from '@/components/ListRowActions/index.vue'

import useDictStore from '@/store/modules/dict'
import { optionselect as getDictOptionselect, getType } from '@/api/system/dict/type'
import { listData, getData, delData, addData, updateData } from '@/api/system/dict/data'
import TableSearch from '@/components/TableSearch'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'
import { onMounted, onUnmounted } from 'vue'
const { proxy } = getCurrentInstance()
const { sys_normal_disable } = proxy.useDict('sys_normal_disable')

const open = ref(false)

const ids = ref([])
const single = ref(true)
const multiple = ref(true)
const total = ref(0)
const title = ref('')
const defaultDictType = ref('')
const typeOptions = ref([])
const route = useRoute()
const gridRef = ref()
const isEdit = ref(false)
const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const listClassOptions = ref([
  { value: 'default', label: '默认' },
  { value: 'primary', label: '主要' },
  { value: 'success', label: '成功' },
  { value: 'info', label: '信息' },
  { value: 'warning', label: '警告' },
  { value: 'danger', label: '危险' }
])

const query = reactive({})
const searchOpt = ref([
  {
    type: 'select',
    label: '字典名称',
    placeholder: '请选择',
    opts: typeOptions,
    prop: 'dictType'
  },
  {
    type: 'input',
    label: '字典标签',
    placeholder: '请输入',
    prop: 'dictLabel'
  },
  {
    type: 'select',
    label: '状态',
    placeholder: '请选择',
    opts: sys_normal_disable,
    prop: 'status'
  }
])

const gridOptions = reactive(withListGridStyle({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true,
    slots: {
      buttons: 'toolbarButtons'
    }
  },
  columns: [
    { type: 'checkbox', width: 55, align: 'center' },
    { title: '字典编码', field: 'dictCode', align: 'center' },
    { title: '字典标签', field: 'dictLabel', align: 'center', slots: { default: 'dictLabelRender' } },
    { title: '字典键值', field: 'dictValue', align: 'center' },
    { title: '字典排序', field: 'dictSort', align: 'center' },
    { title: '状态', field: 'status', align: 'center', slots: { default: 'statusRender' } },
    { title: '备注', field: 'remark', align: 'center', showOverflow: true },
    { title: '创建时间', field: 'createTime', width: 180, align: 'center', slots: { default: 'createTimeRender' } },
    { title: '操作', field: 'active', width: 160, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
}))

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  },
  checkboxChange({ records }) {
    ids.value = records.map(item => item.dictCode)
    single.value = records.length != 1
    multiple.value = !records.length
  }
}

const data = reactive({
  form: {},
  queryParams: {
    pageNum: 1,
    pageSize: 10,
    dictType: undefined,
    dictLabel: undefined,
    status: undefined
  },
  rules: {
    dictLabel: [{ required: true, message: '数据标签不能为空', trigger: 'blur' }],
    dictValue: [{ required: true, message: '数据键值不能为空', trigger: 'blur' }],
    dictSort: [{ required: true, message: '数据顺序不能为空', trigger: 'blur' }]
  }
})

const { queryParams, form, rules } = toRefs(data)

function getTypes(dictId) {
  getType(dictId).then(response => {
    queryParams.value.dictType = response.data.dictType
    defaultDictType.value = response.data.dictType
    query.dictType = response.data.dictType
    getList()
  })
}

function getTypeList() {
  getDictOptionselect().then(response => {
    typeOptions.value = response.data
    typeOptions.value.map(v => {
      v.value = v.dictType
      v.label = v.dictName
    })
  })
}

function getList() {
  gridOptions.loading = true
  listData({
    ...queryParams.value,
    ...query,
    dictType: query.dictType ?? defaultDictType.value,
    pageNum: gridOptions.pagerConfig.currentPage,
    pageSize: gridOptions.pagerConfig.pageSize
  }).then(response => {
    gridOptions.data = response.rows
    gridOptions.pagerConfig.total = response.total * 1
    gridOptions.loading = false
  })
}

function cancel() {
  open.value = false
  reset()
}

function reset() {
  form.value = {
    dictCode: undefined,
    dictLabel: undefined,
    dictValue: undefined,
    cssClass: undefined,
    listClass: 'default',
    dictSort: 0,
    status: '0',
    remark: undefined
  }
  proxy.resetForm('dataRef')
}

function handleQuery() {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}

function handleClose() {
  const obj = { path: '/system/dict' }
  proxy.$tab.closeOpenPage(obj)
}

function resetQuery() {
  proxy.resetForm('queryRef')
  queryParams.value.dictType = defaultDictType.value
  handleQuery()
}

function handleAdd() {
  isEdit.value = false
  reset()
  open.value = true
  title.value = '添加字典数据'
  form.value.dictType = queryParams.value.dictType
}

function handleSelectionChange(selection) {
  ids.value = selection.map(item => item.dictCode)
  single.value = selection.length != 1
  multiple.value = !selection.length
}

function handleUpdate(row) {
  reset()
  const dictCode = row.dictCode || ids.value
  getData(dictCode).then(response => {
    isEdit.value = true
    form.value = response.data
    open.value = true
    title.value = '修改字典数据'
  })
}

function submitForm() {
  proxy.$refs['dataRef'].validate(valid => {
    if (valid) {
      if (form.value.dictCode != undefined) {
        updateData(form.value).then(response => {
          useDictStore().removeDict(queryParams.value.dictType)
          proxy.$modal.msgSuccess('修改成功')
          open.value = false
          getList()
        })
      } else {
        addData(form.value).then(response => {
          useDictStore().removeDict(queryParams.value.dictType)
          proxy.$modal.msgSuccess('新增成功')
          open.value = false
          getList()
        })
      }
    }
  })
}

function handleDelete(row) {
  const dictCodes = row.dictCode || ids.value
  proxy.$modal
    .confirm('是否确认删除字典编码为"' + dictCodes + '"的数据项？')
    .then(function () {
      return delData(dictCodes)
    })
    .then(() => {
      getList()
      proxy.$modal.msgSuccess('删除成功')
      useDictStore().removeDict(queryParams.value.dictType)
    })
    .catch(() => {})
}

function handleExport() {
  proxy.download(
    '/api-qianrong/system/dict/data/export',
    {
      ...queryParams.value
    },
    `dict_data_${new Date().getTime()}.xlsx`
  )
}
function resetDataSearch() { query.dictType = defaultDictType.value; handleSearch() }
const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}

onMounted(() => {
  getTypes(route.params && route.params.dictId)
  getTypeList()
  registerGrid('dict-data-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('dict-data-grid')
})
</script>
</file>

