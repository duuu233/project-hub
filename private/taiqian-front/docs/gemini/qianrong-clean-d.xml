const appStore = useAppStore()
const settingsStore = useSettingsStore()
const permissionStore = usePermissionStore()

const sidebarRouters = computed(() => permissionStore.sidebarRouters)
const showLogo = computed(() => settingsStore.sidebarLogo)
const isCollapse = computed(() => !appStore.sidebar.opened)

const activeMenu = computed(() => {
  const { meta, path } = route
  if (meta.activeMenu) {
    return meta.activeMenu
  }
  const matchedMenu = findBestMatchMenu(path)
  return matchedMenu || path
})

const defaultOpeneds = computed(() => {
  const openeds = []
  const { meta, path } = route
  const activePath = meta.activeMenu || path

  function findMenuToOpen(targetPath) {
    function traverseMenu(routes, basePath = '') {
      routes.forEach(routeItem => {
        let menuPath = routeItem.path
        if (!menuPath.startsWith('/')) {
          menuPath = basePath + '/' + menuPath
        }
        menuPath = menuPath.replace(/\/+/g, '/').replace(/\/$/, '') || '/'

        const shouldExpand = checkMenuMatch(targetPath, menuPath, routeItem)

        if (shouldExpand && routeItem.children && routeItem.children.length > 0) {
          if (!openeds.includes(menuPath)) {
            openeds.push(menuPath)
          }
          traverseMenu(routeItem.children, menuPath)
        }
      })
    }

    if (sidebarRouters.value && sidebarRouters.value.length > 0) {
      traverseMenu(sidebarRouters.value)
    }
  }

  findMenuToOpen(activePath)
  return [...new Set(openeds)]
})

function findBestMatchMenu(targetPath) {
  let bestMatch = null
  let maxMatchScore = 0

  function traverseMenu(routes, basePath = '') {
    routes.forEach(routeItem => {
      if (routeItem.hidden) return

      let menuPath = routeItem.path
      if (!menuPath.startsWith('/')) {
        menuPath = basePath + '/' + menuPath
      }
      menuPath = menuPath.replace(/\/+/g, '/').replace(/\/$/, '') || '/'

      const score = calculateMatchScore(targetPath, menuPath, routeItem)

      if (score > maxMatchScore) {
        maxMatchScore = score
        bestMatch = menuPath
      }

      if (routeItem.children) {
        traverseMenu(routeItem.children, menuPath)
      }
    })
  }

  if (sidebarRouters.value && sidebarRouters.value.length > 0) {
    traverseMenu(sidebarRouters.value)
  }

  return bestMatch
}

function calculateMatchScore(targetPath, menuPath, routeItem) {
  let score = 0

  if (targetPath === menuPath) {
    score = 1000
    return score
  }

  if (isDetailPage(targetPath) || isEditPage(targetPath)) {
    const cleanedPaths = routeMatchConfig.cleaningRules.map(rule => {
      return targetPath.replace(rule.pattern, rule.replacement)
    })

    for (const cleanedPath of cleanedPaths) {
      if (cleanedPath === menuPath) {
        score = 800
        return score
      }
    }

    for (const cleanedPath of cleanedPaths) {
      if (cleanedPath.startsWith(menuPath + '/') || cleanedPath.startsWith(menuPath + '-')) {
        score = 700
        return score
      }
    }
  }

  if (targetPath.startsWith(menuPath + '/')) {
    score = 500 + menuPath.length
    return score
  }

  const targetSegments = targetPath.split('/').filter(s => s)
  const menuSegments = menuPath.split('/').filter(s => s)

  let matchingSegments = 0
  const minLength = Math.min(targetSegments.length, menuSegments.length)

  for (let i = 0; i < minLength; i++) {
    if (targetSegments[i] === menuSegments[i]) {
      matchingSegments++
    } else {
      break
    }
  }

  if (matchingSegments > 0) {
    score = matchingSegments * 100
  }

  return score
}

function checkMenuMatch(targetPath, menuPath, routeItem) {
  if (targetPath === menuPath) {
    return true
  }

  if (targetPath.startsWith(menuPath + '/')) {
    return true
  }

  if (isDetailPage(targetPath)) {
    const detailMatch = findDetailPageParent(targetPath, menuPath, routeItem)
    if (detailMatch) {
      return true
    }
  }

  if (isEditPage(targetPath)) {
    const editMatch = findEditPageParent(targetPath, menuPath, routeItem)
    if (editMatch) {
      return true
    }
  }

  const pathSegmentMatch = checkPathSegmentMatch(targetPath, menuPath)
  if (pathSegmentMatch) {
    return true
  }

  return false
}

function isDetailPage(path) {
  const detailPatterns = [...routeMatchConfig.detailPatterns, /-(detail|view|info|show)$/i, /-\w+-(detail|view|info|show)$/i]

  return detailPatterns.some(pattern => pattern.test(path))
}

function isEditPage(path) {
  const editPatterns = routeMatchConfig.editPatterns
  return editPatterns.some(pattern => pattern.test(path))
}

function findDetailPageParent(targetPath, menuPath, routeItem) {
  const cleanedPaths = routeMatchConfig.cleaningRules.map(rule => {
    return targetPath.replace(rule.pattern, rule.replacement)
  })

  return cleanedPaths.some(cleanedPath => {
    return cleanedPath === menuPath || cleanedPath.startsWith(menuPath + '/') || menuPath.startsWith(cleanedPath + '/')
  })
}

function findEditPageParent(targetPath, menuPath, routeItem) {
  const cleanedPaths = routeMatchConfig.cleaningRules.map(rule => {
    return targetPath.replace(rule.pattern, rule.replacement)
  })

  return cleanedPaths.some(cleanedPath => {
    return cleanedPath === menuPath || cleanedPath.startsWith(menuPath + '/') || menuPath.startsWith(cleanedPath + '/')
  })
}

function checkPathSegmentMatch(targetPath, menuPath) {
  const targetSegments = targetPath.split('/').filter(s => s)
  const menuSegments = menuPath.split('/').filter(s => s)

  if (menuSegments.length <= targetSegments.length) {
    const isMatch = menuSegments.every((segment, index) => {
      return segment === targetSegments[index]
    })
    return isMatch
  }

  return false
}

async function scrollToActiveMenu() {
  if (!scrollbarRef.value || !menuRef.value) return

  await nextTick()

  try {
    const activeMenuSelector = `.el-menu-item.is-active, .el-sub-menu.is-opened > .el-sub-menu__title`
    const activeElement = menuRef.value.$el?.querySelector(activeMenuSelector)

    if (activeElement) {
      const scrollContainer = scrollbarRef.value.wrapRef
      const elementTop = activeElement.offsetTop
      const containerHeight = scrollContainer.getBoundingClientRect().height
      const scrollTop = elementTop - containerHeight / 2 + activeElement.offsetHeight / 2

      scrollContainer.scrollTo({
        top: Math.max(0, scrollTop),
        behavior: 'smooth'
      })
    }
  } catch (error) {
    console.error('自动滚动失败:', error)
  }
}

watch(
  () => route.path,
  () => {},
  { immediate: true }
)

watch(
  activeMenu,
  () => {
    setTimeout(() => {
      scrollToActiveMenu()
    }, 300)
  },
  { immediate: false }
)

watch(
  defaultOpeneds,
  () => {
    setTimeout(() => {
      scrollToActiveMenu()
    }, 500)
  },
  { immediate: false }
)

onMounted(() => {
  setTimeout(() => {
    scrollToActiveMenu()
  }, 1000)
})
</script>

