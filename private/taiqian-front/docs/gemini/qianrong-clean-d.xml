<script setup>
import { reactive, ref, computed } from 'vue'
import { useRouter } from 'vue-router'
import { Delete, Plus, ZoomIn } from '@element-plus/icons-vue'
import { ElMessage } from 'element-plus'

const baseUrl = '/api-qianrong'
const { currentRoute } = useRouter()

const props = defineProps({
  value: {
    type: String,
    default: ''
  },
  acceptSize: {
    type: Number,
    default: 10
  },
  disabled: {
    type: Boolean,
    default: false
  }
})

const emit = defineEmits(['update:value'])

const uploadParams = reactive({
  accept: '.jpg,.jpeg,.png,.gif.JPG,.JPEG,.PNG,.GIF',
  limit: 1,
  acceptSize: props.acceptSize,
  disabled: props.disabled,
  multiple: false
})

const uploadList = ref([])

const fileListCom = computed({
  get() {
    return props.value ? [{ url: props.value, name: 'name' }] : uploadList.value
  },
  set(value) {}
})

const dialogImageUrl = ref('')
const dialogVisible = ref(false)

function success(response, file) {
  let fileItem = {
    name: response.data.name,
    url: baseUrl + response.data.url
  }
  uploadList.value.push(fileItem)
  emit('update:value', uploadList.value[0].url)
  ElMessage.success('上传成功')
}

function error() {
  uploadList.value = []
  emit('update:value', '')
  ElMessage.error('上传失败')
}

const handleRemove = file => {
  uploadList.value = []
  emit('update:value', '')
}

const handlePictureCardPreview = file => {
  dialogImageUrl.value = file.url
  dialogVisible.value = true
}

const beforeUpload = async file => {
  if (file.size > uploadParams.acceptSize * 1024 * 1024) {
    ElMessage.error(`请上传${uploadParams.acceptSize}MB以内的文件`)
    return false
  }
  return true
}
</script>

