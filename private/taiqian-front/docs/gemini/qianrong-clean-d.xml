<script setup>
import Collapse from '@/components/Collapse'
import ImageUpload from '@/components/ImageUpload'
import { ref, reactive, onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import router from '@/router'
import { getLoginSettingDetail, saveOrUpdateLoginSetting } from '@/api/system/config'

const route = useRoute()
const baseUrl = '/api-qianrong'

const _props = defineProps({
  pageType: Number
})

const pageTypeOptions = ref([
  { label: '平台', value: 0 },
  { label: '租户', value: 1 },
  { label: '监管方', value: 2 },
  { label: '银行', value: 3 }
])

const formRef = ref()
const form = ref({
  id: null,
  pageType: '',
  domain: '',
  bigTitle: '',
  smallTitle: '',
  logo: '',
  loginPathX: 0,
  loginPathY: 0
})

const rules = reactive({
  pageType: [{ required: true, message: '请选择页面类型', trigger: 'change' }],
  domain: [{ required: true, message: '请输入域名', trigger: 'blur' }],
  bigTitle: [{ required: true, message: '请输入大标题', trigger: 'blur' }],
  smallTitle: [{ required: true, message: '请输入小标题', trigger: 'blur' }],
  logo: [{ required: true, message: '请上传背景图', trigger: 'change' }],
  loginPathX: [{ required: true, message: '请输入登录框X坐标', trigger: 'blur' }],
  loginPathY: [{ required: true, message: '请输入登录框Y坐标', trigger: 'blur' }]
})

const getDetail = async () => {
  const id = route.query.id
  if (!id) return

  try {
    const res = await getLoginSettingDetail(id)
    if (res.code === 200) {
      form.value = {
        ...res.data,
        logo: res.data.logo
          ? [
              {
                name: '背景图',
                url: baseUrl + res.data.logo
              }
            ]
          : []
      }
    }
  } catch (error) {
    console.error('获取详情失败:', error)
    ElMessage.error('获取详情失败')
  }
}

const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      try {
        let logo = ''
        if (Array.isArray(form.value.logo)) {
          logo = form.value.logo[0]?.url?.replace(/^\/api-qianrong/, '') || ''
        } else {
          logo = form.value.logo.replace(/^\/api-qianrong/, '')
        }

        const submitData = {
          ...form.value,
          logo
        }

        const res = await saveOrUpdateLoginSetting(submitData)
        if (res.code === 200) {
          ElMessage.success('操作成功')
          setTimeout(() => {
            router.back()
          }, 300)
        }
      } catch (error) {
        ElMessage.error('操作失败')
      }
    }
  })
}

onMounted(() => {
  getDetail()
})
</script>

