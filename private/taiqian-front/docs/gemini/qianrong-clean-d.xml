  uid: ++pcUid,
  id: data.id,
  projectConfigId: data.projectConfigId,
  pageType: data.pageType === null || data.pageType === undefined ? undefined : String(data.pageType),
  pcDomain: data.pcDomain || '',
  pcBigTitle: data.pcBigTitle || '',
  pcSmallTitle: data.pcSmallTitle || '',
  backgroundFile: data.backgroundFile || '',
  loginPathX: toNumber(data.loginPathX),
  loginPathY: toNumber(data.loginPathY)
})

const form = ref({
  id: undefined,
  projectConfigNo: '',
  projectCode: undefined,
  projectName: '',
  financeScene: undefined,
  financeTarget: undefined,
  h5Name: '',
  logoFile: '',
  userAgreementFile: [],
  privacyPolicyFile: [],
  registerMode: undefined,
  // 新增时默认带出一块空的 PC 配置，减少一次点击
  pcConfigList: props.pageType === 1 ? [createPcBlock()] : [],
  createTime: '',
  updateTime: ''
})

const required = (message, trigger = 'change') => ({ required: true, message, trigger })
const fileRequired = message => ({
  validator: (_rule, value, callback) => ((Array.isArray(value) ? value.length : value) ? callback() : callback(new Error(message))),
  trigger: 'change'
})

const rules = {
  projectCode: [required('请选择产业项目')],
  financeScene: [required('请选择金融场景')],
  financeTarget: [required('请选择融资对象')],
  h5Name: [required('请输入融资H5名称', 'blur')],
  registerMode: [required('请选择账号注册方式')],
  logoFile: [fileRequired('请上传LOGO')],
  userAgreementFile: [fileRequired('请上传用户协议')],
  privacyPolicyFile: [fileRequired('请上传隐私协议')]
}

// PC 配置块里的字段校验，prop 形如 pcConfigList.0.pageType
const pcRules = {
  pageType: [
    required('请选择页面类型'),
    {
      validator: (rule, value, callback) => {
        const index = Number(String(rule.field).split('.')[1])
        const duplicated = form.value.pcConfigList.some((item, i) => i !== index && item.pageType === value)
        duplicated ? callback(new Error('页面类型不能重复')) : callback()
      },
      trigger: 'change'
    }
  ],
  pcDomain: [required('请输入域名', 'blur')],
  pcBigTitle: [required('请输入大标题', 'blur')],
  pcSmallTitle: [required('请输入小标题', 'blur')],
  loginPathX: [required('请输入登录框X坐标', ['blur', 'change'])],
  loginPathY: [required('请输入登录框Y坐标', ['blur', 'change'])],
  backgroundFile: [fileRequired('请上传背景图')]
}

// 上传组件没有触发表单校验，这里在值变化后补一次校验，避免上传成功后仍显示“请上传”
const validateLater = prop => {
  nextTick(() => formRef.value?.validateField(prop).catch(() => {}))
}

const pageTypeLabel = value => optionLabel(industry_pc_page_type.value, value)
const isPageTypeUsed = (value, index) => form.value.pcConfigList.some((item, i) => i !== index && item.pageType === value)
// 每种页面类型最多配置一份
const canAddPc = computed(() => form.value.pcConfigList.length < industry_pc_page_type.value.length)

const addPcBlock = () => {
  if (canAddPc.value) form.value.pcConfigList.push(createPcBlock())
}

const removePcBlock = index => {
  form.value.pcConfigList.splice(index, 1)
  // 校验状态按下标挂在表单项上，移除后会错位，统一清掉
  nextTick(() => formRef.value?.clearValidate())
}

const fileNameOf = path => {
  const name = String(path).split('/').pop() || ''
  try {
    return decodeURIComponent(name)
  } catch (error) {
    return name
  }
}
// 后端只存文件路径，这里还原成 FileUpload 需要的 [{ fileName, fileUrl }]
const toFileList = path => (path ? [{ fileName: fileNameOf(path), fileUrl: path }] : [])

const fillForm = data => {
  form.value = {
    id: data.id,
    projectConfigNo: data.projectConfigNo || '',
    projectCode: data.projectCode || undefined,
    projectName: data.projectName || '',
    financeScene: data.financeScene ?? undefined,
    financeTarget: data.financeTarget ?? undefined,
    h5Name: data.h5Name || '',
    logoFile: data.logoFile || '',
    userAgreementFile: toFileList(data.userAgreementFile),
    privacyPolicyFile: toFileList(data.privacyPolicyFile),
    registerMode: data.registerMode === null || data.registerMode === undefined ? undefined : String(data.registerMode),
    pcConfigList: (data.pcConfigList || []).map(item => createPcBlock(item)),
    createTime: data.createTime,
    updateTime: data.updateTime
  }
}

const buildPayload = () => {
  const data = form.value
  return {
    id: data.id,
    projectConfigNo: data.projectConfigNo || undefined,
    projectCode: data.projectCode,
    projectName: optionLabel(industry_project.value, data.projectCode) || data.projectName,
    financeScene: data.financeScene,
    financeTarget: data.financeTarget,
    h5Name: data.h5Name,
    logoFile: stripBase(data.logoFile),
    userAgreementFile: data.userAgreementFile?.[0]?.fileUrl || '',
    privacyPolicyFile: data.privacyPolicyFile?.[0]?.fileUrl || '',
    registerMode: data.registerMode,
    // 始终带上 pcConfigList：不传表示保留原配置，传空数组才会清空
    pcConfigList: data.pcConfigList.map(({ uid, ...item }) => ({ ...item, backgroundFile: stripBase(item.backgroundFile) }))
  }
}

const submit = async () => {
  try {
    await formRef.value.validate()
  } catch (error) {
    return
  }
  submitting.value = true
  try {
    const payload = buildPayload()
    if (isAdd.value) {
      await addIndustryConfig(payload)
      ElMessage.success('新增成功')
    } else {
      await editIndustryConfig(payload)
      ElMessage.success('保存成功')
    }
    proxy.toList({
      path: '/project/project-list',
      listName: 'Project-list'
    })
  } catch (error) {
    // 失败提示已由 request 拦截器统一弹出
  } finally {
    submitting.value = false
  }
}

const cancel = () => {
  router.back()
}

const headerFields = computed(() => {
  const data = form.value
  return [
    { label: '配置编号', value: data.projectConfigNo },
    { label: '产业项目', value: data.projectName || optionLabel(industry_project.value, data.projectCode) },
    { label: '金融场景', value: optionLabel(FINANCE_SCENE_OPTIONS, data.financeScene) },
    { label: '融资对象', value: optionLabel(FINANCE_TARGET_OPTIONS, data.financeTarget) },
    { label: '账号注册方式', value: optionLabel(industry_register_mode.value, data.registerMode) },
    { label: '更新时间', value: headerTime(data.updateTime || data.createTime) }
  ]
})

onMounted(async () => {
  if (isAdd.value) return
  const id = route.query.id
  if (!id) return
  loading.value = true
  try {
    const res = await industryConfigDetail(id)
    fillForm(res.data || {})
  } catch (error) {
    // 失败提示已由 request 拦截器统一弹出
  } finally {
    loading.value = false
  }
})
</script>

