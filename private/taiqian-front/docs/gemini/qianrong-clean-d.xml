import Cookies from 'js-cookie'

const TokenKey = 'Deppon-Token'
const UnifiedTokenKey = 'unified_token'
const ExpiresInKey = 'Deppon-Expires-In'
const UserInfoKey = 'Deppon-User-Info'

const cookieConfig = {
  path: '/'
}

function getCookie(name) {
  const value = `; ${document.cookie}`
  const parts = value.split(`; ${name}=`)
  if (parts.length === 2) return parts.pop().split(';').shift()
}

export function getCookieToken() {

  let token = Cookies.get(TokenKey)
  if (!token) {
    token = getCookie(UnifiedTokenKey)

    if (token) {
      Cookies.set(TokenKey, token, cookieConfig)
    }
  }
  return token
}

export function getToken() {
  return getCookieToken()
}

export function setToken(token) {

  Cookies.set(TokenKey, token, cookieConfig)
  Cookies.set(UnifiedTokenKey, token, cookieConfig)
  return token
}

export function removeToken() {

  Cookies.remove(TokenKey, cookieConfig)
  Cookies.remove(UnifiedTokenKey, cookieConfig)

  document.cookie = `${TokenKey}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=.ftechain.com;`
  document.cookie = `${UnifiedTokenKey}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=.ftechain.com;`
}

export function getExpiresIn() {
  return Cookies.get(ExpiresInKey) || -1
}

export function setExpiresIn(time) {
  return Cookies.set(ExpiresInKey, time, cookieConfig)
}

export function removeExpiresIn() {
  return Cookies.remove(ExpiresInKey, cookieConfig)
}

export function getUserInfo() {
  try {
    const userInfo = localStorage.getItem(UserInfoKey)
    if (!userInfo) {
      return null
    }
    return JSON.parse(userInfo)
  } catch (error) {
    return null
  }
}

export function setUserInfo(userInfo) {
  try {
    const userInfoString = JSON.stringify(userInfo)
    localStorage.setItem(UserInfoKey, userInfoString)
    return true
  } catch (error) {
    return false
  }
}

export function removeUserInfo() {
  try {
    localStorage.removeItem(UserInfoKey)
    return true
  } catch (error) {
    return false
  }
}
</file>

