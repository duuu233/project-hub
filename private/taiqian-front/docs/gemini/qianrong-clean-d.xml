}
function handleSearch() { syncSearch(); handleQuery() }
function resetSearch() { syncSearch(); queryParams.value.pageNum = 1; proxy.$refs['operlogRef'].sort(defaultSort.value.prop, defaultSort.value.order) }

function getList() {
