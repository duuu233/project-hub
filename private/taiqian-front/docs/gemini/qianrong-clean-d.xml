<script setup>
import { ref, watch, onMounted, onBeforeUnmount, nextTick } from 'vue'
import { Setting, FullScreen, Close } from '@element-plus/icons-vue'
import ListToolbarTitle from '@/components/ListToolbarTitle/index.vue'
const props = defineProps({ title: String, total: Number, columns: { type: Array, default: () => [] }, storageKey: String })
const panel = ref(), fullscreen = ref(false), actionWidth = ref(200), hidden = ref([])
const storageKey = props.storageKey ? 'qianrong:list-columns:' + props.storageKey : ''
try { if (storageKey) { const saved = JSON.parse(localStorage.getItem(storageKey) || '[]'); if (Array.isArray(saved)) hidden.value = saved.filter(key => props.columns.some(col => col.key === key && !col.locked)) } } catch { /* 存储不可用时使用默认列。 */ }
const visible = key => !hidden.value.includes(key)
const persist = () => { try { if (storageKey) localStorage.setItem(storageKey, JSON.stringify(hidden.value)) } catch { /* 列设置仍在本次页面内生效。 */ } }
function setVisible(key, value) { hidden.value = value ? hidden.value.filter(item => item !== key) : [...new Set([...hidden.value, key])]; persist() }
function restoreColumns() { hidden.value = []; persist() }
let frame = 0, resize, mutations
function schedule() {
  cancelAnimationFrame(frame)
  frame = requestAnimationFrame(() => {
    if (!panel.value) return
    const widths = []
    panel.value.querySelectorAll('.el-table__body .qr-row-actions').forEach(group => [...group.children].forEach((child, index) => {
      const button = child.querySelector('.el-button, .el-dropdown') || child
      widths[index] = Math.max(widths[index] || 0, button.getBoundingClientRect().width)
    }))
    if (!widths.length) return
    panel.value.style.setProperty('--qr-actions-template', widths.map(width => Math.ceil(width) + 'px').join(' '))
    widths.forEach((width, index) => panel.value.style.setProperty('--qr-action-' + (index + 1) + '-width', Math.ceil(width) + 'px'))
    actionWidth.value = Math.max(80, Math.ceil(widths.reduce((sum, width) => sum + width, 0) + (widths.length - 1) * 7 + 20))
  })
}
const onKey = event => { if (event.key === 'Escape') fullscreen.value = false }
watch(fullscreen, async () => { await nextTick(); schedule() })
onMounted(() => {
  resize = new ResizeObserver(schedule); resize.observe(panel.value)
  mutations = new MutationObserver(schedule); mutations.observe(panel.value, { subtree: true, childList: true, characterData: true })
  window.addEventListener('keydown', onKey)
  document.fonts?.ready.then(schedule)
  schedule()
})
onBeforeUnmount(() => { cancelAnimationFrame(frame); resize?.disconnect(); mutations?.disconnect(); window.removeEventListener('keydown', onKey) })
</script>
