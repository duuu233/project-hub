<template>
  <div class="app-container qr-list-page qr-owned-page">
    <ListPageHeader fallback-title="产业配置" subtitle="按产业项目维护金融场景、融资H5及PC登录页配置">
      <template #actions>
        <el-button type="primary" class="handle-add-btn-index" v-hasPermi="['industryProject:config:add']" icon="CirclePlus" @click="handleAdd"
          >新增配置</el-button
        >
      </template>
    </ListPageHeader>
    <TableSearch :query="query" :options="searchOpt" :search="handleSearch" />

    <vxe-grid ref="gridRef" v-bind="gridOptions" v-on="gridEvents" class="qr-list-grid" v-list-grid="{ grid: gridRef }">
      <template #toolbarButtons>
        <ListToolbarTitle :total="gridOptions.pagerConfig?.total" />
      </template>
      <template #active="{ row }">
        <ListRowActions>
          <el-button link type="primary" v-hasPermi="['industryProject:config:detail']" @click="handleDetail(row)">详情</el-button>
          <el-button link type="primary" v-hasPermi="['industryProject:config:edit']" @click="handleEdit(row)">编辑</el-button>
        </ListRowActions>
      </template>
    </vxe-grid>
  </div>
</template>

<script setup name="Project-list">
import { computed, getCurrentInstance, onMounted, onUnmounted, reactive, ref } from 'vue'
import { useRouter } from 'vue-router'
import ListPageHeader from '@/components/ListPageHeader/index.vue'
import ListToolbarTitle from '@/components/ListToolbarTitle/index.vue'
import ListRowActions from '@/components/ListRowActions/index.vue'
import TableSearch from '@/components/TableSearch'
import { withListGridStyle, listGrid as vListGrid } from '@/utils/listGrid'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'
import { industryConfigPage } from '@/api/project/industryConfig'
import { FINANCE_SCENE_OPTIONS, FINANCE_TARGET_OPTIONS, optionLabel } from './constants'

const router = useRouter()
const { proxy } = getCurrentInstance()
const { registerGrid, unregisterGrid } = useVxeGridRefresh()
const { industry_project } = proxy.useDict('industry_project')

const gridRef = ref()

const query = reactive({
  projectCode: ''
})

const searchOpt = computed(() => [
  {
    type: 'select',
    label: '产业项目：',
    placeholder: '请选择产业项目',
    prop: 'projectCode',
    opts: industry_project.value
  }
])

const emptyText = value => (value === null || value === undefined || value === '' ? '--' : value)

const gridOptions = reactive(
  withListGridStyle({
    border: true,
    stripe: true,
    loading: false,
    columnConfig: {
      resizable: true
    },
    pagerConfig: {
      total: 0,
      currentPage: 1,
      pageSize: 20,
      layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
    },
    rowConfig: {
      isHover: true
    },
    toolbarConfig: {
      custom: true,
      refresh: false,
      zoom: true,
      slots: {
        buttons: 'toolbarButtons'
      }
    },
    columns: [
      { title: '配置编号', field: 'projectConfigNo', minWidth: 170 },
      {
        title: '产业项目',
        field: 'projectName',
        formatter: ({ row }) => emptyText(row.projectName || optionLabel(industry_project.value, row.projectCode))
      },
      { title: '金融场景', field: 'financeScene', formatter: ({ cellValue }) => emptyText(optionLabel(FINANCE_SCENE_OPTIONS, cellValue)) },
      { title: '融资对象', field: 'financeTarget', formatter: ({ cellValue }) => emptyText(optionLabel(FINANCE_TARGET_OPTIONS, cellValue)) },
      { title: '融资H5名称', field: 'h5Name', formatter: ({ cellValue }) => emptyText(cellValue) },
      // 注意：后端列表接口目前不返回 PC 大标题（pcBigTitle 只在详情的 pcConfigList 里），待后端补充字段后此列才有值
      { title: 'PC端大标题名称', field: 'pcBigTitle', formatter: ({ cellValue }) => emptyText(cellValue) },
      { title: '更新时间', field: 'updateTime', formatter: ({ row }) => emptyText(row.updateTime || row.createTime) },
      { title: '操作', field: 'active', width: 160, fixed: 'right', align: 'center', slots: { default: 'active' } }
    ],
    data: []
  })
)

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}

async function getList() {
  gridOptions.loading = true
  try {
    const res = await industryConfigPage({
      ...query,
      pageNum: gridOptions.pagerConfig.currentPage,
      pageSize: gridOptions.pagerConfig.pageSize
    })
    gridOptions.data = res.rows || []
    gridOptions.pagerConfig.total = Number(res.total) || 0
  } catch (error) {
    // 失败提示已由 request 拦截器统一弹出，这里保留现有数据
  } finally {
    gridOptions.loading = false
  }
}

function handleAdd() {
  router.push({ path: '/project/project-list/add' })
}

const handleEdit = row => {
  proxy.openNewTagsView({
    name: 'Project-list/edit'
  })
  router.push({
    path: '/project/project-list/edit',
    query: { id: row.id }
  })
}

const handleDetail = row => {
  proxy.openNewTagsView({
    name: 'Project-list/detail'
  })
  router.push({
    path: '/project/project-list/detail',
    query: { id: row.id }
  })
}

onMounted(() => {
  getList()
  registerGrid('project-list-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('project-list-grid')
})
</script>
