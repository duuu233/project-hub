  { label: '存货融资', value: 1 },
  { label: '预付款融资', value: 2 }
]

export const FINANCE_TARGET_OPTIONS = [
  { label: '采购方/经销商', value: 0 },
  { label: '采购方/选矿厂', value: 1 },
  { label: '供应商', value: 2 }
]

// 根据值取选项文案，找不到返回空字符串；兼容数字/字符串取值混用
export const optionLabel = (options, value) => options?.find(item => String(item.value) === String(value))?.label ?? ''
