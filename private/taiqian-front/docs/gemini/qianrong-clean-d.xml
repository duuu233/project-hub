export default {
  install(app) {
    app.mixin({
      mounted() {
        const tables = this.$el?.querySelectorAll?.('.el-table')
        if (!tables?.length) return

        const calculateTextWidth = text => {
          const chinese = text.match(/[\u4e00-\u9fa5]/g)?.length || 0
          const english = text.length - chinese
          return chinese * 16 + english * 8
        }

        const calculateElementWidth = element => {

          if (element.nodeType === Node.TEXT_NODE) {
            return calculateTextWidth(element.textContent || '')
          }

          if (element.nodeType === Node.ELEMENT_NODE) {
            const computedStyle = window.getComputedStyle(element)

            if (element.style.width || (computedStyle.width !== 'auto' && computedStyle.width !== '0px')) {
              return parseFloat(computedStyle.width)
            }

            let totalWidth = 0
            const children = Array.from(element.children)

            if (children.length === 0) {
              return element.getBoundingClientRect().width
            }

            children.forEach(child => {

              const childWidth = calculateElementWidth(child)

              totalWidth += childWidth
            })

            return Math.max(totalWidth, element.getBoundingClientRect().width)
          }

          return 0
        }

        const hasExplicitWidth = col => {

          const width = col.getAttribute('width')
          const styleWidth = col.style.width
          const computedWidth = window.getComputedStyle(col).width

          const isValidWidth = value => {
            if (!value) return false
            const numValue = parseInt(value)
            return !isNaN(numValue) && numValue > 0
          }

          const isAutoWidth = computedWidth && computedWidth !== 'auto' && !isValidWidth(width) && !isValidWidth(styleWidth)

          const hasWidth = (isValidWidth(width) || isValidWidth(styleWidth)) && !isAutoWidth

          return hasWidth
        }

        const getMaxCellWidth = cell => {

          if (cell.childNodes.length === 1 && cell.childNodes[0].nodeType === Node.TEXT_NODE) {
            return calculateTextWidth(cell.textContent?.trim() || '')
          }

          let maxWidth = 0
          let totalWidth = 0

          const children = Array.from(cell.children)

          children.forEach(child => {
            const childWidth = calculateElementWidth(child)
            totalWidth += childWidth
          })

          maxWidth = Math.max(maxWidth, totalWidth, cell.getBoundingClientRect().width)

          return maxWidth
        }

        const updateColumnWidth = () => {
          tables.forEach(table => {
            const cols = table.querySelectorAll('colgroup col')
            const headerCells = table.querySelectorAll('.el-table__header-wrapper .cell')
            const bodyCells = table.querySelectorAll('.el-table__body-wrapper .cell')

            const maxWidths = new Array(cols.length).fill(0)
            const needsAutoWidth = new Array(cols.length).fill(true)

            cols.forEach((col, index) => {
              if (hasExplicitWidth(col)) {
                needsAutoWidth[index] = false
              }
            })

            headerCells.forEach((cell, index) => {
              if (needsAutoWidth[index]) {
                const width = getMaxCellWidth(cell)
                maxWidths[index] = Math.max(maxWidths[index], width)
              }
            })

            bodyCells.forEach((cell, index) => {
              const colIndex = index % cols.length
              if (needsAutoWidth[colIndex]) {
                const width = getMaxCellWidth(cell)
                maxWidths[colIndex] = Math.max(maxWidths[colIndex], width)
              }
            })

            cols.forEach((col, index) => {
              if (needsAutoWidth[index]) {
                const padding = 32
                const minWidth = 80
                const width = Math.max(maxWidths[index] + padding, minWidth)
                col.style.width = `${width}px`
                col.style.minWidth = `${width}px`
              }
            })
          })
        }

        tables.forEach(table => {
          const observer = new MutationObserver(() => {
            updateColumnWidth()
          })

          observer.observe(table, {
            childList: true,
            subtree: true,
            characterData: true
          })
        })

        updateColumnWidth()
      }
    })
  }
}
