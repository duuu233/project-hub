<file path="apps/qianrong/src/components/FileUpload/index.vue">
<template>
  <div class="component-file-upload" style="width: 100%">
    <template v-if="!disabled">
      <el-upload
        multiple
        :action="uploadUrl"
        :on-success="handleUploadSuccess"
        :before-upload="handleBeforeUpload"
        :limit="limit"
        :drag="isDrag"
        :on-error="handleUploadError"
        :on-exceed="handleExceed"
        ref="fileUpload"
        :on-remove="handleDelete"
        :show-file-list="true"
        :headers="headers"
        v-model:file-list="fileList"
        :on-preview="handlePreview"
        :class="{ hide: fileList.length >= limit }"
        :accept="acceptedFileTypes"
      >
        <template #trigger>
          <div class="tips-box">
            <svg-icon style="font-size: 30px" icon-class="ic--round-drive-folder-upload" />
            <div style="font-size: 12px; color: rgb(168, 171, 178)">将文件拖放到此处或<i style="font-style: normal; color: #165dff">单击上传</i></div>
          </div>

        </template>
      </el-upload>

      <div class="el-upload__tip" v-if="showTip">
        请上传
        <template v-if="fileSize">
          大小不超过 <b style="color: #f56c6c">{{ fileSize }}MB</b>
        </template>
        <template v-if="currentFileType.length">
          格式为 <b style="color: #f56c6c">{{ currentFileType.join('/') }}</b>
        </template>
        的文件<br />
      </div>
    </template>

    <div v-if="disabled" class="file-list disabled-list">
      <div v-for="file in fileList" :key="file.name" class="file-item" :class="{ 'image-item': isImageFile(file.name) }">
        <img v-if="isImageFile(file.name)" :src="file.url" @click="handlePreviewImage(file)" class="file-image" />
        <template v-else>
          <el-icon class="file-icon">
            <component :is="getFileIconComponent(file.name)"></component>
          </el-icon>
          <span class="file-name" @click="handlePreviewDocument(file)">{{ file.name }}</span>
        </template>
      </div>
    </div>

    <el-dialog v-model="dialogVisible" :title="dialogTitle" width="800px" append-to-body>
      <template v-if="isCurrentPreviewImage">
        <img :src="dialogUrl" style="max-width: 100%; max-height: 580px" />
      </template>
      <template v-else>
        <iframe :src="dialogUrl" style="width: 100%; height: 600px; border: none"></iframe>
      </template>
    </el-dialog>
  </div>
</template>

<script setup>
import { ref, computed } from 'vue'
import { getToken } from '@/utils/auth'
import { ElMessage } from 'element-plus'
import * as ElementPlusIconsVue from '@element-plus/icons-vue'

const props = defineProps({
  modelValue: {
    type: Array,
    default: () => []
  },
  limit: {
    type: Number,
    default: 5
  },
  fileSize: {
    type: Number,
    default: 5
  },
  fileType: {
    type: Array,
    default: () => []
  },
  isShowTip: {
    type: Boolean,
    default: false
  },
  isDrag: {
    type: Boolean,
    default: true
  },
  listType: {
    type: String,
    default: 'all',
    validator: value => {
      return ['file', 'image', 'all'].indexOf(value) !== -1
    }
  },
  disabled: {
    type: Boolean,
    default: false
  }
})

function getFileIconComponent(fileName) {
  const extension = fileName.split('.').pop().toLowerCase()
  switch (extension) {
    case 'pdf':
      return ElementPlusIconsVue.Document
    case 'doc':
    case 'docx':
      return ElementPlusIconsVue.Memo
    case 'xls':
    case 'xlsx':
      return ElementPlusIconsVue.Grid
    case 'ppt':
    case 'pptx':
      return ElementPlusIconsVue.PieChart
    default:
      return ElementPlusIconsVue.Document
  }
}

const emit = defineEmits(['update:modelValue'])
const number = ref(0)
const dialogUrl = ref('')
const dialogTitle = ref('')
const dialogVisible = ref(false)
const isCurrentPreviewImage = ref(false)
const uploadUrl = ref('/api-qianrong/upload/file-upload')
const headers = ref({ Authorization: 'Bearer ' + getToken() })
const showTip = computed(() => props.isShowTip && (currentFileType.value.length > 0 || props.fileSize))

const filesType = ['pdf', 'doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx']
const imagesType = ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp']
const allTypes = [...filesType, ...imagesType]

const currentFileType = computed(() => {
  if (props.fileType.length > 0) {
    return props.fileType
  } else if (props.listType === 'file') {
    return filesType
  } else if (props.listType === 'image') {
    return imagesType
  } else {
    return allTypes
  }
})

const acceptedFileTypes = computed(() => {
  return currentFileType.value.map(type => `.${type}`).join(',')
})

const fileList = computed(() => {
  if (props.modelValue && props.modelValue.length > 0) {
    return props.modelValue.map((item, index) => ({
      name: item.fileName,
      url: item.fileUrl
        ? item.fileUrl.startsWith('http')
          ? item.fileUrl
          : item.fileUrl.startsWith('/api-qianrong')
          ? item.fileUrl
          : '/api-qianrong' + item.fileUrl
        : ''
    }))
  }
  return []
})

function handleBeforeUpload(file) {
  if (props.disabled) {
    ElMessage.warning('上传功能已禁用')
    return false
  }

  const extension = file.name.split('.').pop().toLowerCase()
  const isValidType = currentFileType.value.includes(extension)

  if (!isValidType) {
    ElMessage.error(`文件格式不正确, 请上传${currentFileType.value.join('/')}格式文件!`)
    return false
  }

  if (props.fileSize) {
    const isLt = file.size / 1024 / 1024 < props.fileSize
    if (!isLt) {
      ElMessage.error(`上传文件大小不能超过 ${props.fileSize} MB!`)
      return false
    }
  }

  ElMessage.info('正在上传文件，请稍候...')
  number.value++
  return true
}

function handleExceed() {
  ElMessage.error(`上传文件数量不能超过 ${props.limit} 个!`)
}

function handleUploadSuccess(res, file) {
  if (res.code === 200) {
    const url = res.data.url.startsWith('/api-qianrong') ? res.data.url : '/api-qianrong' + res.data.url
    const newFile = { name: res.data.name, url: url }
    const updatedList = [...fileList.value, newFile]
    emit(
      'update:modelValue',
      updatedList.map(file => ({
        fileName: file.name,
        fileUrl: file.url.replace(/^\/api-qianrong/, '')
      }))
    )
    ElMessage.success('文件上传成功')
  } else {
    ElMessage.error(res.msg)
  }
}

function handleDelete(file) {
  if (props.disabled) {
    ElMessage.warning('删除功能已禁用')
    return false
  }
  const updatedList = fileList.value.filter(f => !(f.name === file.name && f.url === file.url))
  emit(
    'update:modelValue',
    updatedList.map(file => ({
      fileName: file.name,
      fileUrl: file.url.replace(/^\/api-qianrong/, '')
    }))
  )
  return true
}

function handleUploadError() {
  ElMessage.error('上传文件失败')
}

function handlePreview(file) {
  if (isImageFile(file.name)) {
    handlePreviewImage(file)
  } else {
    handlePreviewDocument(file)
  }
}

function handlePreviewImage(file) {
  dialogUrl.value = file.url
  dialogTitle.value = file.name
  isCurrentPreviewImage.value = true
  dialogVisible.value = true
}

function handlePreviewDocument(file) {
  dialogUrl.value = file.url
  dialogTitle.value = file.name
  isCurrentPreviewImage.value = false
  dialogVisible.value = true
}

function isImageFile(fileName) {
  const extension = fileName.split('.').pop().toLowerCase()
  return imagesType.includes(extension)
}
</script>

