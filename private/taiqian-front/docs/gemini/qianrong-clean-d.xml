          <el-button link v-if="row.roleId != 1" type="primary" @click="handleDataScope(row)" v-hasPermi="['system:role:edit']">数据权限</el-button>

          <el-button link v-if="row.roleId != 1" type="primary" @click="handleAuthUser(row)" v-hasPermi="['system:role:edit']">分配用户</el-button>
