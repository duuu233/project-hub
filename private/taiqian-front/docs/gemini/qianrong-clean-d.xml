// 沿用页面自己的接口。请求成功后回填 data 和 total，分页事件保持原样。
async function loadList() { /* 请求 {...query, pageNum: currentPage, pageSize} 并回填 */ }
function handleSearch() { gridOptions.pagerConfig.currentPage = 1; loadList() }
