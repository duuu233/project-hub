  )
}

function handleRefreshCache() {
  refreshCache().then(() => {
    proxy.$modal.msgSuccess('刷新成功')
    useDictStore().cleanDict()
  })
}

onMounted(() => {
  getList()
  registerGrid('dict-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('dict-grid')
})
</script>
