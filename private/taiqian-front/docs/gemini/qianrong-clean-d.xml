<script setup>
import DetailHeaderCard from '@/components/DetailHeaderCard/index.vue'
import { headerTime, dictTagField, treeLabel } from '@/components/DetailHeaderCard/utils'
import BottomFixedBtnsBox from '@/components/BottomFixedBtnsBox/index.vue'
import Collapse from '@/components/Collapse'
import AreaCascader from '@/components/AreaCascader'

import {
  changeUserStatus,
  listUser,
  resetUserPwd,
  delUser,
  getUser,
  updateUser,
  addUser,
  deptTreeSelect,
  deptTreeSelectByOrg
} from '@/api/system/user'
import { nextTick, onMounted } from 'vue'
import { ElMessage } from 'element-plus'
import { cloneDeep } from 'lodash-es'
import { encode, decode } from 'js-base64'
import { useRouter } from 'vue-router'
const { currentRoute, back } = useRouter()
const _props = defineProps({
  pageType: Number
})
const form = ref({
  status: '0'
})
const { proxy } = getCurrentInstance()
const { sys_normal_disable, sys_user_sex } = proxy.useDict('sys_normal_disable', 'sys_user_sex')
const deptOptions = ref(undefined)
const formRef = ref()
const iconSelectRef = ref(null)
const cascaderRef = ref()
const postOptions = ref([])
const roleOptions = ref([])
const initPassword = ref(undefined)
async function getUserInfo() {
  try {
    const res = await getUser(currentRoute.value.query.id)

    if (_props.pageType !== 1) {
      form.value = res.data

      form.value.areaIds = form.value.areaIds?.length ? form.value.areaIds.split(',') : []
      form.value.roleIds = res.roleIds || []
      form.value.postIds = res.postIds || []
    }
    postOptions.value = res.posts
    roleOptions.value = res.roles
  } catch (error) {
    console.log(error)
  }
}
const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      let areaIds
      let areaNames
      if (form.value.areaIds && form.value.areaIds.length) {
        areaIds = form.value.areaIds.join(',')

        form.value.areaNames = cascaderRef.value.getNames()
        areaNames = form.value.areaNames.join(',')
      }
      let submitData = cloneDeep(form.value)
      submitData.password = encode(submitData.password)
      if (_props.pageType === 1) {
        await addUser({ ...submitData, areaIds, areaNames })
      }
      if (_props.pageType === 2) {
        await updateUser({ ...submitData, areaIds, areaNames })
      }
      ElMessage.success('操作成功')
      setTimeout(() => {
        proxy.toList({
          path: `/system/user`,
          listName: 'User'
        })
      }, 300)
    } else {
      console.log('error submit!', fields)
    }
  })
}

onMounted(async () => {
  await getDeptTree()
  await getUserInfo()
})

async function getDeptTree() {
  await deptTreeSelect().then(response => {
    deptOptions.value = response.data
  })
}

const validateRoleIds = (rule, value, callback) => {
  if (_props.pageType == 1) {
    if (!value || !value.length) {
      callback(new Error('请选择角色'))
    } else {
      callback()
    }
  }

  if (_props.pageType == 2) {
    setTimeout(() => {
      if ((!value || !value.length) && ['00', '02'].indexOf(form.value.userType) == -1) {
        callback(new Error('请选择角色'))
      } else {
        callback()
      }
    }, 1000)
  }

}
const rules = reactive({
  userName: [
    { required: true, message: '用户名称不能为空', trigger: 'blur' },
    {
      min: 2,
      max: 20,
      message: '用户名称长度必须介于 2 和 20 之间',
      trigger: 'blur'
    }
  ],
  nickName: [{ required: true, message: '用户昵称不能为空', trigger: 'blur' }],
  roleIds: [{ type: 'array', validator: validateRoleIds, trigger: 'change' }],
  password: [
    { required: true, message: '用户密码不能为空', trigger: 'blur' },
    {
      min: 5,
      max: 100,
      message: '用户密码长度必须介于 5 和 100 之间',
      trigger: 'blur'
    },
    {
      pattern: /^[^<>"'|\\]+$/,
      message: '不能包含非法字符：< > " \' \\\ |',
      trigger: 'blur'
    }
  ],
  email: [
    {
      type: 'email',
      message: '请输入正确的邮箱地址',
      trigger: ['blur', 'change']
    }
  ],
  phonenumber: [
    {
      required: true,
      pattern: /^1[3|4|5|6|7|8|9][0-9]\d{8}$/,
      message: '请输入正确的手机号码',
      trigger: 'blur'
    }
  ]
})
const detailHeaderFields = computed(() => {
  const data = form.value
  return [
    { label: '用户编号', value: data.userId },
    { label: '用户名称', value: data.userName },
    { label: '用户昵称', value: data.nickName },
    { label: '所属部门', value: data.dept?.deptName || data.deptName || treeLabel(deptOptions, data.deptId) },
    dictTagField('状态', sys_normal_disable, data.status),
    { label: '创建时间', value: headerTime(data.createTime) }
  ]
})
</script>
