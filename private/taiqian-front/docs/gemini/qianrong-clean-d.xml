    { type: 'seq', width: 70, align: 'center', title: '序号' },
    { title: '币种名称', field: 'currencyName', align: 'center' },
    { title: '币种标识', field: 'currencySymbol', align: 'center' },
    { title: '币种编码', field: 'currencyCode', align: 'center' },
    { title: '备注', field: 'remark', align: 'center' },
    { title: '创建时间', field: 'createTime', width: 180, align: 'center', slots: { default: 'createTimeRender' } },
    { title: '操作', field: 'active', width: 180, align: 'center', slots: { default: 'active' } }
  ],
  data: []
}))

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

const data = reactive({
  form: {},
  queryParams: {
    pageNum: 1,
    pageSize: 10,
    postCode: undefined,
    currencyName: undefined,
    status: undefined
  },
  rules: {
    currencyName: [{ required: true, message: '币种名称不能为空', trigger: 'blur' }],
    currencySymbol: [{ required: true, message: '币种标识不能为空', trigger: 'blur' }],
    currencyCode: [{ required: true, message: '币种编码不能为空', trigger: 'blur' }]
  }
})

const { queryParams, form, rules } = toRefs(data)

function getList() {
  gridOptions.loading = true
  listCurrency({
    ...queryParams.value,
    pageNum: gridOptions.pagerConfig.currentPage,
    pageSize: gridOptions.pagerConfig.pageSize
  }).then(response => {
    gridOptions.data = response.rows
    gridOptions.pagerConfig.total = response.total * 1
    gridOptions.loading = false
  })
}

function cancel() {
  open.value = false
  reset()
}

function reset() {
  form.value = {
    postId: undefined,
    postCode: undefined,
    currencyName: undefined,
    postSort: 0,
    status: '0',
    remark: undefined
  }
  proxy.resetForm('postRef')
}

function handleQuery() {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}

function resetQuery() {
  proxy.resetForm('queryRef')
  handleQuery()
}

function handleSelectionChange(selection) {
  ids.value = selection.map(item => item.postId)
  single.value = selection.length != 1
  multiple.value = !selection.length
}

function handleAdd() {
  reset()
  open.value = true
  title.value = '添加币种'
}

function handleUpdate(row) {
  reset()

  detailCurrency({ currencyId: row.currencyId }).then(response => {
    form.value = response.data
    open.value = true
    title.value = '修改币种'
  })
}

function submitForm() {
  proxy.$refs['postRef'].validate(valid => {
    if (valid) {
      saveCurrency(form.value).then(response => {
        proxy.$modal.msgSuccess('修改成功')
        open.value = false
        getList()
      })
    }
  })
}

function handleDelete(row) {
  proxy.$modal
    .confirm('是否确认删除该数据项？')
    .then(function () {
      return delCurrency([row.currencyId])
    })
    .then(() => {
      getList()
      proxy.$modal.msgSuccess('删除成功')
    })
    .catch(() => {})
}

function handleExport() {
  proxy.download(
    'system/post/export',
    {
      ...queryParams.value
    },
    `post_${new Date().getTime()}.xlsx`
  )
}

onMounted(() => {
  getList()
  registerGrid('currency-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('currency-grid')
})
</script>
