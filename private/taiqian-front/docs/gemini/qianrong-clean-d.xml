import { ElMessage } from 'element-plus'
import { user, systems, groups, enterprises, roles, departments, menus, menuTree, dictionaries, dictionaryData, operationLogs, loginLogs } from './fixtures'

function page(rows, params = {}) {
  const filters = Object.entries(params).filter(([key, value]) => !['pageNum', 'pageSize', 'params', 'orderByColumn', 'isAsc', 'dictType'].includes(key) && value !== '' && value != null)
  let filtered = rows.filter(row => filters.every(([key, value]) => row[key] == null || String(row[key]).includes(String(value))))
  const range = params.params || {}
  filtered = filtered.filter(row => { const time = row.operTime || row.loginTime || row.createTime; return (!range.beginTime || time >= range.beginTime) && (!range.endTime || time <= range.endTime) })
  if (params.orderByColumn) filtered = [...filtered].sort((a, b) => String(a[params.orderByColumn]).localeCompare(String(b[params.orderByColumn])) * (params.isAsc === 'asc' ? 1 : -1))
  const size = Number(params.pageSize) || 10, start = ((Number(params.pageNum) || 1) - 1) * size
  return { code: 200, rows: structuredClone(filtered.slice(start, start + size)), total: filtered.length }
}

export default async function request(config) {
  const method = (config.method || 'get').toLowerCase(), url = config.url, params = config.params || {}
  if (method !== 'get') {
    // 资料保存仅影响本次预览；其他提交显式提示，避免伪装后端成功。
    if (url.endsWith('/user/profile') && method === 'put') {
      Object.assign(user, config.data)
      ElMessage.info('已更新本次预览的资料，刷新页面后恢复示例')
      return { code: 200, msg: '静态资料已更新' }
    }
    ElMessage.warning('静态预览：此操作尚未接入服务，未保存任何业务数据')
    throw new Error('静态预览不执行此操作')
  }
  const data = value => ({ code: 200, data: structuredClone(value) })
  if (url.endsWith('/system/page')) return page(systems, params)
  if (url.endsWith('/system/list')) return data(systems)
  if (url.endsWith('/system/detail')) return data(systems.find(row => row.id == params.id) || systems[0])
  if (url.endsWith('/groups/menuTreeList')) return data(systems)
  if (url.endsWith('/groups/page')) return page(groups, params)
  if (url.endsWith('/groups/detail')) return data(groups[0])
  if (url.endsWith('/menu/treeselect')) return data(menuTree)
  if (url.includes('/menu/roleMenuTreeselect/')) return { ...data(menuTree), menus: structuredClone(menuTree), checkedKeys: [11] }
  if (url.endsWith('/menu/list')) return data(menus)
  if (/\/menu\/\d+$/.test(url)) return data(menus[0])
  if (url.endsWith('/org/list')) return page(enterprises, params)
  if (url.includes('/org/detail/')) return data(enterprises[0])
  if (url.includes('/deptTree') || url.includes('/orgDeptTree')) return data([{ id: 1, label: '运营管理部', children: [{ id: 2, label: '客户服务组' }] }])
  if (url.includes('/dept/list')) return data(departments)
  if (/\/dept\/\d+$/.test(url)) return data(departments[0])
  if (url.endsWith('/role/scopeList')) return data([{ label: '全部数据', value: '1' }, { label: '本部门数据', value: '2' }])
  if (url.endsWith('/role/list')) return page(roles, params)
  if (/\/role\/\d+$/.test(url)) return data(roles[0])
  if (url.includes('/authUser/')) return page([user], params)
  if (url.includes('/user/authRole/')) return { code: 200, user: structuredClone(user), roles: structuredClone(roles) }
  if (url.endsWith('/user/profile')) return { ...data(user), roleGroup: '运营管理员', postGroup: '运营专员' }
  if (url.endsWith('/user/list')) return page([user], params)
  if (/\/system\/user(?:\/\d+)?$/.test(url)) return { ...data(user), posts: [], roles: structuredClone(roles), roleIds: [1], postIds: [] }
  if (url.endsWith('/dict/type/list')) return page(dictionaries, params)
  if (url.endsWith('/dict/type/optionselect')) return data(dictionaries)
  if (/\/dict\/type\/\d+$/.test(url)) return data(dictionaries[0])
  if (url.endsWith('/dict/data/list')) return page(dictionaryData, params)
  if (/\/dict\/data\/\d+$/.test(url)) return data(dictionaryData[0])
  if (url.endsWith('/operlog/list')) return page(operationLogs, params)
  if (url.endsWith('/logininfor/list')) return page(loginLogs, params)
  if (url.endsWith('/common/selectArea')) return data([])
  throw new Error('静态预览未配置此读取：' + url)
}
