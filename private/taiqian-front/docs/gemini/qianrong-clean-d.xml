<script setup name="Menu">
import ListPageHeader from '@/components/ListPageHeader/index.vue'
import ListTablePanel from '@/components/ListTablePanel/index.vue'
import ListRowActions from '@/components/ListRowActions/index.vue'
import { ref, reactive, toRefs, nextTick, getCurrentInstance } from 'vue'
import { delMenu, listMenu, updateMenu } from '@/api/system/menu'
import SvgIcon from '@/components/SvgIcon'
import { useRouter } from 'vue-router'
import Sortable from 'sortablejs'
import { ElMessage } from 'element-plus'
import { Operation } from '@element-plus/icons-vue'
import TableSearch from '@/components/TableSearch'
const { push } = useRouter()
const { proxy } = getCurrentInstance()
const { sys_normal_disable } = proxy.useDict('sys_normal_disable')

const menuList = ref([])
const loading = ref(true)
const showSearch = ref(true)
const isExpandAll = ref(false)
const refreshTable = ref(true)

const menuTableRef = ref()
const nativeColumns = [
  {
    "key": "drag",
    "label": "拖动",
    "locked": true
  },
  {
    "key": "menuName",
    "label": "菜单名称",
    "locked": false
  },
  {
    "key": "icon",
    "label": "图标",
    "locked": false
  },
  {
    "key": "index",
    "label": "索引",
    "locked": false
  },
  {
    "key": "orderNum",
    "label": "排序",
    "locked": false
  },
  {
    "key": "perms",
    "label": "权限标识",
    "locked": false
  },
  {
    "key": "component",
    "label": "组件路径",
    "locked": false
  },
  {
    "key": "status",
    "label": "状态",
    "locked": false
  },
  {
    "key": "createTime",
    "label": "创建时间",
    "locked": false
  },
  {
    "key": "actions",
    "label": "操作",
    "locked": true
  }
]
const query = reactive({ menuName: '', status: '' })
function countMenus(rows = []) { return rows.reduce((sum, row) => sum + 1 + countMenus(row.children || []), 0) }
const handleSearch = () => {
  queryParams.value.pageNum = 1
  getList()
}
const searchOpt = ref([
  {
    type: 'input',
    label: '菜单名称：',
    placeholder: '请输入',
    prop: 'menuName'
  },
  {
    type: 'select',
    label: '菜单状态：',
    opts: sys_normal_disable,
    placeholder: '请选择',
    prop: 'status'
  }
])
const columns = [
  { prop: 'menuName', label: '菜单名称', width: '160', showOverflowTooltip: true },
  { prop: 'icon', label: '图标', align: 'center' },
  { prop: 'orderNum', label: '排序' },
  { prop: 'perms', label: '权限标识', width: '240', showOverflowTooltip: true },
  { prop: 'component', label: '组件路径', width: '300', showOverflowTooltip: true },
  { prop: 'status', label: '状态', width: '80' },
  { prop: 'createTime', label: '创建时间', align: 'center', width: '160' },
  { prop: 'operation', label: '操作', align: 'center', width: '210', className: 'small-padding fixed-width' }
]

const data = reactive({
  queryParams: {
    menuName: undefined,
    visible: undefined
  }
})

const { queryParams } = toRefs(data)

function addRealIndex(tree) {
  let index = 0

  function traverse(node) {
    node.realIndex = index++
    if (node.children && node.children.length > 0) {
      node.children.forEach(child => traverse(child))
    }
  }

  tree.forEach(node => traverse(node))

  return tree
}

function getList() {
  loading.value = true
  listMenu({ ...queryParams.value, ...query }).then(response => {
    let treeData = proxy.handleTree(response.data, 'menuId')
    menuList.value = addRealIndex(treeData)
    loading.value = false
    nextTick(() => {
      initSortable()
    })
  })
}

function initSortable() {
  const el = menuTableRef.value?.$el.querySelector('.el-table__body-wrapper tbody')
  if (!el) return
  Sortable.create(el, {
    handle: '.drag-handle',
    onEnd({ oldIndex, newIndex }) {
      const currRow = menuList.value.find(item => item.realIndex === oldIndex)
      const targetRow = menuList.value.find(item => item.realIndex === newIndex)

      if (!currRow || !targetRow) {
        let childrenCurrRow, childrenTargetRow
        if ((!currRow && targetRow) || (currRow && !targetRow)) {
          ElMessage.warning('请拖拽到正确的位置')
          setTimeout(() => {
            window.location.reload()
          }, 300)
          return
        }

        const findChildrenObj = menuList.value.find(item => oldIndex > item.realIndex && item.realIndex < newIndex)
        const findChildren = findChildrenObj?.children
        childrenCurrRow = findChildren.find(item => item.realIndex === oldIndex)
        childrenTargetRow = findChildren.find(item => item.realIndex === newIndex)
        if (!childrenCurrRow || !childrenTargetRow) {
          ElMessage.warning('请拖拽到正确的位置')
          setTimeout(() => {
            window.location.reload()
          }, 300)
          return
        }

        const oldRealIndex = childrenCurrRow.orderNum - 1
        const newRealIndex = childrenTargetRow.orderNum - 1
        findChildren.splice(oldRealIndex, 1)
        findChildren.splice(newRealIndex, 0, childrenCurrRow)
        updateChildrenMenuOrder(findChildren)
      } else {
        if (!isSameLevel(currRow, targetRow)) {
          ElMessage.warning('只能在同级菜单中拖拽')
          setTimeout(() => {
            window.location.reload()
          }, 300)
          return
        }

        const oldRealIndex = currRow.orderNum - 1
        const newRealIndex = targetRow.orderNum - 1
        menuList.value.splice(oldRealIndex, 1)
        menuList.value.splice(newRealIndex, 0, currRow)
        updateMenuOrder()
      }
    }
  })
}

function isSameLevel(row1, row2) {
  return row1?.parentId === row2?.parentId
}

function updateMenuOrder() {
  const updatedMenus = menuList.value.map((menu, index) => ({
    ...menu,
    orderNum: index + 1
  }))
  const updatePromises = updatedMenus.map(menu => updateMenu(menu))
  Promise.all(updatePromises)
    .then(() => {
      ElMessage.success('菜单排序更新成功')
      getList()
    })
    .catch(() => {
      ElMessage.error('菜单排序更新失败')
    })
}

function updateChildrenMenuOrder(children) {
  const updatedChildren = children.map((child, index) => ({
    ...child,
    orderNum: index + 1
  }))
  const updatePromises = updatedChildren.map(child => updateMenu(child))
  Promise.all(updatePromises)
    .then(() => {
      ElMessage.success('子菜单排序更新成功')
      getList()
    })
    .catch(() => {
      ElMessage.error('子菜单排序更新失败')
    })
}

function handleQuery() {
  getList()
}

function resetQuery() {
  proxy.resetForm('queryRef')
  handleQuery()
}

function handleAdd(row = {}) {
  push({
    path: '/system/menu/add',
    query: { parentId: row.menuId }
  })
}

function toggleExpandAll() {
  refreshTable.value = false
  isExpandAll.value = !isExpandAll.value
  nextTick(() => {
    refreshTable.value = true
  })
}

function handleUpdate(row) {
  proxy.openNewTagsView({
    name: 'Menu/edit'
  })
  push({
    path: '/system/menu/edit',
    query: { id: row.menuId }
  })
}

function handleDetail(row) {
  proxy.openNewTagsView({
    name: 'Menu/detail'
  })
  push({
    path: '/system/menu/detail',
    query: { id: row.menuId }
  })
}

function handleDelete(row) {
  proxy.$modal
    .confirm('是否确认删除名称为"' + row.menuName + '"的数据项?')
    .then(function () {
      return delMenu(row.menuId)
    })
    .then(() => {
      getList()
      proxy.$modal.msgSuccess('删除成功')
    })
    .catch(() => {})
}

getList()
</script>

<style scoped>
.drag-handle {
  cursor: move;
}
</style>
