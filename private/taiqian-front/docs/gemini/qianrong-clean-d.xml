<script setup>
import { ref, onMounted, computed, getCurrentInstance } from 'vue'
import { getDataSelectList, setCache } from '@/api/common'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'

const { proxy } = getCurrentInstance()
const { refreshAllGrids } = useVxeGridRefresh()

const selectedValue = ref('')
const options = ref([])

const loginType = localStorage.getItem('loginType')

const placeholder = computed(() => {
  if (loginType === '1') {
    return '选择产业项目'
  } else if (loginType === '2') {
    return '选择产业项目'
  } else if (loginType === '3') {
    return '选择金融项目'
  }
  return '请选择'
})

const dataType = computed(() => {
  if (loginType === '1') {
    return 'tenant'
  } else if (loginType === '2') {
    return 'regulatory'
  } else if (loginType === '3') {
    return 'bank'
  }
  return ''
})

const cacheType = computed(() => {
  if (loginType === '1') {
    return 'tenant'
  } else if (loginType === '2') {
    return 'regulatory'
  } else if (loginType === '3') {
    return 'bank'
  }
  return ''
})

async function fetchData() {
  try {
    if (dataType.value) {
      const response = await getDataSelectList(dataType.value)

      if (response && response.code === 200 && response.data) {
        options.value = response.data.data || []

        if (response.data.key) {
          selectedValue.value = response.data.key
        }
      }
    }
  } catch (error) {
    console.error('获取数据失败:', error)
  }
}

async function handleSelectChange(value) {
  if (value && cacheType.value) {
    try {
      await setCache(cacheType.value, value)

      refreshAllGrids()
    } catch (error) {
      console.error('更新缓存失败:', error)
    }
  }
}

onMounted(() => {
  fetchData()
})
</script>

