import { login, logout, getInfo } from '@/api/login'
import { getToken, setToken, removeToken, getUserInfo, setUserInfo, removeUserInfo } from '@/utils/auth'
import { clearSsoEntryContext } from '@/utils/ssoSystem'
import defAva from '@/assets/images/profile.png'
import { cloneDeep } from 'lodash-es'

const useUserStore = defineStore('user', {
  state: () => ({
    token: getToken(),
    id: '',
    name: '',
    avatar: '',
    roles: [],
    permissions: []
  }),
  actions: {

    login(userInfo) {
      const _userInfo = cloneDeep(userInfo)

      const username = userInfo.username.trim()
      delete _userInfo.passwordByBase64
      if (_userInfo.deptIdList) {
        delete _userInfo.deptIdList
      }
      return new Promise((resolve, reject) => {

        login({
          ..._userInfo,
          username,
          password: userInfo.passwordByBase64,
          loginType: userInfo.loginType,
          orgId: userInfo.orgId,
          roleId: userInfo.roleId
        })
          .then(res => {
            let token = res.token
            setToken(token)
            clearSsoEntryContext()

            this.token = token
            resolve()
          })
          .catch(error => {
            reject(error)
          })
      })
    },

    getInfo() {
      return new Promise((resolve, reject) => {

        const cachedUserInfo = getUserInfo()
        if (cachedUserInfo) {
          this.setUserInfo(cachedUserInfo)
          resolve(cachedUserInfo)
          return
        }

        getInfo()
          .then(res => {
            const user = res.user

            const avatar = user.avatar == '' || user.avatar == null ? defAva : '/api-qianrong' + user.avatar

            if (res.roles && res.roles.length > 0) {

              this.roles = res.roles
              this.permissions = res.permissions
            } else {
              this.roles = ['ROLE_DEFAULT']
            }
            this.id = user.userId
            this.name = user.userName
            this.avatar = avatar

            setUserInfo(res)

            resolve(res)
          })
          .catch(error => {
            reject(error)
          })
      })
    },

    setUserInfo(userInfo) {
      this.id = userInfo.user.userId
      this.name = userInfo.user.userName
      this.avatar = userInfo.user.avatar == '' || userInfo.user.avatar == null ? defAva : '/api-qianrong' + userInfo.user.avatar
      this.roles = userInfo.roles || ['ROLE_DEFAULT']
      this.permissions = userInfo.permissions || []
    },

    logOut() {
      return new Promise((resolve, reject) => {
        logout(this.token)
          .then(() => {
            this.token = ''
            this.roles = []
            this.permissions = []
            clearSsoEntryContext()
            removeToken()
            removeUserInfo()
            resolve()
          })
          .catch(error => {
            reject(error)
          })
      })
    }
  }
})

export default useUserStore
