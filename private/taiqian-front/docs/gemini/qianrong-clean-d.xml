import html2Canvas from 'html2canvas'
import jsPDF from 'jspdf'

const htmlToPdf = {
  getPdf(title, loading, DOMName) {

    if (!DOMName) return
    console.log('DOMName', DOMName)
    console.log('document', document.querySelector(DOMName))
    html2Canvas(document.querySelector(DOMName), {
      allowTaint: false,
      taintTest: false,
      logging: false,
      useCORS: true,
      dpi: window.devicePixelRatio * 4,
      scale: 4
    }).then(canvas => {
      var pdf = new jsPDF('p', 'mm', 'a4')
      var ctx = canvas.getContext('2d'),
        a4w = 190,
        a4h = 272,
        imgHeight = Math.floor((a4h * canvas.width) / a4w),
        renderedHeight = 0

      while (renderedHeight < canvas.height) {
        var page = document.createElement('canvas')
        page.width = canvas.width
        page.height = Math.min(imgHeight, canvas.height - renderedHeight)

        page
          .getContext('2d')
          .putImageData(ctx.getImageData(0, renderedHeight, canvas.width, Math.min(imgHeight, canvas.height - renderedHeight)), 0, 0)
        pdf.addImage(page.toDataURL('image/jpeg', 1.0), 'JPEG', 10, 10, a4w, Math.min(a4h, (a4w * page.height) / page.width))

        renderedHeight += imgHeight
        if (renderedHeight < canvas.height) {
          pdf.addPage()
        }

      }

      pdf.save(title + '.pdf')

      console.log(loading)
    })
  }
}

export default htmlToPdf
