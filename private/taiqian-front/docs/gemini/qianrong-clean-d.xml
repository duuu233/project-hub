export function titleCase(str) {
  return str.replace(/( |^)[a-z]/g, L => L.toUpperCase())
}

export function camelCase(str) {
  return str.replace(/_[a-z]/g, str1 => str1.substr(-1).toUpperCase())
}

export function isNumberStr(str) {
  return /^[+-]?(0|([1-9]\d*))(\.\d+)?$/g.test(str)
}

export function formatThousand(num, decimalPlaces = 2) {
  const digits = Number.isInteger(decimalPlaces) && decimalPlaces >= 0 ? decimalPlaces : 2
  const zeroText = (0).toLocaleString('en-US', {
    minimumFractionDigits: digits,
    maximumFractionDigits: digits
  })

  if (num == null || num === '') {
    return zeroText
  }

  const number = Number(num)

  if (!isFinite(number)) {
    console.warn('Invalid input for formatThousand:', num)
    return zeroText
  }

  return number.toLocaleString('en-US', {
    minimumFractionDigits: digits,
    maximumFractionDigits: digits
  })
}

export function renameFields(arr, oldName1 = 'fileUrl', oldName2 = 'fileName', newName1 = 'url', newName2 = 'name') {
  if (!arr || arr.length === 0) return
  return arr.map(item => {
    return {
      ...item,
      [newName1]: item[oldName1],
      [newName2]: item[oldName2]
    }
  })
}

export function multiplyWithPrecision(num1, num2, precision = 2) {

  const p = Number.isFinite(+precision) ? Math.max(0, Math.floor(+precision)) : 2

  const str1 = num1.toString()
  const str2 = num2.toString()

  const decimal1 = (str1.split('.')[1] || '').length
  const decimal2 = (str2.split('.')[1] || '').length

  const int1 = parseInt(str1.replace('.', ''))
  const int2 = parseInt(str2.replace('.', ''))

  const totalDecimal = decimal1 + decimal2

  const result = (int1 * int2) / Math.pow(10, totalDecimal)

  return result.toFixed(p)
}

export function toPrecision(num, precision = 2) {

  const str = num.toString()

  if (!str.includes('.')) {
    return Number(str + '.' + '0'.repeat(precision))
  }

  const [integerPart, decimalPart] = str.split('.')

  if (decimalPart.length <= precision) {
    const paddedDecimal = decimalPart.padEnd(precision, '0')
    return Number(integerPart + '.' + paddedDecimal)
  }

  const factor = Math.pow(10, precision)
  const intNum = parseInt(integerPart + decimalPart.substring(0, precision + 1))

  const nextDigit = parseInt(decimalPart[precision] || '0')
  const shouldRoundUp = nextDigit >= 5

  let result = Math.floor(intNum / 10)
  if (shouldRoundUp) {
    result += 1
  }

  return result / factor
}
