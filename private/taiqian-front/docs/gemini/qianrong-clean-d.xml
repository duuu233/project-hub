<script setup>
import { ref, computed, watch, getCurrentInstance } from 'vue'
import { getToken } from '@/utils/auth'
import { ElMessage } from 'element-plus'
import { Plus } from '@element-plus/icons-vue'

const props = defineProps({
  modelValue: [String, Object, Array],
  limit: {
    type: Number,
    default: 5
  },
  fileSize: {
    type: Number,
    default: 5
  },
  fileType: {
    type: Array,
    default: () => []
  },
  isShowTip: {
    type: Boolean,
    default: true
  },
  listType: {
    type: String,
    default: 'picture-card',
    validator: value => {
      return ['text', 'picture', 'picture-card', 'file'].indexOf(value) !== -1
    }
  },
  disabled: {
    type: Boolean,
    default: false
  }
})

const { proxy } = getCurrentInstance()
const emit = defineEmits(['update:modelValue'])
const number = ref(0)
const uploadList = ref([])
const dialogUrl = ref('')
const dialogTitle = ref('')
const dialogVisible = ref(false)
const isImageFileDialogOpen = ref(true)
const baseUrl = '/api-qianrong'
const uploadUrl = ref('/api-qianrong/upload/file-upload')
const headers = ref({ Authorization: 'Bearer ' + getToken() })
const fileList = ref([])
const showTip = computed(() => props.isShowTip && (currentFileType.value.length > 0 || props.fileSize))

const filesType = ['pdf', 'doc', 'docx', 'xls', 'xlsx', 'ppt', 'pptx']
const imagesType = ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp']

const currentFileType = computed(() => {
  if (props.fileType.length > 0) {
    return props.fileType
  } else {
    switch (props.listType) {
      case 'file':
        return filesType
      case 'text':
      case 'picture':
      case 'picture-card':
        return imagesType
      default:
        return imagesType
    }
  }
})

const acceptedFileTypes = computed(() => {
  return currentFileType.value.map(type => `.${type}`).join(',')
})

watch(
  () => props.modelValue,
  val => {
    if (val) {
      const list = Array.isArray(val) ? val : props.modelValue.split(',')
      fileList.value = list.map(item => {

        if (typeof item === 'string') {
          item = { name: item, url: baseUrl + item }
        }

        return item
      })
    } else {
      fileList.value = []
      return []
    }
  },
  { deep: true, immediate: true }
)

function handleBeforeUpload(file) {
  if (props.disabled) {
    ElMessage.warning('上传功能已禁用')
    return false
  }

  const extension = file.name.split('.').pop().toLowerCase()
  const isValidType = currentFileType.value.includes(extension)

  if (!isValidType) {
    ElMessage.error(`文件格式不正确, 请上传${currentFileType.value.join('/')}格式文件!`)
    return false
  }

  if (props.fileSize) {
    const isLt = file.size / 1024 / 1024 < props.fileSize
    if (!isLt) {
      ElMessage.error(`上传文件大小不能超过 ${props.fileSize} MB!`)
      return false
    }
  }

  ElMessage.info('正在上传文件，请稍候...')
  number.value++
  return true
}

function handleExceed() {
  ElMessage.error(`上传文件数量不能超过 ${props.limit} 个!`)
}

function handleUploadSuccess(res, file) {
  if (res.code === 200) {
    uploadList.value.push({ name: res.data.url, url: res.data.url })
    uploadedSuccessfully()
  } else {
    number.value--
    ElMessage.error(res.msg)
    proxy.$refs.fileUpload.handleRemove(file)
    uploadedSuccessfully()
  }
}

function handleDelete(file) {
  if (props.disabled) {
    ElMessage.warning('删除功能已禁用')
    return false
  }

  const findex = fileList.value.map(f => f.name).indexOf(file.name)
  if (findex > -1 && uploadList.value.length === number.value) {
    fileList.value.splice(findex, 1)
    emit('update:modelValue', listToString(fileList.value))
    return true
  }
  return false
}

function uploadedSuccessfully() {
  if (number.value > 0 && uploadList.value.length === number.value) {
    fileList.value = fileList.value.filter(f => f.url !== undefined).concat(uploadList.value)
    uploadList.value = []
    number.value = 0
    emit('update:modelValue', listToString(fileList.value))
    ElMessage.success('文件上传成功')
  }
}

function handleUploadError() {
  ElMessage.error('上传文件失败')
}

function handlePreview(file) {
  const url = file.url.startsWith(baseUrl) ? file.url : baseUrl + file.url
  dialogUrl.value = url
  dialogTitle.value = file.name
  isImageFileDialogOpen.value = isImageFile(file.name)
  dialogVisible.value = true
}

function listToString(list, separator) {
  let strs = ''
  separator = separator || ','
  for (let i in list) {
    if (undefined !== list[i].url && list[i].url.indexOf('blob:') !== 0) {
      strs += list[i].url.replace(baseUrl, '') + separator
    }
  }
  return strs != '' ? strs.substr(0, strs.length - 1) : ''
}

function isImageFile(fileName) {
  return /\.(jpg|jpeg|png|gif)$/i.test(fileName)
}
</script>

