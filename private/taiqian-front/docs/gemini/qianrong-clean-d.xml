<script setup>
import { computed, reactive, ref, watch } from 'vue'
import ListPageHeader from '@/components/ListPageHeader/index.vue'
import ListTablePanel from '@/components/ListTablePanel/index.vue'
import ListRowActions from '@/components/ListRowActions/index.vue'
import TableSearch from '@/components/TableSearch/index.vue'
import { filterApiLogs, maskLogContent, apiLogsCsv } from './utils'
const props = defineProps({ records: { type: Array, default: () => [] } })
const query = reactive({ keyword: '', direction: '', status: '', period: [] })
const applied = ref({ ...query }), page = ref(1), pageSize = ref(10), selected = ref(null), detailTab = ref('request')
const defaultSort = { prop: 'calledAt', order: 'descending' }
const sorting = ref(defaultSort)
const columns = [{ key: 'id', label: '日志编号', locked: true }, ...[['direction', '调用方向'], ['externalSystem', '外部系统'], ['interfaceName', '接口名称'], ['method', '请求方式'], ['status', '调用结果'], ['statusCode', 'HTTP状态'], ['duration', '耗时'], ['calledAt', '调用时间']].map(([key, label]) => ({ key, label }))]
const searchOptions = [{ type: 'input', label: '关键词：', prop: 'keyword', placeholder: '编号、接口、系统或追踪编号' }, { type: 'select', label: '调用方向：', prop: 'direction', opts: [{ label: '入站', value: 'inbound' }, { label: '出站', value: 'outbound' }] }, { type: 'select', label: '调用结果：', prop: 'status', opts: [{ label: '成功', value: 'success' }, { label: '失败', value: 'failure' }] }, { type: 'daterange', label: '调用时间：', prop: 'period', format: 'YYYY-MM-DD HH:mm:ss', defaultTime: [new Date(2000, 0, 1, 0, 0, 0), new Date(2000, 0, 1, 23, 59, 59)] }]
const filtered = computed(() => {
  const rows = filterApiLogs(props.records, applied.value), { prop, order } = sorting.value
  if (!order) return rows
  return [...rows].sort((a, b) => (typeof a[prop] === 'number' ? a[prop] - b[prop] : String(a[prop]).localeCompare(String(b[prop]))) * (order === 'ascending' ? 1 : -1))
})
const paged = computed(() => filtered.value.slice((page.value - 1) * pageSize.value, page.value * pageSize.value))
function search() { applied.value = { ...query, keyword: query.keyword.trim(), period: [...(query.period || [])] }; page.value = 1 }
function reset() { Object.assign(query, { keyword: '', direction: '', status: '', period: [] }); search() }
function sortChange(value) { sorting.value = value; page.value = 1 }
watch(pageSize, () => { page.value = 1 })
watch(selected, () => { detailTab.value = 'request' })
function download() {
  const url = URL.createObjectURL(new Blob([apiLogsCsv(filtered.value)], { type: 'text/csv;charset=utf-8' }))
  const link = document.createElement('a'); link.href = url; link.download = '接口日志-静态示例.csv'; link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000)
}
