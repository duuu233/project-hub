<template>
  <div class="notice-message">
    <el-popover placement="bottom-end" :width="400" trigger="click" popper-class="notice-popover" @show="handlePopoverShow">
      <template #reference>
        <div class="notice-icon" @click="handleIconClick">
          <el-icon :size="20">
            <Bell />
          </el-icon>
          <el-badge :value="unreadCount" :hidden="unreadCount === 0" class="notice-badge"> </el-badge>
        </div>
      </template>

      <div class="notice-content">
        <div class="notice-header">
          <span class="notice-title">公告信息</span>
          <el-button type="primary" link size="small" @click="markAllAsRead" v-if="unreadCount > 0"> 全部已读 </el-button>
        </div>

        <div class="notice-list" v-loading="loading">
          <div
            v-for="item in noticeList"
            :key="item.noticeId"
            class="notice-item"
            :class="{ unread: item.readStatus === '0' }"
            @click="handleNoticeClick(item)"
          >
            <div class="notice-item-header">
              <span class="notice-item-title">{{ item.noticeTitle }}</span>
              <span class="notice-item-time">{{ formatTime(item.createTime) }}</span>
            </div>
            <div class="notice-item-footer">
              <span class="notice-item-type">{{ getNoticeTypeText(item.noticeType) }}</span>
              <el-tag v-if="item.readStatus === '0'" type="danger" size="small">未读</el-tag>
            </div>
          </div>

          <div v-if="noticeList.length === 0" class="notice-empty">
            <el-empty description="暂无公告信息" :image-size="80" />
          </div>
        </div>

        <div class="notice-footer" v-if="total > pageSize">
          <el-pagination
            v-model:current-page="currentPage"
            :page-size="pageSize"
            :total="total"
            layout="total, prev, pager, next"
            small
            background
            @current-change="handlePageChange"
          />
        </div>
      </div>
    </el-popover>

    <el-dialog v-model="detailVisible" :title="currentNotice?.noticeTitle" width="700px" class="notice-detail-dialog">
      <div class="notice-detail">
        <div class="notice-detail-meta">
          <div class="meta-item">
            <span class="meta-label">发布时间：</span>
            <span class="meta-value">{{ currentNotice?.createTime }}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">公告类型：</span>
            <span class="meta-value">{{ getNoticeTypeText(currentNotice?.noticeType) }}</span>
          </div>
        </div>
        <div class="notice-detail-content" v-html="currentNotice?.noticeContent"></div>
      </div>
    </el-dialog>
  </div>
</template>

<script setup>
import { ref, reactive, onMounted, computed, getCurrentInstance } from 'vue'
import { Bell } from '@element-plus/icons-vue'
import { getNoticeList, updateNotice } from '@/api/billing/index'
import { ElMessage } from 'element-plus'
import dayjs from 'dayjs'

const { proxy } = getCurrentInstance()
const { sys_notice_status, sys_notice_type } = proxy.useDict('sys_notice_status', 'sys_notice_type')

const loading = ref(false)
const noticeList = ref([])
const total = ref(0)
const currentPage = ref(1)
const pageSize = ref(10)
const detailVisible = ref(false)
const currentNotice = ref(null)

const queryParams = reactive({
  pageNum: 1,
  pageSize: 10,
  status: '0',
  noticeType: '1'
})

const unreadCount = computed(() => {
  return noticeList.value.filter(item => item.readStatus === '0').length
})

const getNoticeData = async () => {
  loading.value = true
  try {
    const response = await getNoticeList({
      ...queryParams,
      pageNum: currentPage.value,
      pageSize: pageSize.value
    })
    noticeList.value = response.rows || []
    total.value = response.total || 0
  } catch (error) {
    console.error('获取公告信息失败:', error)
  } finally {
    loading.value = false
  }
}

const formatTime = time => {
  if (!time) return ''
  const now = dayjs()
  const target = dayjs(time)

  const diffMinutes = now.diff(target, 'minute')
  const diffHours = now.diff(target, 'hour')
  const diffDays = now.diff(target, 'day')

  if (diffMinutes < 1) {
    return '刚刚'
  } else if (diffMinutes < 60) {
    return `${diffMinutes}分钟前`
  } else if (diffHours < 24) {
    return `${diffHours}小时前`
  } else if (diffDays < 7) {
    return `${diffDays}天前`
  } else {
    return target.format('MM-DD HH:mm')
  }
}

const getNoticeTypeText = type => {
  const typeDict = sys_notice_type.value.find(item => item.value === type)
  return typeDict ? typeDict.label : '通知'
}

const handlePopoverShow = () => {

  currentPage.value = 1
  getNoticeData()
}

const handleIconClick = () => {

}

const handleNoticeClick = async notice => {

  if (notice.readStatus === '0') {
    await markAsRead(notice)
  }

  currentNotice.value = notice
  detailVisible.value = true
}

const markAsRead = async notice => {
  try {
    await updateNotice({
      ...notice,
      readStatus: '1'
    })

    const index = noticeList.value.findIndex(item => item.noticeId === notice.noticeId)
    if (index !== -1) {
      noticeList.value[index].readStatus = '1'
    }
  } catch (error) {
    console.error('标记已读失败:', error)
  }
}

const markAllAsRead = async () => {
  const unreadNotices = noticeList.value.filter(item => item.readStatus === '0')

  if (unreadNotices.length === 0) {
    ElMessage.info('没有未读消息')
    return
  }

  try {

    const promises = unreadNotices.map(notice =>
      updateNotice({
        ...notice,
        readStatus: '1'
      })
    )

    await Promise.all(promises)

    noticeList.value.forEach(item => {
      if (item.readStatus === '0') {
        item.readStatus = '1'
      }
    })

    ElMessage.success('已全部标记为已读')
  } catch (error) {
    console.error('批量标记已读失败:', error)
    ElMessage.error('操作失败')
  }
}

const handlePageChange = page => {
  currentPage.value = page
  getNoticeData()
}

onMounted(() => {
  getNoticeData()
})

</script>

