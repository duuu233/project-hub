const props = defineProps({ modelValue: { type: Array, default: () => [] }, options: { type: Array, default: () => [] }, disabled: Boolean })
const emit = defineEmits(['update:modelValue', 'change', 'remove-tag'])
const formItem = inject(formItemContextKey, undefined)
const open = ref(false), draft = ref([])
function openManager() { draft.value = [...props.modelValue]; open.value = true }
async function apply() {
  const previous = [...props.modelValue], selected = [...draft.value]
