<file path="apps/qianrong/src/views/monitor/apilog/utils.js">
const sensitiveKey = /password|passwd|token|authorization|secret|cookie|credential|phone|mobile|idcard|identitycard/i

export function maskLogContent(value) {
  const mask = data => {
    if (Array.isArray(data)) return data.map(mask)
    if (data && typeof data === 'object') return Object.fromEntries(Object.entries(data).map(([key, item]) => [key, sensitiveKey.test(key) ? '******' : mask(item)]))
    if (typeof data === 'string') return data.replace(/\b1\d{10}\b/g, '***********').replace(/(Bearer\s+)[^\s",]+/gi, '$1******')
    return data
  }
  let data = value
  if (typeof value === 'string') {
    try { data = JSON.parse(value) } catch {
      return mask(value).replace(/((?:password|passwd|token|authorization|secret|cookie|credential)\s*[:=]\s*)[^\s,;]+/gi, '$1******')
    }
  }
  return JSON.stringify(mask(data ?? {}), null, 2)
}

export function filterApiLogs(records, query) {
  return records.filter(row => (!query.keyword || [row.id, row.traceId, row.interfaceName, row.url, row.externalSystem].some(value => String(value || '').toLowerCase().includes(query.keyword.toLowerCase()))) && (!query.direction || row.direction === query.direction) && (!query.status || row.status === query.status) && (!query.period?.length || (row.calledAt >= query.period[0] && row.calledAt <= query.period[1])))
}

export function apiLogsCsv(records) {
  const cell = value => '"' + String(value ?? '').replace(/^[=+@\-\t\r]/, "'$&").replaceAll('"', '""') + '"'
  const columns = ['日志编号', '调用方向', '外部系统', '接口名称', '请求方式', '接口地址', '调用结果', 'HTTP状态', '耗时(ms)', '调用时间', '追踪编号']
  return '\uFEFF' + [columns, ...records.map(row => [row.id, row.direction === 'inbound' ? '入站' : '出站', row.externalSystem, row.interfaceName, row.method, maskLogContent(row.url).replace(/^"|"$/g, ''), row.status === 'success' ? '成功' : '失败', row.statusCode, row.duration, row.calledAt, row.traceId])].map(row => row.map(cell).join(',')).join('\r\n')
}
