  }
})

const { queryParams, form } = toRefs(data)
const searchQuery = reactive({ operIp: undefined, title: undefined, operName: undefined, businessType: undefined, status: undefined, period: [] })
const searchOptions = reactive([{ prop: 'operIp', label: '操作地址', type: 'input', placeholder: '请输入' }, { prop: 'title', label: '系统模块', type: 'input', placeholder: '请输入' }, { prop: 'operName', label: '操作人员', type: 'input', placeholder: '请输入' }, { prop: 'businessType', label: '操作类型', type: 'select', placeholder: '请选择', opts: sys_oper_type }, { prop: 'status', label: '操作状态', type: 'select', placeholder: '请选择', opts: sys_common_status }, { prop: 'period', label: '操作时间', type: 'daterange', format: 'YYYY-MM-DD HH:mm:ss', span: 2, defaultTime: [new Date(2000, 0, 1, 0, 0, 0), new Date(2000, 0, 1, 23, 59, 59)] }])
function syncSearch() {
