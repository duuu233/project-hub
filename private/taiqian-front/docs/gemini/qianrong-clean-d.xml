<file path="apps/qianrong/src/utils/listGrid.js">
// 直接配置原生 vxe-grid；表格实例、分页、事件及列定制仍由页面管理。
export function withListGridStyle(options) {
  const columns = options.columns || []
  const regular = columns.filter(col => !col.fixed && !col.type && col.field !== 'active')
  const firstData = columns.find(col => !col.type && col.field !== 'active')
  const allFixed = regular.length && regular.every(col => col.width && !col.minWidth)
  const styleColumn = col => {
    const result = { ...col }
    if (col.children) result.children = col.children.map(styleColumn)
    if (allFixed && regular.includes(col)) { result.minWidth = col.width; delete result.width }
    if (col.field === 'active' || col.slots?.default === 'active') {
      result.field = col.field || '__qr_actions'
      result.width = col.width || col.minWidth || 200
      result.minWidth = 80
      result.align = 'left'
      result.headerAlign = 'center'
      const original = col.className
      result.className = scope => `${typeof original === 'function' ? original(scope) : original || ''} qr-actions-cell`
    }
    const strong = col.strong ?? (col === firstData && (/(?:No|Nos|Code)$/.test(col.field || '') || /编号|单号/.test(col.title || '')))
    if (strong) {
      const original = result.className
      result.className = scope => `${typeof original === 'function' ? original(scope) : original || ''} qr-primary-code`
    }
    return result
  }
  const toolbarConfig = options.toolbarConfig === false ? false : {
    custom: true, zoom: true, ...options.toolbarConfig,
    slots: { buttons: 'qrListToolbar', ...options.toolbarConfig?.slots }
  }
  return { autoResize: true, ...options, toolbarConfig, columns: columns.map(styleColumn) }
}

const states = new WeakMap()
export const listGrid = {
  mounted(el, binding, vnode) {
    const state = { frame: 0, width: 0, destroyed: false, grid: binding.value.grid }
    const measure = () => {
      if (state.destroyed || el.getBoundingClientRect().width === 0) return
      const groups = [...el.querySelectorAll('.vxe-table--body .qr-row-actions')]
      const slotWidths = []
      groups.forEach(group => [...group.children].forEach((child, index) => {
        const button = child.querySelector('.el-button, .el-dropdown') || child
        slotWidths[index] = Math.max(slotWidths[index] || 0, button.getBoundingClientRect().width)
      }))
      if (!slotWidths.length) return
      slotWidths.forEach((width, index) => el.style.setProperty(`--qr-action-${index + 1}-width`, `${Math.ceil(width)}px`))
      el.style.setProperty('--qr-actions-template', slotWidths.map(width => `${Math.ceil(width)}px`).join(' '))
      const width = Math.max(80, Math.ceil(slotWidths.reduce((sum, w) => sum + w, 0) + (slotWidths.length - 1) * 7 + 20))
      const grid = state.grid
      if (grid && width !== state.width) {
        state.width = width
        const column = grid.getColumns().find(col => col.field === 'active' || col.field === '__qr_actions')
        if (column) grid.setColumnWidth(column, width)
      }
    }
    const schedule = () => { cancelAnimationFrame(state.frame); state.frame = requestAnimationFrame(measure) }
    state.mutations = new MutationObserver(schedule)
    state.mutations.observe(el, { childList: true, subtree: true, characterData: true })
    state.resize = new ResizeObserver(schedule)
    state.resize.observe(el)
    state.schedule = schedule
    states.set(el, state)
    document.fonts?.ready.then(schedule)
    schedule()
  },
  updated(el, binding) { const state = states.get(el); if (state) { state.grid = binding.value.grid; state.schedule() } },
  beforeUnmount(el) {
    const state = states.get(el)
    if (!state) return
    state.destroyed = true
    cancelAnimationFrame(state.frame)
    state.mutations.disconnect()
    state.resize.disconnect()
    states.delete(el)
  }
}
