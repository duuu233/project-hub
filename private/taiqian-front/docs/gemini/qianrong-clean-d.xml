<template>
  <el-cascader
    ref="casRef"
    clearable
    :disabled="disabled"
    v-model="checkedValue"
    :options="cascaderParams.options"
    :filterable="cascaderParams.filterable"
    :props="cascaderParams.props"
    style="width: 100%"
  >
    <template #default="{ node, data }" v-if="cascaderParams.isCascaderSlot">
      <slot name="cascaderSlot" :node="node" :data="data"></slot>
    </template>
  </el-cascader>
</template>

<script setup>
import { ref, computed, onMounted, reactive } from 'vue'
import { commonArea } from '@/api/common'

const props = defineProps({
  checkedValueCom: {
    type: [String, Number, Array],
    default: null
  },
  disabled: Boolean,
  filterable: Boolean,
  multiple: Boolean,
  options: {
    type: Array,
    default: () => []
  },
  isCascaderSlot: Boolean
})

const emit = defineEmits(['update:checkedValueCom'])
const casRef = ref(null)

const cascaderParams = reactive({
  filterable: true,
  isCascaderSlot: props.isCascaderSlot || false,
  props: {
    multiple: props.multiple || false,
    expandTrigger: 'hover',
    value: 'id',
    label: 'name',
    children: 'childrens'
  },
  options: []
})

const checkedValue = computed({
  get() {
    return props.checkedValueCom
  },
  set(v) {
    emit('update:checkedValueCom', v)
  }
})

onMounted(() => {
  getData()
})

async function getData() {
  try {
    const res = await commonArea()

    if (res.data.length) {
      cascaderParams.options = res.data
        .map((item) => {
          item.type = 1
          item.childrens = item.childrens
            .map((item1) => {
              item1.type = 2
              item1.childrens = item1.childrens
                .map((item2) => {
                  item2.type = 3
                  return item2
                })
                .sort((a, b) => {
                  if (a.name === '遂溪县') return -1
                  if (b.name === '遂溪县') return 1
                  return parseInt(a.id) - parseInt(b.id)
                })
              return item1
            })
            .sort((a, b) => {
              if (a.name === '湛江市') return -1
              if (b.name === '湛江市') return 1
              return parseInt(a.id) - parseInt(b.id)
            })
          return item
        })
        .sort((a, b) => {
          if (a.name === '广东省') return -1
          if (b.name === '广东省') return 1
          return parseInt(a.id) - parseInt(b.id)
        })
    }
  } catch (error) {}
}

defineExpose({
  getIds: () => {
