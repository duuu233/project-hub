    </el-tabs>

    <el-dialog title="还款商品明细" v-model="repayGoodsDialogVisible" width="900px">
      <el-table :data="repayGoodsList" style="width: 100%" border>
        <el-table-column prop="goodsCode" label="SKU编号" min-width="100" />
        <el-table-column prop="goodsName" label="SKU名称" min-width="150" />
        <el-table-column label="商品属性" min-width="150">
          <template #default="scope">
            <span>{{ getAttributeTextFromList(scope.row.attributeList) }}</span>
          </template>
        </el-table-column>
        <el-table-column prop="price" label="单价" min-width="100">
          <template #default="scope">
            {{ formatCurrency(scope.row.price) }}
          </template>
        </el-table-column>
        <el-table-column prop="num" label="合同数量" min-width="100" />
        <el-table-column prop="repayNum" label="还款数量" min-width="100" />
        <el-table-column label="应还本金" min-width="120">
          <template #default="scope">
            {{ formatCurrency(scope.row.repayPrincipal) }}
          </template>
        </el-table-column>
      </el-table>
    </el-dialog>
  </div>
</template>

<script setup>
import { ref, onMounted, getCurrentInstance, watch } from 'vue'
import { Download } from '@element-plus/icons-vue'
import { financeDetail, financeRepayRecords, financeRepayGoods } from '@/api/finance'
import { getPurchaseOrderDetail } from '@/api/contract'
import { multiplyWithPrecision } from '@/utils/index'

const { proxy } = getCurrentInstance()
const { order_status, finance_status, large_category } = proxy.useDict('order_status', 'finance_status', 'large_category')

const props = defineProps({
  id: {
    type: [String, Number],
    required: true
  },
  title: {
    type: String,
    default: '融资详情'
  }
})

const activeTab = ref('finance')
const financeData = ref({})
const orderData = ref({})
const repayRecords = ref([])
const repayGoodsList = ref([])
const repayGoodsDialogVisible = ref(false)
const dataLoaded = ref(false)

const formatCurrency = value => {
  const num = parseFloat(value)
  if (isNaN(num)) return '0.00'
  return num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
}

const getApplicantTypeName = type => {
  const types = {
    1: '法人',
    2: '实际控制人'
  }
  return types[type] || '-'
}

const getTradeTypeName = type => {
  const types = {
    1: '部分还款',
    2: '结清'
  }
  return types[type] || '-'
}

const getRepayStatusName = status => {
  const statuses = {
    0: '待审批',
    1: '审批通过',
    2: '审批不通过'
  }
  return statuses[status] || '-'
}

const getSummaries = param => {
  const { columns, data } = param
  const sums = []
  columns.forEach((column, index) => {
    if (index === 0) {
      sums[index] = '合计'
      return
    }
    if (column.property === 'num') {
      const values = data.map(item => Number(item.num))
      sums[index] = values.reduce((prev, curr) => {
        const value = Number(curr)
        if (!isNaN(value)) {
          return prev + value
        } else {
          return prev
        }
      }, 0)
    } else if (column.property === 'price' || column.label === '金额小计') {
      if (column.label === '金额小计') {
        const total = data.reduce((prev, curr) => {
          return prev + Number(curr.price || 0) * Number(curr.num || 0)
        }, 0)
        sums[index] = formatCurrency(total)
      } else {
        sums[index] = ''
      }
    } else {
      sums[index] = ''
    }
  })
  return sums
}

const getAttributeText = attributeList => {
  if (!attributeList || attributeList.length === 0) return '-'
  return attributeList.map(item => `${item.attributeName}：${item.attributeValueName}`).join('，')
}

const getAttributeTextFromList = attributeList => {
  if (!attributeList || attributeList.length === 0) return '-'
  return attributeList.map(item => `${item.attributeName}：${item.attributeValueName}`).join('，')
}

const getTotalQuantity = () => {
  if (!orderData.value.orderGoodsList || orderData.value.orderGoodsList.length === 0) return 0
  return orderData.value.orderGoodsList.reduce((sum, item) => sum + (parseInt(item.num) || 0), 0)
}

const getFinanceDetail = async id => {
  try {
    if (!id) return

    if (dataLoaded.value) return

    const res = await financeDetail(id)
    if (res.code === 200 || res.code === 0) {
      financeData.value = res.data || {}

      if (financeData.value.purchaseOrderId) {
        getOrderDetail(financeData.value.purchaseOrderId)
      }

      getRepayRecords(id)

      dataLoaded.value = true
    }
  } catch (error) {
    console.error('获取融资详情失败:', error)
    proxy.$modal.msgError('获取融资详情失败')
  }
}

const getOrderDetail = async orderId => {
  try {
    if (!orderId) return

    const res = await getPurchaseOrderDetail(orderId)
    if (res.code === 200 || res.code === 0) {
      orderData.value = res.data || {}
    }
  } catch (error) {
    console.error('获取合同详情失败:', error)
    proxy.$modal.msgError('获取合同详情失败')
  }
}

const getRepayRecords = async id => {
  try {
    const res = await financeRepayRecords({
      financeId: id
    })
    if (res.code === 200 || res.code === 0) {
      repayRecords.value = res.data || []
    }
  } catch (error) {
    console.error('获取还款记录失败:', error)
    proxy.$modal.msgError('获取还款记录失败')
  }
}

const showRepayGoods = async repayId => {
  try {
    const res = await financeRepayGoods({ repayId })
    if (res.code === 200 || res.code === 0) {
      repayGoodsList.value = res.data || []
      repayGoodsDialogVisible.value = true
    }
  } catch (error) {
    console.error('获取还款商品明细失败:', error)
    proxy.$modal.msgError('获取还款商品明细失败')
  }
}

const handleDownload = file => {
  if (!file || !file.fileUrl) return

  window.open(file.fileUrl.startsWith('http') ? file.fileUrl : window.location.origin + '/api-qianrong' + file.fileUrl)
}

watch(
  () => props.id,
  newId => {
    if (newId && !dataLoaded.value) {
      getFinanceDetail(newId)
    }
  },
  { immediate: true }
)

onMounted(() => {
  if (props.id && !dataLoaded.value) {
    getFinanceDetail(props.id)
  }
})
</script>

