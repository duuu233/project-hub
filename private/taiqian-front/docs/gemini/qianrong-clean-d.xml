<template>
  <div class="app-container qr-list-page qr-owned-page">
    <ListPageHeader fallback-title="字典数据" subtitle="维护字典值、显示顺序和回显样式"><template #actions><el-button type="primary" plain icon="Plus" @click="handleAdd" v-hasPermi="['system:dict:add']">新增</el-button></template></ListPageHeader>
    <TableSearch :query="query" :options="searchOpt" :search="handleSearch" :reset="resetDataSearch" />

    <vxe-grid ref="gridRef" v-bind="gridOptions" v-on="gridEvents" class="qr-list-grid" v-list-grid="{ grid: gridRef }">
      <template #toolbarButtons>
        <ListToolbarTitle :total="gridOptions.pagerConfig?.total" />

        <el-button type="success" plain icon="Edit" :disabled="single" @click="handleUpdate" v-hasPermi="['system:dict:edit']">修改</el-button>
        <el-button type="danger" plain icon="Delete" :disabled="multiple" @click="handleDelete" v-hasPermi="['system:dict:remove']">删除</el-button>
        <el-button type="warning" plain icon="Download" @click="handleExport" v-hasPermi="['system:dict:export']">导出</el-button>
