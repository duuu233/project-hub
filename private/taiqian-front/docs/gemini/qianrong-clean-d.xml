<file path="apps/qianrong/src/views/monitor/logininfor/index.vue">
<template>
  <div class="app-container qr-list-page qr-owned-page">
    <ListPageHeader fallback-title="登录日志" subtitle="查询账号登录记录及登录结果" />
    <TableSearch v-show="showSearch" ref="queryRef" :query="searchQuery" :options="searchOptions" :search="handleSearch" :reset="resetSearch" />
    <ListTablePanel title="登录日志列表" :total="total" :columns="nativeColumns" storage-key="src-views-monitor-logininfor-index.vue">
      <template #toolbar>

          <el-button type="danger" plain icon="Delete" :disabled="multiple" @click="handleDelete" v-hasPermi="['system:logininfor:remove']"
            >删除</el-button
          >


          <el-button type="danger" plain icon="Delete" @click="handleClean" v-hasPermi="['system:logininfor:remove']">清空</el-button>


          <el-button type="primary" plain icon="Unlock" :disabled="single" @click="handleUnlock" v-hasPermi="['system:logininfor:unlock']"
            >解锁</el-button
          >


          <el-button type="warning" plain icon="Download" @click="handleExport" v-hasPermi="['system:logininfor:export']">导出</el-button>

        <el-button icon="Refresh" @click="getList">刷新</el-button><el-button icon="Search" @click="showSearch = !showSearch">筛选</el-button>
      </template>
      <template #default="{ visible, actionWidth }"><el-table
        border
        ref="logininforRef"
        v-loading="loading"
        :data="logininforList"
        @selection-change="handleSelectionChange"
        :default-sort="defaultSort"
        @sort-change="handleSortChange"
      >
        <el-table-column type="selection" width="55" align="center" />
        <el-table-column v-if="visible('infoId')" label="访问编号" align="center" prop="infoId" />
        <el-table-column v-if="visible('userName')"
          label="用户名称"
          align="center"
          prop="userName"
          :show-overflow-tooltip="true"
          sortable="custom"
          :sort-orders="['descending', 'ascending']"
        />
        <el-table-column v-if="visible('status')" label="登录状态" align="center" prop="status">
          <template #default="scope">
            <dict-tag :options="sys_common_status" :value="scope.row.status" />
          </template>
        </el-table-column>
        <el-table-column v-if="visible('msg')" label="描述" align="center" prop="msg" :show-overflow-tooltip="true" />
        <el-table-column v-if="visible('loginTime')" label="访问时间" align="center" prop="loginTime" sortable="custom" :sort-orders="['descending', 'ascending']" width="180">
          <template #default="scope">
            <span>{{ scope.row.loginTime }}</span>
          </template>
        </el-table-column>
      </el-table></template>
      <template #pagination><pagination v-show="total > 0" :total="total" v-model:page="queryParams.pageNum" v-model:limit="queryParams.pageSize" @pagination="getList" /></template>
    </ListTablePanel>


  </div>
</template>

<script setup name="Logininfor">
import ListTablePanel from '@/components/ListTablePanel/index.vue'
import TableSearch from '@/components/TableSearch/index.vue'
import ListPageHeader from '@/components/ListPageHeader/index.vue'
import { list, delLogininfor, cleanLogininfor, unlockLogininfor } from '@/api/system/logininfor'

const nativeColumns = [
  {
    "key": "selection",
    "label": "勾选",
    "locked": true
  },
  {
    "key": "infoId",
    "label": "访问编号",
    "locked": false
  },
  {
    "key": "userName",
    "label": "用户名称",
    "locked": false
  },
  {
    "key": "status",
    "label": "登录状态",
    "locked": false
  },
  {
    "key": "msg",
    "label": "描述",
    "locked": false
  },
  {
    "key": "loginTime",
    "label": "访问时间",
    "locked": false
  }
]
const { proxy } = getCurrentInstance()
const { sys_common_status } = proxy.useDict('sys_common_status')

const logininforList = ref([])
const loading = ref(true)
const showSearch = ref(true)
const ids = ref([])
const single = ref(true)
const multiple = ref(true)
const selectName = ref('')
const total = ref(0)
const dateRange = ref([])
const defaultSort = ref({ prop: 'loginTime', order: 'descending' })

const queryParams = ref({
  pageNum: 1,
  pageSize: 10,
  ipaddr: undefined,
  userName: undefined,
  status: undefined,
  orderByColumn: undefined,
  isAsc: undefined
})
const searchQuery = reactive({ ipaddr: undefined, userName: undefined, status: undefined, period: [] })
const searchOptions = reactive([{ prop: 'ipaddr', label: '登录地址', type: 'input', placeholder: '请输入' }, { prop: 'userName', label: '用户名称', type: 'input', placeholder: '请输入' }, { prop: 'status', label: '登录状态', type: 'select', placeholder: '请选择', opts: sys_common_status }, { prop: 'period', label: '登录时间', type: 'daterange', format: 'YYYY-MM-DD HH:mm:ss', span: 2, defaultTime: [new Date(2000, 0, 1, 0, 0, 0), new Date(2000, 0, 1, 23, 59, 59)] }])
function syncSearch() {
  queryParams.value.ipaddr = searchQuery.ipaddr
  queryParams.value.userName = searchQuery.userName
  queryParams.value.status = searchQuery.status
  dateRange.value = searchQuery.period || []
}
function handleSearch() { syncSearch(); handleQuery() }
function resetSearch() { syncSearch(); queryParams.value.pageNum = 1; proxy.$refs['logininforRef'].sort(defaultSort.value.prop, defaultSort.value.order) }


function getList() {
  loading.value = true
  list(proxy.addDateRange(queryParams.value, dateRange.value)).then(response => {
    logininforList.value = response.rows
    total.value = response.total * 1
    loading.value = false
  })
}

function handleQuery() {
  queryParams.value.pageNum = 1
  getList()
}

function resetQuery() {
  dateRange.value = []
  syncSearch()
  queryParams.value.pageNum = 1
  proxy.$refs['logininforRef'].sort(defaultSort.value.prop, defaultSort.value.order)
}

function handleSelectionChange(selection) {
  ids.value = selection.map(item => item.infoId)
  multiple.value = !selection.length
  single.value = selection.length != 1
  selectName.value = selection.map(item => item.userName)
}

function handleSortChange(column, prop, order) {
  queryParams.value.orderByColumn = column.prop
  queryParams.value.isAsc = column.order
  getList()
}

function handleDelete(row) {
  const infoIds = row.infoId || ids.value
  proxy.$modal
    .confirm('是否确认删除访问编号为"' + infoIds + '"的数据项?')
    .then(function () {
      return delLogininfor(infoIds)
    })
    .then(() => {
      getList()
      proxy.$modal.msgSuccess('删除成功')
    })
    .catch(() => {})
}

function handleClean() {
  proxy.$modal
    .confirm('是否确认清空所有登录日志数据项?')
    .then(function () {
      return cleanLogininfor()
    })
    .then(() => {
      getList()
      proxy.$modal.msgSuccess('清空成功')
    })
    .catch(() => {})
}

function handleUnlock() {
  const username = selectName.value
  proxy.$modal
    .confirm('是否确认解锁用户"' + username + '"数据项?')
    .then(function () {
      return unlockLogininfor(username)
    })
    .then(() => {
      proxy.$modal.msgSuccess('用户' + username + '解锁成功')
    })
    .catch(() => {})
}

function handleExport() {
  proxy.download(
    '/api-qianrong/monitor/logininfor/export',
    {
      ...queryParams.value
    },
    `config_${new Date().getTime()}.xlsx`
  )
}

getList()
</script>
