        <el-form-item label="权限范围">
          <el-select style="width: 280px" v-model="form.dataScope" @change="dataScopeSelectChange">
            <el-option v-for="item in data_permissions_scope" :key="item.value" :label="item.label" :value="item.value"></el-option>
          </el-select>
        </el-form-item>

        <el-form-item v-if="form.dataScope == 5" prop="productIds" label="关联产业项目">
          <el-select style="width: 280px" multiple clearable v-model="form.productIds" placeholder="请选择关联产业项目">
            <el-option v-for="v in enumData.projectList" :key="v.id" :label="v.projectName" :value="v.id" />
          </el-select>
        </el-form-item>
        <el-form-item v-if="form.dataScope == 6" prop="regulatoryIds" label="关联监管方">
          <el-select style="width: 280px" multiple clearable v-model="form.regulatoryIds" placeholder="请选择关联监管方">
            <el-option v-for="v in enumData.regulatoryAuthoritiesList" :key="v.orgId" :label="v.orgName" :value="v.orgId" />
          </el-select>
        </el-form-item>
        <el-form-item v-if="form.dataScope == 7" prop="bankIds" label="关联资金方">
          <el-select style="width: 280px" multiple clearable v-model="form.bankIds" placeholder="请选择关联资金方">
            <el-option v-for="v in enumData.capitalOrgList" :key="v.id" :label="v.orgName" :value="v.id" />
          </el-select>
        </el-form-item>

        <el-form-item label="数据权限" v-show="form.dataScope == 2">
          <el-checkbox v-model="deptExpand" @change="handleCheckedTreeExpand($event, 'dept')">展开/折叠</el-checkbox>
          <el-checkbox v-model="deptNodeAll" @change="handleCheckedTreeNodeAll($event, 'dept')">全选/全不选</el-checkbox>
          <el-checkbox v-model="form.deptCheckStrictly" @change="handleCheckedTreeConnect($event, 'dept')">父子联动</el-checkbox>
          <el-tree
            class="tree-border"
            :data="deptOptions"
            show-checkbox
            default-expand-all
            ref="deptRef"
            node-key="id"
            :check-strictly="!form.deptCheckStrictly"
            empty-text="加载中，请稍候"
            :props="{ label: 'label', children: 'children' }"
          ></el-tree>
        </el-form-item>
      </el-form>
      <template #footer>
        <div class="dialog-footer">
          <el-button type="primary" @click="submitDataScope">确 定</el-button>
          <el-button @click="cancelDataScope">取 消</el-button>
        </div>
      </template>
    </el-dialog>
  </div>
</template>

<script setup name="Role">
import ListPageHeader from '@/components/ListPageHeader/index.vue'
import { withListGridStyle, listGrid as vListGrid } from '@/utils/listGrid'
import ListToolbarTitle from '@/components/ListToolbarTitle/index.vue'
import ListRowActions from '@/components/ListRowActions/index.vue'

import { addRole, changeRoleStatus, dataScope, delRole, getRole, listRole, updateRole, deptTreeSelect } from '@/api/system/role'
import {
  roleMenuTreeselect,
  treeselect as menuTreeselect,
  roleScopeList,
  regulatoryAuthoritiesSelectList,
  capitalOrgAllList,
  projectAllList
} from '@/api/system/menu'
import { ElMessage } from 'element-plus'

import TableSearch from '@/components/TableSearch'
import { onMounted } from 'vue'
import { productSimpleList } from '@/api/credit'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'
import { onUnmounted } from 'vue'
const router = useRouter()
const { proxy } = getCurrentInstance()

const { data_permissions_scope } = proxy.useDict('data_permissions_scope')
const activeName = ref()
const roleList = ref([])
const systemList = ref([])
const query = reactive({})
const open = ref(false)
const loading = ref(true)
const ids = ref([])
const single = ref(true)
const multiple = ref(true)
const total = ref(0)
const title = ref('')
const dateRange = ref([])
const menuOptions = ref([])
const menuExpand = ref(false)
const menuNodeAll = ref(false)
const deptExpand = ref(true)
const deptNodeAll = ref(false)
const deptOptions = ref([])
const openDataScope = ref(false)
const menuRef = ref(null)
const deptRef = ref(null)
const gridRef = ref()

const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const enumData = reactive({
  projectList: [],
  capitalOrgList: [],
  regulatoryAuthoritiesList: []
})
const checkedKeysList = ref([])
const filterCheckedKeysList = ref([])

const dataScopeOptions = ref([
  { value: '1', label: '全部数据权限' },
  { value: '2', label: '自定数据权限' },
  { value: '3', label: '本部门数据权限' },
  { value: '4', label: '本部门及以下数据权限' },
  { value: '5', label: '仅本人数据权限' },
  { value: '6', label: '自定义金融产品数据权限' }
])

const gridOptions = reactive(withListGridStyle({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true,
    slots: {
      buttons: 'toolbarButtons'
    }
  },
  columns: [
    { type: 'seq', width: 55, align: 'center', title: '序号' },
    { title: '角色编号', field: 'roleId' },
    { title: '角色名称', field: 'roleName', showOverflow: true },
    { title: '显示顺序', field: 'roleSort' },
    { title: '状态', field: 'status', align: 'center', slots: { default: 'statusRender' } },
    { title: '创建时间', field: 'createTime', align: 'center', slots: { default: 'createTimeRender' } },
    { title: '操作', field: 'active', width: 450, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
}))

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

const handleSearch = () => {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}
const searchOpt = ref([
  {
    type: 'input',
    label: '角色名称：',
    placeholder: '请输入',
    prop: 'roleName'
  }
])

const data = reactive({
  form: {},
  queryParams: {
    pageNum: 1,
    pageSize: 10,
    roleName: undefined,

    status: undefined
  },
  rules: {
    roleName: [{ required: true, message: '角色名称不能为空', trigger: 'blur' }],

    roleSort: [{ required: true, message: '角色顺序不能为空', trigger: 'blur' }]
  }
})

const { queryParams, form, rules } = toRefs(data)

function getList() {
  gridOptions.loading = true
  listRole({
    ...proxy.addDateRange(queryParams.value, dateRange.value),
    ...query,
    pageNum: gridOptions.pagerConfig.currentPage,
    pageSize: gridOptions.pagerConfig.pageSize
  }).then(response => {
    gridOptions.data = response.rows
    gridOptions.pagerConfig.total = response.total * 1
    gridOptions.loading = false
  })
}
async function getDataScopeOptions() {
  const res = await roleScopeList({})
  dataScopeOptions.value = res.data
}

function handleQuery() {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}

function resetQuery() {
  dateRange.value = []
  proxy.resetForm('queryRef')
  handleQuery()
}

function handleDelete(row) {
  const roleIds = row.roleId || ids.value
  proxy.$modal
    .confirm('是否确认删除角色编号为"' + roleIds + '"的数据项?')
    .then(function () {
      return delRole(roleIds)
    })
    .then(() => {
      getList()
      proxy.$modal.msgSuccess('删除成功')
    })
    .catch(() => {})
}

function handleExport() {
  proxy.download(
    '/api-qianrong/system/role/export',
    {
      ...queryParams.value
    },
    `role_${new Date().getTime()}.xlsx`
  )
}

function handleSelectionChange(selection) {
  ids.value = selection.map(item => item.roleId)
  single.value = selection.length != 1
  multiple.value = !selection.length
}

function handleStatusChange(row) {
  let text = row.status === '0' ? '禁用' : '启用'
  proxy.$modal
    .confirm('确认要"' + text + '""' + row.roleName + '"角色吗?')
    .then(function () {
      return changeRoleStatus(row.roleId, row.status === '0' ? '1' : '0')
    })
    .then(() => {
      proxy.$modal.msgSuccess(text + '成功')
      gridOptions.pagerConfig.currentPage = 1
      getList()
    })
    .catch(function () {})
}

function handleCommand(command, row) {
  switch (command) {
    case 'handleDataScope':
      handleDataScope(row)
      break
    case 'handleAuthUser':
      handleAuthUser(row)
      break
    default:
      break
  }
}

function handleAuthUser(row) {
  router.push('/system/role-auth/user/' + row.roleId)
}

function getMenuTreeselect() {
  menuTreeselect().then(response => {
    menuOptions.value = response.data
  })
}

function getDeptAllCheckedKeys() {

  let checkedKeys = deptRef.value.getCheckedKeys()

  let halfCheckedKeys = deptRef.value.getHalfCheckedKeys()
  checkedKeys.unshift.apply(checkedKeys, halfCheckedKeys)
  return checkedKeys
}

function reset() {

  menuExpand.value = false
  menuNodeAll.value = false
  deptExpand.value = true
  deptNodeAll.value = false
  form.value = {
    roleId: undefined,
    roleName: undefined,

    roleSort: 0,
    status: '0',
    menuIds: [],
    deptIds: [],
    roleSystems: [],
    menuCheckStrictly: true,
    deptCheckStrictly: true,
    remark: undefined
  }
  proxy.resetForm('roleRef')
}

function handleAdd() {

  router.push({ path: '/system/role/add' })
}

function handleUpdate(row) {
  proxy.openNewTagsView({
    name: 'Role/edit'
  })
  router.push({
    path: '/system/role/edit',
    query: { id: row.roleId }
  })
  return
  reset()
  const roleId = row.roleId || ids.value

  getRole(roleId).then(response => {
    form.value = response.data
    form.value.roleSort = Number(form.value.roleSort)
    form.value.selectedSystem = getSelectedSystem(response.data.roleSystems)
    if (!activeName.value && form.value.selectedSystem.length) {
      activeName.value = form.value.selectedSystem[0]
    }
    setCheckedKeys(form.value.roleSystems)

    open.value = true
    if (filterCheckedKeysList.value && filterCheckedKeysList.value.length) {
      filterCheckedKeysList.value.forEach((v, index) => {
        nextTick(() => {
          menuRef.value[index].setCheckedKeys(v)
        })
      })
    }

    title.value = '修改角色'
  })
}
async function getEnumData() {
  try {
    const res1 = await regulatoryAuthoritiesSelectList({})
    enumData.regulatoryAuthoritiesList = res1.data || []

    const res2 = await capitalOrgAllList({})
    enumData.capitalOrgList = res2.data || []

    const res3 = await projectAllList({})
    enumData.projectList = res3.data || []
  } catch (error) {
    console.log(error)
  }
}
function handleDetail(row) {
  proxy.openNewTagsView({
    name: 'Role/detail'
  })
  router.push({
    path: '/system/role/detail',
    query: { id: row.roleId }
  })
  return
}
function getSelectedSystem(data) {
  if (!data.length) return
  let selectedSystem = []
  checkedKeysList.value = []
  filterCheckedKeysList.value = []
  data.forEach(v => {
    checkedKeysList.value.push(v.menuIds)
    filterCheckedKeysList.value.push(v.menuIds)

    systemList.value.forEach(value => {
      if (value.systemId === v.systemId) {
        v.menuOptions = value.menus
        v.deptCheckStrictly = true
        v.deptNodeAll = false
        v.deptExpand = true
        selectedSystem.push(value.systemName)
      }
    })
  })
  return selectedSystem
}
function setCheckedKeys(data) {
  if (!data.length) return
  data.forEach((v, index) => {
    filterTree(v.menuOptions, index)
  })
}

function filterTree(data, index) {
  try {
    for (let i = 0; i < data.length; i++) {
      if (data[i].children && data[i].children.length) {
        let parentId = data[i].parentId
        let fId = data[i].id
        const a = data[i].children.some((o, i) => {
          return checkedKeysList.value[index].indexOf(o.id) === -1
        })
        if (a && checkedKeysList.value[index].indexOf(parentId) != -1) {
          filterCheckedKeysList.value[index].splice(filterCheckedKeysList.value[index].indexOf(parentId), 1)
        }
        if (a && checkedKeysList.value[index].indexOf(fId) != -1) {
          filterCheckedKeysList.value[index].splice(filterCheckedKeysList.value[index].indexOf(fId), 1)
        }

        filterTree(data[i].children, index)
      }
    }
  } catch (error) {
    console.log(error)
  }
}

function getRoleMenuTreeselect(roleId) {
  return roleMenuTreeselect(roleId).then(response => {
    menuOptions.value = response.menus
    return response
  })
}

function getDeptTree(roleId) {
  return deptTreeSelect(roleId).then(response => {
    deptOptions.value = response.depts
    return response
  })
}

function handleCheckedTreeExpand(value, type, index) {
  if (type == 'menu') {
    let treeList = form.value.roleSystems[index].menuOptions
    for (let i = 0; i < treeList.length; i++) {
      menuRef.value[index].store.nodesMap[treeList[i].id].expanded = value
    }
  } else if (type == 'dept') {
    let treeList = deptOptions.value
    for (let i = 0; i < treeList.length; i++) {
      deptRef.value.store.nodesMap[treeList[i].id].expanded = value
    }
  }
}

function handleCheckedTreeNodeAll(value, type, index) {
  if (type == 'menu') {
    menuRef.value[index].setCheckedNodes(value ? form.value.roleSystems[index].menuOptions : [])
  } else if (type == 'dept') {
    deptRef.value.setCheckedNodes(value ? deptOptions.value : [])
  }
}

function handleCheckedTreeConnect(value, type) {
  if (type == 'menu') {
    form.value.menuCheckStrictly = value ? true : false
  } else if (type == 'dept') {
    form.value.deptCheckStrictly = value ? true : false
  }
}

function getMenuAllCheckedKeys(ref) {

  let checkedKeys = ref.getCheckedKeys()

  let halfCheckedKeys = ref.getHalfCheckedKeys()
  checkedKeys.unshift.apply(checkedKeys, halfCheckedKeys)
  return checkedKeys
}

function submitForm() {
  proxy.$refs['roleRef'].validate(valid => {
    if (valid) {
      if (!form.value.roleSystems.length) {
        ElMessage.warning('没有关联系统')
        return
      }
      let roleSystems = []

      form.value.roleSystems.forEach((v, index) => {
        let item = {
          systemId: v.systemId,
          menuIds: getMenuAllCheckedKeys(menuRef.value[index])
        }
        roleSystems.push(item)
      })
      if (form.value.roleId != undefined) {
        form.value.roleSystems = roleSystems

        updateRole(form.value).then(response => {
          proxy.$modal.msgSuccess('修改成功')
          open.value = false
          getList()
        })
      } else {

        form.value.roleSystems = roleSystems
        addRole(form.value).then(response => {
          proxy.$modal.msgSuccess('新增成功')
          open.value = false
          getList()
        })
      }
    }
  })
}

function cancel() {
  open.value = false
  reset()
}

function dataScopeSelectChange(value) {
  if (value !== '2') {
    deptRef.value.setCheckedKeys([])
  }
}

function handleDataScope(row) {
  reset()
  const deptTreeSelect = getDeptTree(row.roleId)
  getRole(row.roleId).then(response => {
    form.value = response.data
    openDataScope.value = true
    nextTick(() => {
      deptTreeSelect.then(res => {
        nextTick(() => {
          if (deptRef.value) {
            deptRef.value.setCheckedKeys(res.checkedKeys)
          }
        })
      })
    })
    title.value = '分配数据权限'
  })
}

function submitDataScope() {
  if (form.value.roleId != undefined) {
    form.value.deptIds = getDeptAllCheckedKeys()
    dataScope(form.value).then(response => {
      proxy.$modal.msgSuccess('修改成功')
      openDataScope.value = false
      getList()
    })
  }
}

function cancelDataScope() {
  openDataScope.value = false
  reset()
}

onMounted(() => {
  getList()
  getEnumData()
  getDataScopeOptions()
  registerGrid('role-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('role-grid')
})
</script>
