  <div class="project-select">
    <el-select v-model="selectedValue" :placeholder="placeholder" class="select-container" @change="handleSelectChange" clearable>
      <el-option v-for="item in options" :key="item.key" :label="item.value" :value="item.key" />
    </el-select>
  </div>
