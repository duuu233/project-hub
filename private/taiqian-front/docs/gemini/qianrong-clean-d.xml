import { eventBus } from '@/plugins/eventBus'

class VxeGridRefreshManager {
  constructor() {
    this.grids = new Map()
    this.listeners = new Map()
  }

  registerGrid(id, gridRef, getListMethod) {
    if (gridRef && gridRef.value) {
      this.grids.set(id, gridRef.value)
    }
    if (getListMethod) {
      this.grids.set(`${id}_getList`, getListMethod)
    }

    const listener = gridId => {
      if (gridId && gridId === id) {
        this.refreshGrid(id)
      } else if (!gridId) {
        this.refreshGrid(id)
      }
    }

    this.listeners.set(id, listener)
    eventBus.on('refreshVxeGrid', listener)
  }

  unregisterGrid(id) {

    this.grids.delete(id)
    this.grids.delete(`${id}_getList`)

    const listener = this.listeners.get(id)
    if (listener) {
      eventBus.off('refreshVxeGrid', listener)
      this.listeners.delete(id)
    }
  }

  refreshGrid(id) {
    const grid = this.grids.get(id)
    const getListMethod = this.grids.get(`${id}_getList`)

    if (getListMethod && typeof getListMethod === 'function') {

      getListMethod()
    } else if (grid) {

      if (typeof grid.refreshData === 'function') {
        grid.refreshData()
      } else if (typeof grid.commitProxy === 'function') {
        grid.commitProxy('query')
      } else if (typeof grid.reloadData === 'function') {
        grid.reloadData()
      }
    }
  }

  refreshAllGrids() {
    this.grids.forEach((grid, id) => {
      if (!id.endsWith('_getList')) {
        this.refreshGrid(id)
      }
    })
  }

  clearAll() {

    this.listeners.forEach((listener, id) => {
      eventBus.off('refreshVxeGrid', listener)
    })

    this.grids.clear()
    this.listeners.clear()
  }
}

const vxeGridRefreshManager = new VxeGridRefreshManager()

export const useVxeGridRefresh = () => {
  return {

    registerGrid: (id, gridRef, getListMethod) => {
      vxeGridRefreshManager.registerGrid(id, gridRef, getListMethod)
    },

    unregisterGrid: id => {
      vxeGridRefreshManager.unregisterGrid(id)
    },

    refreshGrid: gridId => {
      eventBus.emit('refreshVxeGrid', gridId)
    },

    refreshAllGrids: () => {
      eventBus.emit('refreshVxeGrid')
    }
  }
}

export default vxeGridRefreshManager
