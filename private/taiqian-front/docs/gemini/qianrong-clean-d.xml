<script setup>
import { computed, onMounted, ref } from 'vue'
import {
  getAccessibleSsoSystems,
  getCurrentSsoSystemCode,
  getCurrentSsoSystemLabel,
  openSsoSystemWindow,
  syncSsoSystemContext
} from '@/utils/ssoSystem'

const accessibleSystems = ref([])

function refreshSystemList() {
