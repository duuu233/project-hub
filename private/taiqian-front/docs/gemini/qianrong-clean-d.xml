<file path="apps/qianrong/src/views/system/role/index.vue">
<template>
  <div class="app-container qr-list-page qr-owned-page">
    <ListPageHeader fallback-title="角色管理" subtitle="维护角色及功能权限配置">
      <template #actions><el-button type="primary" class="handle-add-btn-index" v-hasPermi="['system:role:add']" icon="CirclePlus" @click="handleAdd"
          >新增</el-button
        ></template>
    </ListPageHeader>
