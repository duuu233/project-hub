<script setup name="User-group">
import ListPageHeader from '@/components/ListPageHeader/index.vue'
import { withListGridStyle, listGrid as vListGrid } from '@/utils/listGrid'
import ListToolbarTitle from '@/components/ListToolbarTitle/index.vue'
import ListRowActions from '@/components/ListRowActions/index.vue'

import { userGroupsList, delUserGroups, enableUserGroups } from '@/api/system/user-group'
import { InfoFilled } from '@element-plus/icons-vue'
import { ElMessage } from 'element-plus'
import { useVxeGridRefresh } from '@/utils/vxeGridRefresh'
import { onMounted, onUnmounted } from 'vue'
const router = useRouter()
const { proxy } = getCurrentInstance()
const { user_groups_type } = proxy.useDict('user_groups_type')

const roleList = ref([])
const loading = ref(false)
const showSearch = ref(true)
const ids = ref([])
const single = ref(true)
const multiple = ref(true)
const total = ref(0)
const dateRange = ref([])
const gridRef = ref()

const { registerGrid, unregisterGrid } = useVxeGridRefresh()

const gridOptions = reactive(withListGridStyle({
  border: true,
  stripe: true,
  loading: false,
  columnConfig: {
    resizable: true
  },
  pagerConfig: {
    total: 0,
    currentPage: 1,
    pageSize: 10,
    layouts: ['Home', 'PrevJump', 'PrevPage', 'Number', 'NextPage', 'NextJump', 'End', 'Sizes', 'FullJump', 'Total']
  },
  rowConfig: {
    isHover: true
  },
  toolbarConfig: {
    custom: true,
    refresh: false,
    zoom: true,
    slots: {
      buttons: 'toolbarButtons'
    }
  },
  columns: [
    { type: 'seq', width: 55, align: 'center', title: '序号' },
    { title: '用户组编号', field: 'userGroupsCode' },
    { title: '用户组名称', field: 'userGroupsName', showOverflow: true },
    { title: '用户组类型', field: 'userGroupsType', align: 'center', slots: { default: 'userGroupsTypeRender' } },
    { title: '状态', field: 'status', align: 'center', slots: { default: 'statusRender' } },
    { title: '创建时间', field: 'createTime', align: 'center', slots: { default: 'createTimeRender' } },
    { title: '操作', field: 'active', width: 300, fixed: 'right', align: 'center', slots: { default: 'active' } }
  ],
  data: []
}))

const gridEvents = {
  pageChange({ pageSize, currentPage }) {
    gridOptions.pagerConfig.currentPage = currentPage
    gridOptions.pagerConfig.pageSize = pageSize
    getList()
  }
}

const data = reactive({
  queryParams: {
    pageNum: 1,
    pageSize: 10,
    dictName: undefined,
    dictType: undefined,
    status: undefined
  }
})
const { queryParams, form, rules } = toRefs(data)

function getList() {
  gridOptions.loading = true
  userGroupsList({
    ...proxy.addDateRange(queryParams.value),
    pageNum: gridOptions.pagerConfig.currentPage,
    pageSize: gridOptions.pagerConfig.pageSize
  }).then(response => {
    gridOptions.data = response.rows
    gridOptions.pagerConfig.total = response.total * 1
    gridOptions.loading = false
  })
}

function handleQuery() {
  gridOptions.pagerConfig.currentPage = 1
  getList()
}
async function confirmDel(row) {
  try {
    await delUserGroups([row.id])
    ElMessage.success('已删除')
    gridOptions.pagerConfig.currentPage = 1
    getList()
  } catch (error) {
    ElMessage.error('操作失败')
  }
}
async function confirmStatus(row) {
  try {
    await enableUserGroups({
      id: row.id,
      status: row.status === '0' ? '1' : '0'
    })
    ElMessage.success('操作成功')
    gridOptions.pagerConfig.currentPage = 1
    getList()
  } catch (error) {
    ElMessage.error('操作失败')
  }
}

function resetQuery() {
  dateRange.value = []
  proxy.resetForm('queryRef')
  handleQuery()
}

function handleExport() {
  proxy.download(
    'system/role/export',
    {
      ...queryParams.value
    },
    `role_${new Date().getTime()}.xlsx`
  )
}

function handleSelectionChange(selection) {
  ids.value = selection.map(item => item.roleId)
  single.value = selection.length != 1
  multiple.value = !selection.length
}

function handleStatusChange(row) {
  let text = row.status === '0' ? '启用' : '停用'
  proxy.$modal
    .confirm('确认要"' + text + '""' + row.roleName + '"角色吗?')
    .then(function () {
      return changeRoleStatus(row.roleId, row.status)
    })
    .then(() => {
      proxy.$modal.msgSuccess(text + '成功')
    })
    .catch(function () {
      row.status = row.status === '0' ? '1' : '0'
    })
}

function handleAdd() {
  router.push({ path: '/system/user-group/add' })
}
const handleEdit = param => {
  proxy.openNewTagsView({
    name: 'User-group/edit'
  })
  router.push({
    path: '/system/user-group/edit',
    query: { id: param.id }
  })
}
const handleDetail = param => {
  proxy.openNewTagsView({
    name: 'User-group/detail'
  })
  router.push({
    path: '/system/user-group/detail',
    query: { id: param.id }
  })
}

onMounted(() => {
  getList()
  registerGrid('user-group-grid', gridRef, getList)
})

onUnmounted(() => {
  unregisterGrid('user-group-grid')
})
</script>
