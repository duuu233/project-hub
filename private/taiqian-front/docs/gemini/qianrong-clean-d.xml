<file path="apps/qianrong/src/permission.js">
import router from './router'
import { ElMessage } from 'element-plus'
import NProgress from 'nprogress'
import 'nprogress/nprogress.css'
import { getToken, removeToken } from '@/utils/auth'
import { isHttp } from '@/utils/validate'
import { isRelogin } from '@/utils/request'
import { redirectToLogin } from '@/utils/loginRedirect'
import { syncSsoSystemContext } from '@/utils/ssoSystem'
import useUserStore from '@/store/modules/user'
import useSettingsStore from '@/store/modules/settings'
import usePermissionStore from '@/store/modules/permission'

NProgress.configure({ showSpinner: false })

const whiteList = ['/login', '/register']
let hasAddRoutes = false

const reloginErrors = ['重新登录', '会话过期', '无效的会话']

function needRelogin(error) {
  if (!error) return false
  const errorMessage = error.toString().toLowerCase()
  return reloginErrors.some(msg => errorMessage.includes(msg.toLowerCase()))
}

function getFirstRouter() {
  const permissionStore = usePermissionStore()
  const addRoutes = permissionStore.addRoutes
  let firstRouter = null

  if (addRoutes && addRoutes.length) {
    for (const item of addRoutes) {
      if (item.children && item.children.length) {
        firstRouter = item.children[0]
        break
      }
    }
  }

  if (firstRouter) {
    const newRoutes = [...addRoutes]
    newRoutes.push({
      ...firstRouter,
      path: ''
    })
    permissionStore.setRoutes(newRoutes)
  }

  return firstRouter
}

async function addDynamicRoutes(accessRoutes) {
  if (!hasAddRoutes) {
    for (const route of accessRoutes) {
      if (!isHttp(route.path)) {
        router.addRoute(route)
      }
    }
    hasAddRoutes = true
  }
}

router.beforeEach(async (to, from, next) => {
  NProgress.start()
  syncSsoSystemContext()

  if (getToken()) {
    to.meta.title && useSettingsStore().setTitle(to.meta.title)

    if (to.path === '/login') {
      next({ path: '/' })
      NProgress.done()
    } else if (whiteList.indexOf(to.path) !== -1) {
      next()
    } else {
      const userStore = useUserStore()
      const permissionStore = usePermissionStore()

      if (userStore.roles.length === 0) {
        try {
          isRelogin.show = true
          await userStore.getInfo()
          isRelogin.show = false

          const accessRoutes = await permissionStore.generateRoutes()
          await addDynamicRoutes(accessRoutes)

          if (location.pathname === '/' || location.pathname === '/login') {
            const firstRouter = getFirstRouter()
            if (firstRouter) {
              next({ ...firstRouter, replace: true })
            } else {
              next({ ...to, replace: true })
            }
          } else {
            next({ ...to, replace: true })
          }
        } catch (err) {
          isRelogin.show = false
          hasAddRoutes = false

          if (needRelogin(err)) {
            await userStore.logOut()
            removeToken()
            ElMessage.error('登录状态已过期，请重新登录')
            const currentRoute = to.fullPath
            redirectToLogin({ next, redirect: currentRoute })
          } else {
            ElMessage.error(err.message || '系统错误')
            const currentRoute = to.fullPath
            redirectToLogin({ next, redirect: currentRoute })
          }
          NProgress.done()
        }
      } else {
        next()
      }
    }
  } else {
    if (whiteList.indexOf(to.path) !== -1) {
      next()
    } else {
      const currentRoute = to.fullPath
      redirectToLogin({ next, redirect: currentRoute })
      NProgress.done()
    }
  }
})

router.afterEach(() => {
  NProgress.done()
})

export default router
</file>

