<script setup>
import { onMounted, nextTick } from 'vue'
import useSettingsStore from '@/store/modules/settings'
import { handleThemeStyle } from '@/utils/theme'

const getDomainType = () => {
  const hostname = window.location.hostname

  let domainType = null
  let loginType = null

  if (hostname.includes('tenant-') || hostname.includes('tenant.')) {
    domainType = '1'
    loginType = '1'
  } else if (hostname.includes('regulator-') || hostname.includes('regulator.')) {
    domainType = '1'
    loginType = '2'
  } else if (hostname.includes('bank-') || hostname.includes('bank.')) {
    domainType = '1'
    loginType = '3'
  } else if (hostname.includes('platform-') || hostname.includes('platform.')) {
    domainType = '1'
    loginType = '0'
  } else {
    domainType = '0'
  }

  localStorage.setItem('domainType', domainType)
  if (domainType === '1') {
    localStorage.setItem('loginType', loginType)
  }

  return domainType
}

onMounted(() => {
  getDomainType()

  nextTick(() => {
    handleThemeStyle(useSettingsStore().theme)
  })
})
</script>
