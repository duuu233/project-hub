<script setup>
import DetailHeaderCard from '@/components/DetailHeaderCard/index.vue'
import { headerTime, dictTagField } from '@/components/DetailHeaderCard/utils'
import BottomFixedBtnsBox from '@/components/BottomFixedBtnsBox/index.vue'
import { ref, reactive, onMounted, nextTick } from 'vue'
import { ElMessage } from 'element-plus'
import { useRouter, useRoute } from 'vue-router'
import Collapse from '@/components/Collapse'
import AreaCascader from '@/components/AreaCascader'
import { userGroupsList as userGroupsListApi } from '@/api/system/user-group'
import { addEnterpriseUser, editEnterpriseUser, detailEnterpriseUser } from '@/api/system/enterprise-users'
const { proxy } = getCurrentInstance()
const { org_user_type, bank_type } = proxy.useDict('org_user_type', 'bank_type')

const props = defineProps({
  pageType: Number
})
const router = useRouter()
const route = useRoute()
const form = ref({
  sysOrgGroups: {}
})

const cascaderRef = ref()
const userGroupList = ref([])
const formRef = ref()

onMounted(async () => {
  await getUserGroupList()

  if (props.pageType !== 1) {
    await getDetails()
  }
})

async function getUserGroupList() {
  const res = await userGroupsListApi({ status: 0, pageNum: 1, pageSize: 500 })
  userGroupList.value = res.rows || []
}

async function getDetails() {
  try {
    const res = await detailEnterpriseUser(route.query.id)

    form.value = res.data
    form.value.orgType = form.value.orgType + ''
    form.value.cascader = [res.data.provinceCode, res.data.cityCode, res.data.areaCode]
    if (!res.data.areaCode) {
      form.value.cascader.pop()
    }
    if (!form.value.sysOrgGroups) {
      form.value.sysOrgGroups = {}
    }
  } catch (error) {
    console.log(error)
  }
}

const submit = async () => {
  await formRef.value.validate(async (valid, fields) => {
    if (valid) {
      if (form.value.cascader && form.value.cascader.length) {
        form.value.provinceCode = form.value.cascader[0]
        form.value.cityCode = form.value.cascader[1]
        form.value.areaCode = form.value.cascader[2]
        form.value.areaFullName = cascaderRef.value.getNames().join('-')
      }
      form.value.orgId = route.query.orgId

      delete form.value.cascader

      if (props.pageType === 1) {
        await addEnterpriseUser(form.value)
      }
      if (props.pageType === 2) {
        await editEnterpriseUser(form.value)
      }
      ElMessage.success('操作成功')
      setTimeout(() => {
        proxy.toList({
          path: `/system/enterprise-users`,
          listName: 'Enterprise-users'
        })
      }, 300)
    } else {
      console.log('error submit!', fields)
    }
  })
}

const validateSocialCreditCode = (rule, value, callback) => {
  const regSocialCreditCode = /^[A-Z0-9]{18}$/
  if (value === '') {
    callback(new Error('请输入统一信用代码'))
  } else if (!regSocialCreditCode.test(value)) {
    callback(new Error('请输入18位数字或大写字母'))
  } else {
    callback()
  }
}

const handlePhoneInput = value => {

  form.value.phonenumber = value.replace(/\D/g, '')
}
const detailHeaderFields = computed(() => {
  const data = form.value
  return [
    { label: '企业编号', value: data.orgCode },
    { label: '企业名称', value: data.orgName },
    { label: '统一信用代码', value: data.socialCreditCode },
    dictTagField('状态', { 0: '启用中', 1: '已禁用' }, data.status),
    { label: '企业来源', value: data.source == '1' ? '后台创建' : '未知' },
    { label: '创建时间', value: headerTime(data.createTime) }
  ]
})
</script>

