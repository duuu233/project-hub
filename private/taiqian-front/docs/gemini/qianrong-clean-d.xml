// 产业配置页面用到的枚举。
// 金融场景、融资对象服务端没有对应字典，取值来自后端接口文档（产业配置新增编辑参数）；
// 产业项目、PC 页面类型、账号注册方式使用字典：industry_project / industry_pc_page_type / industry_register_mode。

export const FINANCE_SCENE_OPTIONS = [
